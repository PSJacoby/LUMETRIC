// Custom cell renderer for checkboxes that disables when type is "none"
class VisualizationCheckBoxRenderer extends JCheckBox implements javax.swing.table.TableCellRenderer {
    public VisualizationCheckBoxRenderer() {
        setHorizontalAlignment(SwingConstants.CENTER);
    }
    
    public Component getTableCellRendererComponent(JTable table, Object value,
                                                   boolean isSelected, boolean hasFocus,
                                                   int row, int column) {
        String type = (String) table.getValueAt(row, 1);
        boolean enabled = !type.equals("none");
        
        setEnabled(enabled);
        setSelected(value != null && ((Boolean) value).booleanValue());
        
        if (isSelected) {
            setBackground(table.getSelectionBackground());
            setForeground(table.getSelectionForeground());
        } else {
            setBackground(table.getBackground());
            setForeground(table.getForeground());
        }
        
        return this;
    }
}

// Custom cell editor for checkboxes
class VisualizationCheckBoxEditor extends DefaultCellEditor {
    public VisualizationCheckBoxEditor() {
        super(new JCheckBox());
        JCheckBox checkBox = (JCheckBox) getComponent();
        checkBox.setHorizontalAlignment(SwingConstants.CENTER);
    }
}

// Main GUI
JFrame frame = new JFrame("LUMETRIC - Hardware control");
frame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
frame.setSize(1300, 600);

// Create tabbed pane
JTabbedPane tabbedPane = new JTabbedPane();

// Create checkboxes at higher scope so both buttons can access them
JCheckBox simpleSnapMode = new JCheckBox("Simple Snap Mode", true);
simpleSnapMode.setToolTipText("Enable for single-channel acquisition with GUI settings only (safe & simple)");

JCheckBox livePics = new JCheckBox("Live Pictures");
livePics.setToolTipText("Show live view in GUI during acquisition (images are always saved to disk)");

// Stack conversion checkboxes (mutually exclusive)
JCheckBox convertToStack = new JCheckBox("Convert to Stack", true);
convertToStack.setToolTipText("After acquisition, convert individual TIFFs to a single stack and delete originals");

JCheckBox stackPerRow = new JCheckBox("Stack per Row");
stackPerRow.setToolTipText("Create one stack for each row in the acquisition settings (not yet implemented)");
stackPerRow.setEnabled(false); // Disabled for now

// Make stack checkboxes mutually exclusive
convertToStack.addActionListener(new ActionListener() {
    public void actionPerformed(ActionEvent e) {
        if (convertToStack.isSelected()) {
            stackPerRow.setSelected(false);
        }
    }
});

stackPerRow.addActionListener(new ActionListener() {
    public void actionPerformed(ActionEvent e) {
        if (stackPerRow.isSelected()) {
            convertToStack.setSelected(false);
        }
    }
});

