if (!savedDataPath.isEmpty() && new File(savedDataPath).exists()) {
    dataDirPathLabel.setText(savedDataPath);
    dataDirPathLabel.setForeground(Color.BLACK);
}

frame.setVisible(true);

// Validation function
    boolean validateSequence() {
        // Stop any active cell editing to commit current edits
        if (table.isEditing()) {
            javax.swing.table.TableCellEditor editor = table.getCellEditor();
            if (editor != null) {
                editor.stopCellEditing();
            }
        }
        
        int rowCount = tableModel.getRowCount();
        StringBuilder errors = new StringBuilder();

        for (int i = 0; i < rowCount; i++) {
            // Note: Empty channels are allowed (e.g., for delay rows)

            // Validate numeric fields (should be auto-corrected, but double-check)
            int exposureValue = 0;
            int frameIntervalValue = 0;

            try {
                String exposure = tableModel.getValueAt(i, 2).toString();
                if (!exposure.isEmpty()) {
                    int exp = Integer.parseInt(exposure);
                    exposureValue = exp;
                    if (exp < 0 || exp > 250) {
                        errors.append("Row " + (i + 1) + ": Exposure must be 0-250 ms\n");
                    }
                }
            } catch (NumberFormatException e) {
                errors.append("Row " + (i + 1) + ": Invalid exposure value\n");
            }

            try {
                String frameRate = tableModel.getValueAt(i, 3).toString();
                if (!frameRate.isEmpty()) {
                    int fr = Integer.parseInt(frameRate);
                    frameIntervalValue = fr;
                    if (fr < 0 || fr > 10000) {
                        errors.append("Row " + (i + 1) + ": Frame interval must be 0-10000 ms\n");
                    }
                }
            } catch (NumberFormatException e) {
                errors.append("Row " + (i + 1) + ": Invalid frame interval value\n");
            }

            // Check that exposure time is not greater than frame interval
            if (exposureValue > 0 && frameIntervalValue > 0 && exposureValue > frameIntervalValue) {
                errors.append("Row " + (i + 1) + ": Exposure time (" + exposureValue
                        + " ms) must be less than or equal to Frame Interval (" + frameIntervalValue + " ms)\n");
            }

            try {
                String frames = tableModel.getValueAt(i, 4).toString();
                if (!frames.isEmpty()) {
                    int f = Integer.parseInt(frames);
                    if (f < 0 || f > 10000) {
                        errors.append("Row " + (i + 1) + ": Frames must be 0-10000\n");
                    }
                }
            } catch (NumberFormatException e) {
                errors.append("Row " + (i + 1) + ": Invalid frames value\n");
            }

            // Validate Loop Times
            try {
                String loopTimes = tableModel.getValueAt(i, 6).toString();
                if (!loopTimes.isEmpty()) {
                    int lt = Integer.parseInt(loopTimes);
                    if (lt < 0 || lt > 10000) {
                        errors.append("Row " + (i + 1) + ": Loop Times must be 0-10000\n");
                    }
                }
            } catch (NumberFormatException e) {
                errors.append("Row " + (i + 1) + ": Invalid Loop Times value\n");
            }

            // Validate goto references
            String loopGoto = tableModel.getValueAt(i, 5).toString();
            if (!loopGoto.isEmpty()) {
                try {
                    int gotoRow = Integer.parseInt(loopGoto);
                    if (gotoRow < 1 || gotoRow > rowCount) {
                        errors.append("Row " + (i + 1) + ": Loop Goto references non-existent row " + gotoRow + "\n");
                    }
                } catch (NumberFormatException e) {
                    errors.append("Row " + (i + 1) + ": Invalid Loop Goto value\n");
                }
            }

            String switchGoto = tableModel.getValueAt(i, 8).toString().trim();
            if (!switchGoto.isEmpty() && !switchGoto.equalsIgnoreCase("none")) {
                try {
                    int gotoRow = Integer.parseInt(switchGoto);
                    if (gotoRow < 1 || gotoRow > rowCount) {
                        errors.append(
                                "Row " + (i + 1) + ": Loop Switch Goto references non-existent row " + gotoRow + "\n");
                    }
                } catch (NumberFormatException e) {
                    errors.append("Row " + (i + 1) + ": Invalid Loop Switch Goto value (use row number or 'none')\n");
                }
            }
        }

        if (errors.length() > 0) {
            JOptionPane.showMessageDialog(frame, errors.toString(), "Validation Errors", JOptionPane.ERROR_MESSAGE);
            return false;
        } else {
            JOptionPane.showMessageDialog(frame, "Sequence is valid!", "Success", JOptionPane.INFORMATION_MESSAGE);
            return true;
        }
    }

    // Print sequence data for debugging - uses captured data
    void printSequenceData() {
        print("DEBUG: [PRINT_SEQ] Starting...");
        print("\n=== Acquisition Sequence ===");
        print("DEBUG: [PRINT_SEQ] Printed header");
        print("Live Pictures: " + config.acqSettings.livePics);
        print("DEBUG: [PRINT_SEQ] Printed livePics");
        print("\nSequence Steps:");
        print("DEBUG: [PRINT_SEQ] About to iterate " + config.acqSettings.sequenceRows.size() + " rows");

        for (int i = 0; i < config.acqSettings.sequenceRows.size(); i++) {
            print("DEBUG: [PRINT_SEQ] Processing row " + (i + 1));
            ArrayList row = config.acqSettings.sequenceRows.get(i);
            print("Step " + (i + 1) + ":");
            print("  Channel: " + row.get(1));
            print("  Exposure: " + row.get(2) + " ms");
            print("  Frame Interval: " + row.get(3) + " ms");
            print("  Frames: " + row.get(4));
            print("  Loop Goto: " + row.get(5));
            print("  Loop Times: " + row.get(6));
            print("  Constant Illum: " + row.get(7));
            print("  Loop Switch Goto: " + row.get(8));
            print("DEBUG: [PRINT_SEQ] Row " + (i + 1) + " complete");
        }
        print("===========================\n");
        print("DEBUG: [PRINT_SEQ] Complete");
    }

// ==================== Generic CSV Export Helper ====================

// Write generic CSV data to file
// data: 2D array or List of Lists - each inner list is a row
// headers: Array/List of column headers
// comments: Optional array/list of comment lines (will be prefixed with #)
boolean writeCSV(File csvFile, Object headers, Object data, Object comments) {
    try {
        PrintWriter writer = new PrintWriter(new FileWriter(csvFile));
        
        // Write headers
        if (headers != null) {
            StringBuilder headerRow = new StringBuilder();
            if (headers instanceof Object[]) {
                Object[] headerArray = (Object[]) headers;
                for (int i = 0; i < headerArray.length; i++) {
                    if (i > 0) headerRow.append(",");
                    headerRow.append(escapeCSV(headerArray[i].toString()));
                }
            } else if (headers instanceof List) {
                List headerList = (List) headers;
                for (int i = 0; i < headerList.size(); i++) {
                    if (i > 0) headerRow.append(",");
                    headerRow.append(escapeCSV(headerList.get(i).toString()));
                }
            }
            writer.println(headerRow.toString());
        }
        
        // Write data rows
        if (data != null) {
            if (data instanceof Object[][]) {
                Object[][] dataArray = (Object[][]) data;
                for (int i = 0; i < dataArray.length; i++) {
                    StringBuilder row = new StringBuilder();
                    for (int j = 0; j < dataArray[i].length; j++) {
                        if (j > 0) row.append(",");
                        row.append(escapeCSV(dataArray[i][j].toString()));
                    }
                    writer.println(row.toString());
                }
            } else if (data instanceof List) {
                List dataList = (List) data;
                for (int i = 0; i < dataList.size(); i++) {
                    StringBuilder row = new StringBuilder();
                    Object rowData = dataList.get(i);
                    if (rowData instanceof Object[]) {
                        Object[] rowArray = (Object[]) rowData;
                        for (int j = 0; j < rowArray.length; j++) {
                            if (j > 0) row.append(",");
                            row.append(escapeCSV(rowArray[j].toString()));
                        }
                    } else if (rowData instanceof List) {
                        List rowList = (List) rowData;
                        for (int j = 0; j < rowList.size(); j++) {
                            if (j > 0) row.append(",");
                            row.append(escapeCSV(rowList.get(j).toString()));
                        }
                    }
                    writer.println(row.toString());
                }
            }
        }
        
        // Write comments
        if (comments != null) {
            writer.println("");
            if (comments instanceof Object[]) {
                Object[] commentArray = (Object[]) comments;
                for (int i = 0; i < commentArray.length; i++) {
                    writer.println("# " + commentArray[i].toString());
                }
            } else if (comments instanceof List) {
                List commentList = (List) comments;
                for (int i = 0; i < commentList.size(); i++) {
                    writer.println("# " + commentList.get(i).toString());
                }
            } else if (comments instanceof String) {
                writer.println("# " + comments.toString());
            }
        }
        
        writer.close();
        return true;
        
    } catch (IOException e) {
        print("ERROR: Failed to write CSV file: " + e.getMessage());
        e.printStackTrace();
        return false;
    }
}

// Escape special characters for CSV format
String escapeCSV(String value) {
    if (value == null) return "";
    if (value.contains(",") || value.contains("\"") || value.contains("\n")) {
        return "\"" + value.replace("\"", "\"\"") + "\"";
    }
    return value;
}

// Find next available filename with timestamp
File getNextAvailableFile(File directory, String baseName, String extension) {
    // Use timestamp to avoid having to check existing files
    import java.text.SimpleDateFormat;
    import java.util.Date;
    
    SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMdd_HHmmss");
    String timestamp = sdf.format(new Date());
    File file = new File(directory, baseName + "_" + timestamp + extension);
    
    // If by some chance file exists (same second), add milliseconds
    if (file.exists()) {
        timestamp = sdf.format(new Date()) + "_" + System.currentTimeMillis();
        file = new File(directory, baseName + "_" + timestamp + extension);
    }
    
    return file;
}

// ==================== ROI Setup for Visualization ====================

// Check if any visualization channels are configured - DEPRECATED, use config.acqSettings.isVisualizationNeeded()
boolean isVisualizationNeeded() {
    return config.acqSettings.isVisualizationNeeded();
}

// Setup ROIs for visualization - returns true if successful, false if cancelled
boolean setupVisualizationROIs() {
    print("========== ROI SETUP START ==========");
    // Note: Main GUI is already disposed at this point
    
    import ij.IJ;
    import ij.ImagePlus;
    import ij.plugin.frame.RoiManager;
    import ij.process.ImageProcessor;
    
    // Snap an image
    print("Snapping image...");
    mmc.setConfig(config.cameraConfigGroup, config.cameraSnapConfig);
    List images = mm.live().snap(false);
    org.micromanager.data.Image image = images.get(0);
    print("Image snapped");
    
    if (images == null || images.isEmpty()) {
        print("ERROR: Failed to snap image");
        return false;
    }
    
    // Create ImageJ display
    ImageProcessor ip = mm.data().ij().createProcessor(image);
    ImagePlus imp = new ImagePlus("ROI Selection - Draw your ROIs", ip);
    imp.show();
    print("Image displayed");
    
    // Open ROI Manager
    IJ.run("ROI Manager...", "");
    ij.plugin.frame.RoiManager rm = ij.plugin.frame.RoiManager.getInstance();
    rm.runCommand(imp, "Show All");
    print("ROI Manager ready");
    
    // Create control window
    final boolean[] done = {false};
    final boolean[] cancelled = {false};
    
    JFrame btnFrame = new JFrame("ROI Setup");
    btnFrame.setSize(400, 150);
    btnFrame.setAlwaysOnTop(true);
    btnFrame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
    
    JPanel infoPanel = new JPanel(new BorderLayout());
    JLabel infoLabel = new JLabel("<html><div style='text-align: center; padding: 10px;'>"
        + "<b>Draw ROIs on the image and add them to ROI Manager</b><br>"
        + "Press 't' to add ROIs, then click Done"
        + "</div></html>", SwingConstants.CENTER);
    infoPanel.add(infoLabel, BorderLayout.CENTER);
    
    JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.CENTER, 20, 10));
    JButton doneButton = new JButton("ROIs Done");
    doneButton.setBackground(Color.GREEN);
    JButton cancelButton = new JButton("Cancel");
    cancelButton.setBackground(Color.ORANGE);
    
    doneButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            print("Done button clicked!");
            done[0] = true;
            btnFrame.dispose();
        }
    });
    
    cancelButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            print("Cancel button clicked!");
            cancelled[0] = true;
            btnFrame.dispose();
        }
    });
    
    buttonPanel.add(doneButton);
    buttonPanel.add(cancelButton);
    
    btnFrame.setLayout(new BorderLayout());
    btnFrame.add(infoPanel, BorderLayout.CENTER);
    btnFrame.add(buttonPanel, BorderLayout.SOUTH);
    btnFrame.setLocationRelativeTo(null);
    btnFrame.setVisible(true);
    
    print("Waiting for button click...");
    int count = 0;
    while (done[0] == false && cancelled[0] == false) {
        count++;
        if (count % 10 == 0) {
            print("Still waiting... " + count);
        }
        Thread.sleep(100);
    }
    
    print("Button clicked! done=" + done[0] + ", cancelled=" + cancelled[0]);
    
    // Clean up ImageJ window
    if (imp.getWindow() != null) {
        imp.getWindow().close();
    }
    
    if (cancelled[0]) {
        print("ROI setup cancelled");
        return false;
    }
    
    // Save ROI set
    print("ROI count = " + rm.getCount());
    if (rm.getCount() > 0) {
        String lastSavePath = prefs.get("lastSavePath", "");
        if (!lastSavePath.isEmpty()) {
            File saveDir = new File(lastSavePath);
            File roiFile = getNextAvailableFile(saveDir, "RoiSet", ".zip");
            print("Saving ROIs to: " + roiFile.getAbsolutePath());
            rm.runCommand("Save", roiFile.getAbsolutePath());
            if (roiFile.exists()) {
                print("SUCCESS: ROI set saved (" + roiFile.length() + " bytes)");
            }
        }
    }
    
    // Close ROI Manager to free memory
    print("Closing ROI Manager...");
    rm.close();
    
    print("========== ROI SETUP COMPLETE ==========");
    return true;
}

    // Export table to CSV with auto-incrementing filename - uses captured data
boolean exportTableToCSV() {
    print("DEBUG: [CSV] Starting export...");
    // Get save directory from captured settings
    String saveDir = config.acqSettings.saveDirectory;
    print("DEBUG: [CSV] Save directory: " + saveDir);
    
    if (saveDir.isEmpty() || !new File(saveDir).exists()) {
        print("ERROR: Save directory not set!");
        return false;
    }
    
    File saveDirFile = new File(saveDir);
    print("DEBUG: [CSV] Save directory file created");
    
    // Find next available filename
    print("DEBUG: [CSV] Getting next available filename...");
    File csvFileReadable = getNextAvailableFile(saveDirFile, "AquisitionSettings", ".csv");
    print("DEBUG: [CSV] Readable file: " + csvFileReadable.getAbsolutePath());
    String baseName = csvFileReadable.getName().replace(".csv", "");
    File csvFileArduino = new File(saveDirFile, baseName + "_Arduino.csv");
    print("DEBUG: [CSV] Arduino file: " + csvFileArduino.getAbsolutePath());
    
    ArrayList tableData = config.acqSettings.sequenceRows;
    print("DEBUG: [CSV] Table data rows: " + tableData.size());
    
    try {
        print("DEBUG: [CSV] Starting human-readable CSV...");
        // ===== HUMAN-READABLE VERSION =====
        PrintWriter writerReadable = new PrintWriter(new FileWriter(csvFileReadable));
        print("DEBUG: [CSV] Writer created");
        
        // Write header
        writerReadable.println("Channel,Exposure [ms],Frame Interval [ms],Frames,Loop Goto,Loop Times,Constant Illum,Loop Switch Goto");
        print("DEBUG: [CSV] Header written");
        
        // Write data rows (display format)
        print("DEBUG: [CSV] Writing data rows...");
        for (int i = 0; i < tableData.size(); i++) {
            StringBuilder row = new StringBuilder();
            ArrayList rowData = (ArrayList) tableData.get(i);
            for (int j = 1; j < rowData.size(); j++) { // Skip column 0 (Row number)
                String value = rowData.get(j).toString();
                
                // Format display values
                if (j == 1 && value.isEmpty()) { // Channel
                    value = "none";
                } else if (j == 6 && value.isEmpty()) { // Loop Times
                    value = "always";
                } else if (j == 7 && value.isEmpty()) { // Constant Illum
                    value = "none";
                } else if (j == 8 && value.isEmpty()) { // Loop Switch Goto
                    value = "none";
                }
                
                row.append(escapeCSV(value));
                if (j < rowData.size() - 1) {
                    row.append(",");
                }
            }
            writerReadable.println(row.toString());
        }
        
        print("DEBUG: [CSV] All data rows written");
        // Write mode settings as comments
        writerReadable.println("");
        writerReadable.println("# Live Pictures: " + config.acqSettings.livePics);
        
        writerReadable.close();
        print("DEBUG: [CSV] Readable CSV closed");
        
        print("DEBUG: [CSV] Starting Arduino CSV...");
        // ===== ARDUINO VERSION =====
        PrintWriter writerArduino = new PrintWriter(new FileWriter(csvFileArduino));
        
        // Write header
        writerArduino.println("Channel,Exposure [ms],Frame Interval [ms],Frames,Loop Goto,Loop Times,Constant Illum,Loop Switch Goto");
        
        // Write data rows (Arduino format)
        print("DEBUG: [CSV] Writing Arduino data rows...");
        for (int i = 0; i < tableData.size(); i++) {
            StringBuilder row = new StringBuilder();
            ArrayList rowData = (ArrayList) tableData.get(i);
            for (int j = 1; j < rowData.size(); j++) { // Skip column 0 (Row number)
                String value = rowData.get(j).toString();
                String arduinoValue = value;
                
                // Convert to Arduino format
                if (j == 1) { // Channel
                    if (value.isEmpty()) {
                        // none channel: 1 if Exposure > 0 (camera only), 0 if Exposure = 0
                        String exposureStr = rowData.get(2).toString();
                        try {
                            int exposure = exposureStr.isEmpty() ? 0 : Integer.parseInt(exposureStr);
                            arduinoValue = exposure > 0 ? "1" : "0";
                        } catch (NumberFormatException e) {
                            arduinoValue = "0";
                        }
                    } else {
                        // Convert channel names to binary sum for Arduino
                        // PIN_1 (Camera) = 1, PIN_2 = 2, PIN_3 = 4, PIN_4 = 8, etc.
                        String[] channels = value.split(",");
                        int binarySum = 1; // Camera (PIN_1) is always on
                        for (String ch : channels) {
                            String channelName = ch.trim();
                            int pinNum = config.getPinForChannel(channelName);
                            if (pinNum != -1) {
                                // Calculate power of 2 for this pin
                                binarySum += (1 << (pinNum - 1));
                            }
                        }
                        arduinoValue = String.valueOf(binarySum);
                    }
                } else if (j == 6) { // Loop Times
                    if (value.isEmpty()) {
                        arduinoValue = "0"; // infinity = 0
                    }
                } else if (j == 7) { // Constant Illum
                    if (value.isEmpty()) {
                        arduinoValue = "0"; // none = 0
                    } else {
                        // Convert constant illum channel names to binary sum for Arduino
                        String[] channels = value.split(",");
                        int binarySum = 0; // No camera base for constant illum
                        for (String ch : channels) {
                            String channelName = ch.trim();
                            int pinNum = config.getPinForChannel(channelName);
                            if (pinNum != -1) {
                                // Calculate power of 2 for this pin
                                binarySum += (1 << (pinNum - 1));
                            }
                        }
                        arduinoValue = String.valueOf(binarySum);
                    }
                } else if (j == 8) { // Loop Switch Goto
                    if (value.isEmpty()) {
                        arduinoValue = "0"; // none = 0
                    }
                }
                
                row.append(escapeCSV(arduinoValue));
                if (j < rowData.size() - 1) {
                    row.append(",");
                }
            }
            writerArduino.println(row.toString());
        }
        
        print("DEBUG: [CSV] Arduino data rows written");
        // Write mode settings as comments
        writerArduino.println("");
        writerArduino.println("# Live Pictures: " + config.acqSettings.livePics);
        
        writerArduino.close();
        print("DEBUG: [CSV] Arduino CSV closed");
        
        print("Tables exported to:");
        print("  Readable: " + csvFileReadable.getAbsolutePath());
        print("  Arduino:  " + csvFileArduino.getAbsolutePath());
        print("DEBUG: [CSV] Export complete, returning true");
        return true;
        
    } catch (IOException e) {
        print("ERROR: Failed to export CSV files: " + e.getMessage());
        e.printStackTrace();
        return false;
    }
}

// ==================== Acquisition Control Window ====================

// Create acquisition control window with live view and control buttons
JFrame createAcquisitionWindow() {
    print("DEBUG: [ACQ WINDOW] Creating JFrame...");
    JFrame acqFrame = new JFrame("LUMETRIC - Acquisition Control");
    print("DEBUG: [ACQ WINDOW] JFrame created");
    acqFrame.setDefaultCloseOperation(JFrame.DO_NOTHING_ON_CLOSE);
    acqFrame.setSize(1000, 700);
    acqFrame.setLayout(new BorderLayout(10, 10));
    print("DEBUG: [ACQ WINDOW] JFrame configured");
    
    // Main split pane: left = display area, right = controls
    print("DEBUG: [ACQ WINDOW] Creating split pane...");
    javax.swing.JSplitPane splitPane = new javax.swing.JSplitPane(
        javax.swing.JSplitPane.HORIZONTAL_SPLIT);
    splitPane.setResizeWeight(0.75); // 75% for display, 25% for controls
    splitPane.setDividerLocation(750);
    print("DEBUG: [ACQ WINDOW] Split pane created");
    
    // ===== LEFT PANEL: Display Area =====
    print("DEBUG: [ACQ WINDOW] Creating display panel...");
    JPanel displayPanel = new JPanel(new BorderLayout());
    displayPanel.setBorder(BorderFactory.createTitledBorder("Live View / Graphs"));
    displayPanel.setBackground(Color.DARK_GRAY);
    print("DEBUG: [ACQ WINDOW] Display panel created");
    
    // Placeholder label (will be replaced with actual graphs/images)
    print("DEBUG: [ACQ WINDOW] Adding placeholder label...");
    JLabel displayLabel = new JLabel("Live view and graphs will appear here during acquisition", 
        SwingConstants.CENTER);
    displayLabel.setForeground(Color.LIGHT_GRAY);
    displayLabel.setFont(new Font("SansSerif", Font.ITALIC, 14));
    displayPanel.add(displayLabel, BorderLayout.CENTER);
    print("DEBUG: [ACQ WINDOW] Display panel configured");
    
    // ===== RIGHT PANEL: Control Buttons =====
    print("DEBUG: [ACQ WINDOW] Creating control panel...");
    JPanel controlPanel = new JPanel();
    controlPanel.setLayout(new GridLayout(0, 1, 10, 10));
    controlPanel.setBorder(BorderFactory.createEmptyBorder(20, 20, 20, 20));
    print("DEBUG: [ACQ WINDOW] Control panel created");
    
    // Status label at top
    print("DEBUG: [ACQ WINDOW] Creating buttons...");
    JLabel statusLabel = new JLabel("Status: Ready", SwingConstants.CENTER);
    statusLabel.setFont(new Font("SansSerif", Font.BOLD, 14));
    statusLabel.setBorder(BorderFactory.createEmptyBorder(0, 0, 20, 0));
    
    // Pause/Resume button
    JButton pauseButton = new JButton("Pause");
    pauseButton.setBackground(Color.ORANGE);
    pauseButton.setFont(new Font("SansSerif", Font.BOLD, 14));
    pauseButton.setPreferredSize(new java.awt.Dimension(150, 50));
    pauseButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            if (pauseButton.getText().equals("Pause")) {
                pauseButton.setText("Resume");
                pauseButton.setBackground(Color.GREEN);
                statusLabel.setText("Status: Paused");
                print("Acquisition paused by user");
                // TODO: Set pause flag
            } else {
                pauseButton.setText("Pause");
                pauseButton.setBackground(Color.ORANGE);
                statusLabel.setText("Status: Running");
                print("Acquisition resumed by user");
                // TODO: Clear pause flag
            }
        }
    });
    
    // Loop Switch button
    JButton loopSwitchButton = new JButton("Loop Switch");
    loopSwitchButton.setBackground(new Color(100, 150, 255)); // Light blue
    loopSwitchButton.setFont(new Font("SansSerif", Font.BOLD, 14));
    loopSwitchButton.setPreferredSize(new java.awt.Dimension(150, 50));
    loopSwitchButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            print("Loop switch triggered by user");
            // TODO: Trigger loop switch in acquisition logic
        }
    });
    
    // Abort button
    JButton abortButton = new JButton("Abort");
    abortButton.setBackground(Color.RED);
    abortButton.setForeground(Color.WHITE);
    abortButton.setFont(new Font("SansSerif", Font.BOLD, 14));
    abortButton.setPreferredSize(new java.awt.Dimension(150, 50));
    abortButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            int confirm = JOptionPane.showConfirmDialog(acqFrame,
                "Are you sure you want to abort the acquisition?",
                "Confirm Abort",
                JOptionPane.YES_NO_OPTION,
                JOptionPane.WARNING_MESSAGE);
            if (confirm == JOptionPane.YES_OPTION) {
                print("Acquisition aborted by user");
                statusLabel.setText("Status: Aborted");
                // TODO: Set abort flag
            }
        }
    });
    
    // Close button (only enabled when acquisition is done)
    JButton closeButton = new JButton("Close");
    closeButton.setBackground(Color.LIGHT_GRAY);
    closeButton.setFont(new Font("SansSerif", Font.BOLD, 14));
    closeButton.setPreferredSize(new java.awt.Dimension(150, 50));
    closeButton.setEnabled(false); // Disabled until acquisition completes
    closeButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            print("Closing acquisition window...");
            acqFrame.dispose();
            print("Acquisition window closed, memory freed");
        }
    });
    
    // Add components to control panel
    print("DEBUG: [ACQ WINDOW] Adding buttons to control panel...");
    controlPanel.add(statusLabel);
    controlPanel.add(pauseButton);
    controlPanel.add(loopSwitchButton);
    controlPanel.add(abortButton);
    controlPanel.add(closeButton);
    
    // Add vertical glue to push buttons to top
    controlPanel.add(new JLabel("")); // Spacer
    print("DEBUG: [ACQ WINDOW] Control panel assembled");
    
    // Add panels to split pane
    print("DEBUG: [ACQ WINDOW] Adding panels to split pane...");
    splitPane.setLeftComponent(displayPanel);
    splitPane.setRightComponent(controlPanel);
    print("DEBUG: [ACQ WINDOW] Split pane assembled");
    
    // Add split pane to frame
    print("DEBUG: [ACQ WINDOW] Adding split pane to frame...");
    acqFrame.add(splitPane, BorderLayout.CENTER);
    print("DEBUG: [ACQ WINDOW] Frame layout complete");
    
    print("DEBUG: [ACQ WINDOW] Returning frame object - creation complete!");
    return acqFrame;
}

