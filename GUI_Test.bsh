JButton testButton = new JButton("TEST Window");
testButton.setBackground(Color.MAGENTA);
testButton.addActionListener(new ActionListener() {
    public void actionPerformed(ActionEvent e) {
        print("TEST: Button clicked");
        frame.setVisible(false);
        print("TEST: Main frame hidden");
        
        SwingUtilities.invokeLater(new Runnable() {
            public void run() {
                print("TEST: On EDT, creating test window...");
                JFrame testFrame = new JFrame("TEST WINDOW");
                testFrame.setSize(400, 300);
                testFrame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
                JLabel label = new JLabel("TEST - If you see this, window creation works!", SwingConstants.CENTER);
                label.setFont(new Font("SansSerif", Font.BOLD, 16));
                testFrame.add(label);
                print("TEST: Test window created, making visible...");
                testFrame.setVisible(true);
                print("TEST: Test window should be visible now");
                frame.dispose();
                print("TEST: Old frame disposed");
            }
        });
    }
});

JButton okButton = new JButton("OK - Start Acquisition");
okButton.setBackground(Color.GREEN);
okButton.addActionListener(new ActionListener() {
    public void actionPerformed(ActionEvent e) {
        if (validateSequence()) {
            // Ensure save directory is selected BEFORE starting threads
            String lastSavePath = prefs.get("lastSavePath", "");
            if (lastSavePath.isEmpty() || !new File(lastSavePath).exists()) {
                JFileChooser dirChooser = new JFileChooser();
                dirChooser.setDialogTitle("Select Directory for Acquisition Data");
                dirChooser.setFileSelectionMode(JFileChooser.DIRECTORIES_ONLY);
                
                int result = dirChooser.showDialog(frame, "Select Folder");
                if (result != JFileChooser.APPROVE_OPTION) {
                    JOptionPane.showMessageDialog(frame, 
                        "You must select a save directory to start acquisition.", 
                        "Save Directory Required", JOptionPane.WARNING_MESSAGE);
                    return;
                }
                
                File saveDir = dirChooser.getSelectedFile();
                lastSavePath = saveDir.getAbsolutePath();
                prefs.put("lastSavePath", lastSavePath);
                
                // Update the display label
                dataDirPathLabel.setText(lastSavePath);
                dataDirPathLabel.setForeground(Color.BLACK);
            }
            
            // CAPTURE ALL DATA FROM GUI - decouple from UI
            print("DEBUG: Capturing all settings from GUI...");
            config.acqSettings.captureFromGUI(tableModel, vizTableModel, livePics, lastSavePath);
            print("DEBUG: Settings captured - disposing GUI...");
            
            // DISPOSE GUI IMMEDIATELY - no more GUI dependencies
            frame.dispose();
            print("DEBUG: GUI disposed - starting acquisition workflow...");
            
            // Run acquisition workflow in background thread with captured data
            new Thread(new Runnable() {
                public void run() {
                    try {
                        if (config.acqSettings.isVisualizationNeeded()) {
                        print("DEBUG: Visualization needed - setting up ROIs...");
                        if (!setupVisualizationROIs()) {
                            print("ERROR: ROI setup failed");
                            return;
                        }
                    }
                    
                    try {
                        print("DEBUG: Exporting CSV files...");
                        if (!exportTableToCSV()) {
                            print("ERROR: CSV export failed");
                            return;
                        }
                        print("DEBUG: CSV export successful!");
                    } catch (Exception csvEx) {
                        print("ERROR: Exception during CSV export!");
                        print("Exception type: " + csvEx.getClass().getName());
                        print("Exception message: " + csvEx.getMessage());
                        csvEx.printStackTrace();
                        return;
                    }
                    
                    try {
                        print("DEBUG: Printing sequence data...");
                        printSequenceData();
                        print("DEBUG: Sequence data printed");
                    } catch (Exception seqEx) {
                        print("ERROR: Exception printing sequence data!");
                        print("Exception type: " + seqEx.getClass().getName());
                        print("Exception message: " + seqEx.getMessage());
                        seqEx.printStackTrace();
                        return;
                    }
                    
                    print("DEBUG: Creating acquisition window on EDT...");
                    SwingUtilities.invokeLater(new Runnable() {
                        public void run() {
                            try {
                                print("DEBUG: Creating acquisition control window...");
                                JFrame acqWindow = createAcquisitionWindow();
                                print("DEBUG: Window object returned, making visible...");
                                acqWindow.setVisible(true);
                                print("DEBUG: Window.setVisible(true) called");
                                print("DEBUG: Acquisition window should now be visible!");
                                print("DEBUG: Window location: " + acqWindow.getLocation());
                                print("DEBUG: Window size: " + acqWindow.getSize());
                                print("DEBUG: Window isVisible: " + acqWindow.isVisible());
                            } catch (Exception ex) {
                                print("ERROR: Exception creating acquisition window!");
                                print("Exception type: " + ex.getClass().getName());
                                print("Exception message: " + ex.getMessage());
                                ex.printStackTrace();
                            }
                        }
                    });
                    } catch (Exception threadEx) {
                        print("ERROR: Uncaught exception in background thread!");
                        print("Exception type: " + threadEx.getClass().getName());
                        print("Exception message: " + threadEx.getMessage());
                        threadEx.printStackTrace();
                    }
                }
            }).start();
        }
    }
});

