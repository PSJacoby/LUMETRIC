FileWriter fw = new FileWriter(filecsv);
BufferedWriter bw = new BufferedWriter(fw);
bw.write("timestamp [ms];");
if (FRET.isSelected() == true){
	for (int ROI = 0; ROI < 3*numberROIs; ROI++) {
		if (ROI < numberROIs){
			bw.write("Donor"+ROI.toString()+";");
			}
		else if (ROI < 2*numberROIs){
			bw.write("Acceptor"+(ROI/2).toString()+";");
			}
		else {
			bw.write("Ratio"+(ROI/3).toString()+";");
			}
	}
	bw.newLine();
	int CountPrintInLine = 0;
	int CountTimeStamps = 0;
	bw.write((listTimeStamps.get(CountTimeStamps)).toString()+";");
	CountTimeStamps = CountTimeStamps + 1;
	for (int i=0;i<listIntensities.size(); i++){
		bw.write((listIntensities.get(i).getValue()).toString()+";");
		CountPrintInLine = CountPrintInLine +1;
		if (CountPrintInLine == 3*numberROIs){
			CountPrintInLine = 0;
			bw.newLine();	
			if (CountTimeStamps<listTimeStamps.size()){
				bw.write((listTimeStamps.get(CountTimeStamps)).toString()+";");
				CountTimeStamps = CountTimeStamps + 1;
			};
		};
	};
};
if (FRET.isSelected() == false){
	for (int ROI = 0; ROI < numberROIs; ROI++) {
		bw.write("ROI"+ROI.toString()+";");
	};
	bw.newLine();
	int CountPrintInLine = 0;
	int CountTimeStamps = 0;
	bw.write((listTimeStamps.get(CountTimeStamps)).toString()+";");
	CountTimeStamps = CountTimeStamps + 1;
	for (int i=0;i<listIntensities.size(); i++){
		bw.write((listIntensities.get(i).getValue()).toString()+";");
		CountPrintInLine = CountPrintInLine +1;
		if (CountPrintInLine == numberROIs){
			CountPrintInLine = 0;
			bw.newLine();	
			if (CountTimeStamps<listTimeStamps.size()){
				bw.write((listTimeStamps.get(CountTimeStamps)).toString()+";");
				CountTimeStamps = CountTimeStamps + 1;
			};
		};
	};
};

