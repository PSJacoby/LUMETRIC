		Accdir = Accdir + 32;
		};
	cb = mm.data().getCoordsBuilder().z(0).c(0).p(0).t(0);
	//display = mm.displays().createDisplay(store);  //initialize live view
	store2 = mm.data().createRAMDatastore();
	//TODO START ACQU IN CAMERA IN WAITING FOR EXTERNAL TRIGGER MODE --> CHECK AT SETUP
	mmc.startSequenceAcquisition(500000, 0, true); //(long numImages, double intervalMs, bool stopOnOverflow) 
	CharVector messageArdu = new CharVector();
	messageArdu.add((char) 45); //Case in Firmware in Arduino
	messageArdu.add((char) Accdir); //PinPattern
	messageArdu.add((char) FHigh);
	messageArdu.add((char) FLow);
	messageArdu.add((char) E);
	mmc.writeToSerialPort("COM10",messageArdu);
	long start = System.nanoTime();
	int curFrame = 0;
	ArrayList listIntensities = new ArrayList(); //List initialize for data collection
	ArrayList listTimeStamps = new ArrayList(); //List initialize for time data collection
	while (mmc.getRemainingImageCount() > 0 || mmc.isSequenceRunning(mmc.getCameraDevice())) {
		if ( curFrame > 3 ) {
			mmc.stopSequenceAcquisition();
			CharVector KillIt = new CharVector();
			KillIt.add((char) 66);
			mmc.writeToSerialPort("COM10",KillIt);
			};
   	if (mmc.getRemainingImageCount() > 0) {
      	tagged = mmc.popNextTaggedImage();
      	timeStamp = tagged.tags.getDouble("ElapsedTime-ms");
      	print(timeStamp);
      	image = mm.data().convertTaggedImage(tagged, cb.time(curFrame).build(), null);
      	store2.putImage(image);
      	ip = mm.data().ij().createProcessor(image);
			for (int ROI = 0; ROI < 2*numberROIs; ROI++) {  // goes through all ROIS and adds the needed number of elements to the chart
				CurRoi = rm.getRoi(ROI);
				ip.setRoi(CurRoi);
				MI = ip.getStatistics().mean;
				name = "SortOut";
				if (ROI < numberROIs){
					name = "Acceptor"+ROI.toString();
					}
				else {
					ROIname = ROI-numberROIs;
					name = "Donor"+ROIname.toString();
					};
				Pair pairedValues = new Pair(name , MI);
  				listIntensities.add(pairedValues);
				};
			for(int i=0;i<(numberROIs);i++){ // calculates and Adds the Ratio for all
        	   Acc = listIntensities.get(i);
        	   Don = listIntensities.get(i + numberROIs);
        	   DonInt = Don.getValue();
				AccInt = Acc.getValue();
           	AoDR = AccInt / DonInt;
				name = "Ratio"+ i.toString();
				Pair pairedValues = new Pair(name , AoDR);
  				listIntensities.add(AoDR);
  				dataset2.getSeries(i).add( timeStamp , AoDR);
  				};
			};			
   curFrame++;   
	};
