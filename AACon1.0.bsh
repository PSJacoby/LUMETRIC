//translating the user Input to the correct Int to be send as serial to Ardu Firmware 
int PinPattern = 1; // because one is the camera TTL, this people should generally want 
if (CFP.isSelected() == true){			//if reconnecting TTL, be sure this logic is still correct! 
	PinPattern = PinPattern + 2;
	}
if (GFP.isSelected() == true){			
	PinPattern = PinPattern + 4;
	}
if (YFP.isSelected() == true){			
	PinPattern = PinPattern + 8;
	}
if (Cy3.isSelected() == true){			
	PinPattern = PinPattern + 16;
	}
if (Cy5.isSelected() == true){			
	PinPattern = PinPattern + 32;
	}
print(PinPattern);
userInputDone = false;//let the user set the imaging parameters 
while (userInputDone == false){
	gd = new ij.gui.GenericDialog("Set Imaging Parameters");
	gd.addNumericField("Frame Rate [ms]", 60000, 0);  // IF HIGHER VALUES ARE NEEDED I NEED TO POINT AT MORE BYTES IN ARDUINO FIRMWARE!SO DO NOT SIMPLY INCREASE HERE!
	gd.addNumericField("Exposure [ms]", 250, 0); 
	gd.showDialog();
	if (gd.wasCanceled()){
		return;
		}
	F = (int)gd.getNextNumber();
	E = (int)gd.getNextNumber();
	if (F <= 60000 && E <= 250  ){
		userInputDone = true;
		}
	else{
		print("Invalid input. Choose unsigned Integers smaller or equal to the given max.");
		}
	}
if (F == 40){ //I can not send a 40 over serial as this is used as keep alive by MM so --> use 60001
	F = 60001; 
}
if (E == 40){ //I can not send a 40 over serial as this is used as keep alive by MM so --> use 251
	E = 251; 
}	
EventValue = 0;
int FLow = 0xff & F;
F2 = F >> 8;
int FHigh = 0xff & F2;
IJ.run("Close All");

boolean UserBoared = false;
