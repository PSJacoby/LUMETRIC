if (FRET.isSelected() == false){
	for (int ROI = 0; ROI < numberROIs; ROI++) {  // goes through all ROIS and adds the needed number of elements to the chart
		name = "ROI"+ROI.toString();
		rm.select(ROI);
		rm.runCommand("Rename", "rightChannel_"+name);
		XYSeries WTF = new XYSeries("rightChannel_"+name); // adding the ROI names to the data to be plotted
		dataset2.addSeries(WTF);  
		DonorRoi = rm.getRoi(ROI);
		AcceptorRoi =  DonorRoi.clone();
		AcceptorRoi = AcceptorRoi.getPolygon(); // get the corresponding left ROI
		AcceptorRoi.translate( -288, 0);
		AcceptorRoi = new PolygonRoi(AcceptorRoi , 2);
		AcceptorRoi.setName("leftChannel_"+name);
		rm.addRoi(AcceptorRoi);
		XYSeries WTF2 = new XYSeries("leftChannel_"+name); // adding the ROI names to the data to be plotted
		dataset2.addSeries(WTF2);  
		};
	};

if (FRET.isSelected() == true){
	for (int ROI = 0; ROI < numberROIs; ROI++) {  // goes through all ROIS and adds the needed number of elements to the chart
		name = "ROI"+ROI.toString();
		rm.select(ROI);
		rm.runCommand("Rename", "Donor_"+name);
		XYSeries WTF = new XYSeries("Ratio_"+name); // adding the ROI names to the data to be plotted
		dataset2.addSeries(WTF);  
		DonorRoi = rm.getRoi(ROI);
		AcceptorRoi =  DonorRoi.clone();
		AcceptorRoi = AcceptorRoi.getPolygon(); // get the corresponding Acceptor ROI
		AcceptorRoi.translate( -288, 0);
		AcceptorRoi = new PolygonRoi(AcceptorRoi , 2);
		AcceptorRoi.setName("Acceptor_"+name);
		rm.addRoi(AcceptorRoi);
		};
	};	


EventLine = "EventLine";
