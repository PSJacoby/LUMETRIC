// Setup wizard: auto-detect settings from the live MM core, present a verify-and-save dialog.
// Reads config groups, presets, and the Arduino COM port — no manual typing needed.
void showGenerateConfigDialog() {
    List allGroups = new ArrayList();
    String autoPort = "";
    try {
        mmcorej.StrVector grpVec = mmc.getAvailableConfigGroups();
        for (int i = 0; i < grpVec.size(); i++) allGroups.add(grpVec.get(i));
        // Auto-detect Arduino COM port: look for any loaded device whose name
        // contains "arduino" (case-insensitive) and exposes a "Port" property.
        // The Arduino Hub is always such a device; the Switch sub-device is not.
        mmcorej.StrVector devices = mmc.getLoadedDevices();
        for (int i = 0; i < devices.size(); i++) {
            String dev = devices.get(i);
            if (dev.toLowerCase().contains("arduino")) {
                try {
                    String port = mmc.getProperty(dev, "Port");
                    if (port != null && !port.isEmpty()) {
                        autoPort = port;
                        break;
                    }
                } catch (Exception ex) {}
            }
        }
    } catch (Exception ex) {}

    if (allGroups.isEmpty()) {
        JOptionPane.showMessageDialog(frame,
            "No config groups found in Micro-Manager.\n" +
            "Please load a hardware configuration in MM first, then try again.\n" +
            "Alternatively use 'Load Configuration File' to open an existing .properties file.",
            "Micro-Manager Not Ready", JOptionPane.WARNING_MESSAGE);
        return;
    }

    JDialog genDialog = new JDialog(frame, "Generate LUMETRIC Configuration", true);
    genDialog.setLayout(new BorderLayout(10, 10));

    JPanel formPanel = new JPanel(new GridLayout(0, 2, 8, 6));
    formPanel.setBorder(BorderFactory.createEmptyBorder(12, 15, 12, 15));

    // Arduino serial port (auto-filled from MM)
    JTextField portField = new JTextField(autoPort.isEmpty() ? config.serialPort : autoPort, 12);
    formPanel.add(new JLabel("Arduino Serial Port:"));
    formPanel.add(portField);

    // Camera config group
    JComboBox cameraGroupCombo = new JComboBox(allGroups.toArray());
    if (!config.cameraConfigGroup.isEmpty()) cameraGroupCombo.setSelectedItem(config.cameraConfigGroup);
    formPanel.add(new JLabel("Camera Config Group:"));
    formPanel.add(cameraGroupCombo);

    // Camera snap preset (populated from the selected group)
    JComboBox snapCombo = new JComboBox();
    formPanel.add(new JLabel("Camera Snap Preset:"));
    formPanel.add(snapCombo);

    // Camera trigger preset (the hardware-triggered one)
    JComboBox triggerCombo = new JComboBox();
    formPanel.add(new JLabel("<html>Camera Trigger Preset<br><font color='gray'>(for hardware-triggered acquisition)</font></html>"));
    formPanel.add(triggerCombo);

    // Arduino config group (which group contains the channel presets)
    List ardGroupOptions = new ArrayList();
    ardGroupOptions.add("-- scan all groups --");
    ardGroupOptions.addAll(allGroups);
    JComboBox arduinoGroupCombo = new JComboBox(ardGroupOptions.toArray());
    if (!config.arduinoConfigGroup.isEmpty()) arduinoGroupCombo.setSelectedItem(config.arduinoConfigGroup);
    formPanel.add(new JLabel("Arduino Config Group:"));
    formPanel.add(arduinoGroupCombo);

    // Circular buffer mode
    JCheckBox circBufferCheck = new JCheckBox("Use Circular Buffer", config.useCircularBuffer);
    circBufferCheck.setToolTipText("Enable for real cameras (high-speed acquisition); disable for demo / simple snap mode");
    formPanel.add(new JLabel("Acquisition Mode:"));
    formPanel.add(circBufferCheck);

    // Populate camera presets for the initially selected group
    String initCamGrp = (String) cameraGroupCombo.getSelectedItem();
    if (initCamGrp != null) {
        try {
            mmcorej.StrVector presets = mmc.getAvailableConfigs(initCamGrp);
            for (int i = 0; i < presets.size(); i++) {
                snapCombo.addItem(presets.get(i));
                triggerCombo.addItem(presets.get(i));
            }
            if (!config.cameraSnapConfig.isEmpty()) snapCombo.setSelectedItem(config.cameraSnapConfig);
            if (!config.cameraTriggerConfig.isEmpty()) triggerCombo.setSelectedItem(config.cameraTriggerConfig);
        } catch (Exception ex) {}
    }

    // Camera group change -> repopulate snap/trigger preset combos
    cameraGroupCombo.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            String grp = (String) cameraGroupCombo.getSelectedItem();
            snapCombo.removeAllItems();
            triggerCombo.removeAllItems();
            if (grp == null) return;
            try {
                mmcorej.StrVector presets = mmc.getAvailableConfigs(grp);
                for (int i = 0; i < presets.size(); i++) {
                    snapCombo.addItem(presets.get(i));
                    triggerCombo.addItem(presets.get(i));
                }
            } catch (Exception ex) {}
        }
    });

    JPanel btnPanel = new JPanel(new FlowLayout(FlowLayout.RIGHT));
    JButton cancelBtn = new JButton("Cancel");
    JButton saveApplyBtn = new JButton("Save & Apply");
    saveApplyBtn.setBackground(new Color(150, 255, 150));
    btnPanel.add(cancelBtn);
    btnPanel.add(saveApplyBtn);

    cancelBtn.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) { genDialog.dispose(); }
    });

    saveApplyBtn.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            // Write form values into config
            config.serialPort = portField.getText().trim();
            config.cameraConfigGroup = (String) cameraGroupCombo.getSelectedItem();
            config.cameraSnapConfig = snapCombo.getSelectedItem() != null ? (String) snapCombo.getSelectedItem() : "";
            config.cameraTriggerConfig = triggerCombo.getSelectedItem() != null ? (String) triggerCombo.getSelectedItem() : "";
            String ardGrp = (String) arduinoGroupCombo.getSelectedItem();
            config.arduinoConfigGroup = (ardGrp == null || ardGrp.equals("-- scan all groups --")) ? "" : ardGrp;
            config.useCircularBuffer = circBufferCheck.isSelected();

            // Ask where to save the new .properties file
            JFileChooser saver = new JFileChooser();
            saver.setDialogTitle("Save Configuration File");
            saver.setFileFilter(new ConfigFileFilter());
            String lastPath = prefs.get("lastConfigPath", "");
            if (!lastPath.isEmpty()) {
                File parentDir = new File(lastPath).getParentFile();
                if (parentDir != null && parentDir.exists()) saver.setCurrentDirectory(parentDir);
            }
            saver.setSelectedFile(new File("lumetric_config.properties"));

            int res = saver.showSaveDialog(genDialog);
            if (res != JFileChooser.APPROVE_OPTION) return;

            File saveFile = saver.getSelectedFile();
            String fname = saveFile.getName();
            // Append .properties if the user didn't type an extension
            if (!fname.toLowerCase().endsWith(".properties")) {
                saveFile = new File(saveFile.getParentFile(), fname + ".properties");
            }
            config.configFilePath = saveFile.getAbsolutePath();

            // Save skeleton config (no PIN_ entries yet)
            if (!config.saveToFile(config.configFilePath)) return;

            // Auto-detect channels from Hub and re-save with PIN_ entries included
            config.loadFromHub(mmc);
            config.saveToFile(config.configFilePath);

            prefs.put("lastConfigPath", config.configFilePath);
            updateSettingsDisplay();
            tabbedPane.setSelectedIndex(1);
            genDialog.dispose();
        }
    });

    JLabel infoLabel = new JLabel("<html><div style='padding:5px'>"
        + "Values auto-detected from Micro-Manager. Verify each field, then click <b>Save &amp; Apply</b>.<br>"
        + "<font color='gray'>Channels will be auto-read from the Arduino Config Group on save.</font>"
        + "</div></html>");
    infoLabel.setBorder(BorderFactory.createEmptyBorder(5, 10, 0, 10));

    genDialog.add(infoLabel, BorderLayout.NORTH);
    genDialog.add(new JScrollPane(formPanel), BorderLayout.CENTER);
    genDialog.add(btnPanel, BorderLayout.SOUTH);
    genDialog.pack();
    genDialog.setMinimumSize(new Dimension(520, 320));
    genDialog.setLocationRelativeTo(frame);
    genDialog.setVisible(true);
}

// Startup choice dialog — shown when no config file is known.
// Offers three paths: generate config from MM, load an existing file, or run as LUMETRIC Lite.
void showStartupChoiceDialog() {
    JDialog d = new JDialog(frame, "Welcome to LUMETRIC", true);
    d.setLayout(new BorderLayout(12, 12));
    d.setDefaultCloseOperation(JDialog.DO_NOTHING_ON_CLOSE);

    JLabel titleLabel = new JLabel("No configuration file found", SwingConstants.CENTER);
    titleLabel.setFont(titleLabel.getFont().deriveFont(Font.BOLD, 14f));
    titleLabel.setBorder(BorderFactory.createEmptyBorder(15, 15, 4, 15));

    JLabel infoLabel = new JLabel(
        "<html><div style='text-align:center'>How would you like to proceed?</div></html>",
        SwingConstants.CENTER);
    infoLabel.setBorder(BorderFactory.createEmptyBorder(0, 15, 8, 15));

    JPanel headerPanel = new JPanel(new BorderLayout());
    headerPanel.add(titleLabel, BorderLayout.NORTH);
    headerPanel.add(infoLabel, BorderLayout.CENTER);

    JPanel btnPanel = new JPanel(new GridLayout(1, 3, 12, 0));
    btnPanel.setBorder(BorderFactory.createEmptyBorder(8, 20, 20, 20));

    JButton generateBtn = new JButton(
        "<html><center><b>Generate Config</b><br><font size='2' color='gray'>Auto-detect from Micro-Manager</font></center></html>");
    generateBtn.setBackground(new Color(255, 230, 100));

    JButton loadBtn = new JButton(
        "<html><center><b>Load Config File</b><br><font size='2' color='gray'>Open existing .properties file</font></center></html>");
    loadBtn.setBackground(new Color(200, 220, 255));

    JButton liteBtn = new JButton(
        "<html><center><b>LUMETRIC Lite</b><br><font size='2' color='gray'>Single-channel, no Arduino</font></center></html>");
    liteBtn.setBackground(new Color(180, 255, 180));

    btnPanel.add(generateBtn);
    btnPanel.add(loadBtn);
    btnPanel.add(liteBtn);

    generateBtn.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            d.dispose();
            showGenerateConfigDialog();
        }
    });

    loadBtn.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            d.dispose();
            loadConfigButton.doClick();
        }
    });

    liteBtn.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            d.dispose();
            simpleSnapMode.setSelected(true);
            tabbedPane.setSelectedIndex(1);
        }
    });

    d.add(headerPanel, BorderLayout.NORTH);
    d.add(btnPanel, BorderLayout.CENTER);
    d.pack();
    d.setMinimumSize(new Dimension(520, 160));
    d.setLocationRelativeTo(frame);
    d.setVisible(true);
}

