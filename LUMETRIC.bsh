// Table Model for the acquisition settings
class AcquisitionTableModel extends DefaultTableModel {

    String[] columnNames = { "Row", "Channel", "Exposure [ms]", "Frame Interval [ms]",
            "Frames", "Loop Goto", "Loop Times", "Constant Illum", "Loop Switch Goto" };
    Set userModifiedLoopGoto = new HashSet(); // Track which rows have user-modified Loop Goto

    public AcquisitionTableModel() {
        super();
        // Only set column identifiers for the data columns (exclude Row)
        String[] dataColumnNames = { "Channel", "Exposure [ms]", "Frame Interval [ms]",
                "Frames", "Loop Goto", "Loop Times", "Constant Illum", "Loop Switch Goto" };
        setColumnIdentifiers(dataColumnNames);
        // Add one default row with upper limits as defaults
        addRow(new Object[] { "", "60000", "60000", "60000", "1", "", "", "" });
    }

    public int getColumnCount() {
        return columnNames.length; // Return 9 for UI display
    }

    public String getColumnName(int col) {
        return columnNames[col];
    }

    public Class getColumnClass(int col) {
        return String.class;
    }

    public Object getValueAt(int row, int col) {
        if (col == 0) {
            return String.valueOf(row + 1); // Row numbers are 1-based
        }
        return super.getValueAt(row, col - 1);
    }

    public boolean isCellEditable(int row, int col) {
        return col != 0; // Row number column is not editable
    }

    public void setValueAt(Object value, int row, int col) {
        if (col == 0)
            return; // Can't set row number

        // Track if user manually edits Loop Goto column (col 5)
        if (col == 5) {
            String oldValue = (String) super.getValueAt(row, col - 1);
            String newValue = value.toString();
            // If value changed and it's not empty, mark as user-modified
            if (!newValue.equals(oldValue) && !newValue.isEmpty()) {
                userModifiedLoopGoto.add(row);
            }
        }

        // Validate and clamp numeric fields
        Object correctedValue = value;
        if (col == 2) { // Exposure [ms] - limit 60000
            correctedValue = clampValue(value.toString(), 0, 60000);
        } else if (col == 3) { // Frame Interval [ms] - limit 60000
            correctedValue = clampValue(value.toString(), 0, 60000);
        } else if (col == 4) { // Frames - limit 60000
            correctedValue = clampValue(value.toString(), 0, 60000);
        } else if (col == 6) { // Loop Times - limit 60000
            correctedValue = clampValue(value.toString(), 0, 60000);
        }

        super.setValueAt(correctedValue, row, col - 1);

        // If Channel column (col 1) changed, update Constant Illum (col 7)
        if (col == 1) {
            updateConstantIllumForRow(row);
        }
    }

    String clampValue(String valueStr, int min, int max) {
        if (valueStr == null || valueStr.trim().isEmpty()) {
            return valueStr;
        }
        try {
            int val = Integer.parseInt(valueStr.trim());
            if (val < min)
                return String.valueOf(min);
            if (val > max)
                return String.valueOf(max);
            return String.valueOf(val);
        } catch (NumberFormatException e) {
            // Return max value if invalid number
            return String.valueOf(max);
        }
    }

    void updateConstantIllumForRow(int row) {
        String channels = (String) super.getValueAt(row, 0);
        String constIllum = (String) super.getValueAt(row, 6);

        if (channels.isEmpty() || constIllum.isEmpty()) {
            return;
        }

        // Parse selected channels
        String[] selectedChannels = channels.split(",");
        Set channelSet = new HashSet();
        for (String ch : selectedChannels) {
            channelSet.add(ch.trim());
        }

        // Parse constant illum and remove conflicts
        String[] constChannels = constIllum.split(",");
        StringBuilder newConstIllum = new StringBuilder();
        for (String ch : constChannels) {
            String trimmed = ch.trim();
            if (!channelSet.contains(trimmed)) {
                if (newConstIllum.length() > 0)
                    newConstIllum.append(",");
                newConstIllum.append(trimmed);
            }
        }

        // Update only if changed
        String newValue = newConstIllum.toString();
        if (!newValue.equals(constIllum)) {
            super.setValueAt(newValue, row, 6);
        }
    }

    void updateLoopGotoDefaults() {
        int rowCount = getRowCount();
        for (int i = 0; i < rowCount; i++) {
            // Only update if not user-modified
            if (!userModifiedLoopGoto.contains(i)) {
                int nextRow = i + 2; // Row numbers are 1-based, and we want next row
                if (nextRow <= rowCount) {
                    super.setValueAt(String.valueOf(nextRow), i, 4); // col 5 in user view, col 4 in storage
                } else {
                    super.setValueAt("1", i, 4); // Last row loops to first
                }
            }
        }
    }

    public void addRow(Object[] rowData) {
        super.addRow(rowData);
        updateLoopGotoDefaults();
    }

    public void removeRow(int row) {
        userModifiedLoopGoto.remove(row);
        // Adjust indices for rows after the removed one
        Set newModified = new HashSet();
        for (Object obj : userModifiedLoopGoto) {
            int idx = (Integer) obj;
            if (idx > row) {
                newModified.add(idx - 1);
            } else {
                newModified.add(idx);
            }
        }
        userModifiedLoopGoto = newModified;

        super.removeRow(row);
        updateLoopGotoDefaults();
    }
}

// Custom cell editor for channel selection with popup dialog
class ChannelEditor extends AbstractCellEditor implements TableCellEditor {

    String currentValue = "";
    JTable parentTable;
    int editingRow;
    int editingColumn;
    List excludedChannels = new ArrayList();

    public ChannelEditor() {
    }

    public Component getTableCellEditorComponent(JTable table, Object value,
            boolean isSelected, int row, int column) {
        parentTable = table;
        editingRow = row;
        editingColumn = column;
        currentValue = value != null ? value.toString() : "";

        // Determine which channels to exclude (for Constant Illum column)
        excludedChannels.clear();
        if (column == 7) { // Constant Illum column (was 6, now 7 with Row column)
            String channelCol = table.getValueAt(row, 1).toString(); // Channel is now column 1
            if (!channelCol.isEmpty()) {
                String[] parts = channelCol.split(",");
                for (String ch : parts) {
                    excludedChannels.add(ch.trim());
                }
            }
        }

        // Show dialog immediately
        SwingUtilities.invokeLater(new Runnable() {
            public void run() {
                showChannelDialog();
            }
        });

        // Return a dummy label (won't be displayed as dialog opens immediately)
        JLabel label = new JLabel(currentValue.isEmpty() ? "none" : currentValue);
        return label;
    }

    void showChannelDialog() {
        JDialog dialog = new JDialog((JFrame) SwingUtilities.getWindowAncestor(parentTable),
                "Select Channels", true);
        dialog.setLayout(new BorderLayout(10, 10));

        // Create checkbox panel with grid layout
        JPanel checkboxPanel = new JPanel(new GridLayout(0, 4, 5, 5));
        checkboxPanel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        List channels = config.getAvailableChannels();
        List checkBoxes = new ArrayList();

        for (String channel : channels) {
            // Skip excluded channels
            if (excludedChannels.contains(channel)) {
                continue;
            }

            JCheckBox box = new JCheckBox(channel);
            box.setSelected(currentValue.contains(channel));
            checkBoxes.add(box);
            checkboxPanel.add(box);
        }

        // Buttons
        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.RIGHT));
        JButton okButton = new JButton("OK");
        JButton cancelButton = new JButton("Cancel");

        okButton.addActionListener(new ActionListener() {
            public void actionPerformed(ActionEvent e) {
                StringBuilder sb = new StringBuilder();
                for (Object obj : checkBoxes) {
                    JCheckBox box = (JCheckBox) obj;
                    if (box.isSelected()) {
                        if (sb.length() > 0)
                            sb.append(",");
                        sb.append(box.getText());
                    }
                }
                currentValue = sb.toString();
                dialog.dispose();
                fireEditingStopped();
            }
        });

        cancelButton.addActionListener(new ActionListener() {
            public void actionPerformed(ActionEvent e) {
                dialog.dispose();
                fireEditingCanceled();
            }
        });

        buttonPanel.add(okButton);
        buttonPanel.add(cancelButton);

        dialog.add(new JScrollPane(checkboxPanel), BorderLayout.CENTER);
        dialog.add(buttonPanel, BorderLayout.SOUTH);
        dialog.pack();
        dialog.setLocationRelativeTo(parentTable);
        dialog.setVisible(true);
    }

    public Object getCellEditorValue() {
        return currentValue;
    }
}

// Custom cell renderer for channel display
class ChannelRenderer extends DefaultTableCellRenderer {
    public Component getTableCellRendererComponent(JTable table, Object value,
            boolean isSelected, boolean hasFocus,
            int row, int column) {
        super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, column);

        String val = value != null ? value.toString() : "";
        if (val.isEmpty()) {
            setText("none");
            setForeground(Color.GRAY);
        } else {
            String[] channels = val.split(",");
            if (channels.length <= 3) {
                setText(val);
            } else {
                setText(channels[0] + ", " + channels[1] + " +" + (channels.length - 2) + " more");
            }
            setForeground(isSelected ? table.getSelectionForeground() : table.getForeground());
        }

        return this;
    }
}

// Custom cell renderer for Loop Times - shows "0" for empty or zero (infinite loops)
class LoopTimesRenderer extends DefaultTableCellRenderer {
    public Component getTableCellRendererComponent(JTable table, Object value,
            boolean isSelected, boolean hasFocus,
            int row, int column) {
        super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, column);

        String val = value != null ? value.toString() : "";
        if (val.isEmpty()) {
            setText("0");
            setForeground(Color.GRAY);
            setHorizontalAlignment(SwingConstants.CENTER);
        } else {
            setText(val);
            setForeground(isSelected ? table.getSelectionForeground() : table.getForeground());
            setHorizontalAlignment(SwingConstants.RIGHT);
        }

        return this;
    }
}

// Custom cell renderer for Loop Switch Goto - shows "none" when empty
class LoopSwitchGotoRenderer extends DefaultTableCellRenderer {
    public Component getTableCellRendererComponent(JTable table, Object value,
                                                   boolean isSelected, boolean hasFocus,
                                                   int row, int column) {
        super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, column);

        String val = value != null ? value.toString() : "";
        if (val.isEmpty() || val.equalsIgnoreCase("none")) {
            setText("none");
            setForeground(Color.GRAY);
            setHorizontalAlignment(SwingConstants.CENTER);
        } else {
            setText(val);
            setForeground(isSelected ? table.getSelectionForeground() : table.getForeground());
            setHorizontalAlignment(SwingConstants.CENTER);
        }

        return this;
    }
}

// ==================== Data Visualization Table Classes ====================

// Table Model for visualization configuration
class VisualizationTableModel extends DefaultTableModel {
    String currentMode = "Temporal";  // Track current processing mode
    String[] temporalColumns = {"Graph", "Type", "every", "every 2nd (odd)", "every 2nd (even)", "Custom"};
    String[] spatialColumns = {"Graph", "Type"};  // Spatial mode: no frame selection columns

    public VisualizationTableModel() {
        super(new Object[][]{
            {"1", "none", Boolean.FALSE, Boolean.FALSE, Boolean.FALSE, "Off"},
            {"2", "none", Boolean.FALSE, Boolean.FALSE, Boolean.FALSE, "Off"},
            {"3", "none", Boolean.FALSE, Boolean.FALSE, Boolean.FALSE, "Off"},
            {"4", "none", Boolean.FALSE, Boolean.FALSE, Boolean.FALSE, "Off"}
        }, new String[]{"Graph", "Type", "every", "every 2nd (odd)", "every 2nd (even)", "Custom"});
    }

    void setProcessingMode(String mode) {
        this.currentMode = mode;
        if (mode.equals("Temporal")) {
            setColumnIdentifiers(temporalColumns);
        } else {
            setColumnIdentifiers(spatialColumns);
        }
        // Reset all rows
        setRowCount(0);
        for (int i = 1; i <= 4; i++) {
            if (mode.equals("Temporal")) {
                addRow(new Object[]{String.valueOf(i), "none", Boolean.FALSE, Boolean.FALSE, Boolean.FALSE, "Off"});
            } else {
                addRow(new Object[]{String.valueOf(i), "none"});
            }
        }
    }

    public Class getColumnClass(int col) {
        if (currentMode.equals("Temporal") && col >= 2 && col <= 4) {
            return Boolean.class;
        }
        return String.class;
    }

    public boolean isCellEditable(int row, int col) {
        if (col == 0) return false;
        if (col == 1) return true;

        // Spatial mode: only Graph and Type columns exist
        if (currentMode.equals("Spatial")) {
            return false;  // No other columns to edit
        }

        // Temporal mode editing logic
        String type = (String) getValueAt(row, 1);
        if (type.equals("none")) return false;

        // Ratio and Split ratio types: checkboxes not editable (auto-managed or not applicable)
        if (type.startsWith("Ratio ") || type.startsWith("Split ratio")) {
            return false;
        }

        if (col == 5) return true; // Custom column always editable when type != none
        return true;
    }

    public void setValueAt(Object value, int row, int col) {
        if (col == 0) return;

        if (col == 1) {
            String newType = (String) value;
            String oldType = (String) super.getValueAt(row, col);
            super.setValueAt(newType, row, col);

            // Only handle checkbox columns in Temporal mode
            if (currentMode.equals("Temporal")) {
                if (newType.equals("none")) {
                    for (int i = 2; i <= 4; i++) {
                        super.setValueAt(Boolean.FALSE, row, i);
                    }
                    super.setValueAt("Off", row, 5);
                } else if (newType.startsWith("Ratio ")) {
                    // N-frame cycle ratio: frame selection is driven by the type string; clear all checkboxes
                    super.setValueAt(Boolean.FALSE, row, 2); // every
                    super.setValueAt(Boolean.FALSE, row, 3); // odd
                    super.setValueAt(Boolean.FALSE, row, 4); // even
                    super.setValueAt("Off", row, 5);         // custom
                } else if (newType.startsWith("Split ratio")) {
                    // Split Ratio: always processes every frame (spatial processing)
                    super.setValueAt(Boolean.TRUE, row, 2);  // every
                    super.setValueAt(Boolean.FALSE, row, 3); // odd
                    super.setValueAt(Boolean.FALSE, row, 4); // even
                    super.setValueAt("Off", row, 5);         // custom
                } else if (oldType.equals("none")) {
                    for (int i = 2; i <= 4; i++) {
                        super.setValueAt(Boolean.FALSE, row, i);
                    }
                    super.setValueAt("Off", row, 5);
                }
            }
            // Spatial mode: no extra columns to set

            fireTableRowsUpdated(row, row);
            return;
        }

        if (col >= 2 && col <= 4) {
            String type = (String) super.getValueAt(row, 1);
            if (type.equals("none")) return;

            boolean newValue = ((Boolean) value).booleanValue();
            int checkedCount = 0;
            for (int i = 2; i <= 4; i++) {
                if (((Boolean) super.getValueAt(row, i)).booleanValue()) {
                    checkedCount++;
                }
            }

            // Check if custom is active
            String customValue = (String) super.getValueAt(row, 5);
            boolean customActive = !customValue.equals("Off");

            if (newValue && (checkedCount >= 1 || customActive)) {
                return;
            }

            super.setValueAt(value, row, col);
        }

        if (col == 5) {
            String type = (String) super.getValueAt(row, 1);
            if (type.equals("none")) return;

            String newValue = (String) value;

            // If setting custom to something other than "Off", uncheck all checkboxes
            if (!newValue.equals("Off")) {
                for (int i = 2; i <= 4; i++) {
                    super.setValueAt(Boolean.FALSE, row, i);
                }
            }

            super.setValueAt(value, row, col);
        }
    }
}

// Custom cell editor for Type column (dropdown) - mode-aware
class VisualizationTypeEditor extends DefaultCellEditor {
    JComboBox combo;
    String currentMode = "Temporal";
    SpatialConfig spatialConfig = new SpatialConfig();

    public VisualizationTypeEditor() {
        super(new JComboBox());
        combo = (JComboBox) getComponent();
        updateOptions();
    }

    void setProcessingMode(String mode, SpatialConfig config) {
        this.currentMode = mode;
        this.spatialConfig = config;
        updateOptions();
    }

    void updateOptions() {
        combo.removeAllItems();
        combo.addItem("none");

        if (currentMode.equals("Temporal")) {
            combo.addItem("Intensity");
            combo.addItem("Ratio 1/2 (2 frames)");
            combo.addItem("Ratio 2/1 (2 frames)");
            combo.addItem("Ratio 1/2 (3 frames)");
            combo.addItem("Ratio 2/1 (3 frames)");
            combo.addItem("Ratio 1/2 (4 frames)");
            combo.addItem("Ratio 2/1 (4 frames)");
            combo.addItem("Ratio 3/4 (4 frames)");
            combo.addItem("Ratio 4/3 (4 frames)");
        } else if (currentMode.equals("Spatial")) {
            // Add split ratio options based on spatial config
            String dir1 = spatialConfig.getRatioDirection1();
            String dir2 = spatialConfig.getRatioDirection2();
            combo.addItem("Split ratio " + dir1);
            combo.addItem("Split ratio " + dir2);

            // Add region-specific intensity options
            if (spatialConfig.splitAxis.equals("Horizontal")) {
                combo.addItem("Intensity Up");
                combo.addItem("Intensity Down");
            } else {
                combo.addItem("Intensity Left");
                combo.addItem("Intensity Right");
            }
        }
    }
}

// Custom cell editor for Custom column (dropdown with interval/offset options)
class VisualizationCustomEditor extends DefaultCellEditor {
    public VisualizationCustomEditor() {
        super(new JComboBox(new String[]{
            "Off",
            "every 3rd",
            "every 3rd (offset 1)",
            "every 3rd (offset 2)",
            "every 4th",
            "every 4th (offset 1)",
            "every 4th (offset 2)",
            "every 4th (offset 3)",
            "every 5th",
            "every 10th"
        }));
    }
}

// Custom cell renderer for checkboxes that disables when type is "none"
class VisualizationCheckBoxRenderer extends JCheckBox implements javax.swing.table.TableCellRenderer {
    public VisualizationCheckBoxRenderer() {
        setHorizontalAlignment(SwingConstants.CENTER);
    }

    public Component getTableCellRendererComponent(JTable table, Object value,
                                                   boolean isSelected, boolean hasFocus,
                                                   int row, int column) {
        String type = (String) table.getValueAt(row, 1);
        boolean enabled = !type.equals("none");

        setEnabled(enabled);
        setSelected(value != null && ((Boolean) value).booleanValue());

        if (isSelected) {
            setBackground(table.getSelectionBackground());
            setForeground(table.getSelectionForeground());
        } else {
            setBackground(table.getBackground());
            setForeground(table.getForeground());
        }

        return this;
    }
}

// Custom cell editor for checkboxes
class VisualizationCheckBoxEditor extends DefaultCellEditor {
    public VisualizationCheckBoxEditor() {
        super(new JCheckBox());
        JCheckBox checkBox = (JCheckBox) getComponent();
        checkBox.setHorizontalAlignment(SwingConstants.CENTER);
    }
}

