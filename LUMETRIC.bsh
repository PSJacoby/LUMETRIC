acqFolderLock = null;

// Table Model for the acquisition settings
class AcquisitionTableModel extends DefaultTableModel {

    String[] columnNames = { "Row", "Channel", "Exposure [ms]", "Frame Interval [ms]",
            "Frames", "Loop Goto", "Loop Times", "Constant Illum", "Loop Switch Goto" };
    Set userModifiedLoopGoto = new HashSet(); // Track which rows have user-modified Loop Goto

    public AcquisitionTableModel() {
        super();
        // Only set column identifiers for the data columns (exclude Row)
        String[] dataColumnNames = { "Channel", "Exposure [ms]", "Frame Interval [ms]",
                "Frames", "Loop Goto", "Loop Times", "Constant Illum", "Loop Switch Goto" };
        setColumnIdentifiers(dataColumnNames);
        // Add one default row with upper limits as defaults
        addRow(new Object[] { "", "60000", "60000", "60000", "1", "", "", "" });
    }

    public int getColumnCount() {
        return columnNames.length; // Return 9 for UI display
    }

    public String getColumnName(int col) {
        return columnNames[col];
    }

    public Class getColumnClass(int col) {
        return String.class;
    }

    public Object getValueAt(int row, int col) {
        if (col == 0) {
            return String.valueOf(row + 1); // Row numbers are 1-based
        }
        return super.getValueAt(row, col - 1);
    }

    public boolean isCellEditable(int row, int col) {
        return col != 0; // Row number column is not editable
    }

    public void setValueAt(Object value, int row, int col) {
        if (col == 0)
            return; // Can't set row number

        // Track if user manually edits Loop Goto column (col 5)
        if (col == 5) {
            String oldValue = (String) super.getValueAt(row, col - 1);
            String newValue = value.toString();
            // If value changed and it's not empty, mark as user-modified
            if (!newValue.equals(oldValue) && !newValue.isEmpty()) {
                userModifiedLoopGoto.add(row);
            }
        }

        // Validate and clamp numeric fields
        Object correctedValue = value;
        if (col == 2) { // Exposure [ms] - limit 60000
            correctedValue = clampValue(value.toString(), 0, 60000);
        } else if (col == 3) { // Frame Interval [ms] - limit 60000
            correctedValue = clampValue(value.toString(), 0, 60000);
        } else if (col == 4) { // Frames - limit 60000
            correctedValue = clampValue(value.toString(), 0, 60000);
        } else if (col == 6) { // Loop Times - limit 60000
            correctedValue = clampValue(value.toString(), 0, 60000);
        }

        super.setValueAt(correctedValue, row, col - 1);

        // If Channel column (col 1) changed, update Constant Illum (col 7)
        if (col == 1) {
            updateConstantIllumForRow(row);
        }
    }

    String clampValue(String valueStr, int min, int max) {
        if (valueStr == null || valueStr.trim().isEmpty()) {
            return valueStr;
        }
        try {
            int val = Integer.parseInt(valueStr.trim());
            if (val < min)
                return String.valueOf(min);
            if (val > max)
                return String.valueOf(max);
            return String.valueOf(val);
        } catch (NumberFormatException e) {
            // Return max value if invalid number
            return String.valueOf(max);
        }
    }

    void updateConstantIllumForRow(int row) {
        String channels = (String) super.getValueAt(row, 0);
        String constIllum = (String) super.getValueAt(row, 6);

        if (channels.isEmpty() || constIllum.isEmpty()) {
            return;
        }

        // Parse selected channels
        String[] selectedChannels = channels.split(",");
        Set channelSet = new HashSet();
        for (String ch : selectedChannels) {
            channelSet.add(ch.trim());
        }

        // Parse constant illum and remove conflicts
        String[] constChannels = constIllum.split(",");
        StringBuilder newConstIllum = new StringBuilder();
        for (String ch : constChannels) {
            String trimmed = ch.trim();
            if (!channelSet.contains(trimmed)) {
                if (newConstIllum.length() > 0)
                    newConstIllum.append(",");
                newConstIllum.append(trimmed);
            }
        }

        // Update only if changed
        String newValue = newConstIllum.toString();
        if (!newValue.equals(constIllum)) {
            super.setValueAt(newValue, row, 6);
        }
    }

    void updateLoopGotoDefaults() {
        int rowCount = getRowCount();
        for (int i = 0; i < rowCount; i++) {
            // Only update if not user-modified
            if (!userModifiedLoopGoto.contains(i)) {
                int nextRow = i + 2; // Row numbers are 1-based, and we want next row
                if (nextRow <= rowCount) {
                    super.setValueAt(String.valueOf(nextRow), i, 4); // col 5 in user view, col 4 in storage
                } else {
                    super.setValueAt("1", i, 4); // Last row loops to first
                }
            }
        }
    }

    public void addRow(Object[] rowData) {
        super.addRow(rowData);
        updateLoopGotoDefaults();
    }

    public void removeRow(int row) {
        userModifiedLoopGoto.remove(row);
        // Adjust indices for rows after the removed one
        Set newModified = new HashSet();
        for (Object obj : userModifiedLoopGoto) {
            int idx = (Integer) obj;
            if (idx > row) {
                newModified.add(idx - 1);
            } else {
                newModified.add(idx);
            }
        }
        userModifiedLoopGoto = newModified;

        super.removeRow(row);
        updateLoopGotoDefaults();
    }
}

// Custom cell editor for channel selection with popup dialog
class ChannelEditor extends AbstractCellEditor implements TableCellEditor {

    String currentValue = "";
    JTable parentTable;
    int editingRow;
    int editingColumn;
    List excludedChannels = new ArrayList();

    public ChannelEditor() {
    }

    public Component getTableCellEditorComponent(JTable table, Object value,
            boolean isSelected, int row, int column) {
        parentTable = table;
        editingRow = row;
        editingColumn = column;
        currentValue = value != null ? value.toString() : "";

        // Determine which channels to exclude (for Constant Illum column)
        excludedChannels.clear();
        if (column == 7) { // Constant Illum column (was 6, now 7 with Row column)
            String channelCol = table.getValueAt(row, 1).toString(); // Channel is now column 1
            if (!channelCol.isEmpty()) {
                String[] parts = channelCol.split(",");
                for (String ch : parts) {
                    excludedChannels.add(ch.trim());
                }
            }
        }

        // Show dialog immediately
        SwingUtilities.invokeLater(new Runnable() {
            public void run() {
                showChannelDialog();
            }
        });

        // Return a dummy label (won't be displayed as dialog opens immediately)
        JLabel label = new JLabel(currentValue.isEmpty() ? "none" : currentValue);
        return label;
    }

    void showChannelDialog() {
        JDialog dialog = new JDialog((JFrame) SwingUtilities.getWindowAncestor(parentTable),
                "Select Channels", true);
        dialog.setLayout(new BorderLayout(10, 10));

        // Create checkbox panel with grid layout
        JPanel checkboxPanel = new JPanel(new GridLayout(0, 4, 5, 5));
        checkboxPanel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        List channels = config.getAvailableChannels();
        List checkBoxes = new ArrayList();

        for (String channel : channels) {
            // Skip excluded channels
            if (excludedChannels.contains(channel)) {
                continue;
            }

            JCheckBox box = new JCheckBox(channel);
            box.setSelected(currentValue.contains(channel));
            checkBoxes.add(box);
            checkboxPanel.add(box);
        }

        // Buttons
        JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.RIGHT));
        JButton okButton = new JButton("OK");
        JButton cancelButton = new JButton("Cancel");

        okButton.addActionListener(new ActionListener() {
            public void actionPerformed(ActionEvent e) {
                StringBuilder sb = new StringBuilder();
                for (Object obj : checkBoxes) {
                    JCheckBox box = (JCheckBox) obj;
                    if (box.isSelected()) {
                        if (sb.length() > 0)
                            sb.append(",");
                        sb.append(box.getText());
                    }
                }
                currentValue = sb.toString();
                dialog.dispose();
                fireEditingStopped();
            }
        });

        cancelButton.addActionListener(new ActionListener() {
            public void actionPerformed(ActionEvent e) {
                dialog.dispose();
                fireEditingCanceled();
            }
        });

        buttonPanel.add(okButton);
        buttonPanel.add(cancelButton);

        dialog.add(new JScrollPane(checkboxPanel), BorderLayout.CENTER);
        dialog.add(buttonPanel, BorderLayout.SOUTH);
        dialog.pack();
        dialog.setLocationRelativeTo(parentTable);
        dialog.setVisible(true);
    }

    public Object getCellEditorValue() {
        return currentValue;
    }
}

// Custom cell renderer for channel display
class ChannelRenderer extends DefaultTableCellRenderer {
    public Component getTableCellRendererComponent(JTable table, Object value,
            boolean isSelected, boolean hasFocus,
            int row, int column) {
        super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, column);

        String val = value != null ? value.toString() : "";
        if (val.isEmpty()) {
            setText("none");
            setForeground(Color.GRAY);
        } else {
            String[] channels = val.split(",");
            if (channels.length <= 3) {
                setText(val);
            } else {
                setText(channels[0] + ", " + channels[1] + " +" + (channels.length - 2) + " more");
            }
            setForeground(isSelected ? table.getSelectionForeground() : table.getForeground());
        }

        return this;
    }
}

// ============================================================
//  RowTracker — shadow of the Arduino's acquisition-table state machine.
//
//  Mirrors the firmware logic in LUMETRIC_ArdFirmware.ino exactly:
//    - Normal row transitions (frame-quota exhausted, loopGoto) are computed
//      deterministically from the table, so no serial traffic is needed.
//    - Switch-button events (row.loopSwitchGoto fired by byte 67 from the Arduino)
//      cannot be predicted; when the Arduino's notification packet arrives the
//      caller invokes patch() to retroactively correct any already-stored data rows
//      and force-synchronise the tracker.
//
//  Column indices in sequenceRows rows (0-based):
//    0 = display row#   1 = channel   2 = exposureMs   3 = intervalMs
//    4 = frames (0=infinite)   5 = loopGoto (1-based, "" = none)
//    6 = loopTimes (0/"" = infinite)   7 = constIllum   8 = loopSwitchGoto (1-based, "" = none)
// ============================================================
class RowTracker {
    // --- state ---
    int  currentRow;       // 0-based index into sequenceRows
    int  framesDoneInRow;  // frames completed on currentRow so far
    int[] loopCounters;    // per-row loop-iteration counter (0-based, mirrors firmware)

    // --- table snapshot (read-only after construction) ---
    ArrayList seqRows;
    int nRows;

    RowTracker(ArrayList sequenceRows) {
        seqRows    = sequenceRows;
        nRows      = sequenceRows.size();
        currentRow = 0;
        framesDoneInRow = 0;
        loopCounters = new int[nRows > 0 ? nRows : 1];
        for (int i = 0; i < loopCounters.length; i++) loopCounters[i] = 0;
    }

    // --- helpers to read the table ---
    int getFrames(int r) {
        try { return Integer.parseInt(((ArrayList)seqRows.get(r)).get(4).toString().trim()); }
        catch (Exception e) { return 0; }
    }
    int getLoopGoto(int r) {
        try {
            String s = ((ArrayList)seqRows.get(r)).get(5).toString().trim();
            return s.isEmpty() ? 0 : Integer.parseInt(s);
        } catch (Exception e) { return 0; }
    }
    int getLoopTimes(int r) {
        try {
            String s = ((ArrayList)seqRows.get(r)).get(6).toString().trim();
            return (s.isEmpty() || s.equals("0")) ? 0 : Integer.parseInt(s);
        } catch (Exception e) { return 0; }
    }
    int getExposure(int r) {
        try { return Integer.parseInt(((ArrayList)seqRows.get(r)).get(2).toString().trim()); }
        catch (Exception e) { return 0; }
    }
    // True when the CURRENT row is a keep-alive row injected by expandPauseRows().
    boolean isKeepAliveRow() {
        if (currentRow < 0 || currentRow >= nRows) return false;
        try {
            ArrayList row = (ArrayList) seqRows.get(currentRow);
            return row.size() > 9 && "keepAlive".equals(row.get(9).toString().trim());
        } catch (Exception e) { return false; }
    }
    // True when the CURRENT row is the end-sentinel row injected by expandPauseRows().
    // When a frame from this row is popped, BeanShell should initiate auto-quit.
    boolean isEndSentinelRow() {
        if (currentRow < 0 || currentRow >= nRows) return false;
        try {
            ArrayList row = (ArrayList) seqRows.get(currentRow);
            return row.size() > 9 && "endSentinel".equals(row.get(9).toString().trim());
        } catch (Exception e) { return false; }
    }
    // Maps an expanded 1-based row index back to the original (user-visible) 1-based row
    // number stored in col 10.  Falls back to the expanded index when col 10 is absent.
    int getOriginalRowNum(int expandedRow) {
        if (expandedRow < 1 || expandedRow > nRows) return expandedRow;
        try {
            ArrayList row = (ArrayList) seqRows.get(expandedRow - 1);
            String s = row.size() > 10 ? row.get(10).toString().trim() : "";
            return s.isEmpty() ? expandedRow : Integer.parseInt(s);
        } catch (Exception e) { return expandedRow; }
    }

    // Returns the 1-based sequence-row number for the CURRENT frame,
    // then advances internal state to the next frame.
    // Call once per frame, in the same order frames are processed.
    int advanceFrame() {
        if (nRows == 0) return 1;

        // Return the original (user-visible) row number from col 10 when present
        // (expandPauseRows stores it there so that shifted imaging rows still report
        // the correct row number to processFrameData and the graphs).
        int result = getOriginalRowNum(currentRow + 1);

        framesDoneInRow++;
        int frames = getFrames(currentRow);

        // Check if this row's frame quota is exhausted (0 = infinite — never exhausted by count)
        if (frames > 0 && framesDoneInRow >= frames) {
            framesDoneInRow = 0;
            _advanceRow();
        }

        return result;
    }

    // Internal: advance currentRow exactly as the firmware does after a row's frame quota ends.
    void _advanceRow() {
        int lg    = getLoopGoto(currentRow);
        int lt    = getLoopTimes(currentRow);

        if (lg > 0 && lg <= nRows) {
            loopCounters[currentRow]++;
            boolean loopAgain = (lt == 0) || (loopCounters[currentRow] < lt);
            if (loopAgain) {
                currentRow = lg - 1;      // jump back (1-based → 0-based)
            } else {
                loopCounters[currentRow] = 0;
                currentRow++;
            }
        } else {
            currentRow++;
        }

        // Clamp to last row if we run off the end (infinite last row)
        if (currentRow >= nRows) currentRow = nRows - 1;

        // Skip pure-wait / photoswitching rows (exposure=0, finite frame count):
        // they produce no camera frames, so the tracker must not sit waiting for
        // frames that will never arrive.  Rows with frames=0 (infinite) are kept.
        while (currentRow < nRows - 1 && getExposure(currentRow) == 0 && getFrames(currentRow) > 0) {
            currentRow++;
        }
    }

    // Called when a switch-button notification arrives from the Arduino.
    //
    // evArdFr   : totalFrames value in the packet  (= last frame on old row, 1-based)
    // evDestRow : 1-based destination row (from packet byte 1)
    // dataRows, correctedDataRows, btCorrDataRows : all three parallel data lists.
    //   Each entry is ArrayList [frameNum, ts, seqRow, ...]; seqRow at index 2 is patched.
    //
    // The patch walks backward through each list to find entries with frameNum >= evArdFr+1
    // and overwrites their seqRow to evDestRow.
    void patch(int evArdFr, int evDestRow, ArrayList dataRows,
               ArrayList correctedDataRows, ArrayList btCorrDataRows) {
        int firstFrameNewRow = evArdFr + 1;
        // Patch data with the original (user-visible) row number so graph lookups
        // stay correct when the expanded table has shifted imaging row indices.
        int origDest = getOriginalRowNum(evDestRow);
        _patchList(dataRows,          firstFrameNewRow, origDest);
        _patchList(correctedDataRows, firstFrameNewRow, origDest);
        _patchList(btCorrDataRows,    firstFrameNewRow, origDest);

        // Force-sync tracker to the expanded row (internal index)
        currentRow      = evDestRow - 1;
        framesDoneInRow = 0;
        loopCounters[currentRow] = 0;  // firmware resets loop counter on switch
    }

    void _patchList(ArrayList list, int firstFrameNewRow, int evDestRow) {
        if (list == null) return;
        for (int i = list.size() - 1; i >= 0; i--) {
            ArrayList dr = (ArrayList) list.get(i);
            int fn = ((Integer) dr.get(0)).intValue();
            if (fn < firstFrameNewRow) break;  // list is in frame order — safe to stop
            if (dr.size() > 2) {
                dr.set(2, new Integer(evDestRow));
            }
        }
    }
}

// Custom cell renderer for Loop Times - shows "0" for empty or zero (infinite loops)
class LoopTimesRenderer extends DefaultTableCellRenderer {
    public Component getTableCellRendererComponent(JTable table, Object value,
            boolean isSelected, boolean hasFocus,
            int row, int column) {
        super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, column);

        String val = value != null ? value.toString() : "";
        if (val.isEmpty()) {
            setText("0");
            setForeground(Color.GRAY);
            setHorizontalAlignment(SwingConstants.CENTER);
        } else {
            setText(val);
            setForeground(isSelected ? table.getSelectionForeground() : table.getForeground());
            setHorizontalAlignment(SwingConstants.RIGHT);
        }

        return this;
    }
}

// Custom cell renderer for Loop Switch Goto - shows "none" when empty
class LoopSwitchGotoRenderer extends DefaultTableCellRenderer {
    public Component getTableCellRendererComponent(JTable table, Object value,
                                                   boolean isSelected, boolean hasFocus,
                                                   int row, int column) {
        super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, column);

        String val = value != null ? value.toString() : "";
        if (val.isEmpty() || val.equalsIgnoreCase("none")) {
            setText("none");
            setForeground(Color.GRAY);
            setHorizontalAlignment(SwingConstants.CENTER);
        } else {
            setText(val);
            setForeground(isSelected ? table.getSelectionForeground() : table.getForeground());
            setHorizontalAlignment(SwingConstants.CENTER);
        }

        return this;
    }
}

// ==================== Data Visualization Table Classes ====================

// Table Model for visualization configuration
class VisualizationTableModel extends DefaultTableModel {
    String currentMode = "Temporal";  // Track current processing mode
    // Temporal columns: Graph | Type | Numerator (row) | Denominator (row)
    String[] temporalColumns = {"Graph", "Type", "Numerator", "Denominator"};
    String[] spatialColumns = {"Graph", "Type", "Row Filter"};  // Spatial mode: graph type + row filter

    public VisualizationTableModel() {
        super(new Object[][]{
            {"1", "none", "Row 1", "1"},
            {"2", "none", "Row 1", "1"},
            {"3", "none", "Row 1", "1"},
            {"4", "none", "Row 1", "1"}
        }, new String[]{"Graph", "Type", "Numerator", "Denominator"});
    }

    void setProcessingMode(String mode) {
        this.currentMode = mode;
        if (mode.equals("Temporal")) {
            setColumnIdentifiers(temporalColumns);
        } else {
            setColumnIdentifiers(spatialColumns);
        }
        setRowCount(0);
        for (int i = 1; i <= 4; i++) {
            if (mode.equals("Temporal")) {
                addRow(new Object[]{String.valueOf(i), "none", "Row 1", "1"});
            } else {
                addRow(new Object[]{String.valueOf(i), "none", "All Rows"});
            }
        }
    }

    public Class getColumnClass(int col) {
        return String.class;
    }

    public boolean isCellEditable(int row, int col) {
        if (col == 0) return false;
        if (col == 1) return true;
        String type = (String) getValueAt(row, 1);
        if (type.equals("none")) return false;
        if (col == 2 && currentMode.equals("Spatial")) return true; // Row Filter
        if (currentMode.equals("Spatial")) return false;

        // Numerator always editable when type != none
        if (col == 2) return true; // Numerator

        // Denominator locked to "1" for Intensity; editable for Ratio
        if (col == 3) return type.equals("Ratio");
        return false;
    }

    public void setValueAt(Object value, int row, int col) {
        if (col == 0) return;

        if (col == 1) {
            String newType = (String) value;
            super.setValueAt(newType, row, col);
            if (currentMode.equals("Temporal")) {
                if (newType.equals("none")) {
                    super.setValueAt("Row 1", row, 2);
                    super.setValueAt("1",     row, 3);
                } else if (newType.equals("Intensity")) {
                    // Denominator must be constant 1 for plain intensity
                    super.setValueAt("1", row, 3);
                }
                // For "Ratio": leave existing numerator/denominator as-is
            } else if (currentMode.equals("Spatial")) {
                if (newType.equals("none")) {
                    super.setValueAt("All Rows", row, 2);
                }
            }
            fireTableRowsUpdated(row, row);
            return;
        }

        // Cols 2 (Numerator/Row Filter) and 3 (Denominator): accept any string value
        super.setValueAt(value, row, col);
    }
}

// Custom cell editor for Type column (dropdown) - mode-aware
class VisualizationTypeEditor extends DefaultCellEditor {
    JComboBox combo;
    String currentMode = "Temporal";
    SpatialConfig spatialConfig = new SpatialConfig();

    public VisualizationTypeEditor() {
        super(new JComboBox());
        combo = (JComboBox) getComponent();
        updateOptions();
    }

    void setProcessingMode(String mode, SpatialConfig config) {
        this.currentMode = mode;
        this.spatialConfig = config;
        updateOptions();
    }

    void updateOptions() {
        combo.removeAllItems();
        combo.addItem("none");

        if (currentMode.equals("Temporal")) {
            combo.addItem("Intensity");
            combo.addItem("Ratio");
        } else if (currentMode.equals("Spatial")) {
            // Add split ratio options based on spatial config
            String dir1 = spatialConfig.getRatioDirection1();
            String dir2 = spatialConfig.getRatioDirection2();
            combo.addItem("Split ratio " + dir1);
            combo.addItem("Split ratio " + dir2);

            // Add region-specific intensity options
            if (spatialConfig.splitAxis.equals("Horizontal")) {
                combo.addItem("Intensity Upper");
                combo.addItem("Intensity Lower");
            } else {
                combo.addItem("Intensity Left");
                combo.addItem("Intensity Right");
            }
        }
    }
}

// Row-selector dropdowns for Numerator/Denominator are built inline (see installTemporalRowEditors
// calls below) so that tableModel is read from the outer script scope where it is always reachable.
// BeanShell named-class methods cannot reliably access outer-namespace variables;
// anonymous listener bodies can, so the inline approach is used instead of a custom class.

// Main GUI
frame = new JFrame("LUMETRIC - Hardware control");
frame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
frame.setSize(1300, 600);

// Create tabbed pane
tabbedPane = new JTabbedPane();

// Create checkboxes at higher scope so both buttons can access them
simpleSnapMode = new JCheckBox("LUMETRIC Lite", false);
simpleSnapMode.setToolTipText("Single-channel acquisition using only GUI exposure settings — no Arduino or multi-channel setup required");

livePics = new JCheckBox("Live Pictures");
livePics.setToolTipText("Show live view in GUI during acquisition (images are always saved to disk)");

// Stack conversion checkboxes (both can be enabled simultaneously)
convertToStack = new JCheckBox("Convert to Stack", true);
convertToStack.setToolTipText("After acquisition, convert individual TIFFs to a single full stack and delete originals");

stackPerRow = new JCheckBox("Stack per Row");
stackPerRow.setToolTipText("After acquisition, create one TIFF stack per sequence row (can be combined with Convert to Stack)");

// Processing mode combo boxes (declared at script scope for save/load access)
processingModeCombo = null;
splitAxisCombo = null;
roiSourceCombo = null;

// Bleedthrough correction widgets (declared at script scope for save/load access)
btCorrectionCheckbox = null;
btDirectionCombo = null;
btFactorField = null;

// Experiment name field (declared at script scope so restartMainGUI can clear it)
experimentNameField = null;

// ===== SETTINGS TAB =====
settingsPanel = new JPanel(new BorderLayout(10, 10));
settingsPanel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

configInfoPanel = new JPanel(new GridLayout(0, 2, 5, 5));
configInfoPanel.setBorder(BorderFactory.createTitledBorder("Current Configuration"));

configFileLabel = new JLabel("Config File: Not loaded");
cameraGroupLabel = new JLabel("Camera Group: -");
arduinoGroupLabel = new JLabel("-");
serialPortLabel = new JLabel("Serial Port: -");
channelsTextArea = new JTextArea(5, 40);
channelsTextArea.setEditable(false);
channelsTextArea.setBorder(BorderFactory.createTitledBorder("Available Channels"));

generateConfigButton = new JButton("Generate Config from MM");
generateConfigButton.setBackground(new Color(255, 230, 100));
generateConfigButton.setToolTipText("Auto-detect settings from the running Micro-Manager instance and create a new .properties config file");
loadConfigButton = new JButton("Load Configuration File");
reloadConfigButton = new JButton("Reload Current Config");
readFromHubButton = new JButton("Read Channels from Hub");
readFromHubButton.setToolTipText("Query the Micro-Manager Arduino Switch device to populate the channel list automatically");
saveConfigButton = new JButton("Save Config");
saveConfigButton.setToolTipText("Save the current channel/pin configuration back to the loaded config file");
saveConfigButton.setBackground(new Color(180, 220, 255));

configInfoPanel.add(new JLabel("Config File:"));
configInfoPanel.add(configFileLabel);
configInfoPanel.add(new JLabel("Camera Group:"));
configInfoPanel.add(cameraGroupLabel);
configInfoPanel.add(new JLabel("Arduino Config Group:"));
configInfoPanel.add(arduinoGroupLabel);
configInfoPanel.add(new JLabel("Serial Port:"));
configInfoPanel.add(serialPortLabel);

configButtonPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
configButtonPanel.add(generateConfigButton);
configButtonPanel.add(loadConfigButton);
configButtonPanel.add(reloadConfigButton);
configButtonPanel.add(readFromHubButton);
configButtonPanel.add(saveConfigButton);

settingsPanel.add(configInfoPanel, BorderLayout.NORTH);
settingsPanel.add(new JScrollPane(channelsTextArea), BorderLayout.CENTER);
settingsPanel.add(configButtonPanel, BorderLayout.SOUTH);

// ===== SEQUENCE TAB =====
sequencePanel = new JPanel(new BorderLayout());

// Top panel with Simple Snap Mode checkbox
sequenceTopPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
sequenceTopPanel.setBorder(BorderFactory.createEmptyBorder(5, 5, 5, 5));
sequenceTopPanel.add(simpleSnapMode);
simpleSnapInfoLabel = new JLabel(" ← No Arduino or multi-channel setup required");
simpleSnapInfoLabel.setForeground(Color.DARK_GRAY);
sequenceTopPanel.add(simpleSnapInfoLabel);
sequencePanel.add(sequenceTopPanel, BorderLayout.NORTH);

// Create the table
tableModel = new AcquisitionTableModel();
table = new JTable(tableModel);
channelEditor = new ChannelEditor();
table.setRowHeight(30);

// Make table headers darker and more visible
JTableHeader header = table.getTableHeader();
header.setFont(header.getFont().deriveFont(Font.BOLD, 12f));
header.setForeground(Color.BLACK);

// Set custom renderer for Row column (bold)
table.getColumnModel().getColumn(0).setCellRenderer(new DefaultTableCellRenderer() {
    public Component getTableCellRendererComponent(JTable table, Object value,
                                                   boolean isSelected, boolean hasFocus,
                                                   int row, int column) {
        super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, column);
        setFont(getFont().deriveFont(Font.BOLD));
        setHorizontalAlignment(SwingConstants.CENTER);
