// ==================== Data Classes ====================

// ROI with spatial metadata
class ROIMetadata {
    ij.gui.Roi roi;
    String sourceRegion;       // "original", "left", "right", "upper", "lower"
    int captureWidth;
    int captureHeight;

    public ROIMetadata(ij.gui.Roi roi, String sourceRegion, int width, int height) {
        this.roi = roi;
        this.sourceRegion = sourceRegion;
        this.captureWidth = width;
        this.captureHeight = height;
    }
}

// Spatial processing configuration
class SpatialConfig {
    String splitAxis = "Horizontal";  // "Horizontal" or "Vertical"
    String roiSourceRegion = "Upper";  // "Left", "Right", "Upper", "Lower"

    String getRatioDirection1() {
        if (splitAxis.equals("Horizontal")) {
            return roiSourceRegion.equals("Upper") ? "Up/Down" : "Down/Up";
        } else {
            return roiSourceRegion.equals("Left") ? "Left/Right" : "Right/Left";
        }
    }

    String getRatioDirection2() {
        if (splitAxis.equals("Horizontal")) {
            return roiSourceRegion.equals("Upper") ? "Down/Up" : "Up/Down";
        } else {
            return roiSourceRegion.equals("Left") ? "Right/Left" : "Left/Right";
        }
    }
}

// Acquisition settings - decoupled from GUI
class AcquisitionSettings {
    boolean livePics = false; // Controls live view GUI display (images are always saved)
    boolean convertToStack = true; // Convert individual TIFFs to stack after acquisition (default: true)
    boolean stackPerRow = false; // Create one stack per sequence row (not yet implemented)
    String saveDirectory = "";
    ArrayList sequenceRows = new ArrayList(); // Each row is ArrayList of column values
    ArrayList visualizationRows = new ArrayList();

    // Processing mode
    String processingMode = "Temporal"; // "Temporal" or "Spatial"
    SpatialConfig spatialConfig = new SpatialConfig();

    void captureFromGUI(DefaultTableModel tableModel, DefaultTableModel vizTableModel,
                       JCheckBox simpleSnapModeCheckbox, JCheckBox livePicsCheckbox,
                       JCheckBox convertToStackCheckbox, JCheckBox stackPerRowCheckbox, String savePath,
                       JComboBox processingModeCombo, JComboBox splitAxisCombo, JComboBox roiSourceCombo) {
        // Capture mode
        config.useSimpleSnapMode = simpleSnapModeCheckbox.isSelected();
        livePics = livePicsCheckbox.isSelected();
        convertToStack = convertToStackCheckbox.isSelected();
        stackPerRow = stackPerRowCheckbox.isSelected();
        saveDirectory = savePath;

        // Capture processing mode and spatial config
        processingMode = (String) processingModeCombo.getSelectedItem();
        if (processingMode.equals("Spatial")) {
            spatialConfig.splitAxis = (String) splitAxisCombo.getSelectedItem();
            spatialConfig.roiSourceRegion = (String) roiSourceCombo.getSelectedItem();
        }

        // Capture sequence table
        sequenceRows.clear();
        for (int i = 0; i < tableModel.getRowCount(); i++) {
            ArrayList row = new ArrayList();
            for (int j = 0; j < tableModel.getColumnCount(); j++) {
                row.add(tableModel.getValueAt(i, j));
            }
            sequenceRows.add(row);
        }

        // Capture visualization table
        visualizationRows.clear();
        for (int i = 0; i < vizTableModel.getRowCount(); i++) {
            ArrayList row = new ArrayList();
            for (int j = 0; j < vizTableModel.getColumnCount(); j++) {
                row.add(vizTableModel.getValueAt(i, j));
            }
            visualizationRows.add(row);
        }
    }

    boolean isVisualizationNeeded() {
        for (int i = 0; i < visualizationRows.size(); i++) {
            ArrayList row = visualizationRows.get(i);
            String type = (String) row.get(1);
            if (type != null && !type.trim().isEmpty() && !type.equals("Off")) {
                return true;
            }
        }
        return false;
    }
}

// Global configuration storage
class MicroscopeConfig {
    Map pinToChannel = new HashMap();
    String cameraConfigGroup = "Hamamatsu";
    String cameraSnapConfig = "Snapping_and_Live";
    String cameraTriggerConfig = "GlobalResetLevelTriggerArduinoMode";
    String spectralConfigGroup = "Spectra";
    String spectralDefaultConfig = "Triggered";
    String arduinoConfigGroup = "";
    String serialPort = "COM4";
    String configFilePath = "";

    // Acquisition mode: true = use circular buffer (for real camera), false = simple snap mode (for demo)
    boolean useCircularBuffer = true;  // Default: true (overridden by USE_CIRCULAR_BUFFER in config file)

    // Simple snap mode: true = use w.o. Arduino,no Channel switch false = full sequence logic
    boolean useSimpleSnapMode = false;  // Default: false (overridden by checkbox in GUI)
    boolean useTestTable = false;        // If true: send case 69 (Arduino Firmware hardcoded test table) instead of case 60

    AcquisitionSettings acqSettings = new AcquisitionSettings();
    ArrayList storedROIs = new ArrayList(); // Store ROIs for acquisition
    String experimentFolder = ""; // Store experiment folder path
    String imagesFolder = ""; // Store images subfolder path (for TIFF files)

    // Load configuration from file
    boolean loadFromFile(String filePath) {
        try {
            pinToChannel.clear();
            BufferedReader reader = new BufferedReader(new FileReader(filePath));
            String line;

            while ((line = reader.readLine()) != null) {
                line = line.trim();
                // Skip comments and empty lines
                if (line.startsWith("#") || line.isEmpty()) {
                    continue;
                }

                // Parse key = value
                if (line.contains("=")) {
                    String[] parts = line.split("=", 2);
                    String key = parts[0].trim();
                    String value = parts[1].trim();

                    if (key.startsWith("PIN_")) {
                        try {
                            int pinNum = Integer.parseInt(key.substring(4));
                            pinToChannel.put(pinNum, value);
                        } catch (NumberFormatException e) {
                            // Ignore malformed PIN_ keys (e.g. PIN_abc)
                        }
                    } else if (key.equals("CAMERA_CONFIG_GROUP")) {
                        cameraConfigGroup = value;
                    } else if (key.equals("CAMERA_SNAP_CONFIG")) {
                        cameraSnapConfig = value;
                    } else if (key.equals("CAMERA_TRIGGER_CONFIG")) {
                        cameraTriggerConfig = value;
                    } else if (key.equals("USE_CIRCULAR_BUFFER")) {
                        useCircularBuffer = value.equalsIgnoreCase("true") || value.equals("1");
                    } else if (key.equals("SPECTRAL_CONFIG_GROUP")) {
                        spectralConfigGroup = value;
                    } else if (key.equals("SPECTRAL_DEFAULT_CONFIG")) {
                        spectralDefaultConfig = value;
                    } else if (key.equals("ARDUINO_CONFIG_GROUP")) {
                        arduinoConfigGroup = value;
                    } else if (key.equals("SERIAL_PORT")) {
                        serialPort = value;
                    }
                }
            }
            reader.close();
            configFilePath = filePath;
            return true;
        } catch (IOException e) {
            JOptionPane.showMessageDialog(null, "Error loading config file: " + e.getMessage(),
                    "Config Error", JOptionPane.ERROR_MESSAGE);
            return false;
        }
    }

    // Get list of available channels (excluding Camera on PIN_1)
    List getAvailableChannels() {
        List channels = new ArrayList();
        for (Map.Entry entry : pinToChannel.entrySet()) {
            int pin = (Integer) entry.getKey();
            String channel = (String) entry.getValue();
            if (pin > 1) { // Skip PIN_1 (Camera)
                channels.add(channel);
            }
        }
        return channels;
    }

    // Get pin number for a channel name
    int getPinForChannel(String channelName) {
        for (Map.Entry entry : pinToChannel.entrySet()) {
            if (((String) entry.getValue()).equals(channelName)) {
                return (Integer) entry.getKey();
            }
        }
        return -1;
    }

    // Save current configuration back to the loaded config file
    boolean saveToFile(String filePath) {
        try {
            PrintWriter writer = new PrintWriter(new FileWriter(filePath));
            writer.println("# Microscope Configuration File");
            writer.println("# Lines starting with # are comments");
            writer.println("# Format: PIN_NUMBER = CHANNEL_NAME");
            writer.println();

            // Pin assignments - sorted by pin number
            writer.println("# Pin assignments (Pin 1 is always Camera TTL)");
            List sortedPins = new ArrayList(pinToChannel.keySet());
            java.util.Collections.sort(sortedPins);
            for (Object pinObj : sortedPins) {
                writer.println("PIN_" + pinObj + " = " + pinToChannel.get(pinObj));
            }
            writer.println();

            // Camera settings
            writer.println("# Camera Configuration Settings (MicroManager config names)");
            writer.println("CAMERA_CONFIG_GROUP = " + cameraConfigGroup);
            writer.println("CAMERA_SNAP_CONFIG = " + cameraSnapConfig);
            writer.println("CAMERA_TRIGGER_CONFIG = " + cameraTriggerConfig);
            writer.println();

            // Acquisition mode
            writer.println("# Acquisition Mode");
            writer.println("# true = Use circular buffer (for real cameras with high-speed acquisition)");
            writer.println("# false = Use simple snap mode (for demo cameras or single frame capture)");
            writer.println("USE_CIRCULAR_BUFFER = " + useCircularBuffer);
            writer.println();

            // Spectral settings
            writer.println("# Spectral Configuration Settings");
            writer.println("SPECTRAL_CONFIG_GROUP = " + spectralConfigGroup);
            writer.println("SPECTRAL_DEFAULT_CONFIG = " + spectralDefaultConfig);
            writer.println();

            // Arduino config group
            writer.println("# Arduino channel config group (MicroManager config group where presets set Arduino-Switch,State)");
            writer.println("# Each preset name becomes a channel name; its State value (2,4,8,...) maps to PIN_2, PIN_3, PIN_4,...");
            writer.println("ARDUINO_CONFIG_GROUP = " + arduinoConfigGroup);
            writer.println();

            // Serial port
            writer.println("# Serial Port");
            writer.println("SERIAL_PORT = " + serialPort);
            writer.println();

            writer.close();
            return true;
        } catch (IOException e) {
            JOptionPane.showMessageDialog(null, "Error saving config file: " + e.getMessage(),
                    "Config Error", JOptionPane.ERROR_MESSAGE);
            return false;
        }
    }

    // Load channel configuration from Micro-Manager config groups.
    // Arduino-Switch,State to a power-of-2 value (1=PIN_1, 2=PIN_2, 4=PIN_3, 8=PIN_4, ...).
    // scan all config groups for presets that set a StateDevice "State" property,
    // then map the numeric state value to a PIN number and use the preset name as the channel name.
    boolean loadFromHub(mmcorej.CMMCore core) {
        try {
            // --- Step 1: find the Arduino Switch device name ---
            String switchDevice = null;
            mmcorej.StrVector devices = core.getLoadedDevices();
            for (int i = 0; i < devices.size(); i++) {
                String dev = devices.get(i);
                if (dev.toLowerCase().contains("switch")) {
                    switchDevice = dev;
                    break;
                }
            }
            if (switchDevice == null) {
                for (int i = 0; i < devices.size(); i++) {
                    String dev = devices.get(i);
                    try {
                        if (core.getDeviceType(dev) == mmcorej.DeviceType.StateDevice) {
                            switchDevice = dev;
                            break;
                        }
                    } catch (Exception ex) {}
                }
            }
            if (switchDevice == null) {
                JOptionPane.showMessageDialog(null,
                    "No Arduino Switch (StateDevice) found in Micro-Manager.\n" +
                    "Please load your MM hardware configuration first.",
                    "Hub Error", JOptionPane.ERROR_MESSAGE);
                return false;
            }

            // --- Step 2: scan config groups for presets that set <switchDevice>,State ---
            // If ARDUINO_CONFIG_GROUP is set in config file, only look in that group.
            Map newPinToChannel = new HashMap();
            mmcorej.StrVector groups;
            if (arduinoConfigGroup != null && !arduinoConfigGroup.isEmpty()) {
                groups = new mmcorej.StrVector();
                groups.add(arduinoConfigGroup);
            } else {
                groups = core.getAvailableConfigGroups();
            }
            for (int g = 0; g < groups.size(); g++) {
                String group = groups.get(g);
                mmcorej.StrVector presets = core.getAvailableConfigs(group);
                for (int p = 0; p < presets.size(); p++) {
                    String preset = presets.get(p);
                    mmcorej.Configuration cfg = core.getConfigData(group, preset);
                    for (int s = 0; s < cfg.size(); s++) {
                        mmcorej.PropertySetting ps = cfg.getSetting(s);
                        if (ps.getDeviceLabel().equals(switchDevice) &&
                            (ps.getPropertyName().equals("State") || ps.getPropertyName().equals("Label"))) {
                            try {
                                int stateVal = Integer.parseInt(ps.getPropertyValue());
                                // Power-of-2: exactly one pin active
                                if (stateVal > 0 && (stateVal & (stateVal - 1)) == 0) {
                                    int pinNum = Integer.numberOfTrailingZeros(stateVal) + 1;
                                    newPinToChannel.put(pinNum, preset);
                                }
                            } catch (NumberFormatException ex) {}
                            break;
                        }
                    }
                }
            }

            if (newPinToChannel.isEmpty()) {
                String groupHint = (arduinoConfigGroup != null && !arduinoConfigGroup.isEmpty())
                    ? "'" + arduinoConfigGroup + "'"
                    : "any config group";
                JOptionPane.showMessageDialog(null,
                    "No channel presets found in " + groupHint + " that control '" + switchDevice + "'.\n" +
                    "Each preset must set " + switchDevice + ",State to a power-of-2 value (2,4,8,...).\n" +
                    "Check ARDUINO_CONFIG_GROUP in your config file.",
                    "Hub Warning", JOptionPane.WARNING_MESSAGE);
                return false;
            }

            pinToChannel.clear();
            pinToChannel.putAll(newPinToChannel);
            return true;

        } catch (Exception e) {
            JOptionPane.showMessageDialog(null,
                "Error reading channels from Arduino Hub:\n" + e.getMessage(),
                "Hub Error", JOptionPane.ERROR_MESSAGE);
            return false;
        }
    }
}

// Simple FileFilter for config files
class ConfigFileFilter extends javax.swing.filechooser.FileFilter {
    public boolean accept(File f) {
        return f.isDirectory() || f.getName().toLowerCase().endsWith(".txt");
    }
    public String getDescription() {
        return "Configuration Files (*.txt)";
    }
}

