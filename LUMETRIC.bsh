JCheckBox useTestTableCheckbox = new JCheckBox("Use hardcoded test table (case 69)", false);
useTestTableCheckbox.setToolTipText("Bypasses serial table upload — loads pin=17, exp=100ms, int=1000ms, frames=1000 directly on Arduino");

okButton = new JButton("OK - Start Acquisition");
okButton.setBackground(Color.GREEN);
okButton.addActionListener(new ActionListener() {
    public void actionPerformed(ActionEvent e) {
        if (validateSequence()) {
            // Ensure save directory is selected BEFORE starting threads
            String lastSavePath = prefs.get("lastSavePath", "");
            if (lastSavePath.isEmpty() || !new File(lastSavePath).exists()) {
                JFileChooser dirChooser = new JFileChooser();
                dirChooser.setDialogTitle("Select Directory for Acquisition Data");
                dirChooser.setFileSelectionMode(JFileChooser.DIRECTORIES_ONLY);

                int result = dirChooser.showDialog(frame, "Select Folder");
                if (result != JFileChooser.APPROVE_OPTION) {
                    JOptionPane.showMessageDialog(frame,
                        "You must select a save directory to start acquisition.",
                        "Save Directory Required", JOptionPane.WARNING_MESSAGE);
                    return;
                }

                File saveDir = dirChooser.getSelectedFile();
                lastSavePath = saveDir.getAbsolutePath();
                prefs.put("lastSavePath", lastSavePath);

                // Update the display label
                dataDirPathLabel.setText(lastSavePath);
                dataDirPathLabel.setForeground(Color.BLACK);
            }

            // Capture all data from GUI before disposal
            config.acqSettings.captureFromGUI(tableModel, vizTableModel, simpleSnapMode, livePics, convertToStack, stackPerRow, lastSavePath, processingModeCombo, splitAxisCombo, roiSourceCombo);

            config.useTestTable = useTestTableCheckbox.isSelected();
            // Dispose GUI immediately - no more GUI dependencies
            frame.dispose();

            // Run acquisition workflow in background thread with captured data
            new Thread(new Runnable() {
                public void run() {
                    try {
                        // Create experiment folder first so all files go there
                        createExperimentFolder();

                        if (config.acqSettings.isVisualizationNeeded()) {
                            if (!setupVisualizationROIs()) {
                                return;
                            }
                        }

                        if (!exportTableToCSV()) {
                            SwingUtilities.invokeLater(new Runnable() {
                                public void run() {
                                    JOptionPane.showMessageDialog(null,
                                        "Failed to save acquisition settings.\nPlease check folder permissions.",
                                        "File Write Error", JOptionPane.ERROR_MESSAGE);
                                }
                            });
                            return;
                        }

                        printSequenceData();

                        // Create acquisition window on EDT
                        SwingUtilities.invokeLater(new Runnable() {
                            public void run() {
                                createInlineAcquisitionWindow();
                            }
                        });
                    } catch (Exception threadEx) {
                        // print("ERROR: Uncaught exception in background thread: " + threadEx.getMessage());
                        threadEx.printStackTrace();
                        // Show user-friendly error dialog on EDT
                        // Capture error message for inner class (BeanShell compatibility)
                        String capturedError = threadEx.getMessage();
                        if (capturedError == null) capturedError = threadEx.getClass().getName();
                        final String errorMsg = capturedError;
                        SwingUtilities.invokeLater(new Runnable() {
                            public void run() {
                                JOptionPane.showMessageDialog(null,
                                    "Acquisition setup failed:\n" + errorMsg +
                                    "\n\nPlease check:\n" +
                                    "- You have write permissions to the selected folder\n" +
                                    "- The folder is not on a network drive or read-only location\n" +
                                    "- You're not running in a restricted directory",
                                    "Acquisition Error", JOptionPane.ERROR_MESSAGE);
                            }
                        });
                    }
                }
            }).start();
        }
    }
});

