// ==================== Generic CSV Export Helper ====================

// Write generic CSV data to file
// data: 2D array or List of Lists - each inner list is a row
// headers: Array/List of column headers
// comments: Optional array/list of comment lines (will be prefixed with #)
boolean writeCSV(File csvFile, Object headers, Object data, Object comments) {
    try {
        PrintWriter writer = new PrintWriter(new FileWriter(csvFile));

        // Write headers
        if (headers != null) {
            StringBuilder headerRow = new StringBuilder();
            if (headers instanceof Object[]) {
                Object[] headerArray = (Object[]) headers;
                for (int i = 0; i < headerArray.length; i++) {
                    if (i > 0) headerRow.append(",");
                    headerRow.append(escapeCSV(headerArray[i].toString()));
                }
            } else if (headers instanceof List) {
                List headerList = (List) headers;
                for (int i = 0; i < headerList.size(); i++) {
                    if (i > 0) headerRow.append(",");
                    headerRow.append(escapeCSV(headerList.get(i).toString()));
                }
            }
            writer.println(headerRow.toString());
        }

        // Write data rows
        if (data != null) {
            if (data instanceof Object[][]) {
                Object[][] dataArray = (Object[][]) data;
                for (int i = 0; i < dataArray.length; i++) {
                    StringBuilder row = new StringBuilder();
                    for (int j = 0; j < dataArray[i].length; j++) {
                        if (j > 0) row.append(",");
                        row.append(escapeCSV(dataArray[i][j].toString()));
                    }
                    writer.println(row.toString());
                }
            } else if (data instanceof List) {
                List dataList = (List) data;
                for (int i = 0; i < dataList.size(); i++) {
                    StringBuilder row = new StringBuilder();
                    Object rowData = dataList.get(i);
                    if (rowData instanceof Object[]) {
                        Object[] rowArray = (Object[]) rowData;
                        for (int j = 0; j < rowArray.length; j++) {
                            if (j > 0) row.append(",");
                            row.append(escapeCSV(rowArray[j].toString()));
                        }
                    } else if (rowData instanceof List) {
                        List rowList = (List) rowData;
                        for (int j = 0; j < rowList.size(); j++) {
                            if (j > 0) row.append(",");
                            row.append(escapeCSV(rowList.get(j).toString()));
                        }
                    }
                    writer.println(row.toString());
                }
            }
        }

        // Write comments
        if (comments != null) {
            writer.println("");
            if (comments instanceof Object[]) {
                Object[] commentArray = (Object[]) comments;
                for (int i = 0; i < commentArray.length; i++) {
                    writer.println("# " + commentArray[i].toString());
                }
            } else if (comments instanceof List) {
                List commentList = (List) comments;
                for (int i = 0; i < commentList.size(); i++) {
                    writer.println("# " + commentList.get(i).toString());
                }
            } else if (comments instanceof String) {
                writer.println("# " + comments.toString());
            }
        }

        writer.close();
        return true;

    } catch (IOException e) {
        // print("ERROR: Failed to write CSV file: " + e.getMessage());
        e.printStackTrace();
        return false;
    }
}

// Escape special characters for CSV format
String escapeCSV(String value) {
    if (value == null) return "";
    if (value.contains(",") || value.contains("\"") || value.contains("\n")) {
        return "\"" + value.replace("\"", "\"\"") + "\"";
    }
    return value;
}

// Find next available filename with timestamp
File getNextAvailableFile(File directory, String baseName, String extension) {
    // Use timestamp to avoid having to check existing files
    import java.text.SimpleDateFormat;
    import java.util.Date;

    SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMdd_HHmmss");
    String timestamp = sdf.format(new Date());
    File file = new File(directory, baseName + "_" + timestamp + extension);

    // If by some chance file exists (same second), add milliseconds
    if (file.exists()) {
        timestamp = sdf.format(new Date()) + "_" + System.currentTimeMillis();
        file = new File(directory, baseName + "_" + timestamp + extension);
    }

    return file;
}

// ==================== ROI Setup for Visualization ====================

boolean isVisualizationNeeded() {
    return config.acqSettings.isVisualizationNeeded();
}

// ==================== Create Experiment Folder ====================
void createExperimentFolder() {
    import java.text.SimpleDateFormat;
    import java.util.Date;
    SimpleDateFormat sdf = new SimpleDateFormat("yyyyMMdd_HHmmss");
    String timestamp = sdf.format(new Date());
    String saveDir = config.acqSettings.saveDirectory;

    if (saveDir == null || saveDir.isEmpty()) {

        return;
    }

    // Check if parent directory is writable
    File saveDirFile = new File(saveDir);
    if (!saveDirFile.canWrite()) {


        throw new IOException("No write permission for save directory");
    }

    String expPrefix = (config.acqSettings.experimentName != null && !config.acqSettings.experimentName.isEmpty())
        ? config.acqSettings.experimentName
        : "Experiment";
    File experimentFolder = new File(saveDir, expPrefix + "_" + timestamp);
    boolean created = experimentFolder.mkdir();

    if (!created) {
        // print("ERROR: Failed to create experiment folder: " + experimentFolder.getAbsolutePath());

        throw new IOException("Failed to create experiment folder");
    }

    // print("Created experiment folder: " + experimentFolder.getAbsolutePath());

    // Store experiment folder path in config
    config.experimentFolder = experimentFolder.getAbsolutePath();

    // Create images subfolder for TIFF files
    File imagesFolder = new File(experimentFolder, "images");
    boolean imagesFolderCreated = imagesFolder.mkdir();
    if (!imagesFolderCreated) {

        throw new IOException("Failed to create images subfolder");
    }

    // print("Created images subfolder: " + imagesFolder.getAbsolutePath());

    // Store images folder path in config
    config.imagesFolder = imagesFolder.getAbsolutePath();

    // Hold a lock file open so Windows blocks any rename of the experiment folder
    // while acquisition is running.  Released by releaseExperimentFolderLock().
    try {
        File lockFile = new File(experimentFolder, ".lumetric-lock");
        acqFolderLock = new FileOutputStream(lockFile);
    } catch (Exception lockEx) {
        // Non-fatal: acquisition continues, folder just won't be rename-protected
        System.err.println("WARNING: Could not create folder lock: " + lockEx.getMessage());
    }
}

// ==================== Setup Visualization ROIs ====================
// Setup ROIs for visualization - returns true if successful, false if cancelled
boolean setupVisualizationROIs() {

    // Note: Main GUI is already disposed at this point

    import ij.plugin.frame.RoiManager;

    // Snap an image
    // Only apply camera config if not in Simple Snap Mode
    if (!config.useSimpleSnapMode) {
        mmc.setConfig(config.cameraConfigGroup, config.cameraSnapConfig);
    }
    List images = mm.live().snap(false);
    org.micromanager.data.Image image = images.get(0);

    if (images == null || images.isEmpty()) {

        return false;
    }

    // Get full sensor dimensions
    int fullWidth = (int) mmc.getImageWidth();
    int fullHeight = (int) mmc.getImageHeight();

    // Create ImageJ processor from snapped image
    ImageProcessor fullIP = mm.data().ij().createProcessor(image);

    // For spatial mode: crop to show only relevant half
    ImageProcessor displayIP = fullIP;
    String displayTitle = "ROI Selection - Draw your ROIs";
    final int[] cropOffset = {0, 0};  // [offsetX, offsetY]

    boolean isSpatialMode = config.acqSettings.processingMode.equals("Spatial");
    final String splitAxis = isSpatialMode ? config.acqSettings.spatialConfig.splitAxis : "";
    final String roiRegion = isSpatialMode ? config.acqSettings.spatialConfig.roiSourceRegion : "";

    if (isSpatialMode) {

        if (splitAxis.equals("Horizontal")) {
            // Split horizontally (top/bottom)
            int halfHeight = fullHeight / 2;
            if (roiRegion.equals("Upper")) {
                // Show top half
                fullIP.setRoi(0, 0, fullWidth, halfHeight);
                displayIP = fullIP.crop();
                cropOffset[1] = 0;
                displayTitle = "ROI Selection - UPPER half (will be duplicated to lower half)";
            } else {
                // Show bottom half
                fullIP.setRoi(0, halfHeight, fullWidth, halfHeight);
                displayIP = fullIP.crop();
                cropOffset[1] = halfHeight;
                displayTitle = "ROI Selection - LOWER half (will be duplicated to upper half)";
            }
        } else {
            // Split vertically (left/right)
            int halfWidth = fullWidth / 2;
            if (roiRegion.equals("Left")) {
                // Show left half
                fullIP.setRoi(0, 0, halfWidth, fullHeight);
                displayIP = fullIP.crop();
                cropOffset[0] = 0;
                displayTitle = "ROI Selection - LEFT half (will be duplicated to right half)";
            } else {
                // Show right half
                fullIP.setRoi(halfWidth, 0, halfWidth, fullHeight);
                displayIP = fullIP.crop();
                cropOffset[0] = halfWidth;
                displayTitle = "ROI Selection - RIGHT half (will be duplicated to left half)";
            }
        }
    }

    // Create and show ImageJ display
    ImagePlus imp = new ImagePlus(displayTitle, displayIP);
    imp.show();

    // Open ROI Manager
    IJ.run("ROI Manager...", "");
    ij.plugin.frame.RoiManager rm = ij.plugin.frame.RoiManager.getInstance();
    rm.runCommand(imp, "Show All");

    // Create control window on EDT and use proper synchronization
    final boolean[] done = {false};
    final boolean[] cancelled = {false};
    final Object lock = new Object();

    // Must create and show GUI on EDT to avoid threading issues (especially on Windows)
    SwingUtilities.invokeLater(new Runnable() {
        public void run() {
            JFrame btnFrame = new JFrame("ROI Setup");
            btnFrame.setSize(400, 150);
            btnFrame.setAlwaysOnTop(true);
            btnFrame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);

            JPanel infoPanel = new JPanel(new BorderLayout());
            JLabel infoLabel = new JLabel("<html><div style='text-align: center; padding: 10px;'>"
                + "<b>Draw ROIs on the image and add them to ROI Manager</b><br>"
                + "Press 't' to add ROIs, then click Done"
                + "</div></html>", SwingConstants.CENTER);
            infoPanel.add(infoLabel, BorderLayout.CENTER);

            JPanel buttonPanel = new JPanel(new FlowLayout(FlowLayout.CENTER, 20, 10));
            JButton doneButton = new JButton("ROIs Done");
            doneButton.setBackground(Color.GREEN);
            JButton cancelButton = new JButton("Cancel");
            cancelButton.setBackground(Color.ORANGE);

            doneButton.addActionListener(new ActionListener() {
                public void actionPerformed(ActionEvent e) {

                    synchronized(lock) {
                        done[0] = true;
                        lock.notifyAll();  // Wake up waiting thread
                    }
                    btnFrame.dispose();
                }
            });

            cancelButton.addActionListener(new ActionListener() {
                public void actionPerformed(ActionEvent e) {

                    synchronized(lock) {
                        cancelled[0] = true;
                        lock.notifyAll();  // Wake up waiting thread
                    }
                    btnFrame.dispose();
                }
            });

            buttonPanel.add(doneButton);
            buttonPanel.add(cancelButton);

            btnFrame.setLayout(new BorderLayout());
            btnFrame.add(infoPanel, BorderLayout.CENTER);
            btnFrame.add(buttonPanel, BorderLayout.SOUTH);
            btnFrame.setLocationRelativeTo(null);
            btnFrame.setVisible(true);
        }
    });

    // Wait for user action using proper wait/notify instead of busy polling

    synchronized(lock) {
        while (done[0] == false && cancelled[0] == false) {
            try {
                lock.wait();  // Efficiently wait for notification, no CPU polling
            } catch (InterruptedException e) {
                // print("Wait interrupted: " + e.getMessage());
                break;
            }
        }
    }


    if (cancelled[0]) {
        // Clean up ImageJ window
        if (imp.getWindow() != null) {
            imp.getWindow().close();
        }

        return false;
    }

    // print("ROI count = " + rm.getCount());

    // Rename ROIs in the ROI Manager immediately
    for (int i = 0; i < rm.getCount(); i++) {
        rm.select(i);
        rm.runCommand("Rename", "ROI" + (i + 1));
    }

    // Clean up ImageJ window
    if (imp.getWindow() != null) {
        imp.getWindow().close();
    }

    // Store renamed ROIs with metadata
    config.storedROIs = new ArrayList();

    // Get current image dimensions
    int imageWidth = (int) mmc.getImageWidth();
    int imageHeight = (int) mmc.getImageHeight();

    // Determine source region based on processing mode
    String sourceRegion = "original";
    if (isSpatialMode) {
        sourceRegion = roiRegion;
    }



    int originalRoiCount = rm.getCount();

    // First, adjust original ROIs in ROI Manager to full image coordinates (for spatial mode)
    if (isSpatialMode) {

        for (int i = 0; i < originalRoiCount; i++) {
            ij.gui.Roi roi = rm.getRoi(i);
            java.awt.Rectangle bounds = roi.getBounds();
            roi.setLocation(bounds.x + cropOffset[0], bounds.y + cropOffset[1]);
        }
    }

    // Store original ROIs with metadata
    for (int i = 0; i < originalRoiCount; i++) {
        ij.gui.Roi roi = rm.getRoi(i);
        ij.gui.Roi roiCopy = (ij.gui.Roi) roi.clone();

        ROIMetadata roiMeta = new ROIMetadata(roiCopy, sourceRegion, imageWidth, imageHeight);
        config.storedROIs.add(roiMeta);
    }

    // For spatial mode: duplicate ROIs to the other half
    if (isSpatialMode) {

        for (int i = 0; i < originalRoiCount; i++) {
            ij.gui.Roi roi = rm.getRoi(i);
            ij.gui.Roi mirroredRoi = (ij.gui.Roi) roi.clone();

            java.awt.Rectangle bounds = mirroredRoi.getBounds();

            if (splitAxis.equals("Horizontal")) {
                // Mirror vertically
                int halfHeight = imageHeight / 2;
                if (roiRegion.equals("Upper")) {
                    // Original is in upper half, mirror to lower
                    int newY = bounds.y + halfHeight;
                    mirroredRoi.setLocation(bounds.x, newY);
                } else {
                    // Original is in lower half, mirror to upper
                    int newY = bounds.y - halfHeight;
                    mirroredRoi.setLocation(bounds.x, newY);
                }
            } else {
                // Mirror horizontally
                int halfWidth = imageWidth / 2;
                if (roiRegion.equals("Left")) {
                    // Original is in left half, mirror to right
                    int newX = bounds.x + halfWidth;
                    mirroredRoi.setLocation(newX, bounds.y);
                } else {
                    // Original is in right half, mirror to left
                    int newX = bounds.x - halfWidth;
                    mirroredRoi.setLocation(newX, bounds.y);
                }
            }

            // Determine mirrored region
            String mirroredRegion = "";
            if (splitAxis.equals("Horizontal")) {
                mirroredRegion = roiRegion.equals("Upper") ? "Lower" : "Upper";
            } else {
                mirroredRegion = roiRegion.equals("Left") ? "Right" : "Left";
            }

            // Add mirrored ROI to ROI Manager
            rm.addRoi(mirroredRoi);

            // Store mirrored ROI with metadata
            ROIMetadata mirroredMeta = new ROIMetadata(mirroredRoi, mirroredRegion, imageWidth, imageHeight);
            config.storedROIs.add(mirroredMeta);
        }

        // Rename all ROIs in ROI Manager (originals + mirrored)
        for (int i = 0; i < rm.getCount(); i++) {
            rm.select(i);
            rm.runCommand("Rename", "ROI" + (i + 1));
        }
     } else {
    }


    // Save ROI set with renamed ROIs
    if (rm.getCount() > 0) {
        // Use experiment folder if it exists, otherwise use data directory
        String savePath = config.experimentFolder.isEmpty() ?
            prefs.get("lastSavePath", "") : config.experimentFolder;
        if (!savePath.isEmpty()) {
            try {
                File saveDir = new File(savePath);

                // Check write permission BEFORE attempting to save
                if (!saveDir.canWrite()) {
                 } else {
                    File roiFile = config.experimentFolder.isEmpty() ?
                        getNextAvailableFile(saveDir, "RoiSet", ".zip") :
                        new File(saveDir, "RoiSet.zip");
                    // Use a timeout thread to prevent indefinite blocking
                    final boolean[] saveComplete = {false};
                    final String roiPath = roiFile.getAbsolutePath();
                    Thread saveThread = new Thread(new Runnable() {
                        public void run() {
                            try {
                                rm.runCommand("Save", roiPath);
                                saveComplete[0] = true;
                            } catch (Exception e) {
                            }
                        }
                    });
                    saveThread.start();
                    saveThread.join(5000); // Wait max 5 seconds

                    if (saveComplete[0] && roiFile.exists()) {
                        // print("SUCCESS: ROI set saved (" + roiFile.length() + " bytes)");
                    } else {
                        // print("WARNING: ROI save timed out or failed (ROIs still in memory)");
                        if (saveThread.isAlive()) {
                            saveThread.interrupt();
                        }
                    }
                }
            } catch (Exception e) {
                // print("WARNING: ROI save failed: " + e.getMessage());

            }
        }
    }

    // Close ROI Manager - we have the ROIs stored in config.storedROIs.
    // Delete all entries first so the manager has nothing to offer to save as overlay,
    // which suppresses the "Save as Overlay?" confirmation dialog.
    rm.runCommand("Deselect");
    rm.runCommand("Delete");
    rm.close();

    // If background correction is enabled, let the user pick the BG ROI now that we know them all
    if (config.acqSettings.bgCorrectionEnabled && config.storedROIs.size() > 0) {
        // Build ROI name list (only source ROIs shown for spatial; all ROIs for temporal)
        boolean isSpatialBG = config.acqSettings.processingMode.equals("Spatial");
        int numSourceROIs = isSpatialBG ? config.storedROIs.size() / 2 : config.storedROIs.size();
        String[] roiNames = new String[numSourceROIs];
        for (int i = 0; i < numSourceROIs; i++) {
            roiNames[i] = "ROI" + (i + 1);
        }
        // Show dialog on EDT and block until answered
        final Object[] selectedIdx = {new Integer(0)};
        final Object bgLock = new Object();
        final boolean[] bgDone = {false};
        SwingUtilities.invokeLater(new Runnable() {
            public void run() {
                JComboBox bgCombo = new JComboBox(roiNames);
                bgCombo.setSelectedIndex(config.acqSettings.bgROIIndex < numSourceROIs
                    ? config.acqSettings.bgROIIndex : 0);
                int res = JOptionPane.showConfirmDialog(null,
                    new Object[]{"Select the Background ROI to subtract from all other ROIs:", bgCombo},
                    "Background Correction - Select BG ROI",
                    JOptionPane.OK_CANCEL_OPTION, JOptionPane.QUESTION_MESSAGE);
                if (res == JOptionPane.OK_OPTION) {
                    selectedIdx[0] = new Integer(bgCombo.getSelectedIndex());
                }
                synchronized (bgLock) { bgDone[0] = true; bgLock.notifyAll(); }
            }
        });
        synchronized (bgLock) {
            while (!bgDone[0]) {
                try { bgLock.wait(); } catch (InterruptedException ie) { break; }
            }
        }
        config.acqSettings.bgROIIndex = ((Integer) selectedIdx[0]).intValue();
    }

    return true;
}

    // Export table to CSV with auto-incrementing filename - uses captured data
// Write a supplementary Micro-Manager state snapshot to the experiment folder.
// Lists all config groups with their currently active preset, plus camera device,
// binning, and pixel size.  The file is intentionally NOT reloadable by LUMETRIC.
void saveMicroscopeStateLog() {
    if (config.experimentFolder == null || config.experimentFolder.isEmpty()) return;
    // Screenshot of the MM main window — rendered in memory so it captures the window
    // even if LUMETRIC is on top. Must run on the EDT for printAll() to work correctly.
    try {
        import java.awt.Frame;
        import java.awt.Graphics2D;
        import java.awt.image.BufferedImage;
        import javax.imageio.ImageIO;
        final String expFolderPath = config.experimentFolder;
        SwingUtilities.invokeAndWait(new Runnable() {
            public void run() {
                try {
                    Frame mmFrame = null;
                    Frame[] frames = Frame.getFrames();
                    for (int fi = 0; fi < frames.length; fi++) {
                        String title = frames[fi].getTitle();
                        if (title != null && title.contains("Micro-Manager")
                                && frames[fi].getWidth() > 0 && frames[fi].getHeight() > 0) {
                            mmFrame = frames[fi];
                            break;
                        }
                    }
                    if (mmFrame == null) return;
                    BufferedImage img = new BufferedImage(
                        mmFrame.getWidth(), mmFrame.getHeight(), BufferedImage.TYPE_INT_RGB);
                    Graphics2D g = img.createGraphics();
                    mmFrame.printAll(g);
                    g.dispose();
                    ImageIO.write(img, "png", new File(expFolderPath, "MMState_Screenshot.png"));
                } catch (Exception ex) {}
            }
        });
    } catch (Exception e) {
        // Silent failure
    }
}

boolean exportTableToCSV() {
    // Get save directory from captured settings
    String saveDir = config.acqSettings.saveDirectory;

    if (saveDir.isEmpty() || !new File(saveDir).exists()) {

        return false;
    }

    // Use experiment folder if it exists
    File saveDirFile = config.experimentFolder.isEmpty() ?
        new File(saveDir) : new File(config.experimentFolder);

    // Check write permission before attempting to create files
    if (!saveDirFile.canWrite()) {
        // print("ERROR: No write permission for directory: " + saveDirFile.getAbsolutePath());

        return false;
    }

    File csvFileReadable = config.experimentFolder.isEmpty() ?
        getNextAvailableFile(saveDirFile, "AquisitionSettings", ".csv") :
        new File(saveDirFile, "AquisitionSettings.csv");

    String baseName = csvFileReadable.getName().replace(".csv", "");
    File csvFileArduino = new File(saveDirFile, baseName + "_Arduino.csv");
    // Use the expanded table (with keep-alive / flush rows) when it exists so that
    // the saved CSV exactly mirrors what was uploaded to the Arduino.  Extra columns
    // KeepAlive and OrigRowNum are included for debugging.
    boolean hasExpanded = (config.expandedSequenceRows != null);
    ArrayList tableData = hasExpanded ? config.expandedSequenceRows : config.acqSettings.sequenceRows;

    try {
        // ===== FULL SETTINGS VERSION (loadable via "Load Settings") =====
        writeSettingsToFile(csvFileReadable);

        // ===== ARDUINO VERSION =====
        PrintWriter writerArduino = new PrintWriter(new FileWriter(csvFileArduino));
        String header = "Channel,Exposure [ms],Frame Interval [ms],Frames,Loop Goto,Loop Times,Constant Illum,Loop Switch Goto";
        if (hasExpanded) header += ",KeepAlive,OrigRowNum";
        writerArduino.println(header);
        for (int i = 0; i < tableData.size(); i++) {
            StringBuilder row = new StringBuilder();
            ArrayList rowData = (ArrayList) tableData.get(i);
            for (int j = 1; j < rowData.size(); j++) { // Skip column 0 (Row number)
                String value = rowData.get(j).toString();
                String arduinoValue = value;

                // Convert to Arduino format
                if (j == 1) { // Channel
                    if (value.isEmpty()) {
                        // none channel: 1 if Exposure > 0 (camera only), 0 if Exposure = 0
                        String exposureStr = rowData.get(2).toString();
                        try {
                            int exposure = exposureStr.isEmpty() ? 0 : Integer.parseInt(exposureStr);
                            arduinoValue = exposure > 0 ? "1" : "0";
                        } catch (NumberFormatException e) {
                            arduinoValue = "0";
                        }
                    } else {
                        // Convert channel names to binary sum for Arduino
                        // PIN_1 (Camera) = 1, PIN_2 = 2, PIN_3 = 4, PIN_4 = 8, etc.
                        String[] channels = value.split(",");
                        int binarySum = 1; // Camera (PIN_1) is always on
                        for (String ch : channels) {
                            String channelName = ch.trim();
                            int pinNum = config.getPinForChannel(channelName);
                            if (pinNum != -1) {
                                // Calculate power of 2 for this pin
                                binarySum += (1 << (pinNum - 1));
                            }
                        }
                        arduinoValue = String.valueOf(binarySum);
                    }
                } else if (j == 6) { // Loop Times
                    if (value.isEmpty()) {
                        arduinoValue = "0"; // infinity = 0
                    }
                } else if (j == 7) { // Constant Illum
                    if (value.isEmpty()) {
                        arduinoValue = "0"; // none = 0
                    } else {
                        // Convert constant illum channel names to binary sum for Arduino
                        String[] channels = value.split(",");
                        int binarySum = 0; // No camera base for constant illum
                        for (String ch : channels) {
                            String channelName = ch.trim();
                            int pinNum = config.getPinForChannel(channelName);
                            if (pinNum != -1) {
                                // Calculate power of 2 for this pin
                                binarySum += (1 << (pinNum - 1));
                            }
                        }
                        arduinoValue = String.valueOf(binarySum);
                    }
                } else if (j == 8) { // Loop Switch Goto
                    if (value.isEmpty()) {
                        arduinoValue = "0"; // none = 0
                    }
                }

                row.append(escapeCSV(arduinoValue));
                if (j < rowData.size() - 1) {
                    row.append(",");
                }
            }
            writerArduino.println(row.toString());
        }

        // Write mode settings as comments
        writerArduino.println("");
        writerArduino.println("# Live Pictures: " + config.acqSettings.livePics);
        writerArduino.close();

        // Save supplementary Micro-Manager state snapshot (non-reloadable)
        saveMicroscopeStateLog();

        // print("  Readable: " + csvFileReadable.getAbsolutePath());
        // print("  Arduino:  " + csvFileArduino.getAbsolutePath());
        return true;

    } catch (IOException e) {
        // print("ERROR: Failed to export CSV files: " + e.getMessage());
        e.printStackTrace();
        return false;
    }
}

// Load settings from CSV file
// Core settings loader — reads csvFile and applies it to all GUI widgets.
// No dialogs, no return value; failures are logged to stderr only.
// Safe to call from the EDT (e.g. auto-reload on restart).
void applySettingsFromFile(File csvFile) {
    try {
        BufferedReader reader = new BufferedReader(new FileReader(csvFile));
        String line;
        boolean headerSkipped = false;
        boolean inVisualizationSection = false;
        boolean vizHeaderSkipped = false;
        int vizRowIndex = 0;
        String loadedMode = "Temporal";
        String loadedSplitAxis = "Horizontal";
        String loadedROIRegion = "Upper";
        boolean loadedBtEnabled = false;
        String  loadedBtDirection = "";
        String  loadedBtFactor = "0.0";

        while (tableModel.getRowCount() > 0) {
            tableModel.removeRow(0);
        }

        ArrayList parsedSequenceRows = new ArrayList();

        while ((line = reader.readLine()) != null) {
            line = line.trim();

            if (line.equals("# Visualization Settings")) {
                inVisualizationSection = true;
                processingModeCombo.setSelectedItem(loadedMode);
                if (loadedMode.equals("Spatial")) {
                    splitAxisCombo.setSelectedItem(loadedSplitAxis);
                    roiSourceCombo.setSelectedItem(loadedROIRegion);
                    if (!loadedBtDirection.isEmpty()) {
                        btDirectionCombo.setSelectedItem(loadedBtDirection);
                    }
                    btCorrectionCheckbox.setEnabled(bgCorrectionCheckbox.isSelected());
                    btCorrectionCheckbox.setSelected(loadedBtEnabled && bgCorrectionCheckbox.isSelected());
                    btFactorField.setText(loadedBtFactor);
                }
                continue;
            }

            if (inVisualizationSection) {
                if (!vizHeaderSkipped) {
                    if (line.startsWith("Graph,Type")) { vizHeaderSkipped = true; continue; }
                }
                if (line.isEmpty() || (line.startsWith("#") && !line.equals("# Visualization Settings"))) continue;
                String[] vizParts = parseCSVLine(line);
                if (loadedMode.equals("Temporal")) {
                    if (vizParts.length >= 4 && vizRowIndex < vizTableModel.getRowCount()) {
                        vizTableModel.setValueAt(vizParts[1], vizRowIndex, 1);
                        vizTableModel.setValueAt(vizParts[2], vizRowIndex, 2);
                        vizTableModel.setValueAt(vizParts[3], vizRowIndex, 3);
                        vizRowIndex++;
                    } else if (vizParts.length >= 6 && vizRowIndex < vizTableModel.getRowCount()) {
                        vizTableModel.setValueAt(vizParts[1], vizRowIndex, 1);
                        vizRowIndex++;
                    }
                } else {
                    if (vizParts.length >= 3 && vizRowIndex < vizTableModel.getRowCount()) {
                        vizTableModel.setValueAt(vizParts[1], vizRowIndex, 1);
                        vizTableModel.setValueAt(vizParts[2], vizRowIndex, 2);
                        vizRowIndex++;
                    } else if (vizParts.length >= 2 && vizRowIndex < vizTableModel.getRowCount()) {
                        vizTableModel.setValueAt(vizParts[1], vizRowIndex, 1);
                        vizRowIndex++;
                    }
                }
                continue;
            }

            if (!headerSkipped) { headerSkipped = true; continue; }

            if (line.startsWith("#")) {
                if (line.contains("Simple Snap Mode:")) {
                    simpleSnapMode.setSelected(line.substring(line.indexOf(":") + 1).trim().equalsIgnoreCase("true"));
                } else if (line.contains("Live Pictures:")) {
                    livePics.setSelected(line.substring(line.indexOf(":") + 1).trim().equalsIgnoreCase("true"));
                } else if (line.contains("Convert to Stack:")) {
                    convertToStack.setSelected(line.substring(line.indexOf(":") + 1).trim().equalsIgnoreCase("true"));
                } else if (line.contains("Stack per Row:")) {
                    stackPerRow.setSelected(line.substring(line.indexOf(":") + 1).trim().equalsIgnoreCase("true"));
                } else if (line.contains("Processing Mode:")) {
                    loadedMode = line.substring(line.indexOf(":") + 1).trim();
                } else if (line.contains("Split Axis:")) {
                    loadedSplitAxis = line.substring(line.indexOf(":") + 1).trim();
                } else if (line.contains("ROI Region:")) {
                    loadedROIRegion = line.substring(line.indexOf(":") + 1).trim();
                } else if (line.contains("BG Correction Enabled:")) {
                    bgCorrectionCheckbox.setSelected(line.substring(line.indexOf(":") + 1).trim().equalsIgnoreCase("true"));
                } else if (line.contains("BT Correction Enabled:")) {
                    loadedBtEnabled = line.substring(line.indexOf(":") + 1).trim().equalsIgnoreCase("true");
                } else if (line.contains("BT Direction:")) {
                    loadedBtDirection = line.substring(line.indexOf(":") + 1).trim();
                } else if (line.contains("BT Factor:")) {
                    loadedBtFactor = line.substring(line.indexOf(":") + 1).trim().replace(",", ".");
                }
                continue;
            }

            if (line.isEmpty()) continue;

            String[] parts = parseCSVLine(line);
            if (parts.length < 8) continue;

            String channel       = parts[0].equals("none") ? "" : parts[0];
            String exposure      = parts[1];
            String interval      = parts[2];
            String frames        = parts[3];
            String loopGoto      = parts[4];
            String loopTimes     = parts[5].equals("always") ? "" : parts[5];
            String constantIllum = parts[6].equals("none")   ? "" : parts[6];
            String loopSwitchGoto = parts[7].equals("none")  ? "" : parts[7];

            parsedSequenceRows.add(new Object[]{
                channel, exposure, interval, frames,
                loopGoto, loopTimes, constantIllum, loopSwitchGoto
            });
        }
        reader.close();

        for (int i = 0; i < parsedSequenceRows.size(); i++) {
            tableModel.addRow((Object[]) parsedSequenceRows.get(i));
        }
        for (int i = 0; i < parsedSequenceRows.size(); i++) {
            String loopGoto = (String) ((Object[]) parsedSequenceRows.get(i))[4];
            tableModel.setValueAt(loopGoto, i, 5);
        }
    } catch (Exception e) {
        e.printStackTrace();
    }
}

// Release the open file handle that blocks folder renaming during acquisition.
void releaseExperimentFolderLock() {
    if (acqFolderLock != null) {
        try {
            acqFolderLock.close();
        } catch (Exception e) {
            // Ignore — OS will release it on JVM exit anyway
        }
        acqFolderLock = null;
        // Clean up the sentinel file (best-effort)
        if (config.experimentFolder != null && !config.experimentFolder.isEmpty()) {
            new File(config.experimentFolder, ".lumetric-lock").delete();
        }
    }
}

// Reset all acquisition state and re-show the main GUI with last settings restored.
// Called after every acquisition completes.  Replacing config drops all references
// to expandedSequenceRows, storedROIs, and acqSettings so the GC can reclaim them
// before the next experiment starts filling the heap.
void restartMainGUI(String experimentFolder) {
    // 0. Release folder lock first — must happen before config is wiped
    releaseExperimentFolderLock();

    // 1. Persist the experiment folder path before wiping config
    if (experimentFolder != null && !experimentFolder.isEmpty()) {
        prefs.put("lastExperimentFolder", experimentFolder);
    }

    // 2. Drop all acquisition data — allows GC to reclaim large objects
    config = new MicroscopeConfig();
    frameCache = new HashMap();
    Runtime.getRuntime().gc();

    // 3. Restore hardware configuration (camera groups, channels, serial port)
    String lastCfgPath = prefs.get("lastConfigPath", "");
    if (!lastCfgPath.isEmpty() && new File(lastCfgPath).exists()) {
        config.loadFromFile(lastCfgPath);
        updateSettingsDisplay();
    }

    // 4. Reload acquisition + visualization settings from last experiment.
    // Use the parameter directly (prefs write above is only for crash-recovery at startup).
    if (experimentFolder != null && !experimentFolder.isEmpty()) {
        File settingsFile = new File(experimentFolder, "AquisitionSettings.csv");
        if (settingsFile.exists()) {
            applySettingsFromFile(settingsFile);
        }
    }

    if (experimentNameField != null) experimentNameField.setText("");
    frame.setVisible(true);
}

void loadSettingsFromCSV() {
    JFileChooser fileChooser = new JFileChooser();
    fileChooser.setDialogTitle("Load Acquisition Settings from CSV");
    fileChooser.setFileSelectionMode(JFileChooser.FILES_ONLY);

    String lastPath = prefs.get("lastSavePath", "");
    if (!lastPath.isEmpty() && new File(lastPath).exists()) {
        fileChooser.setCurrentDirectory(new File(lastPath));
    } else {
        File dataFolder = new File(new File("").getAbsolutePath(), "Data");
        if (dataFolder.exists()) fileChooser.setCurrentDirectory(dataFolder);
    }

    int result = fileChooser.showOpenDialog(frame);
    if (result != JFileChooser.APPROVE_OPTION) return;

    File csvFile = fileChooser.getSelectedFile();
    applySettingsFromFile(csvFile);

    JOptionPane.showMessageDialog(frame,
        "Loaded " + tableModel.getRowCount() + " sequence steps from:\n" + csvFile.getName(),
        "Settings Loaded", JOptionPane.INFORMATION_MESSAGE);
}

// Parse a CSV line, handling quoted fields
String[] parseCSVLine(String line) {
    ArrayList fields = new ArrayList();
    StringBuilder currentField = new StringBuilder();
    boolean inQuotes = false;

    for (int i = 0; i < line.length(); i++) {
        char c = line.charAt(i);

        if (c == '"') {
            inQuotes = !inQuotes;
        } else if (c == ',' && !inQuotes) {
            fields.add(currentField.toString());
            currentField = new StringBuilder();
        } else {
            currentField.append(c);
        }
    }
    fields.add(currentField.toString()); // Add last field

    // Convert ArrayList to String array
    String[] result = new String[fields.size()];
    for (int i = 0; i < fields.size(); i++) {
        result[i] = (String) fields.get(i);
    }
    return result;
}

// Save current settings to CSV file
// Write the full settings file (sequence rows + all GUI state) to the given file.
// Called both from the Save Settings button and automatically at acquisition start.
void writeSettingsToFile(File csvFile) {
    try {
        PrintWriter writer = new PrintWriter(new FileWriter(csvFile));

        // Write sequence settings header
        writer.println("Channel,Exposure [ms],Frame Interval [ms],Frames,Loop Goto,Loop Times,Constant Illum,Loop Switch Goto");

        // Write sequence data
        for (int i = 0; i < tableModel.getRowCount(); i++) {
            StringBuilder row = new StringBuilder();
            for (int j = 1; j < tableModel.getColumnCount(); j++) { // Skip column 0 (Row number)
                Object value = tableModel.getValueAt(i, j);
                String valueStr = value != null ? value.toString() : "";

                if (j == 1 && valueStr.isEmpty()) { valueStr = "none"; }
                else if (j == 6 && valueStr.isEmpty()) { valueStr = "always"; }
                else if (j == 7 && valueStr.isEmpty()) { valueStr = "none"; }
                else if (j == 8 && valueStr.isEmpty()) { valueStr = "none"; }

                row.append(escapeCSV(valueStr));
                if (j < tableModel.getColumnCount() - 1) row.append(",");
            }
            writer.println(row.toString());
        }

        // Mode settings
        writer.println("");
        writer.println("# Simple Snap Mode: " + simpleSnapMode.isSelected());
        writer.println("# Live Pictures: " + livePics.isSelected());
        writer.println("# Convert to Stack: " + convertToStack.isSelected());
        writer.println("# Stack per Row: " + stackPerRow.isSelected());

        String currentMode = (String) processingModeCombo.getSelectedItem();
        writer.println("# Processing Mode: " + currentMode);
        if (currentMode.equals("Spatial")) {
            writer.println("# Split Axis: " + splitAxisCombo.getSelectedItem());
            writer.println("# ROI Region: " + roiSourceCombo.getSelectedItem());
        }

        // BG / BT correction settings (must be before # Visualization Settings so the
        // loader can read them as header comments before entering the viz section)
        writer.println("# BG Correction Enabled: " + bgCorrectionCheckbox.isSelected());
        writer.println("# BT Correction Enabled: " + btCorrectionCheckbox.isSelected());
        writer.println("# BT Direction: " + btDirectionCombo.getSelectedItem());
        writer.println("# BT Factor: " + btFactorField.getText().trim().replace(",", "."));

        // Visualization settings
        writer.println("");
        writer.println("# Visualization Settings");
        if (currentMode.equals("Temporal")) {
            writer.println("Graph,Type,Numerator,Denominator");
            for (int i = 0; i < vizTableModel.getRowCount(); i++) {
                StringBuilder vizRow = new StringBuilder();
                vizRow.append(escapeCSV(vizTableModel.getValueAt(i, 0).toString()));
                vizRow.append(",");
                vizRow.append(escapeCSV(vizTableModel.getValueAt(i, 1).toString()));
                vizRow.append(",");
                vizRow.append(escapeCSV(vizTableModel.getValueAt(i, 2).toString()));
                vizRow.append(",");
                vizRow.append(escapeCSV(vizTableModel.getValueAt(i, 3).toString()));
                writer.println(vizRow.toString());
            }
        } else {
            writer.println("Graph,Type,Row Filter");
            for (int i = 0; i < vizTableModel.getRowCount(); i++) {
                StringBuilder vizRow = new StringBuilder();
                vizRow.append(escapeCSV(vizTableModel.getValueAt(i, 0).toString()));
                vizRow.append(",");
                vizRow.append(escapeCSV(vizTableModel.getValueAt(i, 1).toString()));
                vizRow.append(",");
                vizRow.append(escapeCSV(vizTableModel.getValueAt(i, 2).toString()));
                writer.println(vizRow.toString());
            }
        }

        writer.close();
    } catch (Exception e) {
        e.printStackTrace();
    }
}

void saveSettingsToCSV() {
    // Commit any active cell edit before reading from the model
    if (table.isEditing()) {
        javax.swing.table.TableCellEditor editor = table.getCellEditor();
        if (editor != null) editor.stopCellEditing();
    }
    if (vizTable.isEditing()) {
        javax.swing.table.TableCellEditor editor = vizTable.getCellEditor();
        if (editor != null) editor.stopCellEditing();
    }

    JFileChooser fileChooser = new JFileChooser();
    fileChooser.setDialogTitle("Save Acquisition Settings to CSV");
    fileChooser.setFileSelectionMode(JFileChooser.FILES_ONLY);

    String lastPath = prefs.get("lastSavePath", "");
    if (!lastPath.isEmpty() && new File(lastPath).exists()) {
        fileChooser.setCurrentDirectory(new File(lastPath));
    } else {
        File dataFolder = new File(new File("").getAbsolutePath(), "Data");
        if (dataFolder.exists()) fileChooser.setCurrentDirectory(dataFolder);
    }

    fileChooser.setSelectedFile(new File("Settings.csv"));

    int result = fileChooser.showSaveDialog(frame);
    if (result != JFileChooser.APPROVE_OPTION) return;

    File csvFile = fileChooser.getSelectedFile();
    if (!csvFile.getName().toLowerCase().endsWith(".csv")) {
        csvFile = new File(csvFile.getAbsolutePath() + ".csv");
    }

    writeSettingsToFile(csvFile);

    JOptionPane.showMessageDialog(frame,
        "Settings saved successfully to:\n" + csvFile.getName(),
        "Settings Saved", JOptionPane.INFORMATION_MESSAGE);
}

// ==================== Acquisition Control Window ====================

// Create acquisition control window inline (called from EDT)
void createInlineAcquisitionWindow() {
    // print("DEBUG: createInlineAcquisitionWindow() called");
    // All imports moved to top of file to avoid BeanShell loading issues

    JFrame acqFrame = new JFrame("LUMETRIC - Acquisition Control");

    acqFrame.setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);

    // Adaptive sizing: use 90% of screen width and 65% of screen height (landscape ratio
    // minimises gray letterbox bars in the live view for typical 16:9 / 4:3 cameras)
    java.awt.Dimension screenSize = java.awt.Toolkit.getDefaultToolkit().getScreenSize();
    int width = (int)(screenSize.width * 0.90);
    int height = (int)(screenSize.height * 0.65);
    acqFrame.setSize(width, height);

    // Center window on screen
    acqFrame.setLocationRelativeTo(null);

    acqFrame.setLayout(new BorderLayout());

    // Global event tracking
    final long[] acquisitionStartTime = new long[1];
    acquisitionStartTime[0] = System.currentTimeMillis();

    // Count active graphs and check for live pics
    int activeGraphs = 0;
    for (int i = 0; i < 4; i++) {
        ArrayList vizRow = (ArrayList) config.acqSettings.visualizationRows.get(i);
        String graphType = (String) vizRow.get(1);
        if (!graphType.equals("none")) {
            activeGraphs++;
        }
    }
    boolean hasLiveView = config.acqSettings.livePics;


    // ===== TOP BUTTON PANEL =====
    JPanel topPanel = new JPanel(new BorderLayout());
    topPanel.setBorder(BorderFactory.createEmptyBorder(5, 10, 5, 10));

    // Left side buttons (Event, Loop Switch)
    JPanel leftButtonPanel = new JPanel(new FlowLayout(FlowLayout.LEFT, 5, 0));

    final JButton eventButton = new JButton("Event");
    eventButton.setFont(new Font("SansSerif", Font.BOLD, 11));
    eventButton.setBackground(new Color(100, 180, 100));
    eventButton.setPreferredSize(new java.awt.Dimension(130, 28));

    JButton loopSwitchButton = new JButton("Loop Switch");
    loopSwitchButton.setFont(new Font("SansSerif", Font.BOLD, 11));
    loopSwitchButton.setBackground(new Color(100, 150, 255));
    loopSwitchButton.setPreferredSize(new java.awt.Dimension(130, 28));
    loopSwitchButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            // Send byte 67 to Arduino to trigger loop-switch during acquisition
            try {
                mmcorej.CharVector cv67 = new mmcorej.CharVector();
                cv67.add((char)67);
                mmc.writeToSerialPort(config.serialPort, cv67);
            } catch (Exception ardEx) {
                // print("Arduino loop-switch error: " + ardEx.getMessage());
            }
        }
    });

    JButton resetAllButton = new JButton("Rescale All Axes");
    resetAllButton.setFont(new Font("SansSerif", Font.BOLD, 11));
    resetAllButton.setBackground(new Color(200, 200, 200));
    resetAllButton.setPreferredSize(new java.awt.Dimension(130, 28));
    resetAllButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            for (int i = 0; i < chartPanels.size(); i++) {
                ChartPanel panel = (ChartPanel) chartPanels.get(i);
                if (panel != null) {
                    panel.restoreAutoBounds();
                }
            }

        }
    });

    JButton resetXButton = new JButton("Rescale X-Axis");
    resetXButton.setFont(new Font("SansSerif", Font.BOLD, 11));
    resetXButton.setBackground(new Color(200, 200, 200));
    resetXButton.setPreferredSize(new java.awt.Dimension(130, 28));
    resetXButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            for (int i = 0; i < chartPanels.size(); i++) {
                ChartPanel panel = (ChartPanel) chartPanels.get(i);
                if (panel != null) {
                    panel.restoreAutoDomainBounds();
                }
            }

        }
    });

    leftButtonPanel.add(eventButton);
    leftButtonPanel.add(Box.createHorizontalStrut(3));
    leftButtonPanel.add(loopSwitchButton);
    leftButtonPanel.add(Box.createHorizontalStrut(15));
    leftButtonPanel.add(resetAllButton);
    leftButtonPanel.add(Box.createHorizontalStrut(3));
    leftButtonPanel.add(resetXButton);

    // Right side button (Quit Acquisition)
    JPanel rightButtonPanel = new JPanel(new FlowLayout(FlowLayout.RIGHT, 5, 0));

    JButton quitButton = new JButton("Quit Acquisition");
    quitButton.setFont(new Font("SansSerif", Font.BOLD, 11));
    quitButton.setBackground(Color.RED);
    quitButton.setForeground(Color.BLACK);
    quitButton.setPreferredSize(new java.awt.Dimension(130, 28));
    quitButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            int confirm = JOptionPane.showConfirmDialog(acqFrame,
                "Are you sure you want to quit the acquisition?",
                "Confirm Quit",
                JOptionPane.YES_NO_OPTION,
                JOptionPane.WARNING_MESSAGE);
            if (confirm == JOptionPane.YES_OPTION) {

                acqFrame.dispose();
                // TODO: Clean up acquisition resources
            }
        }
    });

    rightButtonPanel.add(quitButton);

    topPanel.add(leftButtonPanel, BorderLayout.WEST);
    topPanel.add(rightButtonPanel, BorderLayout.EAST);

    // Frame counter (center)
    final JLabel frameCounterLabel = new JLabel("Frames: 0");
    frameCounterLabel.setFont(new Font("SansSerif", Font.BOLD, 13));
    JPanel centerButtonPanel = new JPanel(new FlowLayout(FlowLayout.CENTER, 5, 0));
    centerButtonPanel.add(frameCounterLabel);
    topPanel.add(centerButtonPanel, BorderLayout.CENTER);

    // ===== MAIN CONTENT: ADAPTIVE LAYOUT =====
    JPanel mainPanel = new JPanel();

    // Create charts and collect active ones
    final ArrayList charts = new ArrayList();
    final ArrayList chartPlots = new ArrayList();
    final ArrayList chartPanels = new ArrayList(); // Store chart panels for zoom reset
    final ArrayList datasets = new ArrayList();
    boolean isTemporal = config.acqSettings.processingMode.equals("Temporal");

    // Apply default full-image ROIs now (before graph series are created)
    // so numSeries is correct even when the user hasn't drawn any ROIs.
    if (config.storedROIs == null || config.storedROIs.isEmpty()) {
        createDefaultROIs();
    }

    for (int i = 0; i < 4; i++) {
        ArrayList vizRow = (ArrayList) config.acqSettings.visualizationRows.get(i);
        String graphName = "Graph " + (i + 1);
        String graphType = (String) vizRow.get(1);

        if (graphType.equals("none")) {
            charts.add(null);
            chartPlots.add(null);
            datasets.add(null);
            chartPanels.add(null); // Keep arrays synchronized
            continue;
        }

        // Build frame logic string for chart title
        String frameLogic = computeFrameLogicLabel(vizRow, config.acqSettings.processingMode.equals("Temporal"));

        // Create dataset with multiple series (one per ROI)
        XYSeriesCollection dataset = new XYSeriesCollection();

        // Determine number of series and naming based on graph type
        int numSeries;
        String seriesPrefix;

        if (graphType.startsWith("Split ratio")) {
            // Spatial mode: N ratios (one per ROI pair, which is storedROIs / 2)
            int totalROIs = config.storedROIs != null ? config.storedROIs.size() : 0;
            numSeries = totalROIs / 2;  // Half are source, half are mirrored
            seriesPrefix = "Ratio";
        } else if (graphType.startsWith("Intensity ") && !isTemporal) {
            // Spatial mode Intensity: only source ROIs (first half)
            int totalROIs = config.storedROIs != null ? config.storedROIs.size() : 0;
            numSeries = totalROIs / 2;  // Only source ROIs
            seriesPrefix = "ROI";
        } else {
            // Temporal mode or standard intensity: series for each ROI
            numSeries = config.storedROIs != null ? config.storedROIs.size() : 0;
            seriesPrefix = "ROI";
        }

        // Add series
        for (int seriesIdx = 0; seriesIdx < numSeries; seriesIdx++) {
            XYSeries series = new XYSeries(seriesPrefix + (seriesIdx + 1));
            dataset.addSeries(series);
        }
        datasets.add(dataset);

        // Create chart with frame logic in title
        String yAxisLabel = graphType.equals("Intensity") || graphType.startsWith("Intensity ") ? "Intensity [A.U.]" :
                           graphType.startsWith("Split ratio") ? "Split Ratio" :
                           graphType.startsWith("Ratio ") ? "Ratio" : "Value";

        String chartTitle = graphName + " - " + graphType;
        if (!frameLogic.isEmpty()) {
            chartTitle += " (" + frameLogic + ")";
        }

        JFreeChart chart = ChartFactory.createXYLineChart(
            chartTitle,
            "Time (s)",
            yAxisLabel,
            dataset,
            PlotOrientation.VERTICAL,
            true, false, false  // Enable legend
        );

        // Customize appearance
        chart.setBackgroundPaint(Color.WHITE);
        chart.getTitle().setFont(new Font("SansSerif", Font.BOLD, 11)); // Smaller title
        XYPlot plot = chart.getXYPlot();
        plot.setBackgroundPaint(Color.LIGHT_GRAY);
        plot.setDomainGridlinePaint(Color.WHITE);
        plot.setRangeGridlinePaint(Color.WHITE);

        // Configure axes with initial range and auto-range expansion
        org.jfree.chart.axis.NumberAxis domainAxis = (org.jfree.chart.axis.NumberAxis) plot.getDomainAxis();
        org.jfree.chart.axis.NumberAxis rangeAxis = (org.jfree.chart.axis.NumberAxis) plot.getRangeAxis();

        // Set initial visible range (will expand as data comes in)
        domainAxis.setAutoRangeIncludesZero(false);
        domainAxis.setAutoRange(true);
        domainAxis.setAutoRangeMinimumSize(1.0);  // At least 1 second visible

        rangeAxis.setAutoRangeIncludesZero(false);
        rangeAxis.setAutoRange(true);
        rangeAxis.setAutoRangeMinimumSize(0.1);  // Minimum range for Y axis


        // Configure renderer - enable lines and make them thicker
        org.jfree.chart.renderer.xy.XYItemRenderer renderer = plot.getRenderer();

        // Check if it's the expected type before casting
        if (renderer instanceof org.jfree.chart.renderer.xy.XYLineAndShapeRenderer) {
            org.jfree.chart.renderer.xy.XYLineAndShapeRenderer lineRenderer = (org.jfree.chart.renderer.xy.XYLineAndShapeRenderer) renderer;
            lineRenderer.setDefaultLinesVisible(true);  // Enable lines by default
            lineRenderer.setDefaultShapesVisible(false);  // Disable shapes by default (cleaner look)

            for (int seriesIdx = 0; seriesIdx < numSeries; seriesIdx++) {
                lineRenderer.setSeriesLinesVisible(seriesIdx, Boolean.TRUE);  // Explicitly enable lines for each series
                lineRenderer.setSeriesShapesVisible(seriesIdx, Boolean.FALSE);  // Disable shapes for each series
                lineRenderer.setSeriesStroke(seriesIdx, new BasicStroke(2.0f));  // Thicker lines
            }
        } else {
            // Fallback: just set stroke width on base renderer
            // print("WARNING: Renderer is " + renderer.getClass().getName() + ", not XYLineAndShapeRenderer");
            for (int seriesIdx = 0; seriesIdx < numSeries; seriesIdx++) {
                renderer.setSeriesStroke(seriesIdx, new BasicStroke(2.0f));
            }
        }


        // Create chart panel and store it
        ChartPanel chartPanel = new ChartPanel(chart);
        chartPanel.setMouseWheelEnabled(true);
        chartPanel.setDoubleBuffered(true);
        chartPanel.setOpaque(true);
        chartPanel.setRefreshBuffer(true);


        charts.add(chart);
        chartPlots.add(plot);
        chartPanels.add(chartPanel); // Store for repaint access
    }


    // Event button - adds vertical line markers to all active graphs
    eventButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            long systemTime = System.currentTimeMillis();
            long currentTime = systemTime - acquisitionStartTime[0];
            print("EVENT PRESSED: systemTime=" + systemTime + ", acquisitionStartTime[0]=" + acquisitionStartTime[0] + ", offset=" + currentTime + " ms");

            // Store event time
            eventTimes.add(new Long(currentTime));

            // Add vertical line marker to all active graphs
            for (int i = 0; i < chartPlots.size(); i++) {
                XYPlot plot = (XYPlot) chartPlots.get(i);
                if (plot != null) {
                    ValueMarker marker = new ValueMarker(currentTime / 1000.0); // Convert ms to seconds
                    marker.setPaint(Color.RED);
                    marker.setStroke(new BasicStroke(2.0f));
                    plot.addDomainMarker(marker);

                    // Repaint the chart panel to make marker immediately visible
                    if (i < chartPanels.size() && chartPanels.get(i) != null) {
                        ChartPanel cp = (ChartPanel) chartPanels.get(i);
                        cp.repaint();
                    }
                }
            }
        }
    });

    // ADAPTIVE LAYOUT STRATEGY
    if (!hasLiveView && activeGraphs == 1) {
        // CASE 1: Single graph, no live view - ONE BIG WINDOW
        mainPanel.setLayout(new BorderLayout());
        for (int i = 0; i < chartPanels.size(); i++) {
            if (chartPanels.get(i) != null) {
                mainPanel.add((ChartPanel) chartPanels.get(i), BorderLayout.CENTER);
                break;
            }
        }

    } else if (hasLiveView && activeGraphs <= 2) {
        // CASE 2: Live view + up to 2 graphs - SPLIT: Big live, small graphs
        javax.swing.JSplitPane splitPane = new javax.swing.JSplitPane(
            javax.swing.JSplitPane.HORIZONTAL_SPLIT);
        splitPane.setResizeWeight(0.7);

        // Live view (left, large) - create panel that will hold ImageCanvas
        final JPanel liveViewPanel = new JPanel(new BorderLayout());
        liveViewPanel.setBorder(BorderFactory.createTitledBorder("Live View"));
        liveViewPanel.setBackground(Color.BLACK);
        JLabel liveLabel = new JLabel("Waiting for first frame...", SwingConstants.CENTER);
        liveLabel.setForeground(Color.LIGHT_GRAY);
        liveViewPanel.add(liveLabel, BorderLayout.CENTER);

        // Graphs (right, small, stacked with resizable dividers)
        ArrayList activeChartPanels = new ArrayList();
        for (int i = 0; i < chartPanels.size(); i++) {
            if (chartPanels.get(i) != null) {
                activeChartPanels.add(chartPanels.get(i));
            }
        }

        // Create nested split panes for resizable graphs
        JComponent graphsPanel = null;
        if (activeChartPanels.size() == 1) {
            graphsPanel = (ChartPanel) activeChartPanels.get(0);
        } else if (activeChartPanels.size() == 2) {
            javax.swing.JSplitPane graphSplit = new javax.swing.JSplitPane(
                javax.swing.JSplitPane.VERTICAL_SPLIT,
                (ChartPanel) activeChartPanels.get(0),
                (ChartPanel) activeChartPanels.get(1));
            graphSplit.setResizeWeight(0.5);
            graphsPanel = graphSplit;
        }

        liveViewPanel.setMinimumSize(new java.awt.Dimension(0, 0));
        graphsPanel.setMinimumSize(new java.awt.Dimension(0, 0));
        splitPane.setLeftComponent(liveViewPanel);
        splitPane.setRightComponent(graphsPanel);
        mainPanel.setLayout(new BorderLayout());
        mainPanel.add(splitPane, BorderLayout.CENTER);

    } else if (!hasLiveView && activeGraphs == 3) {
        // CASE 3: 3 graphs, no live - First big, two small
        javax.swing.JSplitPane splitPane = new javax.swing.JSplitPane(
            javax.swing.JSplitPane.HORIZONTAL_SPLIT);
        splitPane.setResizeWeight(0.6);

        // Find first active graph (big)
        ChartPanel firstChart = null;
        ArrayList smallCharts = new ArrayList();

        for (int i = 0; i < chartPanels.size(); i++) {
            if (chartPanels.get(i) != null) {
                if (firstChart == null) {
                    firstChart = (ChartPanel) chartPanels.get(i);
                } else {
                    smallCharts.add(chartPanels.get(i));
                    if (smallCharts.size() >= 2) break;
                }
            }
        }

        // Create split pane for the two small graphs
        javax.swing.JSplitPane smallGraphsSplit = new javax.swing.JSplitPane(
            javax.swing.JSplitPane.VERTICAL_SPLIT,
            (ChartPanel) smallCharts.get(0),
            (ChartPanel) smallCharts.get(1));
        smallGraphsSplit.setResizeWeight(0.5);
        firstChart.setMinimumSize(new java.awt.Dimension(0, 0));
        smallGraphsSplit.setMinimumSize(new java.awt.Dimension(0, 0));
        ((ChartPanel) smallCharts.get(0)).setMinimumSize(new java.awt.Dimension(0, 0));
        ((ChartPanel) smallCharts.get(1)).setMinimumSize(new java.awt.Dimension(0, 0));

        splitPane.setLeftComponent(firstChart);
        splitPane.setRightComponent(smallGraphsSplit);
        mainPanel.setLayout(new BorderLayout());
        mainPanel.add(splitPane, BorderLayout.CENTER);

    } else {
        // DEFAULT: Split pane with live view (if enabled) and all graphs
        javax.swing.JSplitPane splitPane = new javax.swing.JSplitPane(
            javax.swing.JSplitPane.HORIZONTAL_SPLIT);

        if (hasLiveView) {
            splitPane.setResizeWeight(0.6);

            final JPanel liveViewPanel = new JPanel(new BorderLayout());
            liveViewPanel.setBorder(BorderFactory.createTitledBorder("Live View"));
            liveViewPanel.setBackground(Color.BLACK);
            JLabel liveLabel = new JLabel("Waiting for first frame...", SwingConstants.CENTER);
            liveLabel.setForeground(Color.LIGHT_GRAY);
            liveViewPanel.add(liveLabel, BorderLayout.CENTER);
            splitPane.setLeftComponent(liveViewPanel);
        } else {
            splitPane.setResizeWeight(1.0);
        }

        // All graphs stacked with resizable dividers
        ArrayList activeChartPanels = new ArrayList();
        for (int i = 0; i < chartPanels.size(); i++) {
            if (chartPanels.get(i) != null) {
                activeChartPanels.add(chartPanels.get(i));
            }
        }
        // All graphs stacked with resizable dividers
        ArrayList activeChartPanels = new ArrayList();
        for (int i = 0; i < chartPanels.size(); i++) {
            if (chartPanels.get(i) != null) {
                activeChartPanels.add(chartPanels.get(i));
            }
        }

        // Create nested split panes for resizable graphs
        JComponent graphsPanel = null;
        if (activeChartPanels.size() == 1) {
            graphsPanel = (ChartPanel) activeChartPanels.get(0);
        } else if (activeChartPanels.size() == 2) {
            javax.swing.JSplitPane graphSplit = new javax.swing.JSplitPane(
                javax.swing.JSplitPane.VERTICAL_SPLIT,
                (ChartPanel) activeChartPanels.get(0),
                (ChartPanel) activeChartPanels.get(1));
            graphSplit.setResizeWeight(0.5);
            graphsPanel = graphSplit;
        } else if (activeChartPanels.size() == 3) {
            javax.swing.JSplitPane topSplit = new javax.swing.JSplitPane(
                javax.swing.JSplitPane.VERTICAL_SPLIT,
                (ChartPanel) activeChartPanels.get(0),
                (ChartPanel) activeChartPanels.get(1));
            topSplit.setResizeWeight(0.33);
            javax.swing.JSplitPane mainSplit = new javax.swing.JSplitPane(
                javax.swing.JSplitPane.VERTICAL_SPLIT,
                topSplit,
                (ChartPanel) activeChartPanels.get(2));
            mainSplit.setResizeWeight(0.66);
            graphsPanel = mainSplit;
        } else if (activeChartPanels.size() == 4) {
            javax.swing.JSplitPane topSplit = new javax.swing.JSplitPane(
                javax.swing.JSplitPane.VERTICAL_SPLIT,
                (ChartPanel) activeChartPanels.get(0),
                (ChartPanel) activeChartPanels.get(1));
            topSplit.setResizeWeight(0.5);
            javax.swing.JSplitPane bottomSplit = new javax.swing.JSplitPane(
                javax.swing.JSplitPane.VERTICAL_SPLIT,
                (ChartPanel) activeChartPanels.get(2),
                (ChartPanel) activeChartPanels.get(3));
            bottomSplit.setResizeWeight(0.5);
            javax.swing.JSplitPane mainSplit = new javax.swing.JSplitPane(
                javax.swing.JSplitPane.VERTICAL_SPLIT,
                topSplit,
                bottomSplit);
            mainSplit.setResizeWeight(0.5);
            graphsPanel = mainSplit;
        }

        if (hasLiveView) {
            splitPane.getLeftComponent().setMinimumSize(new java.awt.Dimension(0, 0));
            graphsPanel.setMinimumSize(new java.awt.Dimension(0, 0));
            splitPane.setRightComponent(graphsPanel);
        } else {
            splitPane.setLeftComponent(graphsPanel);
        }

        mainPanel.setLayout(new BorderLayout());
        mainPanel.add(splitPane, BorderLayout.CENTER);
    }

    // Assemble frame
    acqFrame.add(topPanel, BorderLayout.NORTH);
    acqFrame.add(mainPanel, BorderLayout.CENTER);

    // Store live view panel reference
    final JPanel[] liveViewPanelRef = new JPanel[1];
    // Find and store the liveViewPanel from the layout
    Component[] components = mainPanel.getComponents();
    for (Component comp : components) {
        if (comp instanceof javax.swing.JSplitPane) {
            javax.swing.JSplitPane sp = (javax.swing.JSplitPane) comp;
            Component left = sp.getLeftComponent();
            if (left instanceof JPanel) {
                JPanel panel = (JPanel) left;
                if (panel.getBorder() instanceof javax.swing.border.TitledBorder) {
                    javax.swing.border.TitledBorder border = (javax.swing.border.TitledBorder) panel.getBorder();
                    if (border.getTitle().equals("Live View")) {
                        liveViewPanelRef[0] = panel;
                        break;
                    }
                }
            }
        }
    }

    // ===== SEND ACQUISITION TABLE (CASE 60) + START COMMAND (CASE 61) TO ARDUINO =====
    // Only used in circular buffer mode:
    //   - Circular buffer: camera is put into hardware-trigger mode inside runCircularBufferAcquisition;
    //     Arduino controls LED timing and camera TTL; BeanShell reads from the image buffer.
    //   - Simple snap mode: BeanShell does software snaps; camera must stay in snap mode;
    //     no Arduino TTL synchronization possible via CAM_FEEDBACK_PIN — do NOT set trigger mode here.
    boolean useCircularBufferMode = config.useCircularBuffer && !config.useSimpleSnapMode;
    if (useCircularBufferMode) {
    try {
        // expandPauseRows() was already called in the background thread before
        // exportTableToCSV(), so config.expandedSequenceRows is already set.
        ArrayList tableData = config.expandedSequenceRows;
        int nRows = tableData.size();
        // Firmware limit is MAX_ACQ_ROWS = 32. Exceeding it causes the Arduino to reject
        // the table header but leave the row bytes in the RX buffer, corrupting the stream.
        if (nRows > 32) {
            JOptionPane.showMessageDialog(acqFrame,
                "Acquisition table has " + nRows + " rows, but the Arduino firmware\n" +
                "supports a maximum of 32 rows. Only the first 32 rows will be sent.",
                "Table Truncated", JOptionPane.WARNING_MESSAGE);
            nRows = 32;
        }
        if (nRows == 0) throw new Exception("Acquisition table is empty.");
        mmcorej.CharVector cv60 = new mmcorej.CharVector();

        // encodeU16: add val as exactly 2 bytes to cv, using sentinel hi-byte
        // values to avoid sending 40 (MM keep-alive) anywhere on the wire.
        // Values are capped at 60000 (max real hi = 234 = 0xEA, so sentinels
        // 235-239 are permanently free and never equal 40).
        //
        //  Condition              sent bytes   Arduino decodes as
        //  ---------------------- ------------ --------------------
        //  normal (no 40/251)     [hi][lo]     (hi<<8)|lo
        //  hi==40, lo normal      [235][lo]    (40<<8)|lo
        //  lo==40,  hi normal     [236][hi]    (hi<<8)|40
        //  lo==251, hi normal     [237][hi]    (hi<<8)|251
        //  hi==40,  lo==40        [238][0]     (40<<8)|40
        //  hi==40,  lo==251       [239][0]     (40<<8)|251
        //
        // Single-byte fields (pinPattern, loopGoto, constIllum, lsGoto) always
        // have hi=0 (value <= 255), so only the lo-encoding cases ever apply.
        // All fields — single-byte and uint16 — use this same function.
        encodeU16(mmcorej.CharVector cv, int val) {
            int hi = (val >> 8) & 0xFF;
            int lo =  val       & 0xFF;
            if      (hi != 40 && lo != 40 && lo != 251) { cv.add((char)hi);  cv.add((char)lo); }
            else if (hi == 40 && lo != 40 && lo != 251) { cv.add((char)235); cv.add((char)lo); }
            else if (hi != 40 && lo == 40)               { cv.add((char)236); cv.add((char)hi); }
            else if (hi != 40 && lo == 251)              { cv.add((char)237); cv.add((char)hi); }
            else if (hi == 40 && lo == 40)               { cv.add((char)238); cv.add((char)0);  }
            else                                          { cv.add((char)239); cv.add((char)0);  } // hi==40, lo==251
        }

        cv60.add((char)60);    // command byte (value 60, never 40 — no encoding needed)
        cv60.add((char)nRows); // row count (single byte; max rows well below 40 in practice)
        for (int ri = 0; ri < nRows; ri++) {
            ArrayList row = (ArrayList) tableData.get(ri);

            // --- pinPattern (uint8, sent as uint16 with hi=0) ---
            int pinPattern = 0;
            String channelVal = row.get(1).toString().trim();
            if (channelVal.isEmpty()) {
                String expStr = row.get(2).toString().trim();
                int expCheck = 0;
                try { expCheck = Integer.parseInt(expStr); } catch (Exception e2) {}
                pinPattern = expCheck > 0 ? 1 : 0;
            } else {
                pinPattern = 1; // bit0 = camera TTL always on
                String[] channels = channelVal.split(",");
                for (String ch : channels) {
                    int pinNum = config.getPinForChannel(ch.trim());
                    if (pinNum != -1) pinPattern |= (1 << (pinNum - 1));
                }
            }
            encodeU16(cv60, pinPattern);

            // --- exposureMs (uint16, capped at 60000 ms) ---
            int expMs = 0;
            try { expMs = Integer.parseInt(row.get(2).toString().trim()); } catch (Exception e2) {}
            expMs = Math.min(expMs, 60000);
            encodeU16(cv60, expMs);

            // --- intervalMs (uint16, capped at 60000 ms) ---
            int intMs = 0;
            try { intMs = Integer.parseInt(row.get(3).toString().trim()); } catch (Exception e2) {}
            intMs = Math.min(intMs, 60000);
            encodeU16(cv60, intMs);

            // --- frames (uint16, capped at 60000; 0 = run until switch/quit) ---
            int frames = 0;
            try { frames = Integer.parseInt(row.get(4).toString().trim()); } catch (Exception e2) {}
            frames = Math.min(frames, 60000);
            encodeU16(cv60, frames);

            // --- loopGoto (uint8, sent as uint16 with hi=0; 1-based row, 0 = advance) ---
            int loopGoto = 0;
            try { loopGoto = Integer.parseInt(row.get(5).toString().trim()); } catch (Exception e2) {}
            encodeU16(cv60, loopGoto);

            // --- loopTimes (uint16, capped at 60000; 0 = infinite) ---
            int loopTimes = 0;
            try { loopTimes = Integer.parseInt(row.get(6).toString().trim()); } catch (Exception e2) {}
            loopTimes = Math.min(loopTimes, 60000);
            encodeU16(cv60, loopTimes);

            // --- constIllum (uint8, sent as uint16 with hi=0) ---
            String constVal = row.get(7).toString().trim();
            int constIllum = 0;
            if (!constVal.isEmpty()) {
                String[] cChannels = constVal.split(",");
                for (String ch : cChannels) {
                    int pinNum = config.getPinForChannel(ch.trim());
                    if (pinNum != -1) constIllum |= (1 << (pinNum - 1));
                }
            }
            constIllum &= 0xFE; // ensure camera bit (bit 0) is never set in constIllum
            encodeU16(cv60, constIllum);

            // --- loopSwitchGoto (uint8, sent as uint16 with hi=0; 1-based row, 0 = disabled) ---
            int lsGoto = 0;
            try { lsGoto = Integer.parseInt(row.get(8).toString().trim()); } catch (Exception e2) {}
            encodeU16(cv60, lsGoto);
        }

        // --- DEBUG: dump cv60 byte-by-byte to file so we can verify what is sent ---
//        try {
//            String dbgDir = (config.experimentFolder != null && !config.experimentFolder.isEmpty())
//                ? config.experimentFolder
//                : System.getProperty("user.home");
//            String dbgPath = dbgDir + "\\cv60_debug.txt";
//            PrintWriter dbgWriter = new PrintWriter(new FileWriter(dbgPath));
//            print("cv60 debug path: " + dbgPath);
//            dbgWriter.println("cv60 total bytes: " + cv60.size());
//            dbgWriter.println("Byte[0] cmd  = " + ((int)(char)cv60.get(0) & 0xFF));
//            int dbgNRows = (int)(char)cv60.get(1) & 0xFF;
//            dbgWriter.println("Byte[1] nRows= " + dbgNRows);
//            String[] fNames = {"pinPattern","exposureMs","intervalMs","frames",
//                               "loopGoto","loopTimes","constIllum","loopSwitchGoto"};
//            for (int dbgR = 0; dbgR < dbgNRows; dbgR++) {
//                int dbgBase = 2 + dbgR * 16;
//                dbgWriter.println("--- Row " + (dbgR+1)
//                    + "  (raw bytes " + dbgBase + ".." + (dbgBase+15) + ") ---");
//                for (int dbgF = 0; dbgF < 8; dbgF++) {
//                    int dbgIdx = dbgBase + dbgF * 2;
//                    int dbgHi  = (int)(char)cv60.get(dbgIdx)     & 0xFF;
//                    int dbgLo  = (int)(char)cv60.get(dbgIdx + 1) & 0xFF;
//                    int dbgVal;
//                    if      (dbgHi == 235) dbgVal = (40     << 8) | dbgLo;
//                    else if (dbgHi == 236) dbgVal = (dbgLo  << 8) | 40;
//                    else if (dbgHi == 237) dbgVal = (dbgLo  << 8) | 251;
//                    else if (dbgHi == 238) dbgVal = (40     << 8) | 40;
//                    else if (dbgHi == 239) dbgVal = (40     << 8) | 251;
//                    else                   dbgVal = (dbgHi  << 8) | dbgLo;
//                    dbgWriter.println("  " + fNames[dbgF]
//                        + ":  hi=" + dbgHi + "  lo=" + dbgLo + "  => " + dbgVal);
//                }
//            }
//            dbgWriter.println("--- raw bytes (all) ---");
//            for (int dbgI = 0; dbgI < cv60.size(); dbgI++) {
//                dbgWriter.print((int)(char)cv60.get(dbgI) & 0xFF);
//                dbgWriter.print(' ');
//            }
//            dbgWriter.println();
//            dbgWriter.close();
//            print("cv60 debug dump written.");
//        } catch (Exception dbgEx) {
//            print("cv60 debug dump FAILED: " + dbgEx.getMessage());
//        }
        // --- END DEBUG ---

        if (config.useTestTable) {
            // Send case 69: load hardcoded test table on Arduino (bypasses serial read)
            mmcorej.CharVector cv69 = new mmcorej.CharVector();
            cv69.add((char)69);
            mmc.writeToSerialPort(config.serialPort, cv69);
            print("TEST TABLE (case 69) sent to Arduino.");
        } else {
            mmc.writeToSerialPort(config.serialPort, cv60);
        }

        // NOTE: case 61 (start) is sent later, after mmc.startSequenceAcquisition(),
        // so that Arduino only begins firing triggers once the camera is armed.
    } catch (Exception ardEx) {
        // print("Arduino serial send error: " + ardEx.getMessage());
    }
    } // end if (useCircularBufferMode)

    acqFrame.setVisible(true);

    // print("DEBUG: Frame visible=" + acqFrame.isVisible() + ", frame size=" + acqFrame.getSize());
    // print("DEBUG: Chart panels count=" + chartPanels.size());
    for (int i = 0; i < chartPanels.size(); i++) {
        if (chartPanels.get(i) != null) {
            ChartPanel cp = (ChartPanel) chartPanels.get(i);
            // print("  ChartPanel " + i + ": visible=" + cp.isVisible() + ", size=" + cp.getSize());
        }
    }

    // ChartFactory.createXYLineChart() provides a renderer with lines enabled by default
    // No additional renderer configuration needed!

    // Force layout and repaint of all chart panels after window is visible
    SwingUtilities.invokeLater(new Runnable() {
        public void run() {
            for (int i = 0; i < chartPanels.size(); i++) {
                if (chartPanels.get(i) != null) {
                    ChartPanel cp = (ChartPanel) chartPanels.get(i);
                    cp.revalidate();
                    cp.repaint();
                }
            }
            acqFrame.revalidate();
            acqFrame.repaint();

        }
    });


    // ===== START ACQUISITION THREAD =====
    final boolean[] acquisitionRunning = {true};
    final ArrayList allDataRows = new ArrayList(); // Store RAW rows [frame, timestamp, roi0, roi1, ...]
    final ArrayList allCorrectedDataRows = new ArrayList(); // Parallel BG-corrected rows (empty when BG disabled)
    final ArrayList allBTCorrDataRows = new ArrayList(); // BT-corrected rows (empty when BT disabled)
    final ArrayList eventTimes = new ArrayList(); // Store event timestamps in ms
    final ArrayList allSwitchEvents = new ArrayList(); // Switch-notification packets: int[]{ lumetricFrame, destRow, ardTotalFrames }

    // Count active graphs for data structure
    int activeGraphCount = 0;
    for (int i = 0; i < 4; i++) {
        ArrayList vizRow = (ArrayList) config.acqSettings.visualizationRows.get(i);
        String graphType = (String) vizRow.get(1);
        if (!graphType.equals("none")) {
            activeGraphCount++;
        }
    }
    final int numActiveGraphs = activeGraphCount;

    // Update Quit button to save data and stop acquisition
    quitButton.removeActionListener(quitButton.getActionListeners()[0]);
    quitButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            int confirm = JOptionPane.showConfirmDialog(acqFrame,
                "Are you sure you want to quit the acquisition?",
                "Confirm Quit",
                JOptionPane.YES_NO_OPTION,
                JOptionPane.WARNING_MESSAGE);
            if (confirm == JOptionPane.YES_OPTION) {
                // Do NOT send byte 66 here.
                // stopSequenceAcquisition() must be called first while Arduino is still
                // active so DCAM is not in trigger-wait when stop is issued (matches
                // Paulis_AACon order).  Both calls happen inside the acquisition thread's
                // drain-bound block below.
                acquisitionRunning[0] = false;

                // Hide the frame immediately so the user gets instant visual feedback.
                // The background acquisition thread will call dispose() once its
                // cleanup (config restore, stopSequenceAcquisition) is done.
                // Hiding first vs waiting for dispose avoids a visible 1-3 s lag
                // caused by USB property writes in the cleanup sequence.
                acqFrame.setVisible(false);

                // Export data to CSV on the EDT while cleanup runs in the background.
                exportGraphDataToCSV(allDataRows, allCorrectedDataRows, allBTCorrDataRows, numActiveGraphs, config.acqSettings.visualizationRows);
                exportEventTimesToCSV(eventTimes);
            }
        }
    });

    // Start acquisition in background thread
    new Thread(new Runnable() {
        public void run() {
            try {
                // Choose acquisition mode based on configuration
                // Simple Snap Mode checkbox overrides config file setting
                boolean useCircularBuffer = config.useCircularBuffer && !config.useSimpleSnapMode;

                print("=== ACQUISITION MODE ROUTING ===");
                print("  config.useCircularBuffer  = " + config.useCircularBuffer);
                print("  config.useSimpleSnapMode  = " + config.useSimpleSnapMode);
                print("  --> useCircularBuffer     = " + useCircularBuffer);
                print("  (if false → snap loop runs, camera self-triggers, no Arduino sync)");
                print("================================");

                if (useCircularBuffer) {
                    runCircularBufferAcquisition(acquisitionRunning, allDataRows, allCorrectedDataRows, allBTCorrDataRows, datasets, acquisitionStartTime, liveViewPanelRef[0], charts, chartPanels, acqFrame, frameCounterLabel, allSwitchEvents, numActiveGraphs, eventTimes);
                } else {
                    runAcquisition(acquisitionRunning, allDataRows, allCorrectedDataRows, allBTCorrDataRows, datasets, acquisitionStartTime, liveViewPanelRef[0], charts, chartPanels, acqFrame, frameCounterLabel);
                }
            } catch (Exception ex) {
                print("ERROR in acquisition thread: " + ex.getMessage());
                ex.printStackTrace();
            }
        }
    }).start();
}

// ==================== Frame Filtering Logic ====================
// Parse a row-selector string from the visualization table.
// "1"      → 0  (constant denominator — never matches a seqRow)
// "Row N"  → N  (1-based sequence row number)
int parseRowNumber(String s) {
    if (s == null || s.trim().equals("1")) return 0;
    String trimmed = s.trim();
    if (trimmed.equals("All Rows")) return -1; // Special: match every sequence row
    if (trimmed.startsWith("Row ")) {
        try { return Integer.parseInt(trimmed.substring(4).trim()); }
        catch (Exception e) {}
    }
    return 0;
}

// Returns true when a frame with the given seqRow should be processed for this vizRow.
// seqRow is the 1-based sequence row number stored in dataRows[i][2].
// For Intensity: accept only frames whose seqRow matches the Numerator row.
// For Ratio:     accept frames matching either Numerator or Denominator (both needed for caching).
// Spatial mode:  always true (unchanged).
boolean shouldProcessFrame(int seqRow, ArrayList vizRow) {
    if (config.acqSettings.processingMode.equals("Spatial")) {
        // Apply Row Filter if set (col 2 exists and is not "All Rows")
        if (vizRow.size() > 2) {
            String rowFilter = (String) vizRow.get(2);
            if (rowFilter != null && !rowFilter.trim().equals("All Rows")) {
                int filterRow = parseRowNumber(rowFilter);
                return (filterRow > 0 && seqRow == filterRow);
            }
        }
        return true;
    }

    String graphType = (String) vizRow.get(1);
    if (graphType == null || graphType.equals("none")) return false;

    int numerRow = parseRowNumber((String) vizRow.get(2));
    int denomRow = parseRowNumber((String) vizRow.get(3));

    if (graphType.equals("Intensity")) {
        if (numerRow == -1) return true; // "All Rows": always accept
        return (numerRow > 0 && seqRow == numerRow);
    }
    if (graphType.equals("Ratio")) {
        boolean matchNumer = (numerRow > 0 && seqRow == numerRow);
        boolean matchDenom = (denomRow > 0 && seqRow == denomRow); // "1" → denomRow==0, never matches
        return matchNumer || matchDenom;
    }
    // Spatial types (Split ratio, Intensity Upper/Lower/Left/Right): always accept
    return true;
}

// ==================== COMMON ACQUISITION HELPER FUNCTIONS ====================

// Frame cache for ratio calculations - stores most recent even and odd frames per graph
// Structure: Map<graphIdx, Map<"even"|"odd", CachedFrame>>
// CachedFrame: [frameNumber, timestamp, roiValues]
Map frameCache = new HashMap();

// Initialize frame cache for a graph
void initializeFrameCache(int graphIdx) {
    Map graphCache = new HashMap();
    graphCache.put("even", null);
    graphCache.put("odd", null);
    frameCache.put(graphIdx, graphCache);
}

// Cache frame data for ratio calculation
void cacheFrameData(int graphIdx, int frameNumber, long timestamp, ArrayList roiValues) {
    if (!frameCache.containsKey(graphIdx)) {
        initializeFrameCache(graphIdx);
    }

    Map graphCache = (Map) frameCache.get(graphIdx);
    String frameType = (frameNumber % 2 == 0) ? "even" : "odd";

    ArrayList cachedFrame = new ArrayList();
    cachedFrame.add(frameNumber);
    cachedFrame.add(timestamp);
    cachedFrame.add(new ArrayList(roiValues)); // Copy the values

    graphCache.put(frameType, cachedFrame);
}

// Cache frame data at a named position slot (for N-frame cycle ratios)
void cacheFrameDataAtPosition(int graphIdx, String slot, int frameNumber, long timestamp, ArrayList roiValues) {
    if (!frameCache.containsKey(graphIdx)) {
        frameCache.put(graphIdx, new HashMap());
    }
    Map graphCache = (Map) frameCache.get(graphIdx);
    ArrayList cachedFrame = new ArrayList();
    cachedFrame.add(frameNumber);
    cachedFrame.add(timestamp);
    cachedFrame.add(new ArrayList(roiValues));
    graphCache.put(slot, cachedFrame);
}

// Calculate frame ratio: divides numerator by denominator element-wise
// Returns ArrayList of ratio values (one per ROI)
ArrayList calculateFrameRatio(ArrayList numeratorROIs, ArrayList denominatorROIs) {
    ArrayList ratios = new ArrayList();

    if (numeratorROIs == null || denominatorROIs == null) {
        return ratios; // Return empty if either is null
    }

    int numROIs = Math.min(numeratorROIs.size(), denominatorROIs.size());
    for (int i = 0; i < numROIs; i++) {
        double numerator = ((Double) numeratorROIs.get(i)).doubleValue();
        double denominator = ((Double) denominatorROIs.get(i)).doubleValue();

        // Avoid division by zero
        if (denominator == 0.0) {
            ratios.add(Double.NaN); // Use NaN for undefined ratios
        } else {
            ratios.add(numerator / denominator);
        }
    }

    return ratios;
}

// Calculate spatial ratios from source and mirrored ROIs
// roiValues contains N values: first half are source region, second half are mirrored region
// graphType determines the ratio direction
ArrayList calculateSpatialRatio(ArrayList roiValues, String graphType) {
    ArrayList ratios = new ArrayList();

    if (roiValues == null || roiValues.size() < 2 || roiValues.size() % 2 != 0) {
        return ratios; // Need even number of ROI values (N source + N mirrored)
    }

    int numROIPairs = roiValues.size() / 2;

    // Split ROIs into source (first half) and mirrored (second half)
    ArrayList sourceROIs = new ArrayList();
    ArrayList mirroredROIs = new ArrayList();

    for (int i = 0; i < numROIPairs; i++) {
        sourceROIs.add(roiValues.get(i));
        mirroredROIs.add(roiValues.get(i + numROIPairs));
    }

    // Determine numerator and denominator based on graph type relative to the source region.
    // dir1 always equals source/mirrored (e.g. "Upper/Lower" when source is "Upper").
    ArrayList numeratorROIs = null;
    ArrayList denominatorROIs = null;

    String dir1 = config.acqSettings.spatialConfig.getRatioDirection1();
    if (graphType.equals("Split ratio " + dir1)) {
        // Source region is numerator
        numeratorROIs = sourceROIs;
        denominatorROIs = mirroredROIs;
    } else if (graphType.startsWith("Split ratio ")) {
        // Mirrored region is numerator (inverted direction)
        numeratorROIs = mirroredROIs;
        denominatorROIs = sourceROIs;
    } else {
        return ratios; // Unknown graph type
    }

    // Calculate ratios for each ROI pair
    for (int i = 0; i < numROIPairs; i++) {
        double numerator = ((Double) numeratorROIs.get(i)).doubleValue();
        double denominator = ((Double) denominatorROIs.get(i)).doubleValue();

        // Avoid division by zero
        if (denominator == 0.0) {
            ratios.add(Double.NaN); // Use NaN for undefined ratios
        } else {
            ratios.add(numerator / denominator);
        }
    }

    return ratios;
}

// Update live view with image and ROI overlays
void updateLiveView(JPanel liveViewPanel, ImageProcessor ip, ArrayList chartsList) {
    if (liveViewPanel == null || ip == null) {
        return;
    }

    // print("DEBUG: updateLiveView called, panel=" + (liveViewPanel != null) + ", ip=" + (ip != null));

    final ImageProcessor ipCopy = ip.duplicate();
    SwingUtilities.invokeLater(new Runnable() {
        public void run() {
            try {

                ImagePlus imp = new ImagePlus("Live", ipCopy);

                // Scale and display - calculate scale first
                int panelWidth = liveViewPanel.getWidth();
                int panelHeight = liveViewPanel.getHeight();

                double scale = 1.0;
                if (panelWidth > 0 && panelHeight > 0) {
                    double scaleX = (double) panelWidth / imp.getWidth();
                    double scaleY = (double) panelHeight / imp.getHeight();
                    scale = Math.min(scaleX, scaleY);
                    scale = Math.max(0.1, Math.min(scale, 4.0));
                }

                // Add ROI overlays using colors from the first active chart
                if (config.storedROIs != null && config.storedROIs.size() > 0) {
                    ij.gui.Overlay overlay = new ij.gui.Overlay();

                    // Get renderer from first active chart to match colors
                    org.jfree.chart.renderer.xy.XYItemRenderer renderer = null;
                    if (chartsList != null) {
                        for (int i = 0; i < chartsList.size(); i++) {
                            if (chartsList.get(i) != null) {
                                XYPlot plot = ((JFreeChart) chartsList.get(i)).getXYPlot();
                                renderer = plot.getRenderer();
                                break;
                            }
                        }
                    }

                    int totalROIs = config.storedROIs.size();
                    boolean isSpatialLV = config.acqSettings.processingMode.equals("Spatial");
                    int halfLV = isSpatialLV ? totalROIs / 2 : totalROIs;

                    for (int roiIdx = 0; roiIdx < config.storedROIs.size(); roiIdx++) {
                        ROIMetadata roiMeta = (ROIMetadata) config.storedROIs.get(roiIdx);
                        ij.gui.Roi roi = roiMeta.roi;

                        // imp has no ImageWindow, so imp.getCanvas() == null, which means
                        // Roi.draw() runs with ic=null, mag=1.0 — screen coords == stored pixel
                        // coords. We must manually pre-scale to display coordinates.
                        // For polygon/freehand types: scale each absolute vertex.
                        // For oval/rectangle: scale the bounding box.
                        int roiType = roi.getType();
                        ij.gui.Roi scaledRoi;
                        if (roiType == ij.gui.Roi.POLYGON || roiType == ij.gui.Roi.FREEROI ||
                                roiType == ij.gui.Roi.POLYLINE || roiType == ij.gui.Roi.FREELINE) {
                            ij.process.FloatPolygon fp = roi.getFloatPolygon(); // absolute image coords
                            float[] sxp = new float[fp.npoints];
                            float[] syp = new float[fp.npoints];
                            for (int k = 0; k < fp.npoints; k++) {
                                sxp[k] = (float)(fp.xpoints[k] * scale);
                                syp[k] = (float)(fp.ypoints[k] * scale);
                            }
                            scaledRoi = new ij.gui.PolygonRoi(
                                new ij.process.FloatPolygon(sxp, syp, fp.npoints), roiType);
                        } else if (roiType == ij.gui.Roi.OVAL) {
                            java.awt.Rectangle b = roi.getBounds();
                            scaledRoi = new ij.gui.OvalRoi(
                                (int)Math.round(b.x * scale), (int)Math.round(b.y * scale),
                                (int)Math.round(b.width * scale), (int)Math.round(b.height * scale));
                        } else {
                            java.awt.Rectangle b = roi.getBounds();
                            scaledRoi = new ij.gui.Roi(
                                (int)Math.round(b.x * scale), (int)Math.round(b.y * scale),
                                (int)Math.round(b.width * scale), (int)Math.round(b.height * scale));
                        }
                        // Use color from chart renderer; mirror ROIs share the color of their
                        // corresponding source ROI (roiIdx % halfLV maps mirror -> source index).
                        if (renderer != null) {
                            java.awt.Paint paint = renderer.getSeriesPaint(roiIdx % halfLV);
                            if (paint instanceof java.awt.Color) {
                                scaledRoi.setStrokeColor((java.awt.Color) paint);
                            }
                        }
                        scaledRoi.setStrokeWidth(1.0);
                        overlay.add(scaledRoi);
                    }
                    imp.setOverlay(overlay);
                }

                if (panelWidth > 0 && panelHeight > 0) {

                    ij.gui.ImageCanvas canvas = new ij.gui.ImageCanvas(imp);
                    canvas.setBackground(Color.BLACK); // AWT Canvas defaults to white; force black so any pre-paint flash is dark
                    canvas.setMagnification(scale);
                    canvas.setSize((int)(imp.getWidth() * scale), (int)(imp.getHeight() * scale));

                    liveViewPanel.removeAll();
                    JPanel centerPanel = new JPanel(new FlowLayout(FlowLayout.CENTER, 0, 0));
                    centerPanel.setBackground(Color.BLACK);
                    centerPanel.add(canvas);
                    liveViewPanel.add(centerPanel, BorderLayout.CENTER);
                    liveViewPanel.revalidate();
                    liveViewPanel.repaint();

                }
            } catch (Exception e) {
                // print("ERROR updating live view: " + e.getMessage());
                e.printStackTrace();
            }
        }
    });
}

// Apply background correction: subtract the BG ROI value from all entries.
// In Temporal mode: subtract rawValues[bgROIIndex] from all entries.
// In Spatial mode: first N/2 subtract rawValues[bgROIIndex],
//                  second N/2 subtract rawValues[bgROIIndex + N/2] (paired BG).
// Raw data is never modified; a new list is returned.
ArrayList applyBGCorrection(ArrayList rawValues) {
    ArrayList corrected = new ArrayList();
    int n = rawValues.size();
    boolean isSpatial = config.acqSettings.processingMode.equals("Spatial");
    int bgIdx = config.acqSettings.bgROIIndex;

    if (isSpatial && n >= 2) {
        int half = n / 2;
        // Guard: clamp bgIdx to valid source range
        if (bgIdx >= half) bgIdx = 0;
        double bgSource  = ((Double) rawValues.get(bgIdx)).doubleValue();
        double bgMirror  = ((Double) rawValues.get(bgIdx + half)).doubleValue();
        for (int i = 0; i < n; i++) {
            double raw = ((Double) rawValues.get(i)).doubleValue();
            corrected.add(new Double(raw - (i < half ? bgSource : bgMirror)));
        }
    } else {
        // Temporal mode (or fallback)
        if (bgIdx >= n) bgIdx = 0;
        double bg = ((Double) rawValues.get(bgIdx)).doubleValue();
        for (int i = 0; i < n; i++) {
            double raw = ((Double) rawValues.get(i)).doubleValue();
            corrected.add(new Double(raw - bg));
        }
    }
    return corrected;
}

// Apply bleedthrough correction to BG-corrected values.
// Must only be called in Spatial mode, after BG correction.
// Direction is read from config.acqSettings.btDirection (e.g. "Upper -> Lower").
// The "from" label is extracted (e.g. "Upper") and compared to
// config.acqSettings.spatialConfig.roiSourceRegion to determine which half is source vs mirror.
//   source indices:  0 .. half-1  (where user drew ROIs)
//   mirror indices:  half .. n-1  (auto-mirrored)
// If "from" = source region:  mirror[i] -= factor * source[i]   (light bleeds source -> mirror)
// If "from" = mirror region:  source[i] -= factor * mirror[i]   (light bleeds mirror -> source)
// Raw input is never modified; a new list is returned.
ArrayList applyBTCorrection(ArrayList bgCorrValues) {
    int n = bgCorrValues.size();
    ArrayList corrected = new ArrayList();
    for (int i = 0; i < n; i++) corrected.add(bgCorrValues.get(i));

    if (!config.acqSettings.processingMode.equals("Spatial") || n < 2) return corrected;

    int half = n / 2;
    double factor = config.acqSettings.btFactor;
    String direction = config.acqSettings.btDirection; // e.g. "Upper -> Lower"
    String roiRegion = config.acqSettings.spatialConfig.roiSourceRegion; // e.g. "Upper"

    // Parse the "from" label: everything before " -> "
    String fromLabel = direction;
    int arrowIdx = direction.indexOf(" -> ");
    if (arrowIdx >= 0) {
        fromLabel = direction.substring(0, arrowIdx).trim();
    }

    boolean fromIsSource = fromLabel.equalsIgnoreCase(roiRegion);

    for (int i = 0; i < half; i++) {
        double src    = ((Double) corrected.get(i)).doubleValue();
        double mirror = ((Double) corrected.get(i + half)).doubleValue();
        if (fromIsSource) {
            // source bleeds into mirror: correct mirror, leave source unchanged
            corrected.set(i + half, new Double(mirror - factor * src));
        } else {
            // mirror bleeds into source: correct source, leave mirror unchanged
            corrected.set(i, new Double(src - factor * mirror));
        }
    }
    return corrected;
}

// Central per-frame processing: measure ROIs, store RAW + corrected rows, update graphs.
// Used by both acquisition loops (circular buffer and simple snap) to avoid duplication.
void processFrameData(ImageProcessor ip, int frameNumber, long currentTime, int seqRow,
                      ArrayList dataRows, ArrayList correctedDataRows,
                      ArrayList btCorrDataRows,
                      ArrayList datasets, ArrayList chartPanels, ArrayList chartsList,
                      boolean shouldUpdateGui) {

    ArrayList roiValues = measureROIs(ip);

    // Always store the RAW row
    ArrayList rawRow = buildDataRow(frameNumber, currentTime, seqRow, roiValues);
    dataRows.add(rawRow);

    // Compute and store BG-corrected row if enabled
    ArrayList valuesForGraphs = roiValues;
    if (config.acqSettings.bgCorrectionEnabled) {
        ArrayList bgCorrValues = applyBGCorrection(roiValues);
        correctedDataRows.add(buildDataRow(frameNumber, currentTime, seqRow, bgCorrValues));
        valuesForGraphs = bgCorrValues;

        // Compute and store BT-corrected row (only valid after BG, only in Spatial)
        if (config.acqSettings.btCorrectionEnabled
                && config.acqSettings.processingMode.equals("Spatial")) {
            ArrayList btValues = applyBTCorrection(bgCorrValues);
            btCorrDataRows.add(buildDataRow(frameNumber, currentTime, seqRow, btValues));
            valuesForGraphs = btValues; // graphs show highest active correction
        }
    }

    // Update graphs (throttled by caller)
    if (shouldUpdateGui) {
        updateGraphs(datasets, frameNumber, currentTime, valuesForGraphs, chartPanels, chartsList, seqRow);
    }
}

// Measure all ROIs on an image
ArrayList measureROIs(ImageProcessor ip) {
    ArrayList roiValues = new ArrayList();
    for (int roiIdx = 0; roiIdx < config.storedROIs.size(); roiIdx++) {
        ROIMetadata roiMeta = (ROIMetadata) config.storedROIs.get(roiIdx);
        ij.gui.Roi roi = roiMeta.roi;
        ip.setRoi(roi);
        double meanIntensity = ip.getStatistics().mean;
        roiValues.add(meanIntensity);
    }
    return roiValues;
}

// Build data row for CSV export.
// Layout: [0]=frameNumber  [1]=timestamp  [2]=seqRow(1-based)  [3..]=roiValues
// seqRow is mutable — RowTracker.patch() may overwrite index 2 retroactively.
ArrayList buildDataRow(int frameNumber, long timestamp, int seqRow, ArrayList roiValues) {
    ArrayList dataRow = new ArrayList();
    dataRow.add(new Integer(frameNumber));
    dataRow.add(timestamp);
    dataRow.add(new Integer(seqRow));   // index 2 — patched by RowTracker on switch event
    for (int i = 0; i < roiValues.size(); i++) {
        dataRow.add(roiValues.get(i));
    }
    while (dataRow.size() < 7) {  // Pad to 7 columns (was 6; seqRow occupies one slot)
        dataRow.add(null);
    }
    return dataRow;
}

// Update all graphs with new data
// seqRow: 1-based sequence-row index of the incoming frame (from RowTracker via processFrameData)
void updateGraphs(ArrayList datasets, int frameNumber, long currentTime, ArrayList roiValues, ArrayList chartPanels, ArrayList charts, int seqRow) {
    if (frameNumber <= 3) {
        // print("DEBUG updateGraphs: frame=" + frameNumber + ", seqRow=" + seqRow + ", time=" + currentTime + ", roiValues.size=" + roiValues.size());
    }

    for (int graphIdx = 0; graphIdx < 4; graphIdx++) {
        ArrayList vizRow = (ArrayList) config.acqSettings.visualizationRows.get(graphIdx);
        String graphType = (String) vizRow.get(1);

        if (graphType.equals("none") || datasets.get(graphIdx) == null) {
            continue;
        }

        // Use seqRow-aware gate
        if (!shouldProcessFrame(seqRow, vizRow)) {
            continue;
        }

        // ── Intensity ──────────────────────────────────────────────────────────
        if (graphType.equals("Intensity") || graphType.startsWith("Intensity ")) {
            // vizRow only has columns 0-1 in Spatial mode; only read col 2 in Temporal mode
            int numerRow = 0;
            if (config.acqSettings.processingMode.equals("Temporal") && vizRow.size() > 2) {
                numerRow = parseRowNumber((String) vizRow.get(2));
            }

            // Temporal Intensity: gate on Numerator row
            if (config.acqSettings.processingMode.equals("Temporal")) {
                if (numerRow != -1 && (numerRow == 0 || seqRow != numerRow)) continue;
            }

            int numSeriesToUpdate = 0;
            ArrayList valuesToPlot = new ArrayList();

            boolean isSpatialMode = config.acqSettings.processingMode.equals("Spatial");
            if (isSpatialMode) {
                numSeriesToUpdate = roiValues.size() / 2;
                int roiOffset = 0;
                if (graphType.startsWith("Intensity ")) {
                    String graphRegion = graphType.substring("Intensity ".length());
                    String srcRegion = config.acqSettings.spatialConfig.roiSourceRegion;
                    boolean matchesSource = srcRegion.equals(graphRegion);
                    roiOffset = matchesSource ? 0 : numSeriesToUpdate;
                }
                for (int i = 0; i < numSeriesToUpdate; i++) {
                    valuesToPlot.add(roiValues.get(roiOffset + i));
                }
            } else {
                numSeriesToUpdate = roiValues.size();
                valuesToPlot.addAll(roiValues);
            }

            final int gIdx = graphIdx;
            final long time = currentTime;
            final int numSeriesFinal = numSeriesToUpdate;
            final ArrayList valuesToPlotFinal = valuesToPlot;
            final ArrayList chartPanelsCopy = chartPanels;

            SwingUtilities.invokeLater(new Runnable() {
                public void run() {
                    try {
                        XYSeriesCollection dataset = (XYSeriesCollection) datasets.get(gIdx);
                        for (int roiIdx = 0; roiIdx < numSeriesFinal; roiIdx++) {
                            XYSeries series = dataset.getSeries(roiIdx);
                            double value = ((Double) valuesToPlotFinal.get(roiIdx)).doubleValue();
                            series.add(time / 1000.0, value, true);
                        }
                        if (chartPanelsCopy != null && gIdx < chartPanelsCopy.size() && chartPanelsCopy.get(gIdx) != null) {
                            ChartPanel cp = (ChartPanel) chartPanelsCopy.get(gIdx);
                            cp.getChart().fireChartChanged();
                            cp.invalidate();
                            cp.validate();
                            cp.repaint();
                        }
                    } catch (Exception e) {
                        e.printStackTrace();
                    }
                }
            });
        }
        // ── Temporal Ratio (row-based) ─────────────────────────────────────────
        else if (graphType.equals("Ratio") && config.acqSettings.processingMode.equals("Temporal")) {
            int numerRow  = parseRowNumber((String) vizRow.get(2));
            int denomRow  = parseRowNumber((String) vizRow.get(3)); // 0 = constant "1"

            // Cache denominator frame whenever we see a denominator row
            if (denomRow > 0 && seqRow == denomRow) {
                cacheFrameDataAtPosition(graphIdx, "denom", frameNumber, currentTime, roiValues);
            }

            // Plot ratio when we see a numerator row
            if (numerRow > 0 && seqRow == numerRow) {
                ArrayList denomValues;
                if (denomRow == 0) {
                    // Denominator is constant 1 — build a list of 1.0 values
                    denomValues = new ArrayList();
                    for (int ri = 0; ri < roiValues.size(); ri++) {
                        denomValues.add(new Double(1.0));
                    }
                } else {
                    // Retrieve most-recently cached denominator frame
                    if (!frameCache.containsKey(graphIdx)) continue;
                    Map graphCache = (Map) frameCache.get(graphIdx);
                    ArrayList denomFrame = (ArrayList) graphCache.get("denom");
                    if (denomFrame == null) continue; // No denom frame seen yet — skip silently
                    denomValues = (ArrayList) denomFrame.get(2);
                }

                ArrayList ratioValues = calculateFrameRatio(roiValues, denomValues);
                if (ratioValues == null || ratioValues.isEmpty()) continue;

                final int gIdx = graphIdx;
                final long time = currentTime;
                final ArrayList ratioValsCopy = new ArrayList(ratioValues);
                final ArrayList chartPanelsCopy = chartPanels;

                SwingUtilities.invokeLater(new Runnable() {
                    public void run() {
                        try {
                            XYSeriesCollection dataset = (XYSeriesCollection) datasets.get(gIdx);
                            for (int roiIdx = 0; roiIdx < ratioValsCopy.size(); roiIdx++) {
                                XYSeries series = dataset.getSeries(roiIdx);
                                Object ratioObj = ratioValsCopy.get(roiIdx);
                                if (ratioObj != null && ratioObj instanceof Double) {
                                    double value = ((Double) ratioObj).doubleValue();
                                    if (!Double.isNaN(value) && !Double.isInfinite(value)) {
                                        series.add(time / 1000.0, value, true);
                                    }
                                }
                            }
                            if (chartPanelsCopy != null && gIdx < chartPanelsCopy.size() && chartPanelsCopy.get(gIdx) != null) {
                                ChartPanel cp = (ChartPanel) chartPanelsCopy.get(gIdx);
                                cp.revalidate();
                                cp.repaint();
                            }
                        } catch (Exception e) {
                            e.printStackTrace();
                        }
                    }
                });
            }
        }
        // ── Split Ratio (Spatial mode) ─────────────────────────────────────────
        else if (graphType.startsWith("Split ratio")) {
            if (frameNumber <= 3) {

                // print("    roiValues.size=" + roiValues.size());
            }

            ArrayList ratioValues = calculateSpatialRatio(roiValues, graphType);

            if (frameNumber <= 3) {
                // print("    calculateSpatialRatio returned, ratioValues=" + (ratioValues != null ? ratioValues.size() + " values" : "NULL"));
            }

            if (ratioValues == null || ratioValues.isEmpty()) {
                if (frameNumber <= 3) {

                }
                continue;
            }

            if (frameNumber % 10 == 1) {
                // print("Frame " + frameNumber + " - " + graphType + " calculated for Graph " + (graphIdx + 1) + ": " + ratioValues);
            }

            final int gIdx = graphIdx;
            final long time = currentTime;
            final ArrayList ratioValsCopy = new ArrayList(ratioValues);
            final ArrayList chartPanelsCopy = chartPanels;
            final ArrayList chartsCopy = charts;

            SwingUtilities.invokeLater(new Runnable() {
                public void run() {
                    try {
                        XYSeriesCollection dataset = (XYSeriesCollection) datasets.get(gIdx);
                        if (frameNumber <= 3) {
                            // print("    SwingUtilities running for Split ratio, dataset has " + dataset.getSeriesCount() + " series");
                        }
                        for (int roiIdx = 0; roiIdx < ratioValsCopy.size(); roiIdx++) {
                            XYSeries series = dataset.getSeries(roiIdx);
                            Object ratioObj = ratioValsCopy.get(roiIdx);
                            if (ratioObj != null && ratioObj instanceof Double) {
                                double value = ((Double) ratioObj).doubleValue();
                                if (!Double.isNaN(value) && !Double.isInfinite(value)) {
                                    series.add(time / 1000.0, value, true);
                                }
                            }
                        }
                        if (chartPanelsCopy != null && gIdx < chartPanelsCopy.size() && chartPanelsCopy.get(gIdx) != null) {
                            ChartPanel cp = (ChartPanel) chartPanelsCopy.get(gIdx);
                            if (frameNumber <= 3) {
                                JFreeChart chart = cp.getChart();
                                if (chart != null) {
                                    XYPlot plot = (XYPlot) chart.getPlot();
                                    org.jfree.chart.axis.ValueAxis domainAxis = plot.getDomainAxis();
                                    org.jfree.chart.axis.ValueAxis rangeAxis = plot.getRangeAxis();
                                    domainAxis.configure();
                                    rangeAxis.configure();
                                    chart.fireChartChanged();
                                }
                            }
                            cp.invalidate();
                            cp.validate();
                            cp.repaint();
                        }
                    } catch (Exception e) {
                        // print("ERROR updating Split ratio graph " + (gIdx + 1) + ": " + e.getMessage());
                        e.printStackTrace();
                    }
                }
            });
        }
    }
}

// Convert TaggedImage to ImageProcessor
ImageProcessor taggedImageToProcessor(Object taggedImg) {
    try {
        int width = (int) mmc.getImageWidth();
        int height = (int) mmc.getImageHeight();
        int bpp = (int) mmc.getBytesPerPixel();

        Object pixels = null;
        if (taggedImg.getClass().getName().contains("TaggedImage")) {
            java.lang.reflect.Field pixField = taggedImg.getClass().getField("pix");
            pixels = pixField.get(taggedImg);
        }

        if (bpp == 1 && pixels instanceof byte[]) {
            ij.process.ByteProcessor ip = new ij.process.ByteProcessor(width, height);
            ip.setPixels((byte[]) pixels);
            return ip;
        } else if (bpp == 2 && pixels instanceof short[]) {
            ij.process.ShortProcessor ip = new ij.process.ShortProcessor(width, height);
            ip.setPixels((short[]) pixels);
            return ip;
        }
    } catch (Exception e) {
        // print("WARNING: Could not convert image: " + e.getMessage());
    }
    return null;
}

// ==================== Circular Buffer Setup ====================
void setupCircularBuffer() {

    // Calculate memory allocation
    long maxMem = Runtime.getRuntime().maxMemory();
    long bufferMem = (long)(maxMem * 0.75);
    int bufferSizeMB = (int)(bufferMem / (1024 * 1024));

    try {
        mmc.setCircularBufferMemoryFootprint(bufferSizeMB);

        // Calculate approximate buffer capacity in frames
        int imageWidth = (int) mmc.getImageWidth();
        int imageHeight = (int) mmc.getImageHeight();
        int bytesPerPixel = (int) mmc.getBytesPerPixel();
        long bytesPerImage = imageWidth * imageHeight * bytesPerPixel;
        int approxCapacity = (int)(bufferMem / bytesPerImage);






    } catch (Exception e) {
        // print("ERROR: Failed to setup circular buffer: " + e.getMessage());
        e.printStackTrace();
    }
}

// ==================== Save Image as TIFF ====================
void saveImageAsTiff(Object img, int frameNumber, String experimentFolder) {
    try {
        // Convert to ImageProcessor via MM data layer — same method as Paulis_AACon.
        // mm.data().convertTaggedImage() handles format, bit-depth, and calibration
        // correctly without reflection on TaggedImage internals.
        ImageProcessor ip = null;
        try {
            if (img instanceof org.micromanager.data.Image) {
                ip = mm.data().ij().createProcessor((org.micromanager.data.Image) img);
            } else if (img != null) {
                org.micromanager.data.Image mmImage = mm.data().convertTaggedImage(img);
                ip = mm.data().ij().createProcessor(mmImage);
            }
        } catch (Exception e) {
            // print("WARNING: Could not convert image: " + e.getMessage());
        }

        if (ip == null) {

            return;
        }

        // Create ImagePlus and save
        ImagePlus imp = new ImagePlus("Frame_" + frameNumber, ip);

        // Avoid String.format() - use manual padding instead (BeanShell compatibility)
        String paddedNumber = "" + frameNumber;
        while (paddedNumber.length() < 5) {
            paddedNumber = "0" + paddedNumber;
        }
        String filename = "Frame_" + paddedNumber + ".tif";
        // Save to images subfolder if it exists, otherwise to experiment folder
        String saveFolder = (config.imagesFolder != null && !config.imagesFolder.isEmpty()) ?
            config.imagesFolder : experimentFolder;
        String filepath = saveFolder + File.separator + filename;

        // Use FileSaver instead of IJ.saveAs to avoid any GUI interactions
        ij.io.FileSaver fs = new ij.io.FileSaver(imp);
        boolean success = fs.saveAsTiff(filepath);
        if (!success) {

        }

        // Log every 100 frames
        if (frameNumber % 100 == 0) {

        }

    } catch (Exception e) {
        // print("ERROR saving frame " + frameNumber + ": " + e.getClass().getName() + ": " + e.getMessage());
        e.printStackTrace();
    }
}

// ==================== Convert TIFFs to Stack ====================
void convertTiffsToStack(String experimentFolder) {
    import ij.ImageStack;
    import ij.io.FileSaver;


    try {
        File expFolder = new File(experimentFolder);
        if (!expFolder.exists() || !expFolder.isDirectory()) {

            return;
        }

        // Check for images subfolder first
        File imagesFolder = new File(expFolder, "images");
        File searchFolder = imagesFolder.exists() ? imagesFolder : expFolder;

        // print("Searching for TIFF files in: " + searchFolder.getAbsolutePath());

        // Find all Frame_*.tif files
        File[] tiffFiles = searchFolder.listFiles(new java.io.FilenameFilter() {
            public boolean accept(File dir, String name) {
                return name.startsWith("Frame_") && name.endsWith(".tif");
            }
        });

        if (tiffFiles == null || tiffFiles.length == 0) {

            return;
        }

        // Sort files by name to ensure correct order
        java.util.Arrays.sort(tiffFiles);

        int numFrames = tiffFiles.length;

        // Calculate actual total file size
        long totalFileSize = 0;
        for (int i = 0; i < tiffFiles.length; i++) {
            totalFileSize += tiffFiles[i].length();
        }
        long totalFileSizeMB = totalFileSize / (1024 * 1024);

        // Load first image to get dimensions (for logging)
        ImagePlus firstImp = IJ.openImage(tiffFiles[0].getAbsolutePath());
        if (firstImp == null) {

            return;
        }

        int width = firstImp.getWidth();
        int height = firstImp.getHeight();
        int bitDepth = firstImp.getBitDepth();


        // Estimate memory requirement based on actual file size
        // Add 20% overhead for ImageStack structure and temporary objects during loading
        long requiredMemoryBytes = (long)(totalFileSize * 1.2);
        long requiredMemoryMB = requiredMemoryBytes / (1024 * 1024);
        // print("Estimated memory required: " + requiredMemoryMB + " MB (file size + 20% overhead)");

        // Check available memory
        Runtime runtime = Runtime.getRuntime();
        runtime.gc(); // Suggest garbage collection before checking memory

        long maxMemory = runtime.maxMemory(); // Maximum memory the JVM will attempt to use
        long allocatedMemory = runtime.totalMemory(); // Current memory allocated to JVM
        long freeMemory = runtime.freeMemory(); // Free memory within allocated memory
        long availableMemory = maxMemory - allocatedMemory + freeMemory; // Total available

        long availableMB = availableMemory / (1024 * 1024);
        long maxMB = maxMemory / (1024 * 1024);




        // Use 60% of available memory as safety margin
        // (need extra space for overhead, intermediate objects, etc.)
        long safeAvailableBytes = (long)(availableMemory * 0.6);
        long safeAvailableMB = safeAvailableBytes / (1024 * 1024);

        // print("  Safe usable memory (60%): " + safeAvailableMB + " MB");

        // Check if we have enough memory
        if (requiredMemoryBytes > safeAvailableBytes) {


            // print("  Available (safe): " + safeAvailableMB + " MB");

            // Show error popup on EDT
            final long reqMB = requiredMemoryMB;
            final long safeMB = safeAvailableMB;
            SwingUtilities.invokeLater(new Runnable() {
                public void run() {
                    JOptionPane.showMessageDialog(null,
                        "Insufficient memory to create stack.\n\n" +
                        "Required: " + reqMB + " MB\n" +
                        "Available: " + safeMB + " MB (60% safety margin)\n\n" +
                        "Individual TIFF files have been kept in:\n" + experimentFolder,
                        "Stack Conversion - Insufficient Memory",
                        JOptionPane.WARNING_MESSAGE);
                }
            });
            return;
        }


        // Create stack
        ImageStack stack = new ImageStack(width, height);


        for (int i = 0; i < tiffFiles.length; i++) {
            ImagePlus imp = IJ.openImage(tiffFiles[i].getAbsolutePath());
            if (imp == null) {
                // print("WARNING: Could not load frame " + (i+1) + ", skipping");
                continue;
            }
            stack.addSlice("Frame_" + (i+1), imp.getProcessor());

            // Progress update every 100 frames
            if ((i+1) % 100 == 0 || i == tiffFiles.length - 1) {
                // print("Loaded " + (i+1) + "/" + numFrames + " frames");
            }
        }

        // Create ImagePlus from stack
        ImagePlus stackImp = new ImagePlus("Stack", stack);

        // Save stack to experiment folder (not images subfolder)
        String stackPath = experimentFolder + File.separator + "Image_Stack.tif";

        FileSaver fs = new FileSaver(stackImp);
        boolean success = fs.saveAsTiffStack(stackPath);

        if (!success) {


            return;
        }


        // Delete individual TIFF files

        int deletedCount = 0;
        for (int i = 0; i < tiffFiles.length; i++) {
            if (tiffFiles[i].delete()) {
                deletedCount++;
            } else {
                // print("WARNING: Could not delete " + tiffFiles[i].getName());
            }
        }


        // Remove images subfolder if it's empty
        File imagesFolder = new File(expFolder, "images");
        if (imagesFolder.exists() && imagesFolder.isDirectory()) {
            File[] remainingFiles = imagesFolder.listFiles();
            if (remainingFiles == null || remainingFiles.length == 0) {
                if (imagesFolder.delete()) {

                } else {

                }
            }
        }


    } catch (Exception e) {
        // print("ERROR during stack conversion: " + e.getClass().getName() + ": " + e.getMessage());
        e.printStackTrace();

        SwingUtilities.invokeLater(new Runnable() {
            public void run() {
                JOptionPane.showMessageDialog(null,
                    "Error during stack conversion:\n" + e.getMessage() + "\n\n" +
                    "Individual TIFF files have been kept.",
                    "Stack Conversion Error",
                    JOptionPane.ERROR_MESSAGE);
            }
        });
    }
}

// ==================== Convert TIFFs to Per-Row Stacks ====================
// Groups Frame_NNNNN.tif files by their sequence row (from dataRows[i][2]) and
// saves one Stack_Row_N.tif per row.  Individual TIFFs are deleted afterwards
// unless deleteOriginals is false (used when Convert to Stack will run next).
void convertTiffsToStacksPerRow(String experimentFolder, ArrayList dataRows, boolean deleteOriginals) {
    import ij.ImageStack;
    import ij.io.FileSaver;

    try {
        File expFolder = new File(experimentFolder);
        if (!expFolder.exists() || !expFolder.isDirectory()) {
            return;
        }

        // Check for images subfolder first (matches saveImageAsTiff save location)
        File imagesFolder = new File(expFolder, "images");
        File searchFolder = imagesFolder.exists() ? imagesFolder : expFolder;

        // Find all Frame_*.tif files
        File[] tiffFiles = searchFolder.listFiles(new java.io.FilenameFilter() {
            public boolean accept(File dir, String name) {
                return name.startsWith("Frame_") && name.endsWith(".tif");
            }
        });

        if (tiffFiles == null || tiffFiles.length == 0) {
            return;
        }

        java.util.Arrays.sort(tiffFiles);

        // Build fast filename -> File lookup
        HashMap nameToFile = new HashMap();
        for (int i = 0; i < tiffFiles.length; i++) {
            nameToFile.put(tiffFiles[i].getName(), tiffFiles[i]);
        }

        // Group frame numbers by seqRow.
        // dataRows layout: [0]=frameNumber  [1]=timestamp  [2]=seqRow  [3..]=roiValues
        HashMap rowToFrames = new HashMap(); // Integer seqRow -> ArrayList of Integer frameNum
        for (int i = 0; i < dataRows.size(); i++) {
            ArrayList row = (ArrayList) dataRows.get(i);
            if (row.size() < 3) continue;
            Object seqRowObj = row.get(2);
            Object frameNumObj = row.get(0);
            if (!rowToFrames.containsKey(seqRowObj)) {
                rowToFrames.put(seqRowObj, new ArrayList());
            }
            ((ArrayList) rowToFrames.get(seqRowObj)).add(frameNumObj);
        }

        if (rowToFrames.isEmpty()) {
            return;
        }

        // Get image dimensions from first available file
        ImagePlus firstImp = IJ.openImage(tiffFiles[0].getAbsolutePath());
        if (firstImp == null) {
            return;
        }
        int width  = firstImp.getWidth();
        int height = firstImp.getHeight();

        // Build sorted list of seqRow keys
        ArrayList seqRowKeys = new ArrayList();
        java.util.Iterator keyIt = rowToFrames.keySet().iterator();
        while (keyIt.hasNext()) {
            seqRowKeys.add(keyIt.next());
        }
        java.util.Collections.sort(seqRowKeys);

        // Track all files successfully incorporated into stacks (for deletion)
        ArrayList processedFiles = new ArrayList();

        for (int ri = 0; ri < seqRowKeys.size(); ri++) {
            Integer seqRowKey = (Integer) seqRowKeys.get(ri);
            ArrayList frames = (ArrayList) rowToFrames.get(seqRowKey);
            java.util.Collections.sort(frames);

            ImageStack stack = new ImageStack(width, height);
            int loadedCount = 0;

            for (int fi = 0; fi < frames.size(); fi++) {
                int frameNum = ((Integer) frames.get(fi)).intValue();
                String paddedNumber = "" + frameNum;
                while (paddedNumber.length() < 5) paddedNumber = "0" + paddedNumber;
                String fname = "Frame_" + paddedNumber + ".tif";
                File f = (File) nameToFile.get(fname);
                if (f == null || !f.exists()) continue;

                ImagePlus imp = IJ.openImage(f.getAbsolutePath());
                if (imp == null) continue;

                stack.addSlice("Frame_" + frameNum, imp.getProcessor());
                loadedCount++;
                processedFiles.add(f);
            }

            if (loadedCount == 0) continue;

            String stackName = "Stack_Row_" + seqRowKey.intValue() + ".tif";
            String stackPath = experimentFolder + File.separator + stackName;
            ImagePlus stackImp = new ImagePlus("Row_" + seqRowKey.intValue(), stack);
            FileSaver fs = new FileSaver(stackImp);
            boolean success = fs.saveAsTiffStack(stackPath);

            if (!success) {
                print("ERROR: Failed to save " + stackName);
            }
        }

        // Delete individual TIFF files that were incorporated into stacks
        if (deleteOriginals) {
            for (int i = 0; i < processedFiles.size(); i++) {
                ((File) processedFiles.get(i)).delete();
            }

            // Remove images subfolder if now empty
            if (imagesFolder.exists() && imagesFolder.isDirectory()) {
                File[] remaining = imagesFolder.listFiles();
                if (remaining == null || remaining.length == 0) {
                    imagesFolder.delete();
                }
            }
        }

    } catch (Exception e) {
        e.printStackTrace();
        SwingUtilities.invokeLater(new Runnable() {
            public void run() {
                JOptionPane.showMessageDialog(null,
                    "Error during per-row stack conversion:\n" + e.getMessage() + "\n\n" +
                    "Individual TIFF files have been kept.",
                    "Stack Conversion Error",
                    JOptionPane.ERROR_MESSAGE);
            }
        });
    }
}

// Build a default full-image ROI set when the user has not drawn any ROIs.
// Temporal: one ROI spanning the full sensor area.
// Spatial:  two ROIs each covering one half — source and mirror — based on
//           the current splitAxis and roiSourceRegion settings.
void createDefaultROIs() {
    int w = (int) mmc.getImageWidth();
    int h = (int) mmc.getImageHeight();
    boolean isSpatial = config.acqSettings.processingMode.equals("Spatial");
    config.storedROIs = new ArrayList();

    if (!isSpatial) {
        // Temporal: single ROI = entire frame
        ij.gui.Roi fullRoi = new ij.gui.Roi(0, 0, w, h);
        config.storedROIs.add(new ROIMetadata(fullRoi, "original", w, h));
        print("Default ROI: full image (" + w + " x " + h + ").");
    } else {
        String splitAxis  = config.acqSettings.spatialConfig.splitAxis;
        String srcRegion  = config.acqSettings.spatialConfig.roiSourceRegion;
        String mirRegion;
        ij.gui.Roi srcRoi, mirRoi;

        if (splitAxis.equals("Horizontal")) {
            int halfH = h / 2;
            mirRegion = srcRegion.equals("Upper") ? "Lower" : "Upper";
            int srcY  = srcRegion.equals("Upper") ? 0    : halfH;
            int mirY  = srcRegion.equals("Upper") ? halfH : 0;
            srcRoi = new ij.gui.Roi(0, srcY, w, halfH);
            mirRoi = new ij.gui.Roi(0, mirY, w, halfH);
        } else {
            int halfW = w / 2;
            mirRegion = srcRegion.equals("Left") ? "Right" : "Left";
            int srcX  = srcRegion.equals("Left") ? 0     : halfW;
            int mirX  = srcRegion.equals("Left") ? halfW : 0;
            srcRoi = new ij.gui.Roi(srcX, 0, halfW, h);
            mirRoi = new ij.gui.Roi(mirX, 0, halfW, h);
        }
        config.storedROIs.add(new ROIMetadata(srcRoi, srcRegion, w, h));
        config.storedROIs.add(new ROIMetadata(mirRoi, mirRegion, w, h));
        print("Default ROIs: " + srcRegion + " half + " + mirRegion + " half (" + splitAxis + " split).");
    }
}

// ==================== Pause Row Expansion ====================
// Returns an expanded copy of originalRows that:
//
//  A) For every exposure=0 row whose total duration > THRESHOLD_MS (30 s):
//     Replaces it with keep-alive rows (10 ms dark triggers every 10 s) so the camera
//     never waits longer than ~20 s for a trigger and does not time out.
//
//  B) For every exposure=0 row whose total duration > FLUSH_THRESHOLD_MS (500 ms) AND whose
//     per-frame interval > FLUSH_INTERVAL_MS (60 ms):
//     Appends a "flush trigger" row (Row C) immediately before the first real imaging frame,
//     shortening the last pause repeat by FLUSH_INTERVAL_MS so total pause duration is exact.
//       fr == 1 → Row B (iMs-60 ms) + Row C (60 ms)           = iMs  ✓
//       fr >  1 → Row A (fr-1 × iMs) + Row B (iMs-60 ms) + Row C (60 ms)  = fr×iMs  ✓
//     If per-frame interval <= FLUSH_INTERVAL_MS the flush is skipped (no timing overhead).
//     Without flush, the first frame after any pause is bright due to charge accumulated in
//     the sensor while it waited for a trigger.
//
//  constIllum IS PRESERVED from the original row in every keep-alive / flush row so that
//  photoswitching illumination continues uninterrupted throughout the pause.
//
//  Row layout (cols 0-10):
//    0  display row#   1  channel ("")   2  exposureMs   3  intervalMs
//    4  frames         5  loopGoto       6  loopTimes
//    7  constIllum (preserved)  8  loopSwitchGoto
//    9  "keepAlive" or ""       10 original 1-based row# ("" on keep-alive/flush rows)
//
//  If no row needs expansion, originalRows is returned as-is (zero overhead).
ArrayList expandPauseRows(ArrayList originalRows) {
    final int THRESHOLD_MS      = 30000; // keep-alive for pauses > 30 s (camera timeout)
    final int KA_INTERVAL_MS    = 10000; // keep-alive pulse every 10 s
    final int KA_EXPOSURE_MS    = 1;     // 1 ms — enough to trigger the camera; minimises light
                                          // dose through constIllum on keep-alive + flush rows
    final int FLUSH_THRESHOLD_MS = 500;  // flush trigger for pauses > 500 ms
    final int FLUSH_INTERVAL_MS  = 60;   // flush trigger interval: 1 ms exposure + ~59 ms gap
                                          // → readout (~20 ms) + ~39 ms idle before real frame

    int N = originalRows.size();

    // ---- Pass 1: build orig2exp[1..N] mapping ----
    // Row index 0 in the expanded table is always the pre-acquisition flush trigger.
    // Therefore expanded row indices start at 2 (1-based) so that orig2exp shifts all
    // loopGoto / loopSwitchGoto references by +1 automatically.
    int[] orig2exp = new int[N + 1]; // 1-based; index 0 unused
    boolean anyExpansion = false;    // used only to log whether pause rows were found
    int ei = 2; // 1-based; row 1 is reserved for the pre-acquisition flush trigger
    for (int i = 0; i < N; i++) {
        orig2exp[i + 1] = ei;
        ArrayList row = (ArrayList) originalRows.get(i);
        int exp = 0;
        try { exp = Integer.parseInt(row.get(2).toString().trim()); } catch (Exception e) {}
        if (exp == 0) {
            int iMs = 0, fr = 0;
            try { iMs = Integer.parseInt(row.get(3).toString().trim()); } catch (Exception e) {}
            try { fr  = Integer.parseInt(row.get(4).toString().trim()); } catch (Exception e) {}
            long totalMs = fr > 0 ? (long)iMs * fr : 0;
            if (totalMs > THRESHOLD_MS) {
                // Row A + Row B' (shortened) + Row C (flush) = 3 rows
                ei += 3; anyExpansion = true; continue;
            } else if (totalMs > FLUSH_THRESHOLD_MS) {
                if (iMs > FLUSH_INTERVAL_MS) {
                    // Timing-precise: shorten last repeat by FLUSH_INTERVAL_MS, append Row C.
                    // fr==1 → 2 rows; fr>1 → Row A (fr-1 full) + Row B (1 shortened) + Row C = 3 rows
                    ei += (fr > 1) ? 3 : 2; anyExpansion = true;
                } else {
                    // Per-frame interval too short to absorb flush without going invalid;
                    // fall through — original row copied as-is, no flush, no timing overhead.
                    ei += 1;
                }
                continue;
            }
        }
        ei += 1;
    }

    // ---- Pass 2: always build expanded list ----
    // (The pre-acquisition flush row is always prepended, so we never short-circuit.)
    ArrayList expanded = new ArrayList();
    for (int i = 0; i < N; i++) {
        ArrayList row = (ArrayList) originalRows.get(i);

        int expMs = 0;
        try { expMs = Integer.parseInt(row.get(2).toString().trim()); } catch (Exception e) {}

        String constIllum = "";
        try { constIllum = row.get(7).toString().trim(); } catch (Exception e) {}

        if (expMs == 0) {
            int iMs = 0, fr = 0;
            try { iMs = Integer.parseInt(row.get(3).toString().trim()); } catch (Exception e) {}
            try { fr  = Integer.parseInt(row.get(4).toString().trim()); } catch (Exception e) {}
            long totalMs = fr > 0 ? (long)iMs * fr : 0;

            if (totalMs > THRESHOLD_MS) {
                // ---- Long pause: keep-alive rows + flush trigger ----
                // kaFrames >= 2 for totalMs > 30 000 ms
                int kaFrames = (int)((totalMs - KA_INTERVAL_MS) / KA_INTERVAL_MS);
                long rowBInterval = totalMs - (long)(kaFrames - 1) * KA_INTERVAL_MS;
                // Shorten Row B by FLUSH_INTERVAL_MS; Row C (flush) provides the
                // final trigger and absorbs those ms → total timing preserved exactly.
                long rowBIntervalShort = rowBInterval - FLUSH_INTERVAL_MS;

                int origLg = 0, origLsg = 0; String origLt = "";
                try { origLg  = Integer.parseInt(row.get(5).toString().trim()); } catch (Exception e) {}
                try { origLsg = Integer.parseInt(row.get(8).toString().trim()); } catch (Exception e) {}
                try { origLt  = row.get(6).toString().trim();                   } catch (Exception e) {}
                int newLg  = (origLg  > 0 && origLg  <= N) ? orig2exp[origLg]  : 0;
                int newLsg = (origLsg > 0 && origLsg <= N) ? orig2exp[origLsg] : 0;

                // Row A: (kaFrames-1) keep-alive frames @ KA_INTERVAL_MS, no loop
                ArrayList rowA = new ArrayList();
                rowA.add(row.get(0)); rowA.add(""); rowA.add(String.valueOf(KA_EXPOSURE_MS));
                rowA.add(String.valueOf(KA_INTERVAL_MS)); rowA.add(String.valueOf(kaFrames - 1));
                rowA.add(""); rowA.add(""); rowA.add(constIllum);
                rowA.add(""); rowA.add("keepAlive"); rowA.add("");
                expanded.add(rowA);

                // Row B': last keep-alive, shortened interval — NO loop refs so the
                // Arduino falls through to Row C (flush) rather than jumping past it.
                ArrayList rowB = new ArrayList();
                rowB.add(row.get(0)); rowB.add(""); rowB.add(String.valueOf(KA_EXPOSURE_MS));
                rowB.add(String.valueOf((int)rowBIntervalShort)); rowB.add("1");
                rowB.add(""); rowB.add(""); rowB.add(constIllum);
                rowB.add(""); rowB.add("keepAlive"); rowB.add("");
                expanded.add(rowB);

                // Row C: flush trigger — fires one short trigger so the sensor is reset;
                // carries the loop/switch refs from the original pause row so the Arduino
                // jumps to the correct imaging row after the flush fires.
                ArrayList rowC = new ArrayList();
                rowC.add(row.get(0)); rowC.add(""); rowC.add(String.valueOf(KA_EXPOSURE_MS));
                rowC.add(String.valueOf(FLUSH_INTERVAL_MS)); rowC.add("1");
                rowC.add(newLg  > 0 ? String.valueOf(newLg)  : "");
                rowC.add(origLt); rowC.add(constIllum);
                rowC.add(newLsg > 0 ? String.valueOf(newLsg) : "");
                rowC.add("keepAlive"); rowC.add("");
                expanded.add(rowC);
                continue;

            } else if (totalMs > FLUSH_THRESHOLD_MS) {
                // ---- Medium pause (500 ms – 30 s) ----
                // Precise timing: shorten the last pause repeat by FLUSH_INTERVAL_MS, then append
                // Row C so the total duration is preserved exactly.
                //   fr==1: Row B (iMs-60 ms pause) + Row C (60 ms flush) = iMs              ✓
                //   fr>1:  Row A (fr-1 full pauses) + Row B (1 shortened) + Row C = fr*iMs  ✓
                // If iMs <= FLUSH_INTERVAL_MS the interval is too short to absorb the flush;
                // fall through to the non-expanded copy path — no flush, no timing overhead.

                if (iMs > FLUSH_INTERVAL_MS) {
                    int origLg = 0, origLsg = 0; String origLt = "";
                    try { origLg  = Integer.parseInt(row.get(5).toString().trim()); } catch (Exception e) {}
                    try { origLsg = Integer.parseInt(row.get(8).toString().trim()); } catch (Exception e) {}
                    try { origLt  = row.get(6).toString().trim();                   } catch (Exception e) {}
                    int newLg  = (origLg  > 0 && origLg  <= N) ? orig2exp[origLg]  : 0;
                    int newLsg = (origLsg > 0 && origLsg <= N) ? orig2exp[origLsg] : 0;

                    if (fr > 1) {
                        // Row A: (fr-1) full-interval pause frames, no loop refs
                        ArrayList rowA = new ArrayList();
                        rowA.add(row.get(0)); rowA.add(""); rowA.add("0");
                        rowA.add(String.valueOf(iMs)); rowA.add(String.valueOf(fr - 1));
                        rowA.add(""); rowA.add(""); rowA.add(constIllum);
                        rowA.add(""); rowA.add(""); rowA.add("");
                        expanded.add(rowA);
                    }

                    // Row B: last pause frame, shortened by FLUSH_INTERVAL_MS — NO loop refs
                    // so the Arduino falls through to Row C (flush) rather than jumping past it.
                    ArrayList rowB = new ArrayList();
                    rowB.add(row.get(0)); rowB.add(""); rowB.add("0");
                    rowB.add(String.valueOf(iMs - FLUSH_INTERVAL_MS)); rowB.add("1");
                    rowB.add(""); rowB.add(""); rowB.add(constIllum);
                    rowB.add(""); rowB.add(""); rowB.add(String.valueOf(i + 1));
                    expanded.add(rowB);

                    // Row C: flush trigger — fires one short trigger so the sensor is reset;
                    // carries the loop/switch refs from the original pause row so the Arduino
                    // jumps to the correct imaging row after the flush fires.
                    ArrayList rowC = new ArrayList();
                    rowC.add(row.get(0)); rowC.add(""); rowC.add(String.valueOf(KA_EXPOSURE_MS));
                    rowC.add(String.valueOf(FLUSH_INTERVAL_MS)); rowC.add("1");
                    rowC.add(newLg  > 0 ? String.valueOf(newLg)  : "");
                    rowC.add(origLt); rowC.add(constIllum);
                    rowC.add(newLsg > 0 ? String.valueOf(newLsg) : "");
                    rowC.add("keepAlive"); rowC.add("");
                    expanded.add(rowC);
                    continue;
                }
                // iMs <= FLUSH_INTERVAL_MS: fall through to non-expanded copy path
            }
        }

        // Non-expanded row: copy, remap loop references, store original 1-based row# in col 10
        ArrayList nr = new ArrayList(row);
        while (nr.size() <= 9) nr.add(""); nr.set(9, "");

        int lg = 0;
        try { lg = Integer.parseInt(nr.get(5).toString().trim()); } catch (Exception e) {}
        if (lg > 0 && lg <= N) nr.set(5, String.valueOf(orig2exp[lg]));

        int lsg = 0;
        try { lsg = Integer.parseInt(nr.get(8).toString().trim()); } catch (Exception e) {}
        if (lsg > 0 && lsg <= N) nr.set(8, String.valueOf(orig2exp[lsg]));

        while (nr.size() <= 10) nr.add("");
        nr.set(10, String.valueOf(i + 1));
        expanded.add(nr);
    }

    // Append end-sentinel row (always last, before the flush prepend).
    // The Arduino loops this row indefinitely (frames=0, exposure=1ms, interval=500ms),
    // keeping the camera receiving triggers after all real imaging rows are done.
    // When BeanShell's frame-pop detects a frame from this row (col9="endSentinel")
    // it sets running[0]=false while the Arduino is still active, so
    // stopSequenceAcquisition() returns immediately instead of blocking for ~40s.
    ArrayList sentinelRow = new ArrayList();
    sentinelRow.add(""); sentinelRow.add(""); sentinelRow.add(String.valueOf(KA_EXPOSURE_MS));
    sentinelRow.add("500"); sentinelRow.add("0"); // frames=0: infinite until byte 66
    sentinelRow.add(""); sentinelRow.add(""); sentinelRow.add("0"); sentinelRow.add("");
    sentinelRow.add("endSentinel"); sentinelRow.add("");
    expanded.add(sentinelRow);

    // Prepend the pre-acquisition flush trigger as expanded row 0 (Arduino row 1).
    // This fires one short camera trigger (1 ms) with a 60 ms total interval just
    // before the very first real imaging frame, resetting the sensor and eliminating
    // the bright-first-frame artifact caused by charge accumulated while the camera
    // was armed and waiting.  constIllum = 0 (no prior photoswitching state).
    ArrayList flushRow0 = new ArrayList();
    flushRow0.add(""); flushRow0.add(""); flushRow0.add(String.valueOf(KA_EXPOSURE_MS));
    flushRow0.add(String.valueOf(FLUSH_INTERVAL_MS)); flushRow0.add("1");
    flushRow0.add(""); flushRow0.add(""); flushRow0.add(""); flushRow0.add("");
    flushRow0.add("keepAlive"); flushRow0.add("");
    expanded.add(0, flushRow0);

    print("expandPauseRows: " + N + " original rows → " + expanded.size()
        + " expanded rows (pre-acq flush + end-sentinel + "
        + (anyExpansion ? "keep-alive + pause flush triggers" : "no pause expansion")
        + " injected).");
    return expanded;
}

// ==================== Main Acquisition Loop (Circular Buffer) ====================
void runCircularBufferAcquisition(boolean[] running, ArrayList dataRows, ArrayList correctedDataRows, ArrayList btCorrDataRows, ArrayList datasets, long[] startTime, JPanel liveViewPanel, ArrayList chartsList, ArrayList chartPanels, JFrame acqFrame, JLabel frameCounterLabel, ArrayList switchEvents, int numActiveGraphs, ArrayList eventTimes) {

    // Verify experiment folder exists
    if (config.experimentFolder == null || config.experimentFolder.isEmpty()) {

        return;
    }

    File expFolder = new File(config.experimentFolder);
    if (!expFolder.exists()) {

        return;
    }

    if (!expFolder.canWrite()) {

        return;
    }


    // Get stored ROIs from config (default full-image ROIs already created by caller if needed).
    // print("Using " + config.storedROIs.size() + " stored ROIs");

    // Setup circular buffer
    setupCircularBuffer();

    // Calculate approximate buffer capacity for monitoring
    long maxMem = Runtime.getRuntime().maxMemory();
    long bufferMem = (long)(maxMem * 0.75);
    int imageWidth = (int) mmc.getImageWidth();
    int imageHeight = (int) mmc.getImageHeight();
    int bytesPerPixel = (int) mmc.getBytesPerPixel();
    long bytesPerImage = imageWidth * imageHeight * bytesPerPixel;
    int approxCapacity = (int)(bufferMem / bytesPerImage);

    // PRE-ARM CLEANUP:
    // Order matters carefully here — each step prevents a specific contamination path.

    // Step 0: Pause the Arduino-Hub monitor thread so it stops sending keep-alive
    //         byte-40 queries while LUMETRIC has exclusive ownership of the serial port.
    //         Without this the monitor thread can interleave with LUMETRIC traffic,
    //         garbling the switch-notification packets we need to read back.
    try {
        mmc.setProperty("Arduino-Hub", "Paused", "1");
        print("Pre-arm: Arduino-Hub monitor thread paused.");
    } catch (Exception e) {
        print("NOTE: Could not pause Arduino-Hub (property may not exist in this MM build): " + e.getMessage());
    }

    // Step 1: Stop Arduino immediately so no TTL pulses arrive while the camera
    //         is in an undefined transition state.  Sending 66 is idempotent.
    print("Pre-arm: sending Arduino stop (byte 66) to ensure no stray TTL pulses...");
    try {
        mmcorej.CharVector cv66pre = new mmcorej.CharVector();
        cv66pre.add((char)66);
        mmc.writeToSerialPort(config.serialPort, cv66pre);
        print("  Arduino stop sent.");
    } catch (Exception e) { print("  NOTE: Could not send stop byte: " + e.getMessage()); }

    // Step 2: Stop MM live mode if it is running.
    //         mm.live() uses the same sequence-acquisition engine as
    //         startSequenceAcquisition(); calling both simultaneously leaves
    //         the Hamamatsu adapter in an undefined state.
    try {
        if (mm.live().isLiveModeOn()) {
            print("  Live mode was ON — stopping it before arming.");
            mm.live().setLiveMode(false);
            Thread.sleep(400); // wait for live thread to exit
        }
    } catch (Exception e) { print("  NOTE: Live mode stop: " + e.getMessage()); }

    // Step 3: Disable auto-shutter NOW, before touching any trigger config.
    //         If auto-shutter is on while the camera transitions into Level trigger
    //         mode it can fire one "free" global-reset cycle, leaving residual
    //         charge in the sensor that adds to frame 0 → double-bright first frame.
    try { mmc.setAutoShutter(false); } catch (Exception e) {}
    try { mmc.setShutterOpen(false); } catch (Exception e) {}

    // Step 4: Stop any leftover sequence from the previous run.
    //
    //         Normal cleanup: stopSequenceAcquisition() is called inside the
    //         acquisition loop's drain-bound block (while Arduino is still active),
    //         so it returns immediately.  isSequenceRunning() is therefore FALSE here
    //         on a clean second run \u2192 else-branch fires as a harmless no-op.
    //
    //         Crash-recovery: if the previous run was killed before the drain block
    //         ran, isSequenceRunning() may still be TRUE.  The if-branch handles that:
    //         snap config switches DCAM to INTERNAL trigger (breaks any leftover
    //         trigger-wait), 300 ms gives DCAM time to absorb the change, then stop.
    if (mmc.isSequenceRunning()) {
        print("Pre-arm: sequence still running (MM flag set) — stopping cleanly...");
        // Snap config is already set by cleanup; applying it again is harmless and
        // ensures we're safe even if cleanup ran in an unexpected order.
        try { mmc.setConfig(config.cameraConfigGroup, config.cameraSnapConfig); } catch (Exception e) {}
        Thread.sleep(300);
        try { mmc.stopSequenceAcquisition(); } catch (Exception e) {}
        Thread.sleep(200);
    } else {
        // isSequenceRunning() is false — first run, or sequence was already closed.
        // Snap config is already set (or will be set momentarily); bare stop is harmless.
        print("Pre-arm: sequence already stopped.");
        try { mmc.stopSequenceAcquisition(); } catch (Exception e) {}
    }

    // Step 5: Confirm sequence is actually stopped.
    if (mmc.isSequenceRunning()) {
        print("WARNING: Sequence still running after stopSequenceAcquisition — retrying.");
        try { mmc.stopSequenceAcquisition(); Thread.sleep(300); } catch (Exception e) {}
    }

    // Step 6: Flush any frames that arrived during cleanup.
    try { mmc.clearCircularBuffer(); } catch (Exception e) {}

    print("Pre-arm cleanup done.");

    // Set camera to triggered mode.
    // Auto-shutter is already OFF (done in pre-arm step 3) so the camera
    // cannot self-expose during the 1.5 s transition into Level trigger mode.
    // If byte 61 fires too soon, early frames still use EDGE + internal exposure
    // → integration ≠ J0 HIGH duration → wrong brightness for those frames.
    try {
        print("=== CAMERA CONFIG SWITCH ===");
        print("  Config group : " + config.cameraConfigGroup);
        print("  Config preset: " + config.cameraTriggerConfig);
        mmc.setConfig(config.cameraConfigGroup, config.cameraTriggerConfig);
        Thread.sleep(1500); // Hamamatsu needs ~1-1.5 s to fully apply LEVEL trigger mode

        // Dump every property defined in the config preset so we can verify
        // TriggerSource, TriggerActive, GlobalExposure etc. are all applied.
        // NOTE: each getProperty() is a synchronous serial round-trip to the camera
        // (~100-500 ms on a slow USB adapter). Keep behind DEBUG_VERBOSE to avoid
        // adding 1-5 seconds of startup latency during normal operation.
        if (DEBUG_VERBOSE) {
            try {
                mmcorej.Configuration cfgData = mmc.getConfigData(config.cameraConfigGroup, config.cameraTriggerConfig);
                print("  Properties in preset '" + config.cameraTriggerConfig + "' (" + cfgData.size() + " total):");
                for (int pi = 0; pi < (int)cfgData.size(); pi++) {
                    mmcorej.PropertySetting ps = cfgData.getSetting(pi);
                    String liveVal = "";
                    try { liveVal = mmc.getProperty(ps.getDeviceLabel(), ps.getPropertyName()); } catch (Exception re) { liveVal = "?"; }
                    print("    [" + ps.getDeviceLabel() + "] " + ps.getPropertyName()
                          + " = " + ps.getPropertyValue()
                          + "  (live: " + liveVal + ")");
                }
            } catch (Exception dumpEx) {
                print("  WARNING: Could not dump config preset: " + dumpEx.getMessage());
            }
        }
        print("=== END CAMERA CONFIG ===");
    } catch (Exception e) {
        print("ERROR: Failed to set camera config: " + e.getMessage());
        return;
    }

    // Number of frames DCAM pre-allocates in its ring buffer per acquisition run.
    // 10000 frames @ 1 fps ≈ 2.8 h — effectively unlimited for any realistic experiment.
    // The watchdog will restart DCAM if the buffer is ever exhausted, but this should
    // never happen in practice. (Reference: Paulis_AACon used 500000 without issues.)
    int numFrames = 10000;
    // stopOnOverflow=true: MM stops inserting frames into its circular buffer when full,
    // preventing overwrite of unread frames. Must stay true to avoid dropped data.
    boolean stopOnOverflow = true;

    try {
        // Auto-shutter is already disabled (pre-arm step 3); shutter is already closed.
        // Confirm state just in case some other code re-enabled it.
        mmc.setAutoShutter(false);
        mmc.setShutterOpen(false);
        Thread.sleep(50);
        mmc.startSequenceAcquisition(numFrames, 0, stopOnOverflow);
        // NOTE: do NOT call setConfig() or setProperty() on the camera here.
        // The DCAM driver treats any property write while the sequence is running
        // as a mode reconfiguration and resets the capture engine to free-running
        // internal trigger → rolling shutter with no TTL synchronisation.
        // Debug readback (DEBUG_VERBOSE) confirmed all preset properties survive
        // startSequenceAcquisition() correctly without any post-arm correction.

        // DEBUG: read back all preset properties immediately after arming to detect
        // whether the adapter silently resets them (e.g. TRIGGER SOURCE → INTERNAL).
        // Each getProperty() is a synchronous serial round-trip; gated on DEBUG_VERBOSE
        // to avoid adding ~1-4 s startup latency during normal operation.
        if (DEBUG_VERBOSE) {
            print("=== POST-ARM PROPERTY READBACK ===");
            try {
                mmcorej.Configuration cfgData = mmc.getConfigData(config.cameraConfigGroup, config.cameraTriggerConfig);
                for (int pi = 0; pi < (int)cfgData.size(); pi++) {
                    mmcorej.PropertySetting ps = cfgData.getSetting(pi);
                    String live = "?";
                    try { live = mmc.getProperty(ps.getDeviceLabel(), ps.getPropertyName()); } catch (Exception re) {}
                    String status = live.equals(ps.getPropertyValue()) ? "OK" : "*** RESET ***";
                    print("  [" + status + "] " + ps.getPropertyName()
                          + " : preset=" + ps.getPropertyValue() + "  live=" + live);
                }
            } catch (Exception dbg) { print("  readback failed: " + dbg.getMessage()); }
            print("==================================");
        }

        // Give the camera time to finish its internal arming sequence before
        // the first Arduino trigger pulse arrives.
        Thread.sleep(500);

        // CRITICAL: flush the circular buffer right before releasing Arduino.
        // Any frames that crept in during mode-switch or arming (spurious free
        // cycles, live-mode remnants, etc.) must be discarded here.  If we do
        // not flush, frame 0 in the buffer will be garbage and, when popped,
        // its pixel values add on top of the real first-frame readout in the
        // next pop → one double-bright frame at the start of every acquisition.
        try {
            int staleFrames = (int) mmc.getRemainingImageCount();
            if (staleFrames > 0) {
                print("WARNING: " + staleFrames + " stale frame(s) in buffer before byte 61 — flushing.");
            }
            mmc.clearCircularBuffer();
            print("Circular buffer flushed — camera ready for first Arduino trigger.");
        } catch (Exception flushEx) {
            print("NOTE: Buffer flush: " + flushEx.getMessage());
        }

        // Camera is armed and buffer is clean — send byte 61 to start Arduino trigger loop.
        if (config.useCircularBuffer && !config.useSimpleSnapMode) {
            try {
                mmcorej.CharVector cv61 = new mmcorej.CharVector();
                cv61.add((char)61);
                mmc.writeToSerialPort(config.serialPort, cv61);
                print("Byte 61 sent — Arduino acquisition started.");
            } catch (Exception ardEx) {
                print("Arduino start error: " + ardEx.getMessage());
            }
        }
    } catch (Exception e) {
        print("ERROR: Failed to start sequence acquisition: " + e.getMessage());
        e.printStackTrace();
        // Snap config FIRST (breaks trigger-wait, prevents 30s hang), then stop
        try {
            mmc.setConfig(config.cameraConfigGroup, config.cameraSnapConfig);
            Thread.sleep(200);
            print("Camera restored to snap config after arm failure.");
        } catch (Exception ce) { print("WARNING: Could not restore snap config: " + ce.getMessage()); }
        try { mmc.stopSequenceAcquisition(); } catch (Exception ce) {}
        // Do NOT call setAutoShutter(true) here — see teardown section for rationale.
        return;
    }

    // Timing reference anchored to the moment byte 61 fires (Arduino starts), not GUI creation.
    // startTime[0] was set several seconds earlier at GUI init — that offset would make
    // all timestamps in the CSV/graphs appear shifted by the full pre-arm duration.
    // (Same approach as Paulis_AACon: `long start = System.nanoTime()` after serial write.)
    // Update startTime[0] NOW so event button timestamps match frame timestamps.
    long acqLoopStart = System.currentTimeMillis();
    print("=== TIMING ANCHOR DEBUG ===");
    print("  acquisitionStartTime[0] BEFORE update: " + startTime[0]);
    print("  acqLoopStart (byte 61 time):            " + acqLoopStart);
    print("  Offset (GUI creation to byte 61):       " + (acqLoopStart - startTime[0]) + " ms");
    startTime[0] = acqLoopStart;
    print("  acquisitionStartTime[0] AFTER update:  " + startTime[0]);
    print("===========================");

    // Monitoring variables
    int maxBufferDepth = 0;
    long lastWarningTime = 0;
    int framesProcessed = 0;
    boolean overflowDetected = false;
    long lastGuiUpdateTime = 0;
    final long GUI_UPDATE_INTERVAL_MS = 100;

    // Trigger timeout detection
    long lastFrameTime = System.currentTimeMillis();
    long noFrameWarningTime = 0;
    final long NO_FRAME_WARNING_INTERVAL = 5000; // Warn every 5 seconds if no frames
    boolean noFrameWarningShown = false;

    // Switch-event tracking: every time the Arduino sends a [67][row][hi][lo] packet
    // we record which LUMETRIC frame was being processed and what the Arduino reported.
    // switchEvents is passed in from the outer scope so the caller can use it for CSV export.
    ArrayList rxAccum = new ArrayList();      // raw byte accumulator for partial packets

    // Shadow state machine: mirrors the Arduino's row-sequencing logic so we know
    // which sequence row is active for every frame without relying on serial packets.
    // Switch-button events (byte 67 packets) patch any retroactive mismatches.
    // Use the expanded table (with keep-alive rows) so the tracker exactly mirrors
    // what was uploaded to the Arduino.
    ArrayList trackerRows = (config.expandedSequenceRows != null)
        ? config.expandedSequenceRows : config.acqSettings.sequenceRows;
    RowTracker rowTracker = new RowTracker(trackerRows);

    // --- DCAM WATCHDOG THREAD ---
    // Polls isSequenceRunning() every 1 ms and sets dcamNeedsRestart to true the
    // moment DCAM's ring buffer is exhausted (all numFrames slots filled).
    // All CMMCore state-changing calls stay on the main thread; the watchdog only
    // reads state (isSequenceRunning() is a thread-safe read).
    // AtomicBoolean ensures the watchdog's write is immediately visible to the
    // main thread without relying on x86 hardware memory ordering.
    final java.util.concurrent.atomic.AtomicBoolean dcamNeedsRestart =
        new java.util.concurrent.atomic.AtomicBoolean(false);
    final Thread[] dcamWatchdog = {null};
    dcamWatchdog[0] = new Thread(new Runnable() {
        public void run() {
            int consecutiveFalse = 0;
            while (running[0]) {
                try {
                    if (!mmc.isSequenceRunning()) {
                        consecutiveFalse++;
                        // Require 5 consecutive false readings (5 ms) before signalling
                        // a restart.  startSequenceAcquisition() has a 1-2 ms internal
                        // initialisation window where isSequenceRunning() briefly returns
                        // false even though the sequence just started.  A single-poll check
                        // would fire a spurious restart on the very next loop iteration,
                        // causing a "restart not possible while sequence running" error.
                        if (consecutiveFalse >= 5) {
                            dcamNeedsRestart.set(true);
                            consecutiveFalse = 0;
                        }
                    } else {
                        consecutiveFalse = 0;
                    }
                    Thread.sleep(1);
                } catch (InterruptedException ie) {
                    break;
                } catch (Exception e) {
                    print("DCAM watchdog: isSequenceRunning() error — " + e.getMessage());
                }
            }
        }
    });
    dcamWatchdog[0].setDaemon(true);
    dcamWatchdog[0].start();

    // Main acquisition loop
    // Condition is split into two parts:
    //   (A) running[0] && (isSequenceRunning || dcamNeedsRestart) — normal active-acquisition gate
    //   (B) getRemainingImageCount() > 0 — drain MM's circular buffer after Stop
    // Part (B) is independent of running[0] so that frames already in MM's buffer when
    // the user clicks Stop are fully processed and saved before teardown.
    // Paulis_AACon stop order (enforced in the drain-bound block):
    //   stopSequenceAcquisition() first (Arduino still active \u2192 fast), then byte 66.
    // After DCAM is stopped, no new frames can arrive even if Arduino keeps triggering.
    //
    // drainBound: snapshot of getRemainingImageCount() taken after stop + byte 66.
    // The drain loop is capped at this count so that a null return from
    // popNextTaggedImage() (which should never happen but is an MM edge case) cannot
    // keep the drain spinning forever if the count never reaches zero.
    int drainBound = -1; // -1 = drain mode not yet entered
    // Third condition (!running[0] && drainBound < 0) guarantees the loop body runs
    // at least once after quit so the drain-bound block always fires — even when
    // getRemainingImageCount() is 0 at the exact moment running[0] becomes false.
    while ((running[0] && (mmc.isSequenceRunning() || dcamNeedsRestart.get())) || mmc.getRemainingImageCount() > 0 || (!running[0] && drainBound < 0)) {
        try {
            // --- DRAIN BOUND: activate on first post-Stop iteration ---
            if (!running[0]) {
                if (drainBound < 0) {
                    // First iteration after quit: stop DCAM while Arduino is still active.
                    // Calling stop BEFORE byte 66 (Paulis_AACon order) means DCAM is NOT
                    // in trigger-wait → stopSequenceAcquisition() returns immediately.
                    try { mmc.stopSequenceAcquisition(); } catch (Exception e) {}
                    // Now safe to kill Arduino triggers.
                    try {
                        mmcorej.CharVector cv66q = new mmcorej.CharVector();
                        cv66q.add((char)66);
                        mmc.writeToSerialPort(config.serialPort, cv66q);
                        print("Byte 66 sent (Arduino stopped).");
                    } catch (Exception e) {}
                    drainBound = (int) mmc.getRemainingImageCount();
                    if (drainBound > 0) print("Post-stop drain: " + drainBound + " frame(s) to flush.");
                }
                if (drainBound == 0) break;
            }

            // --- DCAM RESTART CHECK ---
            // Fires within ~1 ms of DCAM exhausting its ring buffer (watchdog latency).
            // startSequenceAcquisition() only reallocates DCAM's ring buffer;
            // MM's circular buffer and any unprocessed frames are completely untouched.
            if (dcamNeedsRestart.get() && running[0]) {
                // Clear the flag BEFORE attempting restart so that a failure doesn't
                // cause a tight retry loop on every iteration.  If restart fails,
                // the watchdog will re-detect the stopped DCAM and re-set the flag
                // after ~1 ms, giving a natural 1 ms back-off between retries.
                dcamNeedsRestart.set(false);
                try {
                    // Do NOT call stopSequenceAcquisition() here.
                    // DCAM already stopped naturally (all numFrames slots filled) so it
                    // is in idle state.  An explicit stop on an already-idle Hamamatsu
                    // camera is not a no-op — it can corrupt the DCAM capture-engine
                    // state machine, causing cascading errors on subsequent restarts
                    // (observed: camera LED flashes red/green on second restart).
                    // Just re-arm directly with startSequenceAcquisition().
                    mmc.startSequenceAcquisition(numFrames, 0, stopOnOverflow);
                    // Brief settle: give DCAM time to fully enter trigger-wait state
                    // before the next Arduino TTL pulse arrives.
                    Thread.sleep(50);
                    print("DCAM restarted at frame " + framesProcessed + ".");
                } catch (Exception re) {
                    print("WARNING: DCAM restart failed: " + re.getMessage());
                    // watchdog will re-set the flag once it detects DCAM is still stopped
                }
            }

            // --- SWITCH-NOTIFICATION POLL ---
            // Drain any bytes the Arduino has sent since the last loop iteration.
            // The Arduino sends [67][destRow_1based][hi][lo] when it executes a
            // LoopSwitchGoto step.  We accumulate bytes across iterations (partial
            // packets are normal at 57600 baud).
            try {
                mmcorej.CharVector rxBytes = mmc.readFromSerialPort(config.serialPort);
                for (int rxi = 0; rxi < (int)rxBytes.size(); rxi++) {
                    rxAccum.add(new Integer(((int)(rxBytes.get(rxi))) & 0xFF));
                }
                while (rxAccum.size() >= 4) {
                    if (((Integer)rxAccum.get(0)).intValue() == 67) {
                        int evRow  = ((Integer)rxAccum.get(1)).intValue();
                        int evFrHi = ((Integer)rxAccum.get(2)).intValue();
                        int evFrLo = ((Integer)rxAccum.get(3)).intValue();
                        int evArdFr = (evFrHi << 8) | evFrLo;
                        // ev[0] = first LUMETRIC frame on the new row.
                        // evArdFr is the Arduino's last frame on the old row, so
                        // evArdFr+1 is the first frame on the new row — this is
                        // authoritative regardless of how many frames BeanShell
                        // has dequeued so far (framesProcessed lags the buffer).
                        switchEvents.add(new int[]{ evArdFr + 1, evRow, evArdFr });
                        // Patch all three data lists and sync the tracker.
                        rowTracker.patch(evArdFr, evRow, dataRows, correctedDataRows, btCorrDataRows);
                        print("SWITCH EVENT: new row=" + evRow
                              + "  starts at LUMETRIC frame=" + (evArdFr + 1)
                              + "  Arduino totalFrames so far=" + evArdFr);
                        rxAccum.subList(0, 4).clear();
                    } else {
                        rxAccum.remove(0); // discard unexpected leading byte
                    }
                }
            } catch (Exception serialEx) { /* non-fatal — serial read is best-effort */ }

            int remaining = (int) mmc.getRemainingImageCount();

            // Track maximum buffer depth
            if (remaining > maxBufferDepth) {
                maxBufferDepth = remaining;
            }

            // Warning levels
            double bufferUsage = approxCapacity > 0 ? (double)remaining / approxCapacity : 0;

            if (bufferUsage > 0.90) {
                long currentTime = System.currentTimeMillis();
                if (currentTime - lastWarningTime > 5000) {
                    // print("CRITICAL: Buffer at " + (int)(bufferUsage * 100) + "% (" + remaining + "/" + approxCapacity + " frames)");

                    lastWarningTime = currentTime;
                }
            } else if (bufferUsage > 0.75) {
                long currentTime = System.currentTimeMillis();
                if (currentTime - lastWarningTime > 10000) {
                    // print("WARNING: Buffer at " + (int)(bufferUsage * 100) + "% (" + remaining + "/" + approxCapacity + " frames)");
                    lastWarningTime = currentTime;
                }
            }

            // Check for overflow
            if (mmc.isBufferOverflowed()) {
                if (!overflowDetected) {



                    overflowDetected = true;
                }
            }

            // Pop and process images
            if (remaining > 0) {
                // Pop next image from buffer
                Object taggedImg = mmc.popNextTaggedImage();

                if (taggedImg != null) {
                    // Decrement drain bound so the safety exit tracks actual pops.
                    if (!running[0] && drainBound > 0) drainBound--;

                    // Silently discard keep-alive frames (short dark camera-trigger-only
                    // exposures injected by expandPauseRows to prevent camera timeout
                    // during long pause/photoswitching rows).  Not saved, not graphed,
                    // not counted in framesProcessed.
                    if (rowTracker.isKeepAliveRow()) {
                        rowTracker.advanceFrame();
                        continue;
                    }

                    // End-sentinel frame: all real imaging rows are done.
                    // Set running[0]=false while the Arduino is still actively triggering
                    // so stopSequenceAcquisition() in the drain block returns immediately.
                    if (rowTracker.isEndSentinelRow()) {
                        print("End-sentinel reached - auto-quitting.");
                        running[0] = false;
                        rowTracker.advanceFrame();
                        // Export graph data now — the Quit button path won't run for natural ends.
                        exportGraphDataToCSV(dataRows, correctedDataRows, btCorrDataRows, numActiveGraphs, config.acqSettings.visualizationRows);
                        exportEventTimesToCSV(eventTimes);
                        SwingUtilities.invokeLater(new Runnable() {
                            public void run() { acqFrame.setVisible(false); }
                        });
                        continue;
                    }

                    framesProcessed++;
                    final int currentFrameCount = framesProcessed;
                    SwingUtilities.invokeLater(new Runnable() {
                        public void run() {
                            frameCounterLabel.setText("Frames: " + currentFrameCount);
                        }
                    });
                    long systemTime = System.currentTimeMillis();
                    long currentTime = systemTime - acqLoopStart;
                    boolean shouldUpdateGui = (currentTime - lastGuiUpdateTime) >= GUI_UPDATE_INTERVAL_MS;

                    if (framesProcessed <= 3) {
                        print("FRAME " + framesProcessed + ": systemTime=" + systemTime + ", acqLoopStart=" + acqLoopStart + ", timestamp=" + currentTime + " ms");
                    }

                    // Reset frame timeout
                    lastFrameTime = System.currentTimeMillis();
                    noFrameWarningShown = false;

                    // Convert TaggedImage to ImageProcessor via MM data layer.
                    // Matches Paulis_AACon: mm.data().ij().createProcessor(image)
                    // — avoids reflection on TaggedImage.pix, uses MM's own format/calibration pipeline.
                    ImageProcessor ip = null;
                    try {
                        org.micromanager.data.Image mmImage = mm.data().convertTaggedImage(taggedImg);
                        ip = mm.data().ij().createProcessor(mmImage);
                    } catch (Exception e) {
                        // print("WARNING: Could not convert image: " + e.getMessage());
                    }

                    if (ip != null) {
                        // Save image to disk (always)
                        saveImageAsTiff(taggedImg, framesProcessed, config.experimentFolder);

                        // Update live view (throttled, controlled by Live Pictures checkbox)
                        if (shouldUpdateGui && config.acqSettings.livePics) {
                            updateLiveView(liveViewPanel, ip, chartsList);
                        }

                        // Measure ROIs, store RAW + corrected rows, update graphs.
                        // advanceFrame() is called regardless of ip-null so the tracker
                        // stays in sync with framesProcessed even on conversion failures.
                        int currentSeqRow = rowTracker.advanceFrame();
                        processFrameData(ip, framesProcessed, currentTime, currentSeqRow,
                            dataRows, correctedDataRows, btCorrDataRows,
                            datasets, chartPanels, chartsList,
                            shouldUpdateGui);
                        if (shouldUpdateGui) {
                            lastGuiUpdateTime = currentTime;
                        }
                    } else {
                        // Conversion failed — still advance tracker so it stays aligned
                        // with framesProcessed (which was already incremented above).
                        rowTracker.advanceFrame();
                    }
                }
            } else {
                // No frames available - check if we're stuck waiting for triggers
                long currentTime = System.currentTimeMillis();
                long timeSinceLastFrame = currentTime - lastFrameTime;

                if (timeSinceLastFrame > NO_FRAME_WARNING_INTERVAL &&
                    currentTime - noFrameWarningTime > NO_FRAME_WARNING_INTERVAL) {

                    if (!noFrameWarningShown) {
                        // print("\n!!! WARNING: No frames received for " + (timeSinceLastFrame / 1000) + " seconds !!!");






                        noFrameWarningShown = true;
                    }
                    noFrameWarningTime = currentTime;
                }

                Thread.sleep(2); // Small delay to prevent busy-waiting
            }

        } catch (InterruptedException ie) {

            break;
        } catch (Exception e) {
            // print("ERROR in acquisition loop: " + e.getMessage());
            e.printStackTrace();
        }
    }

    // Stop watchdog thread — no longer needed once the acquisition loop exits.
    dcamWatchdog[0].interrupt();

    // ── PROGRESS WINDOW ──────────────────────────────────────────────────────
    // Shown immediately after the loop exits.  Uses an indeterminate progress bar
    // (pulsing animation) because step durations are hardware-dependent.
    // All Swing construction is on the EDT via invokeAndWait; status updates use
    // invokeLater (fire-and-forget from the acquisition thread).
    final JFrame[] statusFrame = {null};
    final JLabel[] statusLabel = {null};
    try {
        SwingUtilities.invokeAndWait(new Runnable() {
            public void run() {
                JFrame f = new JFrame("LUMETRIC");
                f.setDefaultCloseOperation(JFrame.DO_NOTHING_ON_CLOSE);
                f.setAlwaysOnTop(true);
                f.setResizable(false);

                JPanel panel = new JPanel();
                panel.setLayout(new BoxLayout(panel, BoxLayout.Y_AXIS));
                panel.setBorder(BorderFactory.createEmptyBorder(28, 40, 28, 40));
                panel.setBackground(Color.WHITE);

                JLabel title = new JLabel("Finishing experiment");
                title.setFont(title.getFont().deriveFont(java.awt.Font.BOLD, 14f));
                title.setAlignmentX(Component.CENTER_ALIGNMENT);

                JProgressBar bar = new JProgressBar();
                bar.setIndeterminate(true);
                bar.setAlignmentX(Component.CENTER_ALIGNMENT);
                bar.setMaximumSize(new Dimension(Integer.MAX_VALUE, 18));

                JLabel status = new JLabel("Stopping acquisition...");
                status.setFont(status.getFont().deriveFont(12f));
                status.setForeground(new Color(90, 90, 90));
                status.setAlignmentX(Component.CENTER_ALIGNMENT);

                panel.add(title);
                panel.add(Box.createVerticalStrut(16));
                panel.add(bar);
                panel.add(Box.createVerticalStrut(10));
                panel.add(status);

                f.setContentPane(panel);
                f.setMinimumSize(new Dimension(360, 1));
                f.pack();
                f.setLocationRelativeTo(null);
                f.setVisible(true);

                statusFrame[0] = f;
                statusLabel[0] = status;
            }
        });
    } catch (Exception swEx) { /* non-critical — continue without the window */ }

    // CLEANUP:
    // stopSequenceAcquisition() and byte 66 were already sent inside the acquisition
    // loop's drain-bound block (Paulis_AACon order: stop while Arduino active → fast).
    // Here we just restore camera state for MM GUI use.

    // 1. Byte 66 safety-net — redundant if drain block ran, but harmless and necessary
    //    if the loop exited naturally (DCAM's numFrames exhausted without user quit).
    try {
        mmcorej.CharVector cv66 = new mmcorej.CharVector();
        cv66.add((char)66);
        mmc.writeToSerialPort(config.serialPort, cv66);
    } catch (Exception e) {}

    // 2. Restore snap mode so MM GUI operations work correctly.
    //    (Snap preset contains only trigger properties — no ROI/binning reset.)
    SwingUtilities.invokeLater(new Runnable() { public void run() {
        if (statusLabel[0] != null) statusLabel[0].setText("Switching to snap mode..."); } });
    try {
        mmc.setConfig(config.cameraConfigGroup, config.cameraSnapConfig);
        print("Camera switched to snap mode.");
    } catch (Exception e) { print("WARNING: Could not switch to snap config: " + e.getMessage()); }

    // 3. Clear circular buffer.
    SwingUtilities.invokeLater(new Runnable() { public void run() {
        if (statusLabel[0] != null) statusLabel[0].setText("Clearing buffers..."); } });
    try {
        mmc.clearCircularBuffer();
        print("Circular buffer cleared.");
    } catch (Exception e) {}

    // 7. Reset Arduino Port J pins to LOW.
    try {
        mmcorej.CharVector cvReset = new mmcorej.CharVector();
        cvReset.add((char)1);
        cvReset.add((char)0);
        mmc.writeToSerialPort(config.serialPort, cvReset);
        print("Arduino Port J reset to LOW.");
    } catch (Exception e) {}

    // 8. Restore auto-shutter and resume Arduino-Hub.
    SwingUtilities.invokeLater(new Runnable() { public void run() {
        if (statusLabel[0] != null) statusLabel[0].setText("Restoring camera settings..."); } });
    try { mmc.setAutoShutter(true); } catch (Exception e) {}
    try {
        mmc.setProperty("Arduino-Hub", "Paused", "0");
        print("Arduino-Hub monitor thread resumed.");
    } catch (Exception e) {
        print("NOTE: Could not resume Arduino-Hub: " + e.getMessage());
    }

    // Export switch events log if any events were captured.
    if (switchEvents.size() > 0) {
        SwingUtilities.invokeLater(new Runnable() { public void run() {
            if (statusLabel[0] != null) statusLabel[0].setText("Saving event log..."); } });
        try {
            String switchCsvPath = config.experimentFolder + java.io.File.separator + "SwitchEvents.csv";
            java.io.PrintWriter swWriter = new java.io.PrintWriter(new java.io.FileWriter(switchCsvPath));
            swWriter.println("FirstFrameOnNewRow;DestRow_1based;Arduino_TotalFrames");
            for (int sei = 0; sei < switchEvents.size(); sei++) {
                int[] ev = (int[]) switchEvents.get(sei);
                swWriter.println(ev[0] + ";" + ev[1] + ";" + ev[2]);
            }
            swWriter.close();
            print("Switch events saved to: " + switchCsvPath);
        } catch (Exception csvEx) {
            print("WARNING: Could not write SwitchEvents.csv: " + csvEx.getMessage());
        }
    }

    // Final report
    if (approxCapacity > 0) {
        // print("Peak buffer usage: " + (int)((double)maxBufferDepth / approxCapacity * 100) + "%");
    }

    // Convert to stack if requested — this is the potentially long step.
    if (config.acqSettings.convertToStack || config.acqSettings.stackPerRow) {
        SwingUtilities.invokeLater(new Runnable() { public void run() {
            if (statusLabel[0] != null) statusLabel[0].setText("Converting images - please wait..."); } });
        if (config.acqSettings.convertToStack && config.acqSettings.stackPerRow) {
            // Both enabled: per-row first (keep originals), then full stack (deletes originals)
            convertTiffsToStacksPerRow(config.experimentFolder, dataRows, false);
            convertTiffsToStack(config.experimentFolder);
        } else if (config.acqSettings.convertToStack) {
            convertTiffsToStack(config.experimentFolder);
        } else {
            convertTiffsToStacksPerRow(config.experimentFolder, dataRows, true);
        }
    }

    // Dispose the acquisition frame (may already be invisible from quit handler).
    if (acqFrame != null) {
        try {
            SwingUtilities.invokeAndWait(new Runnable() {
                public void run() { acqFrame.dispose(); }
            });
        } catch (Exception ex) {
            try { acqFrame.dispose(); } catch (Exception ex2) {}
        }
    }

    // Hand off to main menu — update status text, give the EDT time to render it,
    // then swap windows.  Without the sleep the two invokeLater calls are queued
    // back-to-back and the dispose fires before the user ever sees the last message.
    SwingUtilities.invokeLater(new Runnable() { public void run() {
        if (statusLabel[0] != null) statusLabel[0].setText("Restarting LUMETRIC..."); } });
    try { Thread.sleep(600); } catch (Exception e) {}

    final String cbExpFolder = config.experimentFolder;
    SwingUtilities.invokeLater(new Runnable() {
        public void run() {
            if (statusFrame[0] != null) statusFrame[0].dispose();
            restartMainGUI(cbExpFolder);
        }
    });
}

// ==================== Main Acquisition Loop (Snap Mode with Full Sequence Logic) ====================
void runAcquisition(boolean[] running, ArrayList dataRows, ArrayList correctedDataRows, ArrayList btCorrDataRows, ArrayList datasets, long[] startTime, JPanel liveViewPanel, ArrayList chartsList, ArrayList chartPanels, JFrame acqFrame, JLabel frameCounterLabel) {

    // Verify experiment folder exists
    if (config.experimentFolder == null || config.experimentFolder.isEmpty()) {

        return;
    }

    // Get stored ROIs from config (default full-image ROIs already created by caller if needed).
    // print("Using " + config.storedROIs.size() + " stored ROIs");

    // Parse acquisition settings from table
    ArrayList sequence = config.acqSettings.sequenceRows;
    if (sequence == null || sequence.isEmpty()) {

        return;
    }

    // print("Executing " + sequence.size() + " step sequence");

    // Debug: Show configuration state

    // print("config.useCircularBuffer (from file): " + config.useCircularBuffer);
    // print("config.useSimpleSnapMode (from checkbox): " + config.useSimpleSnapMode);
    // print("Actual mode being used: " + (config.useSimpleSnapMode ? "Simple Snap Mode" : "Full Sequence Mode"));

    // Check if Simple Snap Mode is enabled
    if (config.useSimpleSnapMode) {




        // Get timing parameters from first row only
        ArrayList firstRow = (ArrayList) sequence.get(0);

        // Debug: print what we have
        // print("\nDEBUG: First row size = " + firstRow.size());
        for (int i = 0; i < firstRow.size(); i++) {
            Object val = firstRow.get(i);
            // print("  Column " + i + ": '" + val + "' (type: " + (val != null ? val.getClass().getName() : "null") + ")");
        }

        // Note: Column 0 is row number, actual data starts at column 1
        // Column 1 = Channel, Column 2 = Exposure, Column 3 = Interval, Column 4 = Frames
        String exposureStr = (String) firstRow.get(2);
        String intervalStr = (String) firstRow.get(3);

        int frameIntervalMs = 1000; // Default
        int exposureMs = 100;       // Default
        int maxFrames = Integer.MAX_VALUE; // No hard frame limit – run until user stops

        try {
            frameIntervalMs = Integer.parseInt(intervalStr.trim());
        } catch (Exception e) {
            // print("  ERROR parsing interval: " + e.getMessage() + ", using default " + frameIntervalMs + "ms");
        }

        try {
            exposureMs = Integer.parseInt(exposureStr.trim());
        } catch (Exception e) {
            // print("  ERROR parsing exposure: " + e.getMessage() + ", using default " + exposureMs + "ms");
        }

        int globalFrameNumber = 0;
        long lastGuiUpdateTime = 0;
        final long GUI_UPDATE_INTERVAL_MS = 100;

        // Track actual frame intervals for performance warning
        long maxActualFrameInterval = 0;
        long totalActualFrameInterval = 0;
        int frameIntervalCount = 0;
        long lastFrameTime = 0;


        // print("  Frame interval: " + frameIntervalMs + "ms (from table)");

        // print("  Mode: Timed acquisition (NOT rolling mode - will wait between frames)");

        // Make copies as final for use in popup messages
        final int finalFrameIntervalMs = frameIntervalMs;
        final int finalMaxFrames = maxFrames;

        // Apply snap config once before the loop (only when a config file is loaded).
        // In Simple Snap Mode without a config file the camera is already in the correct
        // state — calling setConfig would throw "preset does not exist".
        if (!config.useSimpleSnapMode) {
            mmc.setConfig(config.cameraConfigGroup, config.cameraSnapConfig);
        }

        // Re-enable auto-shutter for snap() mode (no Arduino TTL control).
        // If circular buffer mode ran previously, it left setAutoShutter(false) active,
        // which prevents the camera from opening its shutter during snap().
        try { mmc.setAutoShutter(true); } catch (Exception e) {}

        // Apply exposure from table row 1
        try { mmc.setExposure(exposureMs); } catch (Exception e) {
            print("WARNING: Could not set exposure: " + e.getMessage());
        }

        // Update timing reference to NOW (start of snap loop), so event timestamps match frame timestamps
        startTime[0] = System.currentTimeMillis();

        // Simple continuous snapping loop
        while (running[0] && globalFrameNumber < maxFrames) {
            try {
                globalFrameNumber++;
                final int currentFrameCount = globalFrameNumber;
                SwingUtilities.invokeLater(new Runnable() {
                    public void run() {
                        frameCounterLabel.setText("Frames: " + currentFrameCount);
                    }
                });
                long frameStartTime = System.currentTimeMillis();

                // Track actual frame interval for warning
                if (lastFrameTime > 0) {
                    long actualInterval = frameStartTime - lastFrameTime;
                    if (actualInterval > maxActualFrameInterval) {
                        maxActualFrameInterval = actualInterval;
                    }
                    totalActualFrameInterval += actualInterval;
                    frameIntervalCount++;
                }
                lastFrameTime = frameStartTime;

                // Debug: Log first few frames
                if (DEBUG_VERBOSE && globalFrameNumber <= 3) {

                }

                // Camera config was already applied once before this loop.
                if (DEBUG_VERBOSE && globalFrameNumber <= 3) {
                    // print("  About to call mm.live().snap()");
                }

                // WARNING: This is a BLOCKING call with NO TIMEOUT
                // If the camera/USB is too slow or stalled, this will HANG INDEFINITELY
                // and cause the entire script to freeze.
                // The frame interval check below only works if snap() returns successfully.
                long snapStartTime = System.currentTimeMillis();
                List images = mm.live().snap(false);
                long snapDuration = System.currentTimeMillis() - snapStartTime;

                // If snap took longer than frame interval, we're falling behind
                // But we DON'T break - we just skip the wait and continue as fast as possible
                if (snapDuration > frameIntervalMs) {
                    // Camera is too slow for the requested frame interval
                    // The script will just run at maximum camera speed instead of breaking
                }

                if (DEBUG_VERBOSE && globalFrameNumber <= 3) {
                    // print("  Snap completed, got " + (images != null ? images.size() : "null") + " images");
                }

                if (images == null || images.isEmpty()) {

                    Thread.sleep(1000);
                    continue;
                }

                org.micromanager.data.Image image = images.get(0);
                if (DEBUG_VERBOSE && globalFrameNumber <= 3) {

                }
                ImageProcessor ip = mm.data().ij().createProcessor(image);

                if (DEBUG_VERBOSE && globalFrameNumber <= 3) {

                }

                // Save image to disk (always)
                saveImageAsTiff(image, globalFrameNumber, config.experimentFolder);

                if (DEBUG_VERBOSE && globalFrameNumber <= 3) {

                }

                // Progress indicator every 25 frames (reduced from every 10)
                if (globalFrameNumber % 25 == 0) {

                }

                long currentTime = System.currentTimeMillis() - startTime[0];
                boolean shouldUpdateGui = (currentTime - lastGuiUpdateTime) >= GUI_UPDATE_INTERVAL_MS;

                if (DEBUG_VERBOSE && globalFrameNumber <= 3) {


                    // print("  Will update live view: " + ((shouldUpdateGui || globalFrameNumber <= 3) && config.acqSettings.livePics));
                }

                // Update live view if enabled (always update first few frames for debugging)
                if ((shouldUpdateGui || (DEBUG_VERBOSE && globalFrameNumber <= 3)) && config.acqSettings.livePics) {
                    updateLiveView(liveViewPanel, ip, chartsList);
                }

                if (DEBUG_VERBOSE && globalFrameNumber <= 3) {

                }

                // Measure ROIs, store RAW + corrected rows, update graphs
                boolean shouldUpdateGraphs = shouldUpdateGui || (DEBUG_VERBOSE && globalFrameNumber <= 3);
                processFrameData(ip, globalFrameNumber, currentTime, 1,
                    dataRows, correctedDataRows, btCorrDataRows,
                    datasets, chartPanels, chartsList,
                    shouldUpdateGraphs);
                if (shouldUpdateGraphs) {
                    lastGuiUpdateTime = currentTime;
                }

                // Timing logic for frame interval:
                // - Calculate how long this frame took (snap + processing + GUI updates)
                // - If faster than frameIntervalMs: sleep for the remaining time
                // - If slower than frameIntervalMs: NO SLEEP, just continue immediately
                // This means the script will acquire as fast as possible if camera is too slow
                long frameElapsed = System.currentTimeMillis() - frameStartTime;
                long waitTime = frameIntervalMs - frameElapsed;

                if (DEBUG_VERBOSE && globalFrameNumber <= 3) {


                    // print("  Waiting: " + (waitTime > 0 ? waitTime : 0) + "ms before next frame");
                }

                if (waitTime > 0) {
                    Thread.sleep(waitTime);  // Sleep to maintain requested frame interval
                } else {
                    // waitTime <= 0 means we're falling behind - just continue immediately
                    // This prevents breaking and allows acquisition at maximum camera speed
                }

            } catch (InterruptedException ie) {
                // print("Acquisition interrupted (InterruptedException)");
                break;
            } catch (Exception e) {
                // print("ERROR in simple snap loop at frame " + globalFrameNumber + ": " + e.getClass().getName() + ": " + e.getMessage());
                e.printStackTrace();

                // Don't break - try to continue
            }
        }




        // print("Total data rows: " + dataRows.size());

        // Wrap statistics display and frame disposal in try-finally to guarantee cleanup
        try {
            // Make final copies for use in popup messages
            final int finalGlobalFrameNumber = globalFrameNumber;
            final int finalFrameIntervalCount = frameIntervalCount;
            final long finalTotalActualFrameInterval = totalActualFrameInterval;
            final long finalMaxActualFrameInterval = maxActualFrameInterval;

            // Always show acquisition completion statistics
            String statsMsg;
            int msgType;
            String dialogTitle;

            if (finalFrameIntervalCount > 0) {
                long avgActualInterval = finalTotalActualFrameInterval / finalFrameIntervalCount;

                // Show warning if actual interval was significantly slower (>10% slower)
                if (avgActualInterval > finalFrameIntervalMs * 1.1) {
                    // Calculate percentage difference
                    double percentSlower = ((double)(avgActualInterval - finalFrameIntervalMs) * 100.0) / (double)finalFrameIntervalMs;
                    // Round to 1 decimal place
                    long percentSlowerRounded = Math.round(percentSlower * 10.0) / 10;

                    statsMsg = "Frame interval performance warning:\n\n" +
                        "Set Frame Interval: " + finalFrameIntervalMs + " ms\n" +
                        "Actual Average Frame Interval: " + avgActualInterval + " ms (" +
                        (Math.round(percentSlower * 10.0) / 10.0) + "% slower)\n" +
                        "Maximum Frame Interval: " + finalMaxActualFrameInterval + " ms\n\n" +
                        "Your camera could not keep up with the requested frame rate.\n" +
                        "For faster acquisition, consider using TTL hardware triggering.";
                    msgType = JOptionPane.WARNING_MESSAGE;
                    dialogTitle = "Frame Rate Warning";
                } else {
                    // Good performance
                    statsMsg = "Acquisition Complete\n\n" +
                        "Total Frames: " + finalGlobalFrameNumber + "\n" +
                        "Set Frame Interval: " + finalFrameIntervalMs + " ms\n" +
                        "Actual Average: " + avgActualInterval + " ms\n" +
                        "Maximum: " + finalMaxActualFrameInterval + " ms";
                    msgType = JOptionPane.INFORMATION_MESSAGE;
                    dialogTitle = "Acquisition Complete";
                }
            } else {
                // Less than 2 frames captured
                statsMsg = "Acquisition Stopped\n\n" +
                    "Total Frames: " + finalGlobalFrameNumber + "\n\n" +
                    "(Need at least 2 frames to calculate timing statistics)";
                msgType = JOptionPane.INFORMATION_MESSAGE;
                dialogTitle = "Acquisition Stopped";
            }

            // Show popup on EDT - use modal dialog to block until dismissed
            final String finalStatsMsg = statsMsg;
            final int finalMsgType = msgType;
            final String finalDialogTitle = dialogTitle;

            SwingUtilities.invokeAndWait(new Runnable() {
                public void run() {
                    JOptionPane.showMessageDialog(null, finalStatsMsg,
                        finalDialogTitle, finalMsgType);
                }
            });
        } catch (Exception ex) {
            System.err.println("ERROR showing statistics popup:");
            ex.printStackTrace();
        } finally {
            // ALWAYS dispose the acquisition frame, even if popup fails
            if (acqFrame != null) {
                try {
                    SwingUtilities.invokeAndWait(new Runnable() {
                        public void run() {
                            acqFrame.dispose();
                        }
                    });
                } catch (Exception ex) {
                    System.err.println("ERROR disposing acquisition frame:");
                    ex.printStackTrace();
                }
            }
        }

        // Convert to stack if requested
        if (config.acqSettings.convertToStack && config.acqSettings.stackPerRow) {
            convertTiffsToStacksPerRow(config.experimentFolder, dataRows, false);
            convertTiffsToStack(config.experimentFolder);
        } else if (config.acqSettings.convertToStack) {
            convertTiffsToStack(config.experimentFolder);
        } else if (config.acqSettings.stackPerRow) {
            convertTiffsToStacksPerRow(config.experimentFolder, dataRows, true);
        }

        // Return to main menu with settings from this experiment auto-reloaded
        final String snapExpFolder = config.experimentFolder;
        SwingUtilities.invokeLater(new Runnable() {
            public void run() { restartMainGUI(snapExpFolder); }
        });

        return; // Exit after simple mode completes
    }

    // ========== ADVANCED MODE: Full Sequence Logic ==========

    // print("Executing " + sequence.size() + " step sequence");

    int globalFrameNumber = 0; // Total frame counter across all steps
    int currentStepIndex = 0;  // Current step in sequence (0-based)
    long lastGuiUpdateTime = 0;
    final long GUI_UPDATE_INTERVAL_MS = 100;


    // Main acquisition loop with sequence logic
    while (running[0]) {
        try {
            // Get current step
            ArrayList stepRow = (ArrayList) sequence.get(currentStepIndex);

            // Debug: print what we got
            // print("\nDEBUG: Step row size = " + stepRow.size());
            for (int i = 0; i < stepRow.size(); i++) {
                // print("  Column " + i + ": '" + stepRow.get(i) + "'");
            }

            // Note: Column 0 is row number, actual data starts at column 1
            // Column 1 = Channel, Column 2 = Exposure, Column 3 = Interval, Column 4 = Frames, Column 5 = Loop Goto
            String channelName = (String) stepRow.get(1);
            String exposureStr = (String) stepRow.get(2);
            String intervalStr = (String) stepRow.get(3);
            String framesStr = (String) stepRow.get(4);
            String loopGotoStr = (String) stepRow.get(5);

            // Parse numeric values with error handling
            int exposureMs = 250; // default
            int frameIntervalMs = 1000; // default
            int framesInStep = 1; // default

            try {
                exposureMs = Integer.parseInt(exposureStr.trim());
            } catch (Exception e) {

            }

            try {
                frameIntervalMs = Integer.parseInt(intervalStr.trim());
            } catch (Exception e) {

            }

            try {
                framesInStep = Integer.parseInt(framesStr.trim());
            } catch (Exception e) {

            }

            // print("\n--- Step " + (currentStepIndex + 1) + ": " + channelName + " ---");

            // Set camera config and exposure for this channel
            if (!channelName.isEmpty()) {
                try {
                    mmc.setConfig(config.cameraConfigGroup, config.cameraSnapConfig);
                    Thread.sleep(50);
                    mmc.setExposure(exposureMs);
                } catch (Exception e) {
                    // print("WARNING: Failed to set channel config: " + e.getMessage());
                }
            }

            // Capture frames for this step
            for (int frameInStep = 0; frameInStep < framesInStep && running[0]; frameInStep++) {
                globalFrameNumber++;
                final int currentFrameCount = globalFrameNumber;
                SwingUtilities.invokeLater(new Runnable() {
                    public void run() {
                        frameCounterLabel.setText("Frames: " + currentFrameCount);
                    }
                });
                long frameStartTime = System.currentTimeMillis();

                // Snap image
                List images = mm.live().snap(false);
                if (images == null || images.isEmpty()) {

                    Thread.sleep(1000);
                    continue;
                }

                org.micromanager.data.Image image = images.get(0);
                ImageProcessor ip = mm.data().ij().createProcessor(image);

                // Save image to disk (always)
                saveImageAsTiff(image, globalFrameNumber, config.experimentFolder);

                long currentTime = System.currentTimeMillis() - startTime[0];
                boolean shouldUpdateGui = (currentTime - lastGuiUpdateTime) >= GUI_UPDATE_INTERVAL_MS;

                // Update live view if enabled and throttled
                if (shouldUpdateGui && config.acqSettings.livePics) {
                    updateLiveView(liveViewPanel, ip, chartsList);
                }

                // Measure ALL ROIs and log them
                ArrayList roiValues = measureROIs(ip);
                for (int roiIdx = 0; roiIdx < roiValues.size(); roiIdx++) {
                    // print("ROI" + (roiIdx + 1) + " [Frame " + globalFrameNumber + "]: " + roiValues.get(roiIdx));
                }

                // Build data row and store for CSV export
                ArrayList dataRow = buildDataRow(globalFrameNumber, currentTime, 1, roiValues);
                dataRows.add(dataRow);

                // Update graphs (throttled)
                if (shouldUpdateGui) {
                    updateGraphs(datasets, globalFrameNumber, currentTime, roiValues, chartPanels, chartsList);
                    lastGuiUpdateTime = currentTime;
                }

                // Wait for frame interval before next snap
                long frameElapsed = System.currentTimeMillis() - frameStartTime;
                long waitTime = frameIntervalMs - frameElapsed;
                if (waitTime > 0) {
                    Thread.sleep(waitTime);
                }

            } // End frames in step loop

            // Move to next step based on Loop Goto logic
            if (!loopGotoStr.isEmpty()) {
                try {
                    int nextStep = Integer.parseInt(loopGotoStr);
                    if (nextStep >= 1 && nextStep <= sequence.size()) {
                        currentStepIndex = nextStep - 1; // Convert to 0-based index

                    } else {

                        currentStepIndex++;
                    }
                } catch (NumberFormatException e) {

                    currentStepIndex++;
                }
            } else {
                // No loop goto, advance to next step
                currentStepIndex++;
            }

            // If we've gone past the last step and no loop, exit
            if (currentStepIndex >= sequence.size()) {

                break;
            }

        } catch (InterruptedException ie) {

            break;
        } catch (Exception e) {
            // print("ERROR in acquisition loop: " + e.getMessage());
            e.printStackTrace();
            break;
        }
    }



    // print("Total data rows: " + dataRows.size());

    // Convert to stack if requested
    if (config.acqSettings.convertToStack && config.acqSettings.stackPerRow) {
        convertTiffsToStacksPerRow(config.experimentFolder, dataRows, false);
        convertTiffsToStack(config.experimentFolder);
    } else if (config.acqSettings.convertToStack) {
        convertTiffsToStack(config.experimentFolder);
    } else if (config.acqSettings.stackPerRow) {
        convertTiffsToStacksPerRow(config.experimentFolder, dataRows, true);
    }

    // Dispose the acquisition frame after acquisition completes (Advanced Mode)
    if (acqFrame != null) {
        try {
            SwingUtilities.invokeAndWait(new Runnable() {
                public void run() {
                    acqFrame.dispose();
                }
            });
        } catch (Exception ex) {
            System.err.println("ERROR disposing acquisition frame (Advanced Mode):");
            ex.printStackTrace();
        }
    }

    // Return to main menu with settings from this experiment auto-reloaded
    final String advExpFolder = config.experimentFolder;
    SwingUtilities.invokeLater(new Runnable() {
        public void run() { restartMainGUI(advExpFolder); }
    });
}

// Helper: compute the frame-selection label used in CSV filenames.
String computeFrameLogicLabel(ArrayList vizRow, boolean isTemporal) {
    if (!isTemporal) {
        // Spatial mode: use Row Filter value for label
        if (vizRow.size() > 2) {
            String rowFilter = (String) vizRow.get(2);
            if (rowFilter != null && !rowFilter.trim().equals("All Rows")) {
                return rowFilter.replace(" ", ""); // e.g. "Row1"
            }
        }
        return "every";
    }
    String type  = (String) vizRow.get(1);
    String numer = (String) vizRow.get(2);
    String denom = (String) vizRow.get(3);
    String numerLabel = numer.replace(" ", "");   // e.g. "Row1", "1"
    String denomLabel = denom.replace(" ", "");
    if (type.equals("Ratio")) return numerLabel + "_div_" + denomLabel;
    if (numer.trim().equals("All Rows")) return "every"; // Intensity: all rows
    return numerLabel; // Intensity: just the numerator row
}

// Helper: write one CSV file for one graph using the given set of rows.
// corrSuffix is appended to the filename (e.g. "RAW", "BGcorr", "BTcorr").
// Data row layout: [0]=frame [1]=timestamp [2]=seqRow [3..]=roiValues

void exportSingleGraphCSV(ArrayList rows, String corrSuffix, File expFolder,
                           int graphIdx, ArrayList vizRow, String graphType,
                           String frameLogic, boolean isTemporal) {
    if (rows == null || rows.isEmpty()) return;

    int actualNumROIs = config.storedROIs != null ? config.storedROIs.size() : 0;
    String fileName = "Graph" + (graphIdx + 1) + "_"
        + graphType.replace(" ", "_").replace("/", "-")
        + "_" + frameLogic + "_" + corrSuffix + ".csv";
    File csvFile = new File(expFolder, fileName);

    try {
        PrintWriter writer = new PrintWriter(new FileWriter(csvFile));

        // --- Temporal Ratio (row-based) ---
        if (graphType.equals("Ratio") && isTemporal) {
            int numerRow = parseRowNumber((String) vizRow.get(2));
            int denomRow = parseRowNumber((String) vizRow.get(3)); // 0 = constant 1

            writer.print("Frame;Timestamp [ms];SeqRow");
            for (int roiIdx = 0; roiIdx < actualNumROIs; roiIdx++) {
                writer.print(";ROI" + (roiIdx + 1) + "_Ratio");
            }
            writer.println();

            // Carry the most-recently-seen denominator row forward
            ArrayList lastDenomROIs = null;

            for (int i = 0; i < rows.size(); i++) {
                ArrayList row = (ArrayList) rows.get(i);
                int seqRow = ((Integer) row.get(2)).intValue();

                // Cache denominator row values
                if (denomRow > 0 && seqRow == denomRow) {
                    lastDenomROIs = new ArrayList();
                    for (int ri = 0; ri < actualNumROIs; ri++) {
                        lastDenomROIs.add(row.get(3 + ri));
                    }
                }

                // Emit ratio when we hit a numerator row
                if (numerRow > 0 && seqRow == numerRow) {
                    ArrayList denomROIs;
                    if (denomRow == 0) {
                        denomROIs = new ArrayList();
                        for (int ri = 0; ri < actualNumROIs; ri++) denomROIs.add(new Double(1.0));
                    } else {
                        if (lastDenomROIs == null) continue; // No denominator seen yet
                        denomROIs = lastDenomROIs;
                    }
                    ArrayList numerROIs = new ArrayList();
                    for (int ri = 0; ri < actualNumROIs; ri++) numerROIs.add(row.get(3 + ri));
                    ArrayList ratios = calculateFrameRatio(numerROIs, denomROIs);
                    if (ratios == null || ratios.isEmpty()) continue;

                    writer.print(row.get(0) + ";");
                    writer.print(row.get(1));
                    writer.print(";" + seqRow);
                    for (int ri = 0; ri < ratios.size(); ri++) {
                        writer.print(";");
                        Object val = ratios.get(ri);
                        if (val != null) {
                            double v = ((Double) val).doubleValue();
                            writer.print(!Double.isNaN(v) && !Double.isInfinite(v) ? v : "NaN");
                        }
                    }
                    writer.println();
                }
            }

        // --- Split Ratio (Spatial mode) ---
        } else if (graphType.startsWith("Split ratio")) {
            int numRatios = actualNumROIs / 2;
            writer.print("Frame;Timestamp [ms];SeqRow");
            for (int roiIdx = 0; roiIdx < numRatios; roiIdx++) {
                writer.print(";Ratio" + (roiIdx + 1));
            }
            writer.println();

            for (int i = 0; i < rows.size(); i++) {
                ArrayList row = (ArrayList) rows.get(i);
                int seqRow = ((Integer) row.get(2)).intValue();
                if (shouldProcessFrame(seqRow, vizRow)) {
                    writer.print(row.get(0) + ";");
                    writer.print(row.get(1));
                    writer.print(";" + seqRow);
                    ArrayList roiValues = new ArrayList();
                    for (int roiIdx = 0; roiIdx < actualNumROIs; roiIdx++) {
                        roiValues.add(row.get(3 + roiIdx));
                    }
                    ArrayList ratios = calculateSpatialRatio(roiValues, graphType);
                    for (int roiIdx = 0; roiIdx < ratios.size(); roiIdx++) {
                        writer.print(";");
                        Object val = ratios.get(roiIdx);
                        if (val != null) {
                            double v = ((Double) val).doubleValue();
                            writer.print(!Double.isNaN(v) && !Double.isInfinite(v) ? v : "NaN");
                        }
                    }
                    writer.println();
                }
            }

        // --- Standard Intensity ---
        } else {
            int numROIsToExport = actualNumROIs;
            int roiOffset = 0;
            if (!isTemporal && (graphType.equals("Intensity") || graphType.startsWith("Intensity "))) {
                // Spatial mode: export only one half of the ROIs (N/2), matching the graph display.
                // Plain "Intensity" → source half (offset 0).
                // "Intensity X"    → the named half, using the same offset logic as updateGraphs.
                numROIsToExport = actualNumROIs / 2;
                if (graphType.startsWith("Intensity ")) {
                    String graphRegion = graphType.substring("Intensity ".length());
                    String srcRegion = config.acqSettings.spatialConfig.roiSourceRegion;
                    boolean matchesSource = srcRegion.equals(graphRegion);
                    roiOffset = matchesSource ? 0 : numROIsToExport;
                }
            }
            writer.print("Frame;Timestamp [ms];SeqRow");
            for (int roiIdx = 0; roiIdx < numROIsToExport; roiIdx++) {
                writer.print(";ROI" + (roiIdx + 1));
            }
            writer.println();

            for (int i = 0; i < rows.size(); i++) {
                ArrayList row = (ArrayList) rows.get(i);
                int seqRow = ((Integer) row.get(2)).intValue();
                if (shouldProcessFrame(seqRow, vizRow)) {
                    writer.print(row.get(0) + ";");
                    writer.print(row.get(1));
                    writer.print(";" + seqRow);
                    for (int roiIdx = 0; roiIdx < numROIsToExport; roiIdx++) {
                        writer.print(";");
                        Object val = row.get(3 + roiOffset + roiIdx);
                        if (val != null) writer.print(val);
                    }
                    writer.println();
                }
            }
        }

        writer.close();
    } catch (IOException e) {
        e.printStackTrace();
    }
}

// Orchestrator: calls exportSingleGraphCSV once per active correction level.
// To add bleedthrough correction later, pass allBTCorrRows and call exportSingleGraphCSV
// with corrSuffix "BTcorr" exactly as done for "BGcorr" below.
void exportGraphDataToCSV(ArrayList dataRows, ArrayList correctedDataRows,
                           ArrayList btCorrDataRows,
                           int numActiveGraphs, ArrayList visualizationRows) {
    if (dataRows.isEmpty()) return;

    File experimentFolder = new File(config.experimentFolder);
    if (!experimentFolder.exists()) return;

    boolean isTemporal = config.acqSettings.processingMode.equals("Temporal");
    boolean bgEnabled  = config.acqSettings.bgCorrectionEnabled && !correctedDataRows.isEmpty();
    boolean btEnabled  = config.acqSettings.btCorrectionEnabled && !btCorrDataRows.isEmpty();

    for (int graphIdx = 0; graphIdx < 4; graphIdx++) {
        if (graphIdx >= visualizationRows.size()) continue;
        ArrayList vizRow  = (ArrayList) visualizationRows.get(graphIdx);
        String graphType  = (String) vizRow.get(1);
        if (graphType == null || graphType.equals("none")) continue;

        String frameLogic = computeFrameLogicLabel(vizRow, isTemporal);

        exportSingleGraphCSV(dataRows, "RAW", experimentFolder,
            graphIdx, vizRow, graphType, frameLogic, isTemporal);

        if (bgEnabled) {
            exportSingleGraphCSV(correctedDataRows, "BGcorr", experimentFolder,
                graphIdx, vizRow, graphType, frameLogic, isTemporal);
        }

        if (btEnabled) {
            exportSingleGraphCSV(btCorrDataRows, "BTcorr", experimentFolder,
                graphIdx, vizRow, graphType, frameLogic, isTemporal);
        }
    }
}

// Export event times to CSV
void exportEventTimesToCSV(ArrayList eventTimes) {
    if (eventTimes.isEmpty()) {

        return;
    }

    String experimentFolder = config.experimentFolder;
    if (experimentFolder.isEmpty()) {

        return;
    }

    File csvFile = new File(experimentFolder, "Event-Data.csv");

    try {
        PrintWriter writer = new PrintWriter(new FileWriter(csvFile));

        // Header
        writer.println("Event;Time [ms]");

        // Write each event
        for (int i = 0; i < eventTimes.size(); i++) {
            writer.print("Event " + (i + 1));
            writer.print(";");
            writer.println(eventTimes.get(i));
        }

        writer.close();
        // print("Event data exported to: " + csvFile.getName());

    } catch (IOException e) {
        // print("ERROR: Failed to export event data: " + e.getMessage());
        e.printStackTrace();
    }
}

// ==================== Post-Processor ====================

// Rebuild config.storedROIs from the current state of the ROI Manager.
// Temporal mode: all ROIs taken as-is.
// Spatial mode: only ROIs whose centre lies in the configured source half are kept;
//               they are re-mirrored to the other half and both sets are stored.
void ppRebuildROIsFromManager(ij.plugin.frame.RoiManager rm, int imageWidth, int imageHeight) {
    config.storedROIs = new ArrayList();
    if (rm == null || rm.getCount() == 0) return;

    boolean isSpatial = config.acqSettings.processingMode.equals("Spatial");

    if (!isSpatial) {
        for (int i = 0; i < rm.getCount(); i++) {
            ij.gui.Roi roiCopy = (ij.gui.Roi) rm.getRoi(i).clone();
            config.storedROIs.add(new ROIMetadata(roiCopy, "original", imageWidth, imageHeight));
        }
        // Rename all ROIs in temporal mode too
        for (int i = 0; i < rm.getCount(); i++) {
            rm.select(i);
            rm.runCommand("Rename", "ROI" + (i + 1));
        }
        return;
    }

    // Spatial: keep only ROIs whose centre is in the source half
    String splitAxis = config.acqSettings.spatialConfig.splitAxis;
    String roiRegion = config.acqSettings.spatialConfig.roiSourceRegion;

    ArrayList sourceROIs = new ArrayList();
    for (int i = 0; i < rm.getCount(); i++) {
        ij.gui.Roi roi = rm.getRoi(i);
        java.awt.Rectangle b = roi.getBounds();
        int cx = b.x + b.width  / 2;
        int cy = b.y + b.height / 2;
        boolean inSource;
        if (splitAxis.equals("Horizontal")) {
            int half = imageHeight / 2;
            inSource = roiRegion.equals("Upper") ? (cy < half) : (cy >= half);
        } else {
            int half = imageWidth / 2;
            inSource = roiRegion.equals("Left") ? (cx < half) : (cx >= half);
        }
        if (inSource) sourceROIs.add(roi.clone());
    }

    rm.reset();

    String mirroredRegion = splitAxis.equals("Horizontal")
        ? (roiRegion.equals("Upper") ? "Lower" : "Upper")
        : (roiRegion.equals("Left")  ? "Right"  : "Left");

    // Source ROIs first
    for (int i = 0; i < sourceROIs.size(); i++) {
        ij.gui.Roi src = (ij.gui.Roi) sourceROIs.get(i);
        rm.addRoi((ij.gui.Roi) src.clone());
        config.storedROIs.add(new ROIMetadata((ij.gui.Roi) src.clone(), roiRegion, imageWidth, imageHeight));
    }

    // Mirrored ROIs
    for (int i = 0; i < sourceROIs.size(); i++) {
        ij.gui.Roi src    = (ij.gui.Roi) sourceROIs.get(i);
        ij.gui.Roi mirror = (ij.gui.Roi) src.clone();
        java.awt.Rectangle b = src.getBounds();
        if (splitAxis.equals("Horizontal")) {
            int half = imageHeight / 2;
            mirror.setLocation(b.x, roiRegion.equals("Upper") ? b.y + half : b.y - half);
        } else {
            int half = imageWidth / 2;
            mirror.setLocation(roiRegion.equals("Left") ? b.x + half : b.x - half, b.y);
        }
        rm.addRoi(mirror);
        config.storedROIs.add(new ROIMetadata((ij.gui.Roi) mirror.clone(), mirroredRegion, imageWidth, imageHeight));
    }

    for (int i = 0; i < rm.getCount(); i++) {
        rm.select(i);
        rm.runCommand("Rename", "ROI" + (i + 1));
    }
}

// Synchronise the series count in each chart dataset with the current config.storedROIs.
// Adds or removes series so updateGraphs() can address them by index without error.
// Also updates the renderer stroke for any newly-added series.
// Must be called on the EDT.
void ppUpdateChartSeries(ArrayList datasets, ArrayList charts) {
    boolean isTemporal = config.acqSettings.processingMode.equals("Temporal");
    int numROIs = config.storedROIs != null ? config.storedROIs.size() : 0;
    for (int i = 0; i < 4; i++) {
        if (i >= datasets.size() || datasets.get(i) == null) continue;
        if (i >= config.acqSettings.visualizationRows.size()) continue;
        ArrayList vizRow  = (ArrayList) config.acqSettings.visualizationRows.get(i);
        String graphType  = (String) vizRow.get(1);
        if (graphType == null || graphType.equals("none")) continue;
        int required = (graphType.startsWith("Split ratio") || (!isTemporal && graphType.startsWith("Intensity ")))
            ? numROIs / 2 : numROIs;
        XYSeriesCollection ds = (XYSeriesCollection) datasets.get(i);
        int current = ds.getSeriesCount();
        if (current < required) {
            for (int si = current; si < required; si++)
                ds.addSeries(new XYSeries("ROI" + (si + 1)));
        } else if (current > required) {
            for (int si = current - 1; si >= required; si--)
                ds.removeSeries(si);
        }
        // Keep renderer in sync for all series
        if (i < charts.size() && charts.get(i) != null) {
            XYPlot plot = ((JFreeChart) charts.get(i)).getXYPlot();
            org.jfree.chart.renderer.xy.XYItemRenderer rend = plot.getRenderer();
            if (rend instanceof org.jfree.chart.renderer.xy.XYLineAndShapeRenderer) {
                org.jfree.chart.renderer.xy.XYLineAndShapeRenderer lr =
                    (org.jfree.chart.renderer.xy.XYLineAndShapeRenderer) rend;
                for (int si = 0; si < required; si++) {
                    lr.setSeriesLinesVisible(si, Boolean.TRUE);
                    lr.setSeriesShapesVisible(si, Boolean.FALSE);
                    lr.setSeriesStroke(si, new BasicStroke(2.0f));
                }
            }
        }
    }
}

// Build a sparse frame-number → timestamp map from any *_RAW.csv in the experiment folder.
// Returns an ArrayList indexed by (frameNum-1) holding Long timestamps; missing entries = null.
ArrayList ppReadTimestamps(File expFolder) {
    java.util.TreeMap frameMap = new java.util.TreeMap();

    File[] csvFiles = expFolder.listFiles(new java.io.FilenameFilter() {
        public boolean accept(File dir, String name) {
            return name.contains("_RAW") && name.endsWith(".csv");
        }
    });

    if (csvFiles != null) {
        for (int fi = 0; fi < csvFiles.length; fi++) {
            try {
                BufferedReader br = new BufferedReader(new FileReader(csvFiles[fi]));
                String line = br.readLine(); // skip header
                while ((line = br.readLine()) != null) {
                    line = line.trim();
                    if (line.isEmpty()) continue;
                    String[] parts = line.split(";");
                    if (parts.length < 2) continue;
                    try {
                        int  fn = Integer.parseInt(parts[0].trim());
                        long ts = Long.parseLong(parts[1].trim());
                        frameMap.put(new Integer(fn), new Long(ts));
                    } catch (Exception ignored) {}
                }
                br.close();
            } catch (Exception e) { e.printStackTrace(); }
        }
    }

    if (frameMap.isEmpty()) return new ArrayList();

    int maxFrame = ((Integer) frameMap.lastKey()).intValue();
    ArrayList result = new ArrayList();
    for (int i = 0; i < maxFrame; i++) result.add(null);
    java.util.Iterator it = frameMap.entrySet().iterator();
    while (it.hasNext()) {
        java.util.Map.Entry entry = (java.util.Map.Entry) it.next();
        int fn = ((Integer) entry.getKey()).intValue();
        result.set(fn - 1, entry.getValue());
    }
    return result;
}

// Reads all _RAW CSVs from expFolder, groups timestamps by seqRow (column 2), and returns
// Map<Integer seqRow, ArrayList<Long> timestamps> in frame-number order for each row.
// Used when loading per-row stacks (Stack_Row_N.tif) so each stack gets the correct
// original acquisition timestamps instead of the wrong global-frameNum lookup.
Map ppReadTimestampsPerRow(File expFolder) {
    Map rowFrameMap = new HashMap(); // Integer seqRow -> TreeMap<Integer frameNum, Long ts>

    File[] csvFiles = expFolder.listFiles(new java.io.FilenameFilter() {
        public boolean accept(File dir, String name) {
            return name.contains("_RAW") && name.endsWith(".csv");
        }
    });

    if (csvFiles != null) {
        for (int fi = 0; fi < csvFiles.length; fi++) {
            try {
                BufferedReader br = new BufferedReader(new FileReader(csvFiles[fi]));
                String line = br.readLine(); // skip header
                while ((line = br.readLine()) != null) {
                    line = line.trim();
                    if (line.isEmpty()) continue;
                    String[] parts = line.split(";");
                    if (parts.length < 3) continue;
                    try {
                        int  fn  = Integer.parseInt(parts[0].trim());
                        long ts  = Long.parseLong(parts[1].trim());
                        int  row = Integer.parseInt(parts[2].trim());
                        Integer rowKey = new Integer(row);
                        if (!rowFrameMap.containsKey(rowKey))
                            rowFrameMap.put(rowKey, new java.util.TreeMap());
                        ((java.util.TreeMap) rowFrameMap.get(rowKey)).put(new Integer(fn), new Long(ts));
                    } catch (Exception ignored) {}
                }
                br.close();
            } catch (Exception e) { e.printStackTrace(); }
        }
    }

    // Convert per-row TreeMap<frameNum, ts> → ordered ArrayList<Long>
    Map result = new HashMap();
    java.util.Iterator rowIt = rowFrameMap.entrySet().iterator();
    while (rowIt.hasNext()) {
        java.util.Map.Entry entry = (java.util.Map.Entry) rowIt.next();
        Integer seqRowKey = (Integer) entry.getKey();
        java.util.TreeMap frameMap = (java.util.TreeMap) entry.getValue();
        ArrayList tsList = new ArrayList();
        java.util.Iterator tsIt = frameMap.values().iterator();
        while (tsIt.hasNext()) tsList.add(tsIt.next());
        result.put(seqRowKey, tsList);
    }
    return result;
}

// Computes the per-ROI mean BG-corrected acceptor signal over a reference frame range.
// Returns ArrayList<Double> of size N/2 — one value per ROI pair, for the acceptor side.
// "Acceptor side" follows the same fromIsSource logic as applyBTCorrection.
ArrayList computeMeanDirEx(ArrayList stacks) {
    ArrayList result = new ArrayList();
    int n = config.storedROIs != null ? config.storedROIs.size() : 0;
    if (!config.acqSettings.processingMode.equals("Spatial") || n < 2) return result;
    int half = n / 2;
    // Determine which half is acceptor (same logic as BT correction)
    String direction = config.acqSettings.btDirection;
    String roiRegion = config.acqSettings.spatialConfig.roiSourceRegion;
    String deFromLabel = direction;
    int deArrow = direction.indexOf(" -> ");
    if (deArrow >= 0) deFromLabel = direction.substring(0, deArrow).trim();
    boolean deFromIsSource = deFromLabel.equalsIgnoreCase(roiRegion);
    int deIdx = Math.min(config.acqSettings.deStackIndex, stacks.size() - 1);
    ImagePlus refStack = (ImagePlus) stacks.get(deIdx);
    int maxSlice = refStack.getStackSize();
    int fromF = Math.max(1, config.acqSettings.deFromFrame);
    int toF   = Math.min(maxSlice, config.acqSettings.deToFrame);
    if (toF < fromF) {
        JOptionPane.showMessageDialog(null,
            "Direct Excitation: frame range out of bounds (" + config.acqSettings.deFromFrame
            + " \u2013 " + config.acqSettings.deToFrame + ") for stack with "
            + maxSlice + " frames.\nDE correction not applied.",
            "Frame Range Out of Bounds", JOptionPane.WARNING_MESSAGE);
        return result;
    }
    double[] sums   = new double[half];
    int[]    counts = new int[half];
    for (int f = fromF; f <= toF; f++) {
        refStack.setSlice(f);
        ImageProcessor deIP = refStack.getProcessor();
        ArrayList roiVals = measureROIs(deIP);
        ArrayList bgCorr  = applyBGCorrection(roiVals);
        for (int i = 0; i < half; i++) {
            int accIdx = deFromIsSource ? (i + half) : i;
            sums[i]   += ((Double) bgCorr.get(accIdx)).doubleValue();
            counts[i] += 1;
        }
    }
    for (int i = 0; i < half; i++)
        result.add(new Double(counts[i] > 0 ? sums[i] / counts[i] : 0.0));
    return result;
}

// Subtract deFactor * meanDirExPerRoi[i] from each acceptor-side ROI.
// meanDirExPerRoi: ArrayList<Double>, size N/2, from computeMeanDirEx.
ArrayList applyDECorrection(ArrayList btCorrValues, ArrayList meanDirExPerRoi) {
    int n = btCorrValues.size();
    ArrayList corrected = new ArrayList();
    for (int i = 0; i < n; i++) corrected.add(btCorrValues.get(i));
    if (!config.acqSettings.deEnabled || !config.acqSettings.processingMode.equals("Spatial")
            || n < 2 || meanDirExPerRoi.isEmpty()) return corrected;
    int half = n / 2;
    double factor = config.acqSettings.deFactor;
    String direction = config.acqSettings.btDirection;
    String roiRegion = config.acqSettings.spatialConfig.roiSourceRegion;
    String deFromLabel = direction;
    int deArrow = direction.indexOf(" -> ");
    if (deArrow >= 0) deFromLabel = direction.substring(0, deArrow).trim();
    boolean deFromIsSource = deFromLabel.equalsIgnoreCase(roiRegion);
    for (int i = 0; i < half && i < meanDirExPerRoi.size(); i++) {
        double meanDE = ((Double) meanDirExPerRoi.get(i)).doubleValue();
        int accIdx = deFromIsSource ? (i + half) : i;
        double val = ((Double) corrected.get(accIdx)).doubleValue();
        corrected.set(accIdx, new Double(val - factor * meanDE));
    }
    return corrected;
}

// Compute per-ROI bleach slopes (intensity/frame) via OLS linear regression over BGcorr values.
// bcConfigs: ArrayList of per-stack config entries — each is ArrayList[Boolean enabled,
//            Integer fromFrame, Integer toFrame, Double slopeScale].
// Returns: ArrayList indexed by stackIdx containing ArrayList<Double> slopes per ROI,
//          or null for disabled/invalid stacks.
ArrayList computeBleachSlopes(ArrayList stacks, ArrayList bcConfigs) {
    ArrayList result = new ArrayList();
    for (int si = 0; si < stacks.size(); si++) {
        if (si >= bcConfigs.size()) { result.add(null); continue; }
        ArrayList cfg     = (ArrayList) bcConfigs.get(si);
        boolean enabled   = ((Boolean)  cfg.get(0)).booleanValue();
        if (!enabled) { result.add(null); continue; }
        ImagePlus sk = (ImagePlus) stacks.get(si);
        int fromF = Math.max(1, ((Integer) cfg.get(1)).intValue());
        int toF   = Math.min(sk.getStackSize(), ((Integer) cfg.get(2)).intValue());
        if (toF < fromF) {
            JOptionPane.showMessageDialog(null,
                "Bleach Correction: frame range out of bounds ("
                + ((Integer) cfg.get(1)).intValue() + " \u2013 " + ((Integer) cfg.get(2)).intValue()
                + ") for stack \"" + sk.getTitle() + "\" with " + sk.getStackSize() + " frames."
                + "\nBleach correction not applied for this stack.",
                "Frame Range Out of Bounds", JOptionPane.WARNING_MESSAGE);
            result.add(null); continue;
        }
        int n = config.storedROIs != null ? config.storedROIs.size() : 0;
        if (n == 0) { result.add(null); continue; }
        int nFrames = toF - fromF + 1;
        // Accumulate OLS sums: x = local slice index (fromF..toF), y = BGcorr value per ROI
        double sumX  = 0.0;
        double sumX2 = 0.0;
        double[] sumY  = new double[n];
        double[] sumXY = new double[n];
        for (int f = fromF; f <= toF; f++) {
            try {
                sk.setSlice(f);
                ArrayList roiVals = measureROIs(sk.getProcessor());
                ArrayList bgCorr  = applyBGCorrection(roiVals);
                double x = (double) f;
                sumX  += x;
                sumX2 += x * x;
                for (int r = 0; r < n && r < bgCorr.size(); r++) {
                    double y = ((Double) bgCorr.get(r)).doubleValue();
                    sumY[r]  += y;
                    sumXY[r] += x * y;
                }
            } catch (Exception frameEx) {
                System.err.println("computeBleachSlopes: error at slice " + f + ": " + frameEx.getMessage());
            }
        }
        // OLS slope: b = (N*sumXY - sumX*sumY) / (N*sumX2 - sumX^2)
        double denom = (double) nFrames * sumX2 - sumX * sumX;
        ArrayList slopes = new ArrayList();
        for (int r = 0; r < n; r++) {
            double slope = (denom != 0.0)
                ? ((double) nFrames * sumXY[r] - sumX * sumY[r]) / denom
                : 0.0;
            slopes.add(new Double(slope));
        }
        result.add(slopes);
    }
    return result;
}

// Apply bleach correction to BGcorr values for one frame.
// slopes: ArrayList<Double> per ROI from computeBleachSlopes, or null → returns input unchanged.
// localSlice: 1-based slice index within the stack.
// slopeScale: user attenuation factor (1.0 = full correction).
ArrayList applyBleachCorrection(ArrayList bgCorrValues, int localSlice, ArrayList slopes, double slopeScale) {
    ArrayList corrected = new ArrayList();
    for (int i = 0; i < bgCorrValues.size(); i++) corrected.add(bgCorrValues.get(i));
    if (slopes == null || slopes.isEmpty()) return corrected;
    for (int i = 0; i < corrected.size() && i < slopes.size(); i++) {
        double val   = ((Double) corrected.get(i)).doubleValue();
        double slope = ((Double) slopes.get(i)).doubleValue();
        corrected.set(i, new Double(val - (double) localSlice * slope * slopeScale));
    }
    return corrected;
}

// Re-measure every stack slice with the current config.storedROIs and refresh the charts.
// Clears and rebuilds ppDataRows / ppCorrRows / ppBTRows in-place.
// stacks: list of ImagePlus from the post-processor; iterated in order as one sequence.
void ppRecalculate(ArrayList stacks, ArrayList frameTimestamps,
                   ArrayList ppDataRows, ArrayList ppCorrRows, ArrayList ppBCRows, ArrayList ppBTRows,
                   ArrayList ppDERows, ArrayList ppMeanDirEx,
                   ArrayList ppBleachSlopes, ArrayList bcConfigs,
                   ArrayList datasets, ArrayList charts, ArrayList chartPanels,
                   ArrayList perStackSeqRows, ArrayList perStackTimestamps) {
    ppDataRows.clear();
    ppCorrRows.clear();
    ppBCRows.clear();
    ppBTRows.clear();
    ppDERows.clear();
    ppMeanDirEx.clear();
    ppBleachSlopes.clear();

    for (int gi = 0; gi < datasets.size(); gi++) {
        if (datasets.get(gi) == null) continue;
        XYSeriesCollection ds = (XYSeriesCollection) datasets.get(gi);
        for (int si = 0; si < ds.getSeriesCount(); si++) ds.getSeries(si).clear();
    }

    frameCache = new HashMap();

    long fallbackIntervalMs = 1000L;
    if (!config.acqSettings.sequenceRows.isEmpty()) {
        try {
            ArrayList firstRow = (ArrayList) config.acqSettings.sequenceRows.get(0);
            fallbackIntervalMs = Long.parseLong(firstRow.get(3).toString().trim());
        } catch (Exception ignored) {}
    }

    boolean isSpatial = config.acqSettings.processingMode.equals("Spatial");
    RowTracker rowTracker = new RowTracker(config.acqSettings.sequenceRows);

    // Pre-compute bleach slopes (mini-pass over reference frames per stack, BGcorr values)
    ArrayList bleachSlopes = computeBleachSlopes(stacks, bcConfigs);
    ppBleachSlopes.addAll(bleachSlopes);

    // Pre-compute per-ROI direct excitation means (spatial + DE enabled only)
    ArrayList meanDirEx = new ArrayList();
    if (isSpatial && config.acqSettings.deEnabled) {
        meanDirEx = computeMeanDirEx(stacks);
        ppMeanDirEx.addAll(meanDirEx); // expose to caller for logging
    }

    int frameNum = 0;

    if (perStackSeqRows != null) {
        // ── Per-row stacks mode ──────────────────────────────────────────────────────────
        // Build a flat list of all (stackIdx, sliceIdx, seqRow, timestamp) tuples,
        // sort by timestamp to reconstruct the original acquisition order, then process.
        // This ensures ratio denominator caching works in the same temporal order as the
        // original block acquisition (e.g. Row2-block → Row1-block → Row2-block → ...).
        ArrayList allFrameEntries = new ArrayList();
        for (int si = 0; si < stacks.size(); si++) {
            int rowSeqRow = ((Integer) perStackSeqRows.get(si)).intValue();
            ImagePlus sk  = (ImagePlus) stacks.get(si);
            ArrayList rowTsList = (ArrayList) perStackTimestamps.get(si);
            // Per-row fallback interval from sequence table
            long rowFallback = fallbackIntervalMs;
            if (!config.acqSettings.sequenceRows.isEmpty() && rowSeqRow >= 1
                    && rowSeqRow <= config.acqSettings.sequenceRows.size()) {
                try {
                    ArrayList rowConf = (ArrayList) config.acqSettings.sequenceRows.get(rowSeqRow - 1);
                    rowFallback = Long.parseLong(rowConf.get(3).toString().trim());
                } catch (Exception ignored) {}
            }
            for (int s = 1; s <= sk.getStackSize(); s++) {
                long ts;
                if (rowTsList != null && (s-1) < rowTsList.size() && rowTsList.get(s-1) != null) {
                    ts = ((Long) rowTsList.get(s-1)).longValue();
                } else {
                    ts = rowFallback * (long)(s-1);
                }
                ArrayList entry = new ArrayList();
                entry.add(new Integer(si));       // [0] stackIdx
                entry.add(new Integer(s));        // [1] sliceIdx (1-based)
                entry.add(new Integer(rowSeqRow)); // [2] seqRow
                entry.add(new Long(ts));          // [3] timestamp
                allFrameEntries.add(entry);
            }
        }
        // Sort by timestamp → restores original block-acquisition order
        java.util.Collections.sort(allFrameEntries, new java.util.Comparator() {
            public int compare(Object a, Object b) {
                long tsA = ((Long)((ArrayList)a).get(3)).longValue();
                long tsB = ((Long)((ArrayList)b).get(3)).longValue();
                return Long.compare(tsA, tsB);
            }
        });
        // Process frames in temporal order
        for (int fi = 0; fi < allFrameEntries.size(); fi++) {
            ArrayList entry = (ArrayList) allFrameEntries.get(fi);
            int si         = ((Integer) entry.get(0)).intValue();
            int s          = ((Integer) entry.get(1)).intValue();
            int seqRow     = ((Integer) entry.get(2)).intValue();
            long timestamp = ((Long)    entry.get(3)).longValue();
            frameNum++;
            ImagePlus curStack = (ImagePlus) stacks.get(si);
            curStack.setSlice(s);
            ImageProcessor ip = curStack.getProcessor();
            ArrayList roiValues = measureROIs(ip);
            ppDataRows.add(buildDataRow(frameNum, timestamp, seqRow, roiValues));
            ArrayList valuesForGraphs = roiValues;
            if (config.acqSettings.bgCorrectionEnabled) {
                ArrayList bgCorr = applyBGCorrection(roiValues);
                ppCorrRows.add(buildDataRow(frameNum, timestamp, seqRow, bgCorr));
                valuesForGraphs = bgCorr;
                // Bleach correction: uses BGcorr values, local slice index within its stack
                ArrayList valuesAfterBC = bgCorr;
                ArrayList bcSlopesForStack = (si < bleachSlopes.size()) ? (ArrayList) bleachSlopes.get(si) : null;
                ArrayList bcCfg = (si < bcConfigs.size()) ? (ArrayList) bcConfigs.get(si) : null;
                boolean bcEnabled = bcCfg != null && ((Boolean) bcCfg.get(0)).booleanValue();
                double bcScale = (bcCfg != null) ? ((Double) bcCfg.get(3)).doubleValue() : 1.0;
                if (bcEnabled && bcSlopesForStack != null) {
                    valuesAfterBC = applyBleachCorrection(bgCorr, s, bcSlopesForStack, bcScale);
                    ppBCRows.add(buildDataRow(frameNum, timestamp, seqRow, valuesAfterBC));
                    valuesForGraphs = valuesAfterBC;
                }
                if (config.acqSettings.btCorrectionEnabled && isSpatial) {
                    ArrayList btCorr = applyBTCorrection(valuesAfterBC);
                    ppBTRows.add(buildDataRow(frameNum, timestamp, seqRow, btCorr));
                    ArrayList valuesAfterBT = btCorr;
                    if (config.acqSettings.deEnabled && !meanDirEx.isEmpty()) {
                        ArrayList deCorr = applyDECorrection(btCorr, meanDirEx);
                        ppDERows.add(buildDataRow(frameNum, timestamp, seqRow, deCorr));
                        valuesAfterBT = deCorr;
                    }
                    valuesForGraphs = valuesAfterBT;
                }
            }
            updateGraphs(datasets, frameNum, timestamp, valuesForGraphs, chartPanels, charts, seqRow);
        }
    } else {
        // ── Interleaved stacks mode (original behaviour) ─────────────────────────────────
        for (int stackIdx = 0; stackIdx < stacks.size(); stackIdx++) {
            ImagePlus curStack = (ImagePlus) stacks.get(stackIdx);
            int totalSlices = curStack.getStackSize();
            for (int s = 1; s <= totalSlices; s++) {
                frameNum++;
                curStack.setSlice(s);
                ImageProcessor ip = curStack.getProcessor();

                long timestamp;
                if (frameTimestamps != null && (frameNum - 1) < frameTimestamps.size()
                        && frameTimestamps.get(frameNum - 1) != null) {
                    timestamp = ((Long) frameTimestamps.get(frameNum - 1)).longValue();
                } else {
                    timestamp = (long)(frameNum - 1) * fallbackIntervalMs;
                }

                int seqRow = rowTracker.advanceFrame();

                ArrayList roiValues = measureROIs(ip);
                ppDataRows.add(buildDataRow(frameNum, timestamp, seqRow, roiValues));

                ArrayList valuesForGraphs = roiValues;
                if (config.acqSettings.bgCorrectionEnabled) {
                    ArrayList bgCorr = applyBGCorrection(roiValues);
                    ppCorrRows.add(buildDataRow(frameNum, timestamp, seqRow, bgCorr));
                    valuesForGraphs = bgCorr;
                    // Bleach correction: uses BGcorr values, local slice index within its stack
                    ArrayList valuesAfterBC = bgCorr;
                    ArrayList bcSlopesForStack = (stackIdx < bleachSlopes.size()) ? (ArrayList) bleachSlopes.get(stackIdx) : null;
                    ArrayList bcCfg = (stackIdx < bcConfigs.size()) ? (ArrayList) bcConfigs.get(stackIdx) : null;
                    boolean bcEnabled = bcCfg != null && ((Boolean) bcCfg.get(0)).booleanValue();
                    double bcScale = (bcCfg != null) ? ((Double) bcCfg.get(3)).doubleValue() : 1.0;
                    if (bcEnabled && bcSlopesForStack != null) {
                        valuesAfterBC = applyBleachCorrection(bgCorr, s, bcSlopesForStack, bcScale);
                        ppBCRows.add(buildDataRow(frameNum, timestamp, seqRow, valuesAfterBC));
                        valuesForGraphs = valuesAfterBC;
                    }
                    if (config.acqSettings.btCorrectionEnabled && isSpatial) {
                        ArrayList btCorr = applyBTCorrection(valuesAfterBC);
                        ppBTRows.add(buildDataRow(frameNum, timestamp, seqRow, btCorr));
                        ArrayList valuesAfterBT = btCorr;
                        if (config.acqSettings.deEnabled && !meanDirEx.isEmpty()) {
                            ArrayList deCorr = applyDECorrection(btCorr, meanDirEx);
                            ppDERows.add(buildDataRow(frameNum, timestamp, seqRow, deCorr));
                            valuesAfterBT = deCorr;
                        }
                        valuesForGraphs = valuesAfterBT;
                    }
                }
                updateGraphs(datasets, frameNum, timestamp, valuesForGraphs, chartPanels, charts, seqRow);
            }
        }
    }
}

// Export post-processed data to a new numbered folder next to the original experiment folder.
// Write a log of all post-processing parameters actually applied.
// Writes Correction_Parameters_per_ROI.csv — bleach slopes and DE means in one file
// so the user can verify the math easily after the fact.
void ppSaveCorrectionParametersCSV(File outFolder, ArrayList bcConfigs, ArrayList ppBleachSlopes,
                                    ArrayList ppMeanDirEx, ArrayList stacks) {
    PrintWriter pw = null;
    try {
        import java.text.SimpleDateFormat;
        import java.util.Date;
        File outFile = new File(outFolder, "Correction_Parameters_per_ROI.csv");
        pw = new PrintWriter(new FileWriter(outFile));
        String ts = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new Date());
        pw.println("# LUMETRIC - Correction Parameters per ROI");
        pw.println("# Generated: " + ts);
        pw.println("# Use this file to verify the correction math applied during post-processing.");
        pw.println("#");

        // --- Bleach Correction Slopes ---
        pw.println("[Bleach Correction Slopes]");
        pw.println("# slope [intensity/frame] — from OLS linear regression of BGcorr values");
        pw.println("# Correction applied: BCcorr(roi,frame) = BGcorr(roi,frame) - frame * slope * scale");
        pw.println("Stack,Enabled,Frames Used,Scale,ROI,Slope [intensity/frame]");
        boolean anyBCEnabled = false;
        for (int si = 0; si < stacks.size() && si < bcConfigs.size(); si++) {
            ArrayList cfg = (ArrayList) bcConfigs.get(si);
            boolean enabled = ((Boolean) cfg.get(0)).booleanValue();
            int fromF = ((Integer) cfg.get(1)).intValue();
            int toF   = ((Integer) cfg.get(2)).intValue();
            double scale = ((Double) cfg.get(3)).doubleValue();
            String stackName = ((ImagePlus) stacks.get(si)).getTitle();
            if (!enabled) {
                pw.println(escapeCSV(stackName) + ",false,,,");
                continue;
            }
            anyBCEnabled = true;
            ArrayList slopes = (si < ppBleachSlopes.size()) ? (ArrayList) ppBleachSlopes.get(si) : null;
            if (slopes == null || slopes.isEmpty()) {
                pw.println(escapeCSV(stackName) + ",true," + fromF + "-" + toF + "," + scale + ",(no slopes computed),");
                continue;
            }
            for (int r = 0; r < slopes.size(); r++) {
                double slope = ((Double) slopes.get(r)).doubleValue();
                String slopeStr = "" + slope;
                pw.println(escapeCSV(stackName) + ",true,"
                    + fromF + "-" + toF + "," + scale + ","
                    + "ROI" + (r + 1) + "," + slopeStr);
            }
        }
        if (!anyBCEnabled) pw.println("# Bleach correction was not enabled for any stack.");
        pw.println("#");

        // --- Direct Excitation Means ---
        pw.println("[Direct Excitation Means]");
        pw.println("# Mean BGcorr acceptor intensity over the reference frame range.");
        pw.println("# Correction applied: DEcorr(roi) = BTcorr(roi) - deFactor * mean");
        pw.println("ROI (acceptor side),Mean Intensity Used");
        if (ppMeanDirEx != null && !ppMeanDirEx.isEmpty()) {
            for (int i = 0; i < ppMeanDirEx.size(); i++) {
                double val = ((Double) ppMeanDirEx.get(i)).doubleValue();
                pw.println((i + 1) + "," + val);
            }
        } else {
            pw.println("# Direct excitation correction was not enabled.");
        }

        pw.flush();
        pw.close();
    } catch (Throwable e) {
        print("[CorrCSV] ERROR: " + e.getClass().getName() + ": " + e.getMessage());
        if (pw != null) { try { pw.flush(); pw.close(); } catch (Throwable ignored) {} }
        JOptionPane.showMessageDialog(null,
            "Could not write Correction_Parameters_per_ROI.csv:\n" + e.getMessage(),
            "Export Error", JOptionPane.ERROR_MESSAGE);
    }
}

void ppSavePostProcessingLog(File outFolder, ArrayList bcConfigs, ArrayList stacks, int totalFrames) {
    PrintWriter pw = null;
    try {
        import java.text.SimpleDateFormat;
        import java.util.Date;
        pw = new PrintWriter(new FileWriter(new File(outFolder, "PostProcessing_Log.csv")));
        String ts = new SimpleDateFormat("yyyy-MM-dd HH:mm:ss").format(new Date());
        pw.println("# LUMETRIC - Post-Processing Parameter Log");
        pw.println("# Post-processed: " + ts);
        pw.println("# NOTE: These are the settings ACTUALLY APPLIED during post-processing.");
        pw.println("# They may differ from the original AquisitionSettings.csv.");
        pw.println("# Per-ROI slopes and DE means: see Correction_Parameters_per_ROI.csv");
        pw.println("#");

        // --- Spatial setup ---
        pw.println("[Spatial Setup]");
        pw.println("Parameter,Value");
        pw.println("Processing Mode," + escapeCSV(config.acqSettings.processingMode));
        if (config.acqSettings.spatialConfig != null) {
            pw.println("Split Axis," + escapeCSV(config.acqSettings.spatialConfig.splitAxis));
            pw.println("ROI Source Region," + escapeCSV(config.acqSettings.spatialConfig.roiSourceRegion));
        }
        pw.println("Frames Processed," + totalFrames);
        pw.println("#");

        // --- Background correction ---
        pw.println("[Background Correction]");
        pw.println("Parameter,Value");
        pw.println("BG Correction Enabled," + config.acqSettings.bgCorrectionEnabled);
        if (config.acqSettings.bgCorrectionEnabled) {
            int bgIdx = config.acqSettings.bgROIIndex;
            pw.println("BG ROI Index (1-based)," + (bgIdx + 1));
        }
        pw.println("#");

        // --- Bleach correction ---
        pw.println("[Bleach Correction]");
        pw.println("Stack,Enabled,Frames Used,Scale");
        for (int si = 0; si < stacks.size() && si < bcConfigs.size(); si++) {
            ArrayList cfg  = (ArrayList) bcConfigs.get(si);
            boolean enabled = ((Boolean) cfg.get(0)).booleanValue();
            int fromF = ((Integer) cfg.get(1)).intValue();
            int toF   = ((Integer) cfg.get(2)).intValue();
            double scale = ((Double) cfg.get(3)).doubleValue();
            String stackName = ((ImagePlus) stacks.get(si)).getTitle();
            if (enabled)
                pw.println(escapeCSV(stackName) + ",true," + fromF + "-" + toF + "," + scale);
            else
                pw.println(escapeCSV(stackName) + ",false,,");
        }
        pw.println("# Per-ROI slopes: see Correction_Parameters_per_ROI.csv");
        pw.println("#");

        // --- Bleedthrough correction ---
        pw.println("[Bleedthrough Correction]");
        pw.println("Parameter,Value");
        pw.println("BT Correction Enabled," + config.acqSettings.btCorrectionEnabled);
        if (config.acqSettings.btCorrectionEnabled) {
            pw.println("BT Direction," + escapeCSV(config.acqSettings.btDirection));
            pw.println("BT Factor," + config.acqSettings.btFactor);
        }
        pw.println("#");

        // --- Direct excitation correction ---
        pw.println("[Direct Excitation Correction]");
        pw.println("Parameter,Value");
        pw.println("DE Correction Enabled," + config.acqSettings.deEnabled);
        if (config.acqSettings.deEnabled) {
            pw.println("DE Factor," + config.acqSettings.deFactor);
            pw.println("DE Reference Stack Index (1-based)," + (config.acqSettings.deStackIndex + 1));
            pw.println("DE Frame Range," + config.acqSettings.deFromFrame + " - " + config.acqSettings.deToFrame);
            pw.println("# Per-ROI DE means: see Correction_Parameters_per_ROI.csv");
        }
        pw.println("#");

        // --- Graphs computed ---
        pw.println("[Graphs]");
        pw.println("Graph,Type");
        boolean isTemporal = config.acqSettings.processingMode.equals("Temporal");
        for (int gi = 0; gi < config.acqSettings.visualizationRows.size(); gi++) {
            ArrayList vizRow = (ArrayList) config.acqSettings.visualizationRows.get(gi);
            String gtype = (String) vizRow.get(1);
            if (gtype != null && !gtype.equals("none"))
                pw.println((gi + 1) + "," + escapeCSV(gtype));
        }

        pw.flush();
        pw.close();
    } catch (Throwable e) {
        if (pw != null) { try { pw.flush(); pw.close(); } catch (Throwable ignored) {} }
        JOptionPane.showMessageDialog(null,
            "Could not write PostProcessing_Log.csv:\n" + e.getMessage(),
            "Export Error", JOptionPane.ERROR_MESSAGE);
    }
}

void ppExport(ArrayList ppDataRows, ArrayList ppCorrRows, ArrayList ppBCRows, ArrayList ppBTRows,
              ArrayList ppDERows, ArrayList ppMeanDirEx, ArrayList ppBleachSlopes,
              ArrayList bcConfigs, ArrayList stacks,
              File originalExpFolder, ij.plugin.frame.RoiManager rm) {
    int n = 1;
    File outFolder;
    do {
        outFolder = new File(originalExpFolder.getParent(),
            originalExpFolder.getName() + "_Postprocessed" + n);
        n++;
    } while (outFolder.exists());
    outFolder.mkdirs();

    String savedExpFolder = config.experimentFolder;
    config.experimentFolder = outFolder.getAbsolutePath();

    exportGraphDataToCSV(ppDataRows, ppCorrRows, ppBTRows,
        config.acqSettings.visualizationRows.size(),
        config.acqSettings.visualizationRows);

    // Export BG+BC corrected data as a separate CSV per graph (post-processor only)
    if (!ppBCRows.isEmpty()) {
        boolean isTemporal = config.acqSettings.processingMode.equals("Temporal");
        File bcOutFolder = new File(config.experimentFolder);
        for (int graphIdx = 0; graphIdx < 4; graphIdx++) {
            if (graphIdx >= config.acqSettings.visualizationRows.size()) continue;
            ArrayList vizRow = (ArrayList) config.acqSettings.visualizationRows.get(graphIdx);
            String graphType = (String) vizRow.get(1);
            if (graphType == null || graphType.equals("none")) continue;
            String frameLogic = computeFrameLogicLabel(vizRow, isTemporal);
            exportSingleGraphCSV(ppBCRows, "BCcorr", bcOutFolder,
                graphIdx, vizRow, graphType, frameLogic, isTemporal);
        }
    }

    // Export BG+BT+DE corrected data as a separate CSV per graph (post-processor only)
    if (!ppDERows.isEmpty()) {
        boolean isTemporal = config.acqSettings.processingMode.equals("Temporal");
        File deOutFolder = new File(config.experimentFolder);
        for (int graphIdx = 0; graphIdx < 4; graphIdx++) {
            if (graphIdx >= config.acqSettings.visualizationRows.size()) continue;
            ArrayList vizRow = (ArrayList) config.acqSettings.visualizationRows.get(graphIdx);
            String graphType = (String) vizRow.get(1);
            if (graphType == null || graphType.equals("none")) continue;
            String frameLogic = computeFrameLogicLabel(vizRow, isTemporal);
            exportSingleGraphCSV(ppDERows, "BTDEcorr", deOutFolder,
                graphIdx, vizRow, graphType, frameLogic, isTemporal);
        }
    }

    config.experimentFolder = savedExpFolder;

    if (rm != null && rm.getCount() > 0)
        rm.runCommand("Save", new File(outFolder, "RoiSet.zip").getAbsolutePath());

    ppSavePostProcessingLog(outFolder, bcConfigs, stacks, ppDataRows.size());
    ppSaveCorrectionParametersCSV(outFolder, bcConfigs, ppBleachSlopes, ppMeanDirEx, stacks);

    File srcSettings = new File(originalExpFolder, "AquisitionSettings.csv");
    File dstSettings = new File(outFolder, "AquisitionSettings.csv");
    if (srcSettings.exists()) {
        try {
            java.io.FileInputStream  fis = new java.io.FileInputStream(srcSettings);
            java.io.FileOutputStream fos = new java.io.FileOutputStream(dstSettings);
            byte[] buf = new byte[4096];
            int len;
            while ((len = fis.read(buf)) > 0) fos.write(buf, 0, len);
            fis.close();
            fos.close();
        } catch (Exception e) { System.err.println("Could not copy settings: " + e.getMessage()); }
    }

    JOptionPane.showMessageDialog(null,
        "Exported to:\n" + outFolder.getName(),
        "Export Complete", JOptionPane.INFORMATION_MESSAGE);
}

// Builds one row of the bleach correction panel for a single stack.
// All anonymous classes are at the TOP LEVEL of this function to avoid the
// BeanShell/JDK-11 class-naming bug (anonymous classes inside for-loop blocks
// get illegal "/" characters in their JVM class names).
void buildSingleBleachRow(JPanel outerPanel, String stackTitle, ArrayList cfg) {
    final ArrayList rowCfg    = cfg;
    final boolean initEnabled = ((Boolean) cfg.get(0)).booleanValue();
    final int     initFrom    = ((Integer) cfg.get(1)).intValue();
    final int     initTo      = ((Integer) cfg.get(2)).intValue();
    final double  initScale   = ((Double)  cfg.get(3)).doubleValue();

    final JCheckBox  cbEnable = new JCheckBox(stackTitle, initEnabled);
    final JTextField tfFrom   = new JTextField(String.valueOf(initFrom),  5);
    final JTextField tfTo     = new JTextField(String.valueOf(initTo),    5);
    final JTextField tfScale  = new JTextField(String.valueOf(initScale), 5);
    cbEnable.setToolTipText("Enable bleach correction for this stack");
    tfFrom.setToolTipText("First local slice used for slope regression (1-based)");
    tfTo.setToolTipText("Last local slice used for slope regression");
    tfScale.setToolTipText("Scale factor applied to slope (1.0 = full correction)");
    tfFrom.setEnabled(initEnabled);
    tfTo.setEnabled(initEnabled);
    tfScale.setEnabled(initEnabled);

    cbEnable.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            boolean en = cbEnable.isSelected();
            rowCfg.set(0, Boolean.valueOf(en));
            tfFrom.setEnabled(en);
            tfTo.setEnabled(en);
            tfScale.setEnabled(en);
        }
    });
    tfFrom.addFocusListener(new java.awt.event.FocusAdapter() {
        public void focusLost(java.awt.event.FocusEvent fe) {
            try { rowCfg.set(1, new Integer(Integer.parseInt(tfFrom.getText().trim()))); }
            catch (NumberFormatException nfe) {}
        }
    });
    tfFrom.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            try { rowCfg.set(1, new Integer(Integer.parseInt(tfFrom.getText().trim()))); }
            catch (NumberFormatException nfe) {}
        }
    });
    tfTo.addFocusListener(new java.awt.event.FocusAdapter() {
        public void focusLost(java.awt.event.FocusEvent fe) {
            try { rowCfg.set(2, new Integer(Integer.parseInt(tfTo.getText().trim()))); }
            catch (NumberFormatException nfe) {}
        }
    });
    tfTo.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            try { rowCfg.set(2, new Integer(Integer.parseInt(tfTo.getText().trim()))); }
            catch (NumberFormatException nfe) {}
        }
    });
    tfScale.addFocusListener(new java.awt.event.FocusAdapter() {
        public void focusLost(java.awt.event.FocusEvent fe) {
            try { rowCfg.set(3, new Double(Double.parseDouble(
                tfScale.getText().trim().replace(",", ".")))); }
            catch (NumberFormatException nfe) {}
        }
    });
    tfScale.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            try { rowCfg.set(3, new Double(Double.parseDouble(
                tfScale.getText().trim().replace(",", ".")))); }
            catch (NumberFormatException nfe) {}
        }
    });

    JPanel row = new JPanel(new FlowLayout(FlowLayout.LEFT, 8, 2));
    row.add(cbEnable);
    row.add(new JLabel("Frames:"));
    row.add(tfFrom);
    row.add(new JLabel("\u2013"));
    row.add(tfTo);
    row.add(new JLabel("Scale:"));
    row.add(tfScale);
    outerPanel.add(row);
}

// Build the bleach correction panel for the post-processor.
// One row per stack — delegates to buildSingleBleachRow to keep anonymous
// classes out of the for-loop body (BeanShell/JDK-11 naming bug avoidance).
JPanel buildPPBleachPanel(ArrayList stacks, ArrayList bcConfigs) {
    JPanel outer = new JPanel();
    outer.setLayout(new BoxLayout(outer, BoxLayout.Y_AXIS));
    outer.setBorder(BorderFactory.createTitledBorder("Bleach Correction"));
    for (int si = 0; si < stacks.size(); si++) {
        buildSingleBleachRow(outer,
            ((ImagePlus) stacks.get(si)).getTitle(),
            (ArrayList) bcConfigs.get(si));
    }
    return outer;
}

// ==================== Post-Processor Entry Point ====================
// Helper: build the spatial correction panel for the post-processor.
// Extracted from openPostProcessor to avoid BeanShell/JDK-11 anonymous-class naming bug:
// classes created inside an `if` block inside a function get names like
// "openPostProcessor/BlockNameSpace$N" — the `/` is illegal in JVM class names.
// At the top level of a function the names are "buildPPSpatialPanel$N" (valid).
JPanel buildPPSpatialPanel(ArrayList stacks) {
    // Guard: corrections are only valid for Spatial mode experiments.
    final boolean isSpatial = config.acqSettings.processingMode.equals("Spatial");

    // BT correction checkbox — allows enabling/disabling BT in the post-processor
    // regardless of what was saved in the acquisition settings.
    final boolean btInitial = isSpatial && config.acqSettings.btCorrectionEnabled;
    if (!btInitial) config.acqSettings.btCorrectionEnabled = false;
    final JCheckBox ppBTCheckbox = new JCheckBox("Bleedthrough Correction", btInitial);
    ppBTCheckbox.setEnabled(isSpatial);
    ppBTCheckbox.setToolTipText("Enable bleedthrough correction (spatial mode only)");

    final JTextField ppBTFactorField = new JTextField(
        String.valueOf(config.acqSettings.btFactor), 6);
    ppBTFactorField.setToolTipText("Bleedthrough correction factor");
    ppBTFactorField.setEnabled(btInitial);
    ppBTFactorField.addFocusListener(new java.awt.event.FocusAdapter() {
        public void focusLost(java.awt.event.FocusEvent fe) {
            try { config.acqSettings.btFactor =
                Double.parseDouble(ppBTFactorField.getText().trim().replace(",", ".")); }
            catch (NumberFormatException nfe) {}
        }
    });
    ppBTFactorField.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            try { config.acqSettings.btFactor =
                Double.parseDouble(ppBTFactorField.getText().trim().replace(",", ".")); }
            catch (NumberFormatException nfe) {}
        }
    });

    // DE correction requires BT correction to be active and mode to be Spatial.
    final boolean deInitial = btInitial && config.acqSettings.deEnabled;
    if (!deInitial) config.acqSettings.deEnabled = false;
    final JCheckBox ppDECheckbox = new JCheckBox("Direct Excitation");
    ppDECheckbox.setSelected(deInitial);
    ppDECheckbox.setEnabled(btInitial);
    ppDECheckbox.setToolTipText("Subtract per-ROI direct excitation offset (requires BT correction)");
    final JTextField ppDEFactorField = new JTextField(
        String.valueOf(config.acqSettings.deFactor), 6);
    ppDEFactorField.setEnabled(deInitial);
    final JComboBox ppDEStackCombo = new JComboBox();
    for (int dsi = 0; dsi < stacks.size(); dsi++)
        ppDEStackCombo.addItem(((ImagePlus) stacks.get(dsi)).getTitle());
    ppDEStackCombo.setSelectedIndex(
        Math.min(config.acqSettings.deStackIndex, stacks.size() - 1));
    ppDEStackCombo.setEnabled(deInitial);
    final JTextField ppDEFromField = new JTextField(
        String.valueOf(config.acqSettings.deFromFrame), 5);
    ppDEFromField.setEnabled(deInitial);
    final JTextField ppDEToField = new JTextField(
        String.valueOf(config.acqSettings.deToFrame), 5);
    ppDEToField.setEnabled(deInitial);

    // Direction combo — declared here so the ppBTCheckbox listener below can reference it.
    String splitAxis = config.acqSettings.spatialConfig != null
        ? config.acqSettings.spatialConfig.splitAxis : "Horizontal";
    String[] btDirOptions = splitAxis.equals("Vertical")
        ? new String[]{"Left -> Right", "Right -> Left"}
        : new String[]{"Upper -> Lower", "Lower -> Upper"};
    final JComboBox ppBTDirectionCombo = new JComboBox(btDirOptions);
    ppBTDirectionCombo.setSelectedItem(config.acqSettings.btDirection);
    ppBTDirectionCombo.setEnabled(btInitial);
    ppBTDirectionCombo.setToolTipText("Direction of bleedthrough: which region bleeds INTO the other");
    ppBTDirectionCombo.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            config.acqSettings.btDirection = (String) ppBTDirectionCombo.getSelectedItem();
        }
    });

    ppBTCheckbox.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            config.acqSettings.btCorrectionEnabled = ppBTCheckbox.isSelected();
            ppBTFactorField.setEnabled(config.acqSettings.btCorrectionEnabled);
            ppBTDirectionCombo.setEnabled(config.acqSettings.btCorrectionEnabled);
            ppDECheckbox.setEnabled(config.acqSettings.btCorrectionEnabled);
            if (!config.acqSettings.btCorrectionEnabled) {
                ppDECheckbox.setSelected(false);
                config.acqSettings.deEnabled = false;
            }
            ppDEFactorField.setEnabled(config.acqSettings.btCorrectionEnabled && config.acqSettings.deEnabled);
            ppDEStackCombo.setEnabled(config.acqSettings.btCorrectionEnabled && config.acqSettings.deEnabled);
            ppDEFromField.setEnabled(config.acqSettings.btCorrectionEnabled && config.acqSettings.deEnabled);
            ppDEToField.setEnabled(config.acqSettings.btCorrectionEnabled && config.acqSettings.deEnabled);
        }
    });
    ppDECheckbox.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            config.acqSettings.deEnabled = ppDECheckbox.isSelected();
            ppDEFactorField.setEnabled(config.acqSettings.deEnabled);
            ppDEStackCombo.setEnabled(config.acqSettings.deEnabled);
            ppDEFromField.setEnabled(config.acqSettings.deEnabled);
            ppDEToField.setEnabled(config.acqSettings.deEnabled);
        }
    });
    ppDEFactorField.addFocusListener(new java.awt.event.FocusAdapter() {
        public void focusLost(java.awt.event.FocusEvent fe) {
            try { config.acqSettings.deFactor =
                Double.parseDouble(ppDEFactorField.getText().trim().replace(",", ".")); }
            catch (NumberFormatException nfe) {}
        }
    });
    ppDEFactorField.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            try { config.acqSettings.deFactor =
                Double.parseDouble(ppDEFactorField.getText().trim().replace(",", ".")); }
            catch (NumberFormatException nfe) {}
        }
    });
    ppDEStackCombo.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            if (ppDEStackCombo.getSelectedIndex() >= 0)
                config.acqSettings.deStackIndex = ppDEStackCombo.getSelectedIndex();
        }
    });
    ppDEFromField.addFocusListener(new java.awt.event.FocusAdapter() {
        public void focusLost(java.awt.event.FocusEvent fe) {
            try { config.acqSettings.deFromFrame =
                Integer.parseInt(ppDEFromField.getText().trim()); }
            catch (NumberFormatException nfe) {}
        }
    });
    ppDEFromField.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            try { config.acqSettings.deFromFrame =
                Integer.parseInt(ppDEFromField.getText().trim()); }
            catch (NumberFormatException nfe) {}
        }
    });
    ppDEToField.addFocusListener(new java.awt.event.FocusAdapter() {
        public void focusLost(java.awt.event.FocusEvent fe) {
            try { config.acqSettings.deToFrame =
                Integer.parseInt(ppDEToField.getText().trim()); }
            catch (NumberFormatException nfe) {}
        }
    });
    ppDEToField.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            try { config.acqSettings.deToFrame =
                Integer.parseInt(ppDEToField.getText().trim()); }
            catch (NumberFormatException nfe) {}
        }
    });

    // ROI region combo — which half of the image the ROIs were drawn on.
    // Changing this lets the user correct a mismatch without re-running the experiment.
    String[] roiRegionOptions = splitAxis.equals("Vertical")
        ? new String[]{"Left", "Right"}
        : new String[]{"Upper", "Lower"};
    final JComboBox ppROIRegionCombo = new JComboBox(roiRegionOptions);
    if (config.acqSettings.spatialConfig != null)
        ppROIRegionCombo.setSelectedItem(config.acqSettings.spatialConfig.roiSourceRegion);
    ppROIRegionCombo.setToolTipText("Which half of the image the ROIs were drawn on");
    ppROIRegionCombo.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            if (config.acqSettings.spatialConfig != null)
                config.acqSettings.spatialConfig.roiSourceRegion =
                    (String) ppROIRegionCombo.getSelectedItem();
        }
    });

    JPanel ppSpatialPanel = new JPanel(new FlowLayout(FlowLayout.LEFT, 8, 4));
    ppSpatialPanel.add(new JLabel("ROI Region:"));
    ppSpatialPanel.add(ppROIRegionCombo);
    ppSpatialPanel.add(javax.swing.Box.createHorizontalStrut(8));
    ppSpatialPanel.add(ppBTCheckbox);
    ppSpatialPanel.add(new JLabel("Direction:"));
    ppSpatialPanel.add(ppBTDirectionCombo);
    ppSpatialPanel.add(new JLabel("Factor:"));
    ppSpatialPanel.add(ppBTFactorField);
    ppSpatialPanel.add(javax.swing.Box.createHorizontalStrut(16));
    ppSpatialPanel.add(ppDECheckbox);
    ppSpatialPanel.add(new JLabel("Factor:"));
    ppSpatialPanel.add(ppDEFactorField);
    ppSpatialPanel.add(new JLabel("Stack:"));
    ppSpatialPanel.add(ppDEStackCombo);
    ppSpatialPanel.add(new JLabel("Frames:"));
    ppSpatialPanel.add(ppDEFromField);
    ppSpatialPanel.add(new JLabel("\u2013"));
    ppSpatialPanel.add(ppDEToField);
    ppSpatialPanel.setBorder(BorderFactory.createTitledBorder("Spatial Correction"));
    return ppSpatialPanel;
}

void openPostProcessor() {
    // 1. Pick experiment folder
    JFileChooser fc = new JFileChooser();
    fc.setDialogTitle("Select Experiment Folder for Post-Processing");
    fc.setFileSelectionMode(JFileChooser.DIRECTORIES_ONLY);
    String lastPath = prefs.get("lastSavePath", "");
    if (!lastPath.isEmpty() && new File(lastPath).exists())
        fc.setCurrentDirectory(new File(lastPath));
    if (fc.showOpenDialog(frame) != JFileChooser.APPROVE_OPTION) return;

    final File expFolder = fc.getSelectedFile();

    // 2. Validate settings file
    File settingsFile = new File(expFolder, "AquisitionSettings.csv");
    if (!settingsFile.exists()) {
        JOptionPane.showMessageDialog(frame,
            "No AquisitionSettings.csv found in:\n" + expFolder.getAbsolutePath(),
            "Invalid Folder", JOptionPane.ERROR_MESSAGE);
        return;
    }

    // 3. Load settings into GUI widgets then capture into config
    applySettingsFromFile(settingsFile);
    config.acqSettings.captureFromGUI(tableModel, vizTableModel, simpleSnapMode, livePics,
        convertToStack, stackPerRow, prefs.get("lastSavePath", ""),
        processingModeCombo, splitAxisCombo, roiSourceCombo,
        bgCorrectionCheckbox, btCorrectionCheckbox, btDirectionCombo, btFactorField, experimentNameField);
    config.experimentFolder = expFolder.getAbsolutePath();

    // 4. Find image source (images/ subfolder → Image_Stack.tif → Stack_Row_N.tif)
    // Each source file is its own ImagePlus window; titles come from file/folder names.
    ArrayList ppStacks = new ArrayList();
    File imagesSubfolder = new File(expFolder, "images");
    File singleStackFile = new File(expFolder, "Image_Stack.tif");

    if (imagesSubfolder.exists()) {
        File[] tiffs = imagesSubfolder.listFiles(new java.io.FilenameFilter() {
            public boolean accept(File d, String name) {
                String lc = name.toLowerCase();
                return lc.endsWith(".tif") || lc.endsWith(".tiff");
            }
        });
        if (tiffs != null && tiffs.length > 0) {
            java.util.Arrays.sort(tiffs);
            ij.ImageStack is = new ij.ImageStack();
            for (int fi = 0; fi < tiffs.length; fi++) {
                ImagePlus tmp = IJ.openImage(tiffs[fi].getAbsolutePath());
                if (tmp != null) is.addSlice(tiffs[fi].getName(), tmp.getProcessor());
            }
            if (is.getSize() > 0) ppStacks.add(new ImagePlus(expFolder.getName(), is));
        }
    }
    if (ppStacks.isEmpty() && singleStackFile.exists()) {
        ImagePlus tmp = IJ.openImage(singleStackFile.getAbsolutePath());
        if (tmp != null) ppStacks.add(tmp);
    }

    // Per-row stack metadata: non-null only when Stack_Row_N.tif files are loaded.
    // perStackSeqRows[i] = seqRow for stacks[i]; perStackTimestamps[i] = ordered timestamps.
    ArrayList ppPerStackSeqRows    = null;
    ArrayList ppPerStackTimestamps = null;
    if (ppStacks.isEmpty()) {
        File[] rowStacks = expFolder.listFiles(new java.io.FilenameFilter() {
            public boolean accept(File d, String name) {
                return name.startsWith("Stack_Row_") && name.endsWith(".tif");
            }
        });
        if (rowStacks != null && rowStacks.length > 0) {
            java.util.Arrays.sort(rowStacks);
            // Build per-row timelines from RAW CSVs so each stack's slices get
            // their correct original acquisition timestamps (not the wrong global index).
            ppPerStackSeqRows    = new ArrayList();
            ppPerStackTimestamps = new ArrayList();
            Map rowTimelinesMap = ppReadTimestampsPerRow(expFolder);
            for (int fi = 0; fi < rowStacks.length; fi++) {
                ImagePlus tmp = IJ.openImage(rowStacks[fi].getAbsolutePath());
                if (tmp == null) continue;
                ppStacks.add(tmp);
                // Extract N from filename "Stack_Row_N.tif"
                int rowNum = fi + 1; // fallback
                try {
                    String numStr = rowStacks[fi].getName()
                        .replace("Stack_Row_", "").replace(".tif", "").trim();
                    rowNum = Integer.parseInt(numStr);
                } catch (Exception ignored) {}
                ppPerStackSeqRows.add(new Integer(rowNum));
                ArrayList rowTsList = (ArrayList) rowTimelinesMap.get(new Integer(rowNum));
                ppPerStackTimestamps.add(rowTsList != null ? rowTsList : new ArrayList());
            }
        }
    }
    if (ppStacks.isEmpty()) {
        JOptionPane.showMessageDialog(frame,
            "No image data found in experiment folder.\n"
            + "Expected: images/ subfolder, Image_Stack.tif, or Stack_Row_N.tif",
            "No Images Found", JOptionPane.ERROR_MESSAGE);
        return;
    }

    final ArrayList finalStacks = ppStacks;
    final ArrayList finalPerStackSeqRows    = ppPerStackSeqRows;
    final ArrayList finalPerStackTimestamps = ppPerStackTimestamps;
    for (int si = 0; si < finalStacks.size(); si++)
        ((ImagePlus) finalStacks.get(si)).show();

    // 5. Load ROI Manager
    ij.plugin.frame.RoiManager rm = ij.plugin.frame.RoiManager.getInstance();
    if (rm == null) {
        IJ.run("ROI Manager...", "");
        rm = ij.plugin.frame.RoiManager.getInstance();
    }
    rm.reset();
    File roiSetFile = new File(expFolder, "RoiSet.zip");
    if (roiSetFile.exists()) rm.runCommand("Open", roiSetFile.getAbsolutePath());
    ImagePlus firstStack = (ImagePlus) finalStacks.get(0);
    rm.runCommand(firstStack, "Show All");

    final int imgW = firstStack.getWidth();
    final int imgH = firstStack.getHeight();
    final ij.plugin.frame.RoiManager finalRM = rm;

    ppRebuildROIsFromManager(rm, imgW, imgH);

    // 6. Read frame timestamps from existing RAW CSVs (best-effort)
    final ArrayList frameTimestamps = ppReadTimestamps(expFolder);

    // 7. Data containers
    final ArrayList ppDataRows  = new ArrayList();
    final ArrayList ppCorrRows  = new ArrayList();
    final ArrayList ppBCRows    = new ArrayList(); // BG + Bleach corrected
    final ArrayList ppBTRows    = new ArrayList();
    final ArrayList ppDERows    = new ArrayList(); // BG + BC + BT + DE corrected
    final ArrayList ppMeanDirEx  = new ArrayList(); // per-ROI DE means (for log)
    final ArrayList ppBleachSlopes = new ArrayList(); // per-stack OLS slopes (for log)

    // Bleach correction config: one entry per stack.
    // Each entry: ArrayList[Boolean enabled, Integer fromFrame, Integer toFrame, Double slopeScale]
    final ArrayList bcConfigs = new ArrayList();
    for (int si = 0; si < ppStacks.size(); si++) {
        ArrayList cfg = new ArrayList();
        cfg.add(Boolean.FALSE);
        cfg.add(new Integer(1));
        cfg.add(new Integer(((ImagePlus) ppStacks.get(si)).getStackSize()));
        cfg.add(new Double(1.0));
        bcConfigs.add(cfg);
    }

    // 8. Build chart datasets and panels (same pattern as acquisition window)
    final boolean isTemporal = config.acqSettings.processingMode.equals("Temporal");
    final ArrayList ppDatasets    = new ArrayList();
    final ArrayList ppCharts      = new ArrayList();
    final ArrayList ppChartPanels = new ArrayList();

    for (int i = 0; i < 4; i++) {
        if (i >= config.acqSettings.visualizationRows.size()) {
            ppDatasets.add(null); ppCharts.add(null); ppChartPanels.add(null);
            continue;
        }
        ArrayList vizRow = (ArrayList) config.acqSettings.visualizationRows.get(i);
        String graphType = (String) vizRow.get(1);
        if (graphType == null || graphType.trim().isEmpty() || graphType.equals("none")) {
            ppDatasets.add(null); ppCharts.add(null); ppChartPanels.add(null);
            continue;
        }
        String frameLogic = computeFrameLogicLabel(vizRow, isTemporal);
        XYSeriesCollection dataset = new XYSeriesCollection();
        int numROIs = config.storedROIs != null ? config.storedROIs.size() : 0;
        int numSeries = (graphType.startsWith("Split ratio") || (!isTemporal && graphType.startsWith("Intensity ")))
            ? numROIs / 2 : numROIs;
        for (int si = 0; si < numSeries; si++) dataset.addSeries(new XYSeries("ROI" + (si + 1)));
        ppDatasets.add(dataset);

        String yLabel = (graphType.equals("Intensity") || graphType.startsWith("Intensity "))
            ? "Intensity [A.U.]" : "Ratio";
        String title  = "Graph " + (i + 1) + " - " + graphType
            + (frameLogic.isEmpty() ? "" : " (" + frameLogic + ")");
        JFreeChart chart = ChartFactory.createXYLineChart(
            title, "Time (s)", yLabel, dataset, PlotOrientation.VERTICAL, true, false, false);
        chart.setBackgroundPaint(Color.WHITE);
        chart.getTitle().setFont(new Font("SansSerif", Font.BOLD, 11));
        XYPlot plot = chart.getXYPlot();
        plot.setBackgroundPaint(Color.LIGHT_GRAY);
        plot.setDomainGridlinePaint(Color.WHITE);
        plot.setRangeGridlinePaint(Color.WHITE);
        plot.getDomainAxis().setAutoRange(true);
        plot.getRangeAxis().setAutoRange(true);
        org.jfree.chart.renderer.xy.XYItemRenderer rend = plot.getRenderer();
        if (rend instanceof org.jfree.chart.renderer.xy.XYLineAndShapeRenderer) {
            org.jfree.chart.renderer.xy.XYLineAndShapeRenderer lr =
                (org.jfree.chart.renderer.xy.XYLineAndShapeRenderer) rend;
            for (int si = 0; si < numSeries; si++) {
                lr.setSeriesLinesVisible(si, Boolean.TRUE);
                lr.setSeriesShapesVisible(si, Boolean.FALSE);
                lr.setSeriesStroke(si, new BasicStroke(2.0f));
            }
        }
        ChartPanel cp = new ChartPanel(chart);
        cp.setMouseWheelEnabled(true);
        ppCharts.add(chart);
        ppChartPanels.add(cp);
    }

    // 9. Chart grid layout
    int activePanels = 0;
    for (int i = 0; i < ppChartPanels.size(); i++) if (ppChartPanels.get(i) != null) activePanels++;
    int gridCols = activePanels <= 1 ? 1 : 2;
    int gridRows = activePanels <= 2 ? 1 : 2;
    JPanel chartGrid = new JPanel(new GridLayout(gridRows, gridCols, 5, 5));
    for (int i = 0; i < ppChartPanels.size(); i++) {
        if (ppChartPanels.get(i) != null) chartGrid.add((ChartPanel) ppChartPanels.get(i));
    }

    // 10. BG correction controls
    final JCheckBox ppBGCheckbox = new JCheckBox("BG Correction", config.acqSettings.bgCorrectionEnabled);
    final JComboBox ppBGCombo    = new JComboBox();
    for (int ri = 0; ri < config.storedROIs.size(); ri++) ppBGCombo.addItem("ROI " + (ri + 1));
    if (config.storedROIs.size() > 0)
        ppBGCombo.setSelectedIndex(Math.min(config.acqSettings.bgROIIndex, config.storedROIs.size() - 1));
    ppBGCombo.setEnabled(config.acqSettings.bgCorrectionEnabled);

    ppBGCheckbox.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            config.acqSettings.bgCorrectionEnabled = ppBGCheckbox.isSelected();
            ppBGCombo.setEnabled(ppBGCheckbox.isSelected());
        }
    });
    ppBGCombo.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            if (ppBGCombo.getSelectedIndex() >= 0)
                config.acqSettings.bgROIIndex = ppBGCombo.getSelectedIndex();
        }
    });

    final JLabel ppStatus = new JLabel("Loading...");

    // 11. Recalculate button
    final JButton ppRecalcButton = new JButton("Recalculate");
    ppRecalcButton.setBackground(new Color(150, 200, 255));
    ppRecalcButton.setEnabled(false);
    ppRecalcButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            ppStatus.setText("Recalculating...");
            ppRecalcButton.setEnabled(false);
            new Thread(new Runnable() {
                public void run() {
                    try {
                        SwingUtilities.invokeAndWait(new Runnable() {
                            public void run() {
                                // Rebuild ROIs on EDT (ROI Manager is a Swing component)
                                ppRebuildROIsFromManager(finalRM, imgW, imgH);
                                // Refresh BG ROI combo, keeping current selection
                                int savedIdx = config.acqSettings.bgROIIndex;
                                ppBGCombo.removeAllItems();
                                for (int ri = 0; ri < config.storedROIs.size(); ri++)
                                    ppBGCombo.addItem("ROI " + (ri + 1));
                                int newIdx = config.storedROIs.size() > 0
                                    ? Math.min(savedIdx, config.storedROIs.size() - 1) : 0;
                                ppBGCombo.setSelectedIndex(newIdx);
                                config.acqSettings.bgROIIndex = newIdx; // suppress spurious action events
                                // Sync chart series count to new ROI count
                                ppUpdateChartSeries(ppDatasets, ppCharts);
                            }
                        });
                    } catch (Exception ex) { ex.printStackTrace(); }
                    ppRecalculate(finalStacks, frameTimestamps,
                        ppDataRows, ppCorrRows, ppBCRows, ppBTRows, ppDERows, ppMeanDirEx,
                        ppBleachSlopes, bcConfigs,
                        ppDatasets, ppCharts, ppChartPanels,
                        finalPerStackSeqRows, finalPerStackTimestamps);
                    SwingUtilities.invokeLater(new Runnable() {
                        public void run() {
                            ppStatus.setText("Done \u2014 " + ppDataRows.size() + " frames");
                            ppRecalcButton.setEnabled(true);
                        }
                    });
                }
            }).start();
        }
    });

    // 12. Export button
    final JButton ppExportButton = new JButton("Export");
    ppExportButton.setBackground(new Color(150, 255, 150));
    ppExportButton.setEnabled(false);
    ppExportButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            ppStatus.setText("Exporting...");
            ppExportButton.setEnabled(false);
            new Thread(new Runnable() {
                public void run() {
                    try {
                        try {
                            SwingUtilities.invokeAndWait(new Runnable() {
                                public void run() {
                                    ppRebuildROIsFromManager(finalRM, imgW, imgH);
                                    ppUpdateChartSeries(ppDatasets, ppCharts);
                                }
                            });
                        } catch (Exception ex) { ex.printStackTrace(); }
                        ppRecalculate(finalStacks, frameTimestamps,
                            ppDataRows, ppCorrRows, ppBCRows, ppBTRows, ppDERows, ppMeanDirEx,
                            ppBleachSlopes, bcConfigs,
                            ppDatasets, ppCharts, ppChartPanels,
                            finalPerStackSeqRows, finalPerStackTimestamps);
                        ppExport(ppDataRows, ppCorrRows, ppBCRows, ppBTRows, ppDERows, ppMeanDirEx,
                            ppBleachSlopes, bcConfigs, finalStacks, expFolder, finalRM);
                        SwingUtilities.invokeLater(new Runnable() {
                            public void run() {
                                ppStatus.setText("Exported");
                                ppExportButton.setEnabled(true);
                            }
                        });
                    } catch (Exception threadEx) {
                        print("[Export] ERROR: " + threadEx.getClass().getName() + ": " + threadEx.getMessage());
                        threadEx.printStackTrace();
                        SwingUtilities.invokeLater(new Runnable() {
                            public void run() {
                                ppStatus.setText("Export failed — see terminal");
                                ppExportButton.setEnabled(true);
                            }
                        });
                    }
                }
            }).start();
        }
    });

    // 13. Close button
    final JFrame[] ppFrameRef = {null};
    JButton ppCloseButton = new JButton("Close");
    ppCloseButton.setBackground(Color.ORANGE);
    ppCloseButton.addActionListener(new ActionListener() {
        public void actionPerformed(ActionEvent e) {
            if (ppFrameRef[0] != null) ppFrameRef[0].dispose();
            for (int si = 0; si < finalStacks.size(); si++) {
                ImagePlus st = (ImagePlus) finalStacks.get(si);
                if (st.getWindow() != null) st.getWindow().close();
            }
            frame.setVisible(true);
        }
    });

    // 14. Control panel
    JPanel ppBGPanel = new JPanel(new FlowLayout(FlowLayout.LEFT, 8, 4));
    ppBGPanel.add(ppBGCheckbox);
    ppBGPanel.add(new JLabel("BG ROI:"));
    ppBGPanel.add(ppBGCombo);
    ppBGPanel.add(ppStatus);

    JPanel ppButtonPanel = new JPanel(new FlowLayout(FlowLayout.RIGHT, 8, 4));
    ppButtonPanel.add(ppRecalcButton);
    ppButtonPanel.add(ppExportButton);
    ppButtonPanel.add(ppCloseButton);

    // 14b. Bleach correction panel (one row per stack)
    final JPanel ppBleachPanel = buildPPBleachPanel(finalStacks, bcConfigs);

    // 14c. Spatial-only correction controls (visible only in Spatial mode)
    // Built in a separate function to avoid BeanShell/JDK-11 class-naming bug
    // (anonymous classes inside `if` blocks get illegal "/" in their JVM names).
    JPanel ppSpatialPanel = null;
    if (!isTemporal) {
        ppSpatialPanel = buildPPSpatialPanel(finalStacks);
    }

    JPanel ppControlPanel = new JPanel();
    ppControlPanel.setLayout(new BoxLayout(ppControlPanel, BoxLayout.Y_AXIS));
    JPanel ppTopBar = new JPanel(new BorderLayout());
    ppTopBar.add(ppBGPanel, BorderLayout.WEST);
    ppTopBar.add(ppButtonPanel, BorderLayout.EAST);
    ppControlPanel.add(ppTopBar);
    ppControlPanel.add(ppBleachPanel);
    if (ppSpatialPanel != null) ppControlPanel.add(ppSpatialPanel);
    ppControlPanel.setBorder(BorderFactory.createEtchedBorder());

    // 15. Post-processor frame
    JFrame ppFrame = new JFrame("LUMETRIC Post-Processor \u2014 " + expFolder.getName());
    ppFrameRef[0] = ppFrame;
    java.awt.Dimension screenSize = java.awt.Toolkit.getDefaultToolkit().getScreenSize();
    ppFrame.setSize((int)(screenSize.width * 0.85), (int)(screenSize.height * 0.80));
    ppFrame.setLocationRelativeTo(null);
    ppFrame.setDefaultCloseOperation(JFrame.DO_NOTHING_ON_CLOSE);
    ppFrame.addWindowListener(new java.awt.event.WindowAdapter() {
        public void windowClosing(java.awt.event.WindowEvent we) {
            ppFrameRef[0].dispose();
            for (int si = 0; si < finalStacks.size(); si++) {
                ImagePlus st = (ImagePlus) finalStacks.get(si);
                if (st.getWindow() != null) st.getWindow().close();
            }
            frame.setVisible(true);
        }
    });

    JPanel ppMain = new JPanel(new BorderLayout(5, 5));
    ppMain.setBorder(BorderFactory.createEmptyBorder(5, 5, 5, 5));
    ppMain.add(chartGrid,      BorderLayout.CENTER);
    ppMain.add(ppControlPanel, BorderLayout.SOUTH);
    ppFrame.add(ppMain);

    // 16. Show post-processor, hide main menu
    frame.setVisible(false);
    ppFrame.setVisible(true);

    // 17. Initial recalculate in background thread
    new Thread(new Runnable() {
        public void run() {
            ppRecalculate(finalStacks, frameTimestamps,
                ppDataRows, ppCorrRows, ppBCRows, ppBTRows, ppDERows, ppMeanDirEx,
                ppBleachSlopes, bcConfigs,
                ppDatasets, ppCharts, ppChartPanels,
                finalPerStackSeqRows, finalPerStackTimestamps);
            SwingUtilities.invokeLater(new Runnable() {
                public void run() {
                    ppStatus.setText("Ready \u2014 " + ppDataRows.size() + " frames");
                    ppRecalcButton.setEnabled(true);
                    ppExportButton.setEnabled(true);
                }
            });
        }
    }).start();
}
