// Mode change listener - clear table and update options
typeEditor = new VisualizationTypeEditor();
processingModeCombo.addActionListener(new ActionListener() {
    public void actionPerformed(ActionEvent e) {
        String mode = (String) processingModeCombo.getSelectedItem();

        // Show/hide spatial config and BT panel
        spatialConfigPanel.setVisible(mode.equals("Spatial"));
        btCorrectionPanel.setVisible(mode.equals("Spatial"));
        if (!mode.equals("Spatial")) {
            btCorrectionCheckbox.setSelected(false);
            btCorrectionCheckbox.setEnabled(false);
        } else {
            btCorrectionCheckbox.setEnabled(bgCorrectionCheckbox.isSelected());
        }

        // Update table model mode (which rebuilds columns)
        vizTableModel.setProcessingMode(mode);

        // Update type editor options
        SpatialConfig config = new SpatialConfig();
        config.splitAxis = (String) splitAxisCombo.getSelectedItem();
        config.roiSourceRegion = (String) roiSourceCombo.getSelectedItem();
        typeEditor.setProcessingMode(mode, config);
        vizTable.getColumnModel().getColumn(1).setCellEditor(typeEditor);

        // Fire structure change (resets the column model — all editors must be re-applied below)
        vizTableModel.fireTableStructureChanged();
        vizTable.getColumnModel().getColumn(0).setPreferredWidth(80);
        vizTable.getColumnModel().getColumn(1).setPreferredWidth(180);

        // Re-apply all cell editors after structure change
        vizTable.getColumnModel().getColumn(1).setCellEditor(typeEditor);
        if (mode.equals("Temporal")) {
            // Build row-selector combos inline — tableModel is accessible here (outer scope)
            int rCnt = tableModel.getRowCount();
            if (rCnt < 1) rCnt = 1;
            JComboBox mNumCombo = new JComboBox();
            mNumCombo.addItem("All Rows");
            mNumCombo.addItem("1");
            for (int r = 1; r <= rCnt; r++) mNumCombo.addItem("Row " + r);
            vizTable.getColumnModel().getColumn(2).setCellEditor(new DefaultCellEditor(mNumCombo));
            vizTable.getColumnModel().getColumn(2).setPreferredWidth(120);
            JComboBox mDenCombo = new JComboBox();
            mDenCombo.addItem("1");
            for (int r = 1; r <= rCnt; r++) mDenCombo.addItem("Row " + r);
            vizTable.getColumnModel().getColumn(3).setCellEditor(new DefaultCellEditor(mDenCombo));
            vizTable.getColumnModel().getColumn(3).setPreferredWidth(120);
        } else if (mode.equals("Spatial")) {
            // Build Row Filter combo for Spatial mode
            int rCnt = tableModel.getRowCount();
            if (rCnt < 1) rCnt = 1;
            JComboBox mRowFilterCombo = new JComboBox();
            mRowFilterCombo.addItem("All Rows");
            for (int r = 1; r <= rCnt; r++) mRowFilterCombo.addItem("Row " + r);
            vizTable.getColumnModel().getColumn(2).setCellEditor(new DefaultCellEditor(mRowFilterCombo));
            vizTable.getColumnModel().getColumn(2).setPreferredWidth(120);
        }
    }
});

// Split axis change listener - update ROI source options
splitAxisCombo.addActionListener(new ActionListener() {
    public void actionPerformed(ActionEvent e) {
        String axis = (String) splitAxisCombo.getSelectedItem();

        // Temporarily remove the action listener to prevent cascading events
        ActionListener[] listeners = roiSourceCombo.getActionListeners();
        for (ActionListener listener : listeners) {
            roiSourceCombo.removeActionListener(listener);
        }

        roiSourceCombo.removeAllItems();
        if (axis.equals("Horizontal")) {
            roiSourceCombo.addItem("Upper");
            roiSourceCombo.addItem("Lower");
        } else {
            roiSourceCombo.addItem("Left");
            roiSourceCombo.addItem("Right");
        }

        // Restore action listeners
        for (ActionListener listener : listeners) {
            roiSourceCombo.addActionListener(listener);
        }

        // Rebuild btDirectionCombo to match new axis (physical direction labels)
        String currentBtDir = btDirectionCombo != null ? (String) btDirectionCombo.getSelectedItem() : null;
        if (btDirectionCombo != null) {
            btDirectionCombo.removeAllItems();
            if (axis.equals("Horizontal")) {
                btDirectionCombo.addItem("Upper -> Lower");
                btDirectionCombo.addItem("Lower -> Upper");
            } else {
                btDirectionCombo.addItem("Left -> Right");
                btDirectionCombo.addItem("Right -> Left");
            }
            // Axis changed — reset to first item (old label is no longer valid)
        }

        // Clear all visualization settings when split axis changes
        if (processingModeCombo.getSelectedItem().equals("Spatial")) {
            for (int row = 0; row < vizTableModel.getRowCount(); row++) {
                vizTableModel.setValueAt("none", row, 1);
            }
        }

        // Update type editor when spatial config changes
        if (processingModeCombo.getSelectedItem().equals("Spatial")) {
            SpatialConfig config = new SpatialConfig();
            config.splitAxis = axis;
            config.roiSourceRegion = (String) roiSourceCombo.getSelectedItem();
            typeEditor.setProcessingMode("Spatial", config);
            vizTable.getColumnModel().getColumn(1).setCellEditor(typeEditor);
        }
    }
});

// bgCorrectionCheckbox listener — enable/disable BT checkbox
bgCorrectionCheckbox.addActionListener(new ActionListener() {
    public void actionPerformed(ActionEvent e) {
        boolean bgOn = bgCorrectionCheckbox.isSelected();
        boolean isSpatial = processingModeCombo.getSelectedItem().equals("Spatial");
        btCorrectionCheckbox.setEnabled(bgOn && isSpatial);
        if (!bgOn) {
            btCorrectionCheckbox.setSelected(false);
        }
    }
});

