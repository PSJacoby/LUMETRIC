// Validation function
    boolean validateSequence() {
        // Stop any active cell editing to commit current edits
        if (table.isEditing()) {
            javax.swing.table.TableCellEditor editor = table.getCellEditor();
            if (editor != null) {
                editor.stopCellEditing();
            }
        }
        if (vizTable.isEditing()) {
            javax.swing.table.TableCellEditor editor = vizTable.getCellEditor();
            if (editor != null) {
                editor.stopCellEditing();
            }
        }

        int rowCount = tableModel.getRowCount();
        StringBuilder errors = new StringBuilder();

        for (int i = 0; i < rowCount; i++) {
            // Note: Empty channels are allowed (e.g., for delay rows)
            // Validate numeric fields (should be auto-corrected, but double-check)
            int exposureValue = 0;
            int frameIntervalValue = 0;
            try {
                String exposure = tableModel.getValueAt(i, 2).toString();
                if (!exposure.isEmpty()) {
                    int exp = Integer.parseInt(exposure);
                    exposureValue = exp;
                    if (exp < 0 || exp > 60000) {
                        errors.append("Row " + (i + 1) + ": Exposure must be 0-60000 ms\n");
                    }
                }
            } catch (NumberFormatException e) {
                errors.append("Row " + (i + 1) + ": Invalid exposure value\n");
            }

            try {
                String frameRate = tableModel.getValueAt(i, 3).toString();
                if (!frameRate.isEmpty()) {
                    int fr = Integer.parseInt(frameRate);
                    frameIntervalValue = fr;
                    if (fr < 0 || fr > 60000) {
                        errors.append("Row " + (i + 1) + ": Frame interval must be 0-60000 ms\n");
                    }
                }
            } catch (NumberFormatException e) {
                errors.append("Row " + (i + 1) + ": Invalid frame interval value\n");
            }

            // Check that exposure time is not greater than frame interval
            if (exposureValue > 0 && frameIntervalValue > 0 && exposureValue > frameIntervalValue) {
                errors.append("Row " + (i + 1) + ": Exposure time (" + exposureValue
                        + " ms) must be less than or equal to Frame Interval (" + frameIntervalValue + " ms)\n");
            }

            try {
                String frames = tableModel.getValueAt(i, 4).toString();
                if (!frames.isEmpty()) {
                    int f = Integer.parseInt(frames);
                    if (f < 0 || f > 60000) {
                        errors.append("Row " + (i + 1) + ": Frames must be 0-60000\n");
                    }
                }
            } catch (NumberFormatException e) {
                errors.append("Row " + (i + 1) + ": Invalid frames value\n");
            }

            // Validate Loop Times
            try {
                String loopTimes = tableModel.getValueAt(i, 6).toString();
                if (!loopTimes.isEmpty()) {
                    int lt = Integer.parseInt(loopTimes);
                    if (lt < 0 || lt > 60000) {
                        errors.append("Row " + (i + 1) + ": Loop Times must be 0-60000\n");
                    }
                }
            } catch (NumberFormatException e) {
                errors.append("Row " + (i + 1) + ": Invalid Loop Times value\n");
            }

            // Validate goto references
            String loopGoto = tableModel.getValueAt(i, 5).toString();
            if (!loopGoto.isEmpty()) {
                try {
                    int gotoRow = Integer.parseInt(loopGoto);
                    if (gotoRow < 1 || gotoRow > rowCount) {
                        errors.append("Row " + (i + 1) + ": Loop Goto references non-existent row " + gotoRow + "\n");
                    }
                } catch (NumberFormatException e) {
                    errors.append("Row " + (i + 1) + ": Invalid Loop Goto value\n");
                }
            }

            String switchGoto = tableModel.getValueAt(i, 8).toString().trim();
            if (!switchGoto.isEmpty() && !switchGoto.equalsIgnoreCase("none")) {
                try {
                    int gotoRow = Integer.parseInt(switchGoto);
                    if (gotoRow < 1 || gotoRow > rowCount) {
                        errors.append(
                                "Row " + (i + 1) + ": Loop Switch Goto references non-existent row " + gotoRow + "\n");
                    }
                } catch (NumberFormatException e) {
                    errors.append("Row " + (i + 1) + ": Invalid Loop Switch Goto value (use row number or 'none')\n");
                }
            }
        }

        if (errors.length() > 0) {
            JOptionPane.showMessageDialog(frame, errors.toString(), "Validation Errors", JOptionPane.ERROR_MESSAGE);
            return false;
        } else {
            JOptionPane.showMessageDialog(frame, "Sequence is valid!", "Success", JOptionPane.INFORMATION_MESSAGE);
            return true;
        }
    }

