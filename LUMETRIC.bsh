// Control panel — left side: main action buttons; right side: Post-Processor launcher
controlPanel = new JPanel(new BorderLayout());
JPanel leftButtons  = new JPanel(new FlowLayout(FlowLayout.LEFT, 4, 2));
JPanel rightButtons = new JPanel(new FlowLayout(FlowLayout.RIGHT, 4, 2));
JButton openPostProductionButton = new JButton("Open Post-Production");
