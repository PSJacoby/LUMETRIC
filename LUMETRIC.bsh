// Function to update settings display
void updateSettingsDisplay() {
    if (config.configFilePath.isEmpty()) {
        configFileLabel.setText("Not loaded");
        cameraGroupLabel.setText("-");
        arduinoGroupLabel.setText("-");
        serialPortLabel.setText("-");
        channelsTextArea.setText("No configuration loaded.\nPlease load a configuration file.");
    } else {
        configFileLabel.setText(config.configFilePath);
        cameraGroupLabel.setText(config.cameraConfigGroup);
        arduinoGroupLabel.setText(config.arduinoConfigGroup.isEmpty() ? "(not set - will scan all groups)" : config.arduinoConfigGroup);
        serialPortLabel.setText(config.serialPort);

        StringBuilder channelText = new StringBuilder();
        for (Map.Entry entry : config.pinToChannel.entrySet()) {
            channelText.append("PIN_").append(entry.getKey())
                      .append(" = ").append(entry.getValue()).append("\n");
        }
        channelsTextArea.setText(channelText.toString());
    }
}

// Load config button action
loadConfigButton.addActionListener(new ActionListener() {
    public void actionPerformed(ActionEvent e) {
        JFileChooser fileChooser = new JFileChooser();
        fileChooser.setDialogTitle("Select Configuration File");
        fileChooser.setFileFilter(new ConfigFileFilter());

        // Start in the script directory
        String lastPath = prefs.get("lastConfigPath", "");
        if (!lastPath.isEmpty()) {
            fileChooser.setCurrentDirectory(new File(lastPath).getParentFile());
        }

        int result = fileChooser.showOpenDialog(frame);
        if (result == JFileChooser.APPROVE_OPTION) {
            File selectedFile = fileChooser.getSelectedFile();
            if (config.loadFromFile(selectedFile.getAbsolutePath())) {
                // Save this path for next time
                prefs.put("lastConfigPath", selectedFile.getAbsolutePath());
                updateSettingsDisplay();
                tabbedPane.setSelectedIndex(1);
                JOptionPane.showMessageDialog(frame,
                    "Configuration loaded successfully!\nChannels updated in Sequence tab.",
                    "Success", JOptionPane.INFORMATION_MESSAGE);
            }
        }
    }
});

